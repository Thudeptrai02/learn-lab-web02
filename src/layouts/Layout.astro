---
import SmartPopup from '../components/SmartPopup.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Learn Lab Web' } = Astro.props;
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>

  <body class="bg-[#030305] text-[#f8fafc] relative min-h-[100dvh] flex flex-col font-sans antialiased overflow-x-hidden">
    <!-- Glowing background elements -->
    <div class="fixed inset-0 -z-50 pointer-events-none overflow-hidden">
      <div class="absolute -top-[20%] -left-[10%] w-[60%] aspect-square rounded-full bg-teal-500/8 blur-[120px]"></div>
      <div class="absolute top-[40%] right-[-10%] w-[50%] aspect-square rounded-full bg-indigo-600/6 blur-[130px]"></div>
      <div class="absolute bottom-[-10%] left-[20%] w-[45%] aspect-square rounded-full bg-teal-600/5 blur-[120px]"></div>
    </div>

    <Header />
    
    <main class="flex-grow flex flex-col relative z-10">
      <slot /> 
    </main>

    <Footer />
    <SmartPopup />
  </body>
</html>