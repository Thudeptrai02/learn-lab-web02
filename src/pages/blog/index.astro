---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Lấy toàn bộ bài viết và sắp xếp theo ngày mới nhất
const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => 
  new Date(b.data.pubDate || 0).getTime() - new Date(a.data.pubDate || 0).getTime()
);

// 2. Danh sách chuyên mục chuẩn của sếp
const categories = ["Trải nghiệm", "Kiến thức", "Niềm tin", "Tài liệu"];
---

<Layout title="Blog | Learn Lab">
  <main class="pt-20 pb-24 bg-slate-50 min-h-screen">
    <div class="max-w-6xl mx-auto px-6">
      
      {/* Tiêu đề trang */}
      <div class="text-center mb-16">
        <span class="text-teal-600 font-bold text-sm tracking-widest uppercase mb-4 block">Knowledge Base</span>
        <h1 class="text-5xl font-black text-slate-900 mb-6">Học Tiếng Anh <span class="text-teal-600">Thú Vị Hơn</span></h1>
        <p class="text-slate-500 max-w-2xl mx-auto font-medium leading-relaxed">
          Nơi mình lưu giữ những bài giảng tâm huyết, vài mẫu nhật ký vu vơ và những trải nghiệm thực tế trên hành trình phát triển bản thân.
        </p>
      </div>

      {/* Bộ lọc chuyên mục */}
      <div class="flex flex-wrap gap-3 justify-center mb-16">
        <button class="category-btn active px-7 py-2.5 rounded-full bg-slate-900 text-white font-bold text-sm shadow-lg shadow-slate-200 transition-all" data-category="all">
          Tất cả
        </button>
        {categories.map(cat => (
          <button class="category-btn px-7 py-2.5 rounded-full bg-white border border-slate-200 text-slate-600 font-bold text-sm hover:border-teal-500 hover:text-teal-600 transition-all shadow-sm" data-category={cat}>
            {cat}
          </button>
        ))}
      </div>

      {/* Danh sách bài viết */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="post-grid">
        {posts.map(post => {
          const slug = post.data.slug ?? post.slug ?? post.id;
          return (
            <article class="post-card group bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all flex flex-col" data-category={post.data.category}>
              <div class="aspect-video bg-slate-100 relative overflow-hidden">
                {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-slate-300 font-black text-4xl">LL</div>
              )}
              <span class="absolute top-4 left-4 px-3 py-1 bg-teal-500 text-white text-[10px] font-black uppercase rounded-lg shadow-lg">
                {post.data.category || 'Chưa phân loại'}
              </span>
            </div>
            
            <div class="p-8 flex flex-col flex-grow">
              <div class="flex items-center gap-2 text-slate-400 text-[11px] font-bold mb-4 uppercase">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                {new Date(post.data.pubDate || '').toLocaleDateString('vi-VN', { day: '2-digit', month: 'long', year: 'numeric' })}
              </div>
              <h2 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-teal-600 transition-colors line-clamp-2">
                <a href={`/blog/${slug}`}>{post.data.title}</a>
              </h2>
              <p class="text-slate-500 text-sm leading-relaxed mb-6 line-clamp-3 font-medium italic">
                {post.data.description || 'XIN CHÀO...'}
              </p>
              <div class="mt-auto pt-6 border-t border-slate-50">
                <a href={`/blog/${slug}`} class="text-slate-900 font-black text-xs uppercase tracking-widest flex items-center gap-2 group-hover:gap-3 transition-all">
                  Đọc tiếp <svg class="w-4 h-4 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </a>
              </div>
            </div>
          </article>
        )})}
      </div>
    </div>
  </main>
</Layout>

<script>
  // Logic lọc bài viết bằng JavaScript (nhanh & mượt)
  const buttons = document.querySelectorAll('.category-btn');
  const cards = document.querySelectorAll('.post-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');

      // Đổi trạng thái active của nút
      buttons.forEach(b => b.classList.remove('bg-slate-900', 'text-white', 'active'));
      buttons.forEach(b => b.classList.add('bg-white', 'text-slate-600'));
      btn.classList.add('bg-slate-900', 'text-white', 'active');
      btn.classList.remove('bg-white', 'text-slate-600');

      // Ẩn/Hiện bài viết
      cards.forEach(card => {
        const cardCat = (card as HTMLElement).getAttribute('data-category');
        if (category === 'all' || cardCat === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>