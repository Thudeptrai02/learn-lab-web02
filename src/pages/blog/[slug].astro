---
import { getEntry, render } from 'astro:content';
// Lưu ý: Đảm bảo đường dẫn tới file Layout.astro này là chính xác với cấu trúc thư mục của sếp
import Layout from '../../layouts/Layout.astro'; 

// 1. Lấy cái đường dẫn (slug) hiện tại trên thanh địa chỉ
const { slug } = Astro.params;

// 2. Chốt chặn 1: Nếu không có slug, đá về trang chủ
if (!slug) {
  return Astro.redirect('/');
}

// 3. Chui vào kho 'blog' và tóm đích danh cái bài viết đó ra
const post = await getEntry('blog', slug);

// 4. Chốt chặn 2: Nếu link sai hoặc bài đã bị xóa -> Đá về trang chủ (Không cho sập Web)
if (!post) {
  return Astro.redirect('/');
}

// 5. Bắt đầu render nội dung Markdown
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Learn Lab`}>
  <main class="max-w-[800px] mx-auto px-6 py-16 min-h-screen">
    <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-teal-600 hover:text-teal-700 transition-colors mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Quay lại danh sách bài viết
    </a>

    <header class="mb-10 text-center">
      <h1 class="text-4xl sm:text-5xl font-black text-slate-900 leading-tight tracking-tight mb-6">{post.data.title}</h1>
      
      {post.data.description && (
        <p class="text-lg text-slate-500 font-medium max-w-2xl mx-auto">
          {post.data.description}
        </p>
      )}
      
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-sm font-bold text-slate-400 uppercase tracking-wider">
        <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full">Learn Lab Edu</span>
        <span>•</span>
        
        <time 
          datetime={new Date(post.data.pubDate || post.data.date || new Date()).toISOString()} 
          class="flex items-center gap-1.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {new Date(post.data.pubDate || post.data.date || new Date()).toLocaleDateString('vi-VN')}
        </time>
      </div>
    </header>

    {post.data.image && (
      <div class="mb-12 overflow-hidden rounded-3xl shadow-xl shadow-slate-200/50">
        <img src={post.data.image} alt={post.data.title} class="w-full h-auto object-cover aspect-video" />
      </div>
    )}

    <article class="prose prose-slate prose-lg max-w-none prose-headings:font-black prose-h2:text-3xl prose-h3:text-2xl prose-a:text-teal-600 prose-a:no-underline hover:prose-a:underline prose-img:rounded-2xl prose-img:shadow-lg prose-pre:bg-slate-900 prose-pre:shadow-xl">
      <Content />
    </article>
    
    <div class="mt-16 border-t border-slate-100 pt-8 text-center text-slate-500 font-medium">
      <p>Hết bài viết. Chúc bạn học tập hiệu quả trên hệ thống Learn Lab!</p>
    </div>
  </main>
</Layout>