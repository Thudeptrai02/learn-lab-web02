---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Đăng nhập | Learn Lab">
  <main class="flex min-h-[calc(100vh-76px)] w-full bg-slate-50 justify-center items-center p-6">
    
    <div class="w-full max-w-[420px] bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8 sm:p-10 relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-32 h-32 bg-teal-50 rounded-full blur-3xl"></div>

      <div class="relative text-center mb-8">
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Mừng sếp trở lại 👋</h1>
        <p class="mt-2 text-sm font-medium text-slate-500">Đăng nhập để tiếp tục lộ trình học thuật.</p>
      </div>

      <div class="relative mb-8">
        <button id="btn-google" class="flex w-full items-center justify-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 text-sm font-bold text-slate-700 shadow-sm transition-all hover:bg-slate-50 hover:border-slate-300 active:scale-[0.98]">
          <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google" />
          Tiếp tục siêu tốc với Google
        </button>
      </div>

      <div class="relative mb-6">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-100"></div></div>
        <div class="relative flex justify-center text-xs font-bold uppercase tracking-wider text-slate-400 bg-white px-4 mx-auto w-fit">Hoặc dùng Email</div>
      </div>

      <div id="auth-message" class="hidden mb-5 p-3.5 rounded-xl text-sm font-bold text-center transition-all"></div>

      <form id="login-form" class="relative space-y-4">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5 ml-1">Email</label>
          <input name="email" type="email" required placeholder="name@example.com" class="block w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-slate-900 placeholder:text-slate-400 focus:border-teal-500 focus:ring-4 focus:ring-teal-50 transition-all font-medium bg-slate-50/50 focus:bg-white outline-none" />
        </div>
        <div>
          <div class="flex items-center justify-between mb-1.5 ml-1 mr-1">
            <label class="block text-sm font-bold text-slate-700">Mật khẩu</label>
            <a href="#" class="text-xs font-bold text-teal-600 hover:text-teal-500">Quên mật khẩu?</a>
          </div>
          <input name="password" type="password" required placeholder="••••••••" class="block w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-slate-900 placeholder:text-slate-400 focus:border-teal-500 focus:ring-4 focus:ring-teal-50 transition-all font-medium bg-slate-50/50 focus:bg-white outline-none" />
        </div>
        <button id="submit-btn" type="submit" class="mt-2 w-full rounded-2xl bg-teal-600 px-4 py-4 text-sm font-bold text-white shadow-lg shadow-teal-200 transition-all hover:bg-teal-700 hover:-translate-y-0.5 active:scale-[0.98] flex justify-center items-center">
          Đăng nhập hệ thống
        </button>
      </form>

      <p class="mt-8 text-center text-sm font-medium text-slate-500">
        Chưa có tài khoản? <a href="/register" class="font-bold text-teal-600 hover:text-teal-700">Tạo tài khoản mới</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) window.location.href = "/";
  });

  const form = document.getElementById('login-form');
  const msgBox = document.getElementById('auth-message');
  const submitBtn = document.getElementById('submit-btn');

  function showMsg(text, isErr) {
    msgBox.textContent = text;
    msgBox.classList.remove('hidden');
    msgBox.className = `mb-5 p-3.5 rounded-xl text-sm font-bold text-center ${isErr ? 'bg-rose-50 text-rose-600 border border-rose-100' : 'bg-emerald-50 text-emerald-600 border border-emerald-100'}`;
  }

  document.getElementById('btn-google')?.addEventListener('click', async (e) => {
    e.preventDefault();
    await supabase.auth.signInWithOAuth({ provider: 'google' });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(form).get('email');
    const password = new FormData(form).get('password');

    submitBtn.disabled = true;
    submitBtn.innerHTML = `<svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    
    if (error) {
      showMsg("Thông tin đăng nhập chưa chính xác.", true);
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Đăng nhập hệ thống';
    } else {
      showMsg("Đăng nhập thành công!", false);
      window.location.href = "/";
    }
  });
</script>