---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
---
<Layout title="Tạo khảo sát - LearnLab">
<style>

  .topbar {
    background: #fff;
    border-bottom: 1px solid #e0e0e0;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky; top: 0; z-index: 50;
  }
  .topbar-left { display: flex; align-items: center; gap: 12px; }
  .topbar-left h1 { font-size: 16px; font-weight: 700; color: #202124; }
  .topbar-right { display: flex; gap: 8px; align-items: center; }

  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 18px; border: none; border-radius: 8px;
    font-size: 13px; font-weight: 600; font-family: inherit;
    cursor: pointer; transition: all .15s; text-decoration: none;
  }
  .btn-outline {
    background: transparent; color: #5f6368; border: 1px solid #dadce0;
  }
  .btn-outline:hover { background: #f8f9fa; border-color: #bdc1c6; }
  .btn-primary { background: #7c3aed; color: #fff; }
  .btn-primary:hover { background: #6d28d9; box-shadow: 0 2px 8px rgba(124,58,237,.3); }
  .btn-sm { padding: 6px 12px; font-size: 12px; }
  .btn-teal { background: #0d9488; color: #fff; }
  .btn-teal:hover { background: #0f766e; }

  .container { max-width: 720px; margin: 0 auto; padding: 20px 16px 40px; }

  .survey-meta {
    background: #fff;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 12px;
    border: 1px solid #e0e0e0;
  }
  .survey-meta input, .survey-meta textarea {
    width: 100%; border: none; outline: none;
    font-family: inherit; background: transparent;
  }
  .survey-meta input { font-size: 20px; font-weight: 700; color: #202124; padding: 2px 0; }
  .survey-meta input::placeholder { color: #9aa0a6; }
  .survey-meta textarea {
    font-size: 13px; color: #5f6368; resize: vertical; min-height: 32px;
    padding: 2px 0; margin-top: 4px; line-height: 1.5;
  }
  .survey-meta textarea::placeholder { color: #9aa0a6; }

  .q-card {
    background: #fff;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 10px;
    border: 1px solid #e0e0e0;
    transition: box-shadow .15s;
    position: relative;
  }
  .q-card:hover { box-shadow: 0 1px 6px rgba(0,0,0,.06); }
  .q-card.active { border-color: #7c3aed; box-shadow: 0 0 0 1px #7c3aed; }

  .q-head { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 10px; }
  .q-num {
    font-size: 13px; font-weight: 700; color: #7c3aed;
    min-width: 28px; padding-top: 10px; text-align: center;
    background: #f5f0ff; border-radius: 6px; height: 36px; line-height: 18px;
  }
  .q-title-input {
    flex: 1;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    color: #202124;
    outline: none;
    transition: border-color .15s, background .15s;
    background: transparent;
  }
  .q-title-input:hover { background: #f8f9fa; }
  .q-title-input:focus { border-color: #7c3aed; background: #fff; }
  .q-title-input::placeholder { color: #9aa0a6; font-weight: 400; }

  .q-type-select {
    padding: 6px 10px;
    border: 1px solid #dadce0;
    border-radius: 6px;
    font-size: 12px;
    font-family: inherit;
    background: #fff;
    color: #5f6368;
    cursor: pointer;
    outline: none;
  }
  .q-type-select:focus { border-color: #7c3aed; }

  .q-toolbar {
    display: flex; gap: 4px; align-items: center;
    padding: 6px 0 0;
    border-top: 1px solid #f0f0f0;
    margin-top: 10px;
  }
  .q-toolbar button {
    background: none; border: none; cursor: pointer;
    color: #5f6368; padding: 6px 8px; border-radius: 6px;
    font-size: 13px; transition: all .1s;
  }
  .q-toolbar button:hover { background: #f0f0f0; color: #202124; }
  .q-toolbar .spacer { flex: 1; }
  .q-toolbar .required-toggle {
    display: flex; align-items: center; gap: 4px;
    font-size: 12px; color: #5f6368; cursor: pointer; user-select: none;
  }
  .q-toolbar .required-toggle input { width: auto; }

  .likert-preview {
    display: flex; gap: 4px; margin-top: 8px;
  }
  .likert-preview span {
    flex: 1; text-align: center;
    padding: 6px 2px;
    background: #f5f5f5;
    border-radius: 6px;
    font-size: 11px;
    color: #5f6368;
  }

  .option-list { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
  .option-row {
    display: flex; gap: 6px; align-items: center;
  }
  .option-row .drag { color: #dadce0; cursor: grab; font-size: 16px; }
  .option-row input {
    flex: 1;
    padding: 6px 10px;
    border: 1px solid #dadce0;
    border-radius: 6px;
    font-size: 13px;
    font-family: inherit;
    outline: none;
  }
  .option-row input:focus { border-color: #7c3aed; }
  .option-row .del-opt {
    background: none; border: none; cursor: pointer;
    color: #9aa0a6; font-size: 16px; padding: 4px;
  }
  .option-row .del-opt:hover { color: #d93025; }

  .add-options {
    background: none; border: none; cursor: pointer;
    color: #7c3aed; font-size: 12px; font-weight: 600;
    padding: 6px 0; margin-top: 4px;
    font-family: inherit;
  }
  .add-options:hover { text-decoration: underline; }

  .add-bar {
    background: #fff;
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 12px;
    border: 1px dashed #dadce0;
    display: flex; gap: 6px; justify-content: center;
    flex-wrap: wrap;
  }
  .add-bar button {
    padding: 8px 14px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    font-family: inherit;
    color: #5f6368;
    transition: all .1s;
  }
  .add-bar button:hover {
    border-color: #7c3aed;
    color: #7c3aed;
    background: #f5f0ff;
  }

  .empty-state {
    text-align: center; padding: 40px 20px; color: #9aa0a6;
  }
  .empty-state p { font-size: 14px; margin-bottom: 4px; }

  .toast {
    position: fixed; top: 16px; left: 50%; transform: translateX(-50%) translateY(-80px);
    padding: 10px 20px; border-radius: 8px; color: #fff; font-size: 13px; font-weight: 500;
    box-shadow: 0 4px 20px rgba(0,0,0,.15); transition: transform .3s ease; z-index: 999;
    white-space: nowrap;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }
  .toast-success { background: #188038; }
  .toast-error { background: #d93025; }

  @media (max-width: 640px) {
    .container { padding: 12px; }
    .survey-meta { padding: 16px; }
    .q-card { padding: 16px; }
    .topbar { padding: 10px 16px; }
    .topbar-left h1 { font-size: 14px; }
    .add-bar button { font-size: 11px; padding: 6px 10px; }
  }
</style>

<div class="topbar">
  <div class="topbar-left">
    <h1>📋 Tạo khảo sát</h1>
  </div>
  <div class="topbar-right">
    <a href="/survey" class="btn btn-outline">← Quay lại</a>
    <button class="btn btn-primary" onclick="saveSurvey()">💾 Lưu</button>
  </div>
</div>

<div class="container">
  <div class="survey-meta">
    <input type="text" id="survey-title" placeholder="Tiêu đề khảo sát (VD: Khảo sát hài lòng khách hàng)">
    <textarea id="survey-desc" placeholder="Mô tả khảo sát (hiển thị ở đầu form)" rows="2"></textarea>
  </div>

  <div id="questions-container">
    <div class="empty-state" id="empty-state">
      <div style="font-size:32px;margin-bottom:8px">📝</div>
      <p>Chưa có câu hỏi nào</p>
      <p style="font-size:12px">Bấm vào các nút bên dưới để thêm câu hỏi</p>
    </div>
  </div>

  <div class="add-bar">
    <button onclick="addQuestion('likert5')">➕ Likert 5</button>
    <button onclick="addQuestion('likert7')">➕ Likert 7</button>
    <button onclick="addQuestion('multiple_choice')">➕ Trắc nghiệm</button>
    <button onclick="addQuestion('text')">➕ Văn bản</button>
    <button onclick="addQuestion('rating')">➕ Rating</button>
  </div>
</div>

<div id="toast" class="toast"></div>

<script is:inline>
  let questions = [];
  let qCounter = 0;
  const editId = new URLSearchParams(window.location.search).get('edit');

  function qs(s) { return document.querySelector(s); }
  function byId(id) { return document.getElementById(id); }

  function showToast(msg, type) {
    const t = byId('toast');
    t.textContent = msg; t.className = 'toast toast-' + type;
    requestAnimationFrame(() => t.classList.add('show'));
    clearTimeout(t._hide);
    t._hide = setTimeout(() => t.classList.remove('show'), 3000);
  }

  function getDefaultOptions(type) {
    if (type === 'likert5') return ['Rất không đồng ý', 'Không đồng ý', 'Trung lập', 'Đồng ý', 'Rất đồng ý'];
    if (type === 'likert7') return ['1', '2', '3', '4', '5', '6', '7'];
    if (type === 'rating') return ['1', '2', '3', '4', '5'];
    return [];
  }

  function escAttr(s) { return (s ?? '').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function addQuestion(type, data) {
    qCounter++;
    const id = data?.id || 'q_' + Date.now() + '_' + qCounter;
    const q = data || { id, title: '', type, required: true, options: getDefaultOptions(type), labels: [] };
    questions.push(q);
    renderQuestions();
  }

  function changeType(i, type) {
    questions[i].type = type;
    questions[i].options = getDefaultOptions(type);
    questions[i].labels = [];
    renderQuestions();
  }

  function moveQuestion(i, dir) {
    const j = i + dir;
    if (j < 0 || j >= questions.length) return;
    [questions[i], questions[j]] = [questions[j], questions[i]];
    renderQuestions();
  }

  function duplicateQuestion(i) {
    const q = JSON.parse(JSON.stringify(questions[i]));
    q.id = 'q_' + Date.now();
    q.title = q.title + ' (copy)';
    questions.splice(i + 1, 0, q);
    renderQuestions();
  }

  function deleteQuestion(i) {
    if (!confirm('Xóa câu hỏi này?')) return;
    questions.splice(i, 1);
    renderQuestions();
  }

  function addOption(i) {
    if (!questions[i].labels) questions[i].labels = [];
    questions[i].labels.push('');
    renderQuestions();
  }

  function removeOption(i, li) {
    questions[i].labels.splice(li, 1);
    renderQuestions();
  }

  function renderQuestions() {
    const container = byId('questions-container');
    const empty = byId('empty-state');
    empty.style.display = questions.length > 0 ? 'none' : 'block';

    if (questions.length === 0) {
      container.innerHTML = '<div class="empty-state" id="empty-state"><div style="font-size:32px;margin-bottom:8px">📝</div><p>Chưa có câu hỏi nào</p><p style="font-size:12px;color:#9aa0a6">Bấm vào các nút bên dưới để thêm câu hỏi</p></div>';
      return;
    }

    let h = '';
    questions.forEach((q, i) => {
      const typeLabels = { likert5: 'Likert 5', likert7: 'Likert 7', multiple_choice: 'Trắc nghiệm', text: 'Văn bản', rating: 'Rating' };
      h += `<div class="q-card" onclick="this.querySelector('.q-title-input')?.focus()">
        <div class="q-head">
          <div class="q-num">${i + 1}</div>
          <input class="q-title-input" type="text" value="${escAttr(q.title)}" placeholder="Nhập câu hỏi..."
            oninput="questions[${i}].title=this.value" onfocus="this.closest('.q-card').classList.add('active')" onblur="this.closest('.q-card').classList.remove('active')">
          <select class="q-type-select" onchange="changeType(${i},this.value)">
            <option value="likert5" ${q.type==='likert5'?'selected':''}>Likert 5</option>
            <option value="likert7" ${q.type==='likert7'?'selected':''}>Likert 7</option>
            <option value="multiple_choice" ${q.type==='multiple_choice'?'selected':''}>Trắc nghiệm</option>
            <option value="text" ${q.type==='text'?'selected':''}>Văn bản</option>
            <option value="rating" ${q.type==='rating'?'selected':''}>Rating</option>
          </select>
        </div>`;

      if (q.type === 'likert5' || q.type === 'likert7') {
        h += `<div class="likert-preview">`;
        q.options.forEach((o, oi) => {
          h += `<span><input type="text" value="${escAttr(o)}" style="width:100%;border:none;background:transparent;text-align:center;font-size:11px;font-family:inherit;outline:none;color:inherit"
            onchange="questions[${i}].options[${oi}]=this.value"></span>`;
        });
        h += `</div>`;
      }

      if (q.type === 'multiple_choice') {
        h += `<div class="option-list">`;
        (q.labels && q.labels.length ? q.labels : ['']).forEach((l, li) => {
          h += `<div class="option-row">
            <span class="drag">≡</span>
            <input type="text" value="${escAttr(l)}" placeholder="Nhập lựa chọn..." onchange="questions[${i}].labels[${li}]=this.value">
            <button class="del-opt" onclick="removeOption(${i},${li})">✕</button>
          </div>`;
        });
        h += `</div>`;
        h += `<button class="add-options" onclick="addOption(${i})">+ Thêm lựa chọn</button>`;
      }

      if (q.type === 'rating') {
        h += `<div class="likert-preview">${[1,2,3,4,5].map(v => `<span>${v} ⭐</span>`).join('')}</div>`;
      }

      if (q.type === 'text') {
        h += `<div style="margin-top:8px;padding:8px 10px;background:#f5f5f5;border-radius:6px;font-size:12px;color:#9aa0a6">Câu trả lời dạng văn bản</div>`;
      }

      h += `<div class="q-toolbar">
        <button onclick="moveQuestion(${i},-1)" title="Lên">↑</button>
        <button onclick="moveQuestion(${i},1)" title="Xuống">↓</button>
        <button onclick="duplicateQuestion(${i})" title="Nhân bản">⧉</button>
        <button onclick="deleteQuestion(${i})" title="Xóa" style="color:#d93025">✕</button>
        <span class="spacer"></span>
        <label class="required-toggle">
          <input type="checkbox" ${q.required?'checked':''} onchange="questions[${i}].required=this.checked"> Bắt buộc
        </label>
      </div>`;

      h += `</div>`;
    });

    container.innerHTML = h;
  }

  async function saveSurvey() {
    const title = byId('survey-title').value.trim();
    if (!title) { showToast('Vui lòng nhập tiêu đề', 'error'); return; }
    if (questions.length === 0) { showToast('Thêm ít nhất 1 câu hỏi', 'error'); return; }

    try {
      let r;
      const body = JSON.stringify({ title, description: byId('survey-desc').value.trim(), questions });
      if (editId) {
        r = await fetch('/api/survey/' + editId, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body });
      } else {
        r = await fetch('/api/survey', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body });
      }
      const json = await r.json();
      if (!json.ok) throw new Error(json.error);

      showToast('✅ Đã lưu!', 'success');
      setTimeout(() => { window.location.href = '/survey'; }, 1000);
    } catch (e) {
      showToast('❌ ' + e.message, 'error');
    }
  }

  if (editId) {
    setTimeout(function() { var el = document.querySelector('.topbar-left h1'); if (el) el.textContent = '✏️ Sửa khảo sát'; }, 0);
    (async () => {
      try {
        const r = await fetch('/api/survey/' + editId);
        const json = await r.json();
        if (json.ok && json.data) {
          const s = json.data;
          byId('survey-title').value = s.title || '';
          byId('survey-desc').value = s.description || '';
          questions = s.questions || [];
          qCounter = questions.length;
          renderQuestions();
        }
      } catch (e) { showToast('❌ ' + e.message, 'error'); }
    })();
  }
</script>
</Layout>
