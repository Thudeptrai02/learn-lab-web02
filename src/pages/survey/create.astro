---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
---
<Layout title="Tạo khảo sát - LearnLab">
<div class="ge" style="min-height:100vh;background:#f0ebf8;font-family:'Google Sans','Roboto',sans-serif;color:#222">
<style is:global>
.ge .tb { background:#fff; border-bottom:1px solid #e0e0e0; padding:8px 24px; display:flex; align-items:center; gap:16px; position:sticky; top:0; z-index:50; }
.ge .tb .tt { flex:1; font-size:16px; font-weight:400; color:#444; border:none; outline:none; background:transparent; font-family:inherit; }
.ge .tb .tt:focus { border-bottom:2px solid #673ab7; }
.ge .tb button,.ge .tb a { background:none; border:none; cursor:pointer; color:#666; padding:8px 12px; border-radius:4px; font-size:13px; text-decoration:none; display:inline-flex; align-items:center; gap:4px; }
.ge .tb button:hover,.ge .tb a:hover { background:#f5f5f5; }
.ge .tb .sv { background:#673ab7; color:#fff; padding:8px 20px; border-radius:4px; font-weight:500; }
.ge .tb .sv:hover { background:#5e35b1; }
.ge .cn { max-width:720px; margin:0 auto; padding:20px 16px 100px; }
.ge .mt { background:#fff; border-radius:8px; margin-bottom:12px; overflow:hidden; box-shadow:0 2px 1px -1px rgba(0,0,0,.2),0 1px 1px 0 rgba(0,0,0,.14),0 1px 3px 0 rgba(0,0,0,.12); }
.ge .mt .br { height:10px; background:#673ab7; }
.ge .mt .bd { padding:18px 24px 20px; }
.ge .mt .ti { width:100%; border:none; outline:none; font-size:24px; font-weight:400; color:#222; font-family:inherit; background:transparent; margin-bottom:4px; }
.ge .mt .ti::placeholder { color:#999; }
.ge .mt .de { width:100%; border:none; outline:none; font-size:13px; color:#666; font-family:inherit; background:transparent; resize:vertical; min-height:32px; padding:2px 0; }
.ge .mt .de::placeholder { color:#999; }
.ge .qc { background:#fff; border-radius:8px; margin-bottom:10px; padding:20px 24px 12px; box-shadow:0 1px 3px rgba(0,0,0,.12); position:relative; }
.ge .qc.sl { box-shadow:0 2px 1px -1px rgba(0,0,0,.2),0 1px 1px 0 rgba(0,0,0,.14),0 1px 3px 0 rgba(0,0,0,.12); border-left:4px solid #673ab7; }
.ge .qh { display:flex; align-items:flex-start; gap:10px; margin-bottom:8px; }
.ge .qh .no { width:32px; height:32px; border-radius:50%; background:#673ab7; color:#fff; font-size:13px; font-weight:500; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px; }
.ge .qh .qi { flex:1; font-size:14px; font-weight:500; color:#222; border:none; outline:none; padding:6px 8px; border-radius:4px; font-family:inherit; background:transparent; }
.ge .qh .qi:focus { background:#f5f5f5; border-bottom:2px solid #673ab7; }
.ge .qh .qi::placeholder { color:#999; font-weight:400; }
.ge .qh .ql { padding:6px 10px; border:1px solid #ddd; border-radius:4px; font-size:12px; font-family:inherit; background:#fff; color:#555; cursor:pointer; outline:none; }
.ge .qh .ql:focus { border-color:#673ab7; }
.ge .op { margin:8px 0 4px; }
.ge .op .or { display:flex; align-items:center; gap:8px; padding:4px 0; }
.ge .op .or .ci { width:18px; height:18px; border-radius:50%; border:2px solid #888; flex-shrink:0; }
.ge .op .or .oi { flex:1; border:none; outline:none; font-size:13px; color:#222; font-family:inherit; padding:6px 8px; border-radius:4px; background:transparent; }
.ge .op .or .oi:focus { background:#f5f5f5; border-bottom:2px solid #673ab7; }
.ge .op .or .oi::placeholder { color:#999; }
.ge .op .or .rm { background:none; border:none; cursor:pointer; color:#999; font-size:16px; padding:4px; }
.ge .op .or .rm:hover { color:#d93025; }
.ge .op .ao { background:none; border:none; cursor:pointer; color:#673ab7; font-size:12px; font-weight:500; padding:6px 0; font-family:inherit; display:inline-flex; align-items:center; gap:4px; }
.ge .op .ao:hover { text-decoration:underline; }
.ge .lp { display:flex; gap:4px; margin:8px 0 4px; }
.ge .lp span { flex:1; text-align:center; padding:6px 4px; border-radius:4px; font-size:11px; color:#555; }
.ge .lp span input { width:100%; border:none; background:transparent; text-align:center; font-size:11px; font-family:inherit; outline:none; color:inherit; }
.ge .qtb { display:flex; align-items:center; gap:4px; padding:6px 0 0; border-top:1px solid #eee; margin-top:8px; }
.ge .qtb button { background:none; border:none; cursor:pointer; color:#777; padding:6px 8px; border-radius:4px; font-size:13px; }
.ge .qtb button:hover { background:#f0f0f0; color:#333; }
.ge .qtb .sp { flex:1; }
.ge .qtb .rt { display:flex; align-items:center; gap:4px; font-size:12px; color:#777; cursor:pointer; user-select:none; }
.ge .qtb .rt input { width:16px; height:16px; accent-color:#673ab7; }
.ge .es { text-align:center; padding:60px 20px; color:#999; font-size:14px; }
.ge .es p { margin:4px 0; }
.ge .fb { position:fixed; bottom:24px; right:24px; z-index:40; display:flex; flex-direction:column; gap:8px; }
.ge .fb .fab { width:56px; height:56px; border-radius:50%; background:#673ab7; color:#fff; border:none; cursor:pointer; font-size:24px; box-shadow:0 3px 6px rgba(0,0,0,.2); display:flex; align-items:center; justify-content:center; transition:box-shadow .2s; }
.ge .fb .fab:hover { box-shadow:0 6px 12px rgba(0,0,0,.3); }
.ge .fb .fm { display:none; flex-direction:column; gap:4px; background:#fff; border-radius:8px; padding:8px; box-shadow:0 3px 12px rgba(0,0,0,.15); }
.ge .fb .fm.sh { display:flex; }
.ge .fb .fm button { background:none; border:none; cursor:pointer; padding:8px 14px; border-radius:6px; font-size:12px; font-family:inherit; color:#333; text-align:left; white-space:nowrap; display:flex; align-items:center; gap:8px; }
.ge .fb .fm button:hover { background:#f5f0ff; color:#673ab7; }
.ge .tt { position:fixed; top:16px; left:50%; transform:translateX(-50%) translateY(-80px); padding:10px 22px; border-radius:4px; color:#fff; font-size:13px; font-weight:500; box-shadow:0 3px 6px rgba(0,0,0,.16); transition:transform .3s; z-index:999; white-space:nowrap; }
.ge .tt.sh { transform:translateX(-50%) translateY(0); }
.ge .tt.ok { background:#188038; }
.ge .tt.bd { background:#d93025; }
@media (max-width:640px) {
  .ge .tb { padding:8px 12px; gap:8px; }
  .ge .tb .tt { font-size:14px; }
  .ge .cn { padding:12px 8px 100px; }
  .ge .qc { padding:14px 16px 10px; }
  .ge .mt .bd { padding:14px 16px; }
  .ge .mt .ti { font-size:20px; }
  .ge .qh { gap:6px; }
  .ge .qh .qi { font-size:13px; }
}
</style>

<div class="tb">
  <a href="/survey">←</a>
  <input class="tt" id="s-title" placeholder="Mẫu khảo sát" value="">
  <a href="/survey">Nháp</a>
  <button class="sv" onclick="saveSurvey()">Lưu</button>
</div>

<div class="cn">
  <div class="mt">
    <div class="br"></div>
    <div class="bd">
      <input class="ti" id="s-title2" placeholder="Tiêu đề khảo sát" value="">
      <textarea class="de" id="s-desc" placeholder="Mô tả khảo sát" rows="2"></textarea>
    </div>
  </div>

  <div id="qs"></div>

  <div class="es" id="es">
    <p style="font-size:32px;margin-bottom:8px">📝</p>
    <p>Chưa có câu hỏi nào</p>
    <p style="font-size:12px">Bấm nút + ở góc dưới để thêm</p>
  </div>
</div>

<div class="fb">
  <div class="fm" id="fm">
    <button onclick="aq('likert5')">◎ Likert 5</button>
    <button onclick="aq('likert7')">◎ Likert 7</button>
    <button onclick="aq('multiple_choice')">◉ Trắc nghiệm</button>
    <button onclick="aq('text')">▬ Văn bản</button>
    <button onclick="aq('rating')">★ Rating</button>
  </div>
  <button class="fab" id="fab" onclick="toggleFab()">+</button>
</div>

<div class="tt" id="tt"></div>

<script is:inline>
(function(){
  var qs=[],cnt=0,eid=(new URLSearchParams(location.search)).get('edit');
  function $(i){return document.getElementById(i)}
  function tt(m,t){
    var e=$('tt');e.textContent=m;e.className='tt '+(t==='e'?'bd':'ok');
    requestAnimationFrame(function(){e.classList.add('sh')});
    clearTimeout(e._h);e._h=setTimeout(function(){e.classList.remove('sh')},3000);
  }
  function es(s){return(s??'').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
  function dft(t){
    if(t==='likert5')return['Rất không đồng ý','Không đồng ý','Trung lập','Đồng ý','Rất đồng ý'];
    if(t==='likert7')return['1','2','3','4','5','6','7'];
    if(t==='rating')return['1','2','3','4','5'];
    return[];
  }
  function toggleFab(){
    var m=$('fm');m.classList.toggle('sh');
  }
  function aq(type,data){
    cnt++;var id=data?.id||'q_'+Date.now()+'_'+cnt;
    var q=data||{id:id,title:'',type:type,required:true,options:dft(type),labels:[]};
    qs.push(q);render();$('fm').classList.remove('sh');
  }
  function ct(i,type){
    qs[i].type=type;qs[i].options=dft(type);qs[i].labels=[];render();
  }
  function mv(i,dir){
    var j=i+dir;if(j<0||j>=qs.length)return;
    var t=qs[i];qs[i]=qs[j];qs[j]=t;render();
  }
  function dup(i){
    var q=JSON.parse(JSON.stringify(qs[i]));q.id='q_'+Date.now();q.title+=' (copy)';
    qs.splice(i+1,0,q);render();
  }
  function del(i){
    if(!confirm('Xóa câu hỏi này?'))return;qs.splice(i,1);render();
  }
  function ao(i){
    if(!qs[i].labels)qs[i].labels=[];qs[i].labels.push('');render();
  }
  function ro(i,li){
    qs[i].labels.splice(li,1);render();
  }
  function render(){
    var c=$('qs'),e=$('es');e.style.display=qs.length?'none':'block';
    if(!qs.length){c.innerHTML='';return}
    var h='';
    for(var i=0;i<qs.length;i++){
      var q=qs[i];
      h+='<div class="qc" onclick="this.classList.toggle(\'sl\')"><div class="qh"><div class="no">'+(i+1)+'</div>'+
        '<input class="qi" value="'+es(q.title)+'" placeholder="Câu hỏi" oninput="qs['+i+'].title=this.value">'+
        '<select class="ql" onchange="ct('+i+',this.value)">'+
        '<option value="likert5"'+(q.type==='likert5'?' selected':'')+'>Likert 5</option>'+
        '<option value="likert7"'+(q.type==='likert7'?' selected':'')+'>Likert 7</option>'+
        '<option value="multiple_choice"'+(q.type==='multiple_choice'?' selected':'')+'>Trắc nghiệm</option>'+
        '<option value="text"'+(q.type==='text'?' selected':'')+'>Văn bản</option>'+
        '<option value="rating"'+(q.type==='rating'?' selected':'')+'>Rating</option></select></div><div class="op">';
      if(q.type==='multiple_choice'){
        var lb=q.labels&&q.labels.length?q.labels:[''];
        for(var l=0;l<lb.length;l++){
          h+='<div class="or"><span class="ci"></span><input class="oi" value="'+es(lb[l])+'" placeholder="Lựa chọn '+(l+1)+'" onchange="qs['+i+'].labels['+l+']=this.value">'+
            '<button class="rm" onclick="ro('+i+','+l+')">✕</button></div>';
        }
        h+='<button class="ao" onclick="ao('+i+')">+ Thêm lựa chọn</button>';
      }else if(q.type==='likert5'||q.type==='likert7'){
        h+='<div class="lp">';
        for(var o=0;o<q.options.length;o++){
          h+='<span><input value="'+es(q.options[o])+'" onchange="qs['+i+'].options['+o+']=this.value"></span>';
        }
        h+='</div>';
      }else if(q.type==='rating'){
        h+='<div class="lp">';
        for(var r=1;r<=5;r++)h+='<span>'+r+'</span>';
        h+='</div>';
      }else if(q.type==='text'){
        h+='<div style="padding:6px 0;color:#999;font-size:13px">Câu trả lời dạng văn bản</div>';
      }
      h+='</div><div class="qtb">'+
        '<button onclick="mv('+i+',-1)" title="Lên">↑</button>'+
        '<button onclick="mv('+i+',1)" title="Xuống">↓</button>'+
        '<button onclick="dup('+i+')" title="Nhân bản">⧉</button>'+
        '<span class="sp"></span>'+
        '<label class="rt"><input type="checkbox" '+(q.required?'checked':'')+' onchange="qs['+i+'].required=this.checked"> Bắt buộc</label>'+
        '<button onclick="del('+i+')" title="Xóa" style="color:#d93025">✕</button></div></div>';
    }
    c.innerHTML=h;
  }
  function saveSurvey(){
    var t=$('s-title2').value.trim()||$('s-title').value.trim();
    if(!t){tt('Vui lòng nhập tiêu đề','e');return}
    if(!qs.length){tt('Thêm ít nhất 1 câu hỏi','e');return}
    fetch(eid?'/api/survey/'+eid:'/api/survey',{
      method:eid?'PUT':'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({title:t,description:$('s-desc').value.trim(),questions:qs})
    }).then(function(r){return r.json()}).then(function(j){
      if(!j.ok)throw new Error(j.error);
      tt('✅ Đã lưu!','s');setTimeout(function(){location.href='/survey'},1000);
    }).catch(function(e){tt('❌ '+e.message,'e')});
  }
  if(eid){
    fetch('/api/survey/'+eid).then(function(r){return r.json()}).then(function(j){
      if(j.ok&&j.data){
        var s=j.data;
        $('s-title').value=s.title||'';
        $('s-title2').value=s.title||'';
        $('s-desc').value=s.description||'';
        qs=s.questions||[];cnt=qs.length;render();
      }
    }).catch(function(e){tt('❌ '+e.message,'e')});
  }
  window.aq=aq;window.ct=ct;window.mv=mv;window.dup=dup;window.del=del;window.ao=ao;window.ro=ro;window.toggleFab=toggleFab;window.saveSurvey=saveSurvey;
})();
</script>
</div>
</Layout>