<script is:inline>
// Generated: 2026-06-05
</script>

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tạo khảo sát</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f4f8; color: #1e293b; min-height: 100vh; }
  .topbar { background: #fff; border-bottom: 1px solid #e2e8f0; padding: .75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; }
  .topbar h1 { font-size: 1.15rem; font-weight: 700; }
  .container { max-width: 800px; margin: 0 auto; padding: 1.5rem 1rem; }
  .card { background: #fff; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.08); padding: 1.5rem; margin-bottom: 1rem; border: 1px solid #e2e8f0; }
  .card-title { font-size: 1rem; font-weight: 600; margin-bottom: .75rem; }
  input[type="text"], textarea { width: 100%; padding: .6rem .75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: .9rem; font-family: inherit; transition: border-color .15s; }
  input:focus, textarea:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.12); }
  textarea { resize: vertical; min-height: 60px; }
  .btn { display: inline-flex; align-items: center; gap: .4rem; padding: .5rem 1rem; border: none; border-radius: 8px; font-size: .85rem; font-weight: 600; cursor: pointer; transition: all .15s; text-decoration: none; font-family: inherit; }
  .btn-primary { background: #6366f1; color: #fff; }
  .btn-primary:hover { background: #4f46e5; }
  .btn-outline { background: transparent; color: #64748b; border: 1px solid #cbd5e1; }
  .btn-outline:hover { background: #f8fafc; }
  .btn-sm { padding: .35rem .65rem; font-size: .78rem; }
  .btn-success { background: #10b981; color: #fff; }
  .btn-success:hover { background: #059669; }
  .btn-danger { background: #ef4444; color: #fff; }
  .btn-danger:hover { background: #dc2626; }
  .q-item { border: 1px solid #e2e8f0; border-radius: 10px; padding: 1rem; margin-bottom: .75rem; background: #fafbfc; }
  .q-item:hover { border-color: #c7d2fe; }
  .q-head { display: flex; gap: .5rem; align-items: start; margin-bottom: .5rem; }
  .q-num { font-weight: 700; color: #6366f1; font-size: .85rem; min-width: 28px; padding-top: .35rem; }
  .q-title-input { flex: 1; }
  .q-type { padding: .35rem .5rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: .8rem; background: #fff; }
  .q-actions { display: flex; gap: .25rem; }
  .q-actions button { background: none; border: none; cursor: pointer; color: #94a3b8; padding: .25rem .35rem; border-radius: 4px; font-size: .85rem; }
  .q-actions button:hover { background: #e2e8f0; color: #475569; }
  .q-required { display: flex; align-items: center; gap: .3rem; font-size: .78rem; color: #64748b; cursor: pointer; }
  .q-required input { width: auto; }
  .q-likert-preview { margin-top: .5rem; display: flex; gap: .25rem; font-size: .75rem; color: #94a3b8; }
  .q-likert-preview span { flex: 1; text-align: center; padding: .3rem .25rem; background: #f1f5f9; border-radius: 4px; }
  .q-options { margin-top: .5rem; display: flex; flex-direction: column; gap: .35rem; }
  .q-option { display: flex; gap: .35rem; align-items: center; }
  .q-option input { flex: 1; padding: .35rem .5rem; border: 1px solid #e2e8f0; border-radius: 6px; font-size: .8rem; }
  .q-option button { background: none; border: none; cursor: pointer; color: #ef4444; font-size: .85rem; padding: .25rem; }
  .empty-state { text-align: center; padding: 2rem; color: #94a3b8; }
  .toast { position: fixed; bottom: 2rem; right: 2rem; padding: .75rem 1.25rem; border-radius: 10px; color: #fff; font-size: .85rem; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,.15); transform: translateY(100px); opacity: 0; transition: all .3s; z-index: 999; }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast-success { background: #10b981; }
  .toast-error { background: #ef4444; }
  @media (max-width: 640px) { .container { padding: 1rem .75rem; } .card { padding: 1rem; } }
</style>
</head>
<body>

<div class="topbar">
  <h1>📋 Tạo khảo sát</h1>
  <div style="display:flex;gap:.5rem">
    <a href="/survey" class="btn btn-outline">← Dashboard</a>
    <button class="btn btn-success" onclick="saveSurvey()">💾 Lưu</button>
  </div>
</div>

<div class="container">
  <div class="card">
    <div style="margin-bottom:.75rem">
      <input type="text" id="survey-title" placeholder="Tiêu đề khảo sát (VD: Khảo sát hài lòng khách hàng)" style="font-size:1.25rem;font-weight:700;border:none;padding:.25rem 0">
    </div>
    <div>
      <textarea id="survey-desc" placeholder="Mô tả khảo sát (hiển thị ở đầu form)" style="border:none;padding:.25rem 0;font-size:.9rem;color:#64748b"></textarea>
    </div>
  </div>

  <div id="questions-container">
    <div class="empty-state" id="empty-state">
      <p style="font-size:1.1rem;margin-bottom:.5rem">📝 Chưa có câu hỏi nào</p>
      <p style="font-size:.85rem">Bấm nút bên dưới để thêm câu hỏi</p>
    </div>
  </div>

  <div class="card" style="display:flex;gap:.5rem;flex-wrap:wrap">
    <button class="btn btn-primary" onclick="addQuestion('likert5')">➕ Likert 5 mức</button>
    <button class="btn btn-primary" onclick="addQuestion('likert7')">➕ Likert 7 mức</button>
    <button class="btn btn-primary" onclick="addQuestion('multiple_choice')">➕ Trắc nghiệm</button>
    <button class="btn btn-primary" onclick="addQuestion('text')">➕ Văn bản</button>
    <button class="btn btn-primary" onclick="addQuestion('rating')">➕ Rating 1-5</button>
  </div>

  <a href="/survey" class="btn btn-outline" style="margin-top:.5rem;width:100%;justify-content:center">← Quay lại</a>
</div>

<div id="toast" class="toast"></div>

<script>
  let questions = [];
  let editingId = null;
  let qCounter = 0;

  function showToast(msg, type) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.className = 'toast toast-' + type;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3000);
  }

  function addQuestion(type, data) {
    qCounter++;
    const id = data?.id || 'q_' + Date.now() + '_' + qCounter;
    const q = data || { id, title: '', type, required: true, options: getDefaultOptions(type), labels: [] };
    questions.push(q);
    renderQuestions();
  }

  function getDefaultOptions(type) {
    if (type === 'likert5') return ['Rất không đồng ý', 'Không đồng ý', 'Trung lập', 'Đồng ý', 'Rất đồng ý'];
    if (type === 'likert7') return ['1', '2', '3', '4', '5', '6', '7'];
    if (type === 'rating') return ['1', '2', '3', '4', '5'];
    return [];
  }

  function renderQuestions() {
    const container = document.getElementById('questions-container');
    const empty = document.getElementById('empty-state');
    empty.style.display = questions.length > 0 ? 'none' : 'block';

    if (questions.length === 0) { container.innerHTML = ''; container.appendChild(empty); return; }

    let h = '';
    questions.forEach((q, i) => {
      const typeLabels = { likert5: 'Likert 5', likert7: 'Likert 7', multiple_choice: 'Trắc nghiệm', text: 'Văn bản', rating: 'Rating' };
      h += `<div class="q-item" data-index="${i}">
        <div class="q-head">
          <div class="q-num">${i + 1}.</div>
          <input class="q-title-input" type="text" value="${escAttr(q.title)}" placeholder="Nhập câu hỏi..." oninput="questions[${i}].title=this.value" style="font-weight:600;font-size:.95rem;border:none;padding:.35rem 0;background:transparent">
          <select class="q-type" onchange="changeType(${i},this.value)">
            <option value="likert5" ${q.type==='likert5'?'selected':''}>Likert 5</option>
            <option value="likert7" ${q.type==='likert7'?'selected':''}>Likert 7</option>
            <option value="multiple_choice" ${q.type==='multiple_choice'?'selected':''}>Trắc nghiệm</option>
            <option value="text" ${q.type==='text'?'selected':''}>Văn bản</option>
            <option value="rating" ${q.type==='rating'?'selected':''}>Rating</option>
          </select>
          <label class="q-required"><input type="checkbox" ${q.required?'checked':''} onchange="questions[${i}].required=this.checked"> Bắt buộc</label>
          <div class="q-actions">
            <button onclick="moveQuestion(${i},-1)" title="Lên">↑</button>
            <button onclick="moveQuestion(${i},1)" title="Xuống">↓</button>
            <button onclick="duplicateQuestion(${i})" title="Nhân bản">⧉</button>
            <button onclick="deleteQuestion(${i})" title="Xóa" style="color:#ef4444">✕</button>
          </div>
        </div>`;

      if (q.type === 'likert5' || q.type === 'likert7') {
        h += `<div class="q-likert-preview">${q.options.map(o => `<span>${escHtml(o)}</span>`).join('')}</div>`;
        h += `<div style="margin-top:.35rem;display:flex;gap:.25rem;flex-wrap:wrap">${q.options.map((o, oi) =>
          `<input type="text" value="${escAttr(o)}" style="flex:1;min-width:60px;padding:.25rem;border:1px solid #e2e8f0;border-radius:4px;font-size:.72rem;text-align:center" onchange="questions[${i}].options[${oi}]=this.value;renderQuestions()">`
        ).join('')}</div>`;
      }

      if (q.type === 'multiple_choice') {
        h += `<div class="q-options">`;
        (q.labels && q.labels.length ? q.labels : ['']).forEach((l, li) => {
          h += `<div class="q-option"><input type="text" value="${escAttr(l)}" placeholder="Nhập lựa chọn..." onchange="questions[${i}].labels[${li}]=this.value">
            <button onclick="removeOption(${i},${li})">✕</button></div>`;
        });
        h += `</div>`;
        h += `<button class="btn btn-outline btn-sm" onclick="addOption(${i})" style="margin-top:.35rem">+ Thêm lựa chọn</button>`;
      }

      if (q.type === 'rating') {
        h += `<div class="q-likert-preview">${q.options.map((o, oi) => `<span>${oi+1}</span>`).join('')}</div>`;
      }

      h += `</div>`;
    });

    container.innerHTML = h;
    if (questions.length === 0) container.appendChild(empty);
  }

  function changeType(i, type) {
    questions[i].type = type;
    questions[i].options = getDefaultOptions(type);
    questions[i].labels = [];
    renderQuestions();
  }

  function moveQuestion(i, dir) {
    const j = i + dir;
    if (j < 0 || j >= questions.length) return;
    [questions[i], questions[j]] = [questions[j], questions[i]];
    renderQuestions();
  }

  function duplicateQuestion(i) {
    const q = JSON.parse(JSON.stringify(questions[i]));
    q.id = 'q_' + Date.now();
    q.title = q.title + ' (copy)';
    questions.splice(i + 1, 0, q);
    renderQuestions();
  }

  function deleteQuestion(i) {
    if (!confirm('Xóa câu hỏi này?')) return;
    questions.splice(i, 1);
    renderQuestions();
  }

  function addOption(i) {
    if (!questions[i].labels) questions[i].labels = [];
    questions[i].labels.push('');
    renderQuestions();
  }

  function removeOption(i, li) {
    questions[i].labels.splice(li, 1);
    renderQuestions();
  }

  function escHtml(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }
  function escAttr(s) { return (s ?? '').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }

  const urlParams = new URLSearchParams(window.location.search);
  const editId = urlParams.get('edit');

  async function saveSurvey() {
    const title = document.getElementById('survey-title').value.trim();
    if (!title) { showToast('Vui lòng nhập tiêu đề khảo sát', 'error'); return; }
    if (questions.length === 0) { showToast('Thêm ít nhất 1 câu hỏi', 'error'); return; }

    const payload = { title, description: document.getElementById('survey-desc').value.trim(), questions: JSON.stringify(questions) };

    try {
      let r;
      if (editId) {
        r = await fetch('/api/survey/' + editId, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, description: payload.description, questions: questions })
        });
      } else {
        r = await fetch('/api/survey', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, description: payload.description, questions })
        });
      }
      const json = await r.json();
      if (!json.ok) throw new Error(json.error);

      showToast('✅ Đã lưu!', 'success');
      setTimeout(() => { window.location.href = '/survey'; }, 1000);
    } catch (e) {
      showToast('❌ Lỗi: ' + e.message, 'error');
    }
  }

  if (editId) {
    document.querySelector('.topbar h1').textContent = '✏️ Sửa khảo sát';
    (async () => {
      const r = await fetch('/api/survey/' + editId);
      const json = await r.json();
      if (json.ok && json.data) {
        const s = json.data;
        document.getElementById('survey-title').value = s.title || '';
        document.getElementById('survey-desc').value = s.description || '';
        questions = s.questions || [];
        qCounter = questions.length;
        renderQuestions();
      }
    })();
  }
</script>

</body></html>
