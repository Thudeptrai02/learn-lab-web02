---
import Layout from '../../../layouts/Layout.astro';
export const prerender = false;
const { id: surveyId } = Astro.params;
---

<Layout title="Kết quả khảo sát - LearnLab">
  <div class="mx-auto max-w-6xl w-full px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <a href="/survey" class="text-sm text-slate-500 hover:text-slate-700 font-medium">← Dashboard</a>
        <h1 class="text-2xl font-black tracking-tight text-slate-900 mt-1" id="survey-title">📊 Kết quả khảo sát</h1>
      </div>
      <div class="flex gap-2">
        <button class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50" onclick="exportXLSX()">⬇️ Xuất Excel</button>
        <a href="/survey/s/{surveyId}" target="_blank" class="rounded-xl bg-teal-600 px-4 py-2 text-sm font-bold text-white hover:bg-teal-700">🔗 Form</a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-6" id="stats-row">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center">
        <div class="text-3xl font-black text-slate-900" id="stat-total">0</div>
        <div class="text-sm text-slate-500 mt-1">Tổng responses</div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center">
        <div class="text-3xl font-black text-teal-600" id="stat-today">0</div>
        <div class="text-sm text-slate-500 mt-1">Hôm nay</div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center">
        <div class="text-3xl font-black text-amber-600" id="stat-week">0</div>
        <div class="text-sm text-slate-500 mt-1">7 ngày qua</div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center">
        <div class="text-3xl font-black text-indigo-600" id="stat-avg">0.0</div>
        <div class="text-sm text-slate-500 mt-1">Điểm TB</div>
      </div>
    </div>

    <div id="responses-container">
      <div class="text-center py-16 text-slate-400">
        <div class="text-5xl mb-4">⏳</div>
        <p class="text-lg font-medium">Đang tải...</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const SURVEY_ID = '{surveyId}';
  let responses = [];
  let questions = [];

  async function loadResults() {
    try {
      const [surveyRes, respRes] = await Promise.all([
        fetch('/api/survey/' + SURVEY_ID),
        fetch('/api/response?survey_id=' + SURVEY_ID)
      ]);
      const surveyJson = await surveyRes.json();
      const respJson = await respRes.json();

      if (!surveyJson.ok) throw new Error(surveyJson.error);
      const survey = surveyJson.data;
      questions = survey.questions || [];
      responses = respJson.data || [];

      document.getElementById('survey-title').textContent = '📊 ' + escHtml(survey.title);
      updateStats();
      renderResponses();
    } catch (e) {
      document.getElementById('responses-container').innerHTML = `<div class="text-center py-16 text-slate-400"><p>❌ Lỗi: ${escHtml(e.message)}</p></div>`;
    }
  }

  function updateStats() {
    const total = responses.length;
    const now = new Date();
    const today = responses.filter(r => new Date(r.submitted_at).toDateString() === now.toDateString()).length;
    const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
    const weekCount = responses.filter(r => new Date(r.submitted_at) >= weekAgo).length;

    let sum = 0, count = 0;
    responses.forEach(r => {
      Object.values(r.answers || {}).forEach(v => {
        if (typeof v === 'number') { sum += v; count++; }
      });
    });

    document.getElementById('stat-total').textContent = total;
    document.getElementById('stat-today').textContent = today;
    document.getElementById('stat-week').textContent = weekCount;
    document.getElementById('stat-avg').textContent = count > 0 ? (sum / count).toFixed(1) : '0.0';
  }

  function renderResponses() {
    const container = document.getElementById('responses-container');
    if (responses.length === 0) {
      container.innerHTML = `<div class="text-center py-16 text-slate-400"><div class="text-5xl mb-4">📭</div><p class="text-lg font-medium">Chưa có response nào</p></div>`;
      return;
    }

    let html = `<div class="space-y-3">`;
    responses.forEach((r, ri) => {
      const ts = new Date(r.submitted_at).toLocaleString('vi-VN');
      html += `<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-slate-400">#${ri + 1} · ${ts}</span>
          <button onclick="deleteResponse('${r.id}', ${ri})" class="text-xs text-red-400 hover:text-red-600 font-medium">🗑️</button>
        </div>`;
      questions.forEach((q, qi) => {
        const val = r.answers?.[q.id];
        if (val === undefined) return;
        const display = q.type === 'text' ? escHtml(String(val)) : `<span class="font-semibold">${val}</span>`;
        html += `<div class="text-sm py-1 border-b border-slate-100 last:border-0"><span class="text-slate-500">${escHtml(q.title)}:</span> ${display}</div>`;
      });
      html += `</div>`;
    });
    html += `</div>`;
    container.innerHTML = html;
  }

  async function deleteResponse(id, index) {
    if (!confirm('Xóa response này?')) return;
    const r = await fetch('/api/response/' + id, { method: 'DELETE' });
    const json = await r.json();
    if (json.ok) { responses.splice(index, 1); renderResponses(); updateStats(); }
    else alert('Lỗi: ' + json.error);
  }

  function exportXLSX() {
    if (responses.length === 0) { alert('Chưa có response để xuất.'); return; }
    const rows = responses.map((r, ri) => {
      const row = { STT: ri + 1, 'Thời gian': new Date(r.submitted_at).toLocaleString('vi-VN') };
      questions.forEach(q => {
        const val = r.answers?.[q.id];
        row[escHtml(q.title)] = val !== undefined ? val : '';
      });
      return row;
    });
    const ws = XLSX.utils.json_to_sheet(rows);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Responses');
    const colWidths = [{ wch:6 }, { wch:22 }, ...questions.map(() => ({ wch:25 }))];
    ws['!cols'] = colWidths;
    XLSX.writeFile(wb, `Khao_sat_${SURVEY_ID.slice(0,8)}_${new Date().toISOString().slice(0,10)}.xlsx`);
  }

  function escHtml(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

  // Load SheetJS
  const s = document.createElement('script');
  s.src = 'https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js';
  s.onload = loadResults;
  document.head.appendChild(s);
</script>
