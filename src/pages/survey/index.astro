---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
---

<Layout title="Khảo sát - LearnLab">
  <div class="mx-auto max-w-5xl w-full px-4 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900" style="background:linear-gradient(135deg,#7c3aed,#6d28d9);-webkit-background-clip:text;-webkit-text-fill-color:transparent">📋 Khảo sát</h1>
        <p class="text-slate-500 mt-1">Tạo và quản lý form khảo sát của bạn</p>
      </div>
      <a href="/survey/create" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-violet-600 to-indigo-600 px-5 py-2.5 text-sm font-bold text-white shadow-md hover:shadow-lg hover:from-violet-700 hover:to-indigo-700 transition-all">➕ Tạo khảo sát mới</a>
    </div>

    <div id="survey-list">
      <div class="text-center py-16 text-slate-400">
        <div class="text-5xl mb-4">📋</div>
        <p class="text-lg font-medium">Đang tải danh sách...</p>
      </div>
    </div>

    <div id="setup-box" class="mx-auto max-w-3xl w-full px-4 pb-12" style="display:none">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
        <div class="flex items-start gap-3">
          <span class="text-2xl">⚠️</span>
          <div style="flex:1">
            <h3 class="font-bold text-amber-800 text-lg">Cần thiết lập database</h3>
            <p class="text-amber-700 text-sm mt-1" id="setup-message">Chạy SQL sau trong Supabase Dashboard → SQL Editor hoặc bấm nút bên dưới:</p>
            <button class="mt-3 text-sm font-medium text-amber-800 underline" onclick="runSetup()">🔄 Bấm để thử tự động tạo</button>
            <pre class="mt-3 bg-amber-100/70 p-4 rounded-xl text-xs overflow-x-auto text-amber-900 max-h-60 overflow-y-auto" id="setup-sql"></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  async function loadSurveys() {
    try {
      const r = await fetch('/api/survey');
      const json = await r.json();
      if (!json.ok) throw new Error(json.error);

      const list = document.getElementById('survey-list');
      if (json.data.length === 0) {
        list.innerHTML = `<div class="text-center py-16 text-slate-400">
          <div class="text-5xl mb-4">📝</div>
          <p class="text-lg font-medium">Chưa có khảo sát nào</p>
          <a href="/survey/create" class="inline-block mt-4 rounded-xl bg-gradient-to-r from-violet-600 to-indigo-600 px-6 py-3 text-sm font-bold text-white hover:shadow-lg transition-all">Tạo khảo sát đầu tiên</a>
        </div>`;
        return;
      }

      list.innerHTML = `<div class="grid gap-4">${json.data.map(s => `
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-violet-200 transition-all">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <h3 class="font-bold text-slate-900 text-lg truncate">${escHtml(s.title)}</h3>
              <p class="text-sm text-slate-500 mt-0.5 line-clamp-1">${escHtml(s.description || 'Không có mô tả')}</p>
              <p class="text-xs text-slate-400 mt-1">Tạo: ${new Date(s.created_at).toLocaleDateString('vi-VN')} · Cập nhật: ${new Date(s.updated_at).toLocaleDateString('vi-VN')}</p>
            </div>
            <div class="flex items-center gap-2 shrink-0 flex-wrap justify-end">
              <a href="/survey/create?edit=${s.id}" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-violet-50 hover:border-violet-200 transition-all">✏️ Sửa</a>
              <a href="/survey/r/${s.id}" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-violet-50 hover:border-violet-200 transition-all">📊 Kết quả</a>
              <a href="/survey/s/${s.id}" target="_blank" class="rounded-lg bg-violet-50 px-3 py-1.5 text-xs font-semibold text-violet-700 hover:bg-violet-100 transition-all">🔗 Form</a>
              <a href="/survey/ghost/${s.id}" class="rounded-lg bg-purple-50 px-3 py-1.5 text-xs font-semibold text-purple-700 hover:bg-purple-100 transition-all">👻 Ghost</a>
              <button onclick="deleteSurvey('${s.id}')" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-500 hover:bg-red-50 transition-all">🗑️</button>
            </div>
          </div>
        </div>`).join('')}</div>`;
    } catch (e) {
      document.getElementById('survey-list').innerHTML = `<div class="text-center py-16 text-slate-400"><p>❌ Lỗi tải dữ liệu</p><p class="text-sm mt-2">${e.message}</p></div>`;
      showSetup();
    }
  }

  function escHtml(s) { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }

  async function deleteSurvey(id) {
    if (!confirm('Xóa khảo sát này?')) return;
    const r = await fetch('/api/survey/' + id, { method: 'DELETE' });
    const json = await r.json();
    if (json.ok) loadSurveys();
    else alert('Lỗi: ' + json.error);
  }

  async function showSetup() {
    const box = document.getElementById('setup-box');
    box.style.display = 'block';
    document.getElementById('setup-message').textContent = 'Supabase admin chưa được cấu hình. Vào Vercel Dashboard → Project Settings → add SUPABASE_SERVICE_ROLE_KEY';
    document.getElementById('setup-sql').textContent = 'Không thể tải SQL. Vui lòng chạy thủ công.';
  }

  async function runSetup() {
    const btn = event.target;
    btn.textContent = '⏳ Đang tạo...';
    btn.disabled = true;
    try {
      const r = await fetch('/api/survey-setup', { method: 'POST' });
      const json = await r.json();
      if (json.ok) {
        document.getElementById('setup-box').style.display = 'none';
        loadSurveys();
      } else {
        alert('Lỗi: ' + json.error + '\n\n' + (json.hint || ''));
      }
    } catch (e) { alert('Lỗi: ' + e.message); }
    btn.textContent = '🔄 Bấm để thử tự động tạo';
    btn.disabled = false;
  }

  loadSurveys();
</script>
