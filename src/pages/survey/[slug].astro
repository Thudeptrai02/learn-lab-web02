---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { slug } = Astro.params;

const { data: survey } = await supabase
  .from('surveys')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

const { data: questions } = survey
  ? await supabase
      .from('survey_questions')
      .select('*')
      .eq('survey_id', survey.id)
      .order('order_index')
  : { data: [] };
---

<Layout title={survey ? `${survey.title} - LearnLab Survey` : 'Khảo sát không tồn tại'}>
  {
    !survey ? (
      <div class="flex-1 flex items-center justify-center p-8">
        <div class="text-center max-w-md">
          <div class="text-6xl mb-4">📋</div>
          <h1 class="text-2xl font-black mb-2">Khảo sát không tồn tại</h1>
          <p class="text-slate-500">Link khảo sát không hợp lệ hoặc đã bị đóng.</p>
          <a href="/" class="mt-6 inline-block px-6 py-3 bg-slate-900 text-white rounded-xl font-bold text-sm">Về trang chủ</a>
        </div>
      </div>
    ) : (
      <div id="survey-root" class="flex-1 flex flex-col">
        <div class="bg-white border-b border-slate-200">
          <div class="max-w-2xl mx-auto px-4 py-4 flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-slate-900 flex items-center justify-center text-white text-xs font-black">L</div>
            <span class="text-sm font-bold text-slate-700">LearnLab Survey</span>
          </div>
        </div>

        <div id="survey-form-view" class="flex-1 flex flex-col">
          <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white">
            <div class="max-w-2xl mx-auto px-4 py-12">
              <h1 class="text-2xl sm:text-3xl font-black mb-3">{survey.title}</h1>
              {survey.description && <p class="text-slate-300 text-sm sm:text-base leading-relaxed">{survey.description}</p>}
              {survey.intro_text && <p class="text-slate-400 text-sm mt-3 leading-relaxed">{survey.intro_text}</p>}
            </div>
          </div>

          <div class="flex-1 max-w-2xl mx-auto w-full px-4 py-8">
            <div id="progress-bar" class="hidden mb-8">
              <div class="flex justify-between text-xs text-slate-400 mb-1.5">
                <span id="progress-label">0%</span>
                <span id="progress-count">0/{questions.length}</span>
              </div>
              <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden">
                <div id="progress-fill" class="h-full bg-slate-900 rounded-full transition-all duration-500" style="width:0%"></div>
              </div>
            </div>

            <form id="survey-form" onsubmit="return false">
              <div id="questions-container" class="space-y-6">
                {questions.map((q, i) => {
                  const labels = ['Rất không đồng ý', 'Không đồng ý', 'Trung lập', 'Đồng ý', 'Rất đồng ý'];
                  return (
                    <div class="question-card bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 transition-shadow duration-300" data-qid={q.id} data-order={i}>
                      <div class="flex items-start gap-3 mb-4">
                        {q.construct_label && (
                          <span class="shrink-0 px-2.5 py-1 rounded-lg bg-slate-100 text-[11px] font-bold text-slate-500 uppercase tracking-wider">{q.construct_label}</span>
                        )}
                        <span class="text-xs text-slate-400 font-medium ml-auto">{i + 1}/{questions.length}</span>
                      </div>
                      <p class="text-sm sm:text-base font-semibold text-slate-800 mb-4 leading-relaxed">{q.question_text}</p>
                      {q.question_type === 'likert5' ? (
                        <div class="likert-grid">
                          <div class="flex gap-1 sm:gap-2">
                            {labels.map((label, li) => {
                              const val = li + 1;
                              return (
                                <label class="likert-option flex-1 flex flex-col items-center gap-1.5 cursor-pointer group">
                                  <input type="radio" name={'q_' + q.id} value={val} class="sr-only peer" required={q.required} />
                                  <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border-2 border-slate-200 flex items-center justify-center text-sm font-bold text-slate-400 peer-checked:border-slate-900 peer-checked:bg-slate-900 peer-checked:text-white group-hover:border-slate-400 transition-all duration-200">
                                    {val}
                                  </div>
                                  <span class="text-[10px] sm:text-[11px] text-slate-400 text-center leading-tight peer-checked:text-slate-700">{label}</span>
                                </label>
                              );
                            })}
                          </div>
                        </div>
                      ) : (
                        <input type="text" name={'q_' + q.id} class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:border-slate-400 focus:ring-2 focus:ring-slate-100 outline-none transition-all" placeholder="Nhập câu trả lời..." required={q.required} />
                      )}
                    </div>
                  );
                })}
              </div>

              <div class="mt-8 flex flex-col items-center gap-4">
                <button type="submit" id="btn-submit" class="w-full sm:w-auto px-10 py-4 bg-slate-900 hover:bg-slate-800 text-white font-black text-sm rounded-2xl shadow-lg shadow-slate-900/20 transition-all hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-50 disabled:cursor-not-allowed">
                  Gửi khảo sát
                </button>
                <p class="text-xs text-slate-400">Dữ liệu của bạn được bảo mật và chỉ sử dụng cho mục đích nghiên cứu.</p>
              </div>
            </form>
          </div>
        </div>

        <div id="survey-thankyou-view" class="flex-1 flex items-center justify-center p-8" style="display:none">
          <div class="text-center max-w-md">
            <div class="text-6xl mb-4">🎉</div>
            <h2 class="text-2xl font-black mb-3">Hoàn thành!</h2>
            <p class="text-slate-500 leading-relaxed">{survey.thank_you_text || 'Cảm ơn bạn đã hoàn thành khảo sát!'}</p>
          </div>
        </div>
      </div>
    )
  }
</Layout>

<style is:global>
  .likert-option input:checked + div {
    border-color: #0f172a;
    background: #0f172a;
    color: #fff;
  }
</style>

<script>
const questions = document.querySelectorAll('.question-card');
const form = document.getElementById('survey-form');
const formView = document.getElementById('survey-form-view');
const thankyouView = document.getElementById('survey-thankyou-view');
const progressFill = document.getElementById('progress-fill');
const progressLabel = document.getElementById('progress-label');
const progressCount = document.getElementById('progress-count');
const progressBar = document.getElementById('progress-bar');
const btnSubmit = document.getElementById('btn-submit');
const slug = window.location.pathname.split('/').pop();

function updateProgress() {
  let answered = 0;
  questions.forEach(q => {
    const inputs = q.querySelectorAll('input[type="radio"], input[type="text"]');
    let isAnswered = false;
    inputs.forEach(inp => {
      if (inp.type === 'radio' && inp.checked) isAnswered = true;
      if (inp.type === 'text' && inp.value.trim()) isAnswered = true;
    });
    if (isAnswered) answered++;
  });
  const pct = Math.round((answered / questions.length) * 100);
  progressFill.style.width = pct + '%';
  progressLabel.textContent = pct + '%';
  progressCount.textContent = answered + '/' + questions.length;
}

questions.forEach(q => {
  q.querySelectorAll('input').forEach(inp => {
    inp.addEventListener('change', updateProgress);
    inp.addEventListener('input', updateProgress);
  });
});

progressBar.style.display = 'block';
updateProgress();

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  btnSubmit.disabled = true;
  btnSubmit.textContent = 'Đang gửi...';

  const answers = [];
  questions.forEach(q => {
    const qid = q.dataset.qid;
    const radios = q.querySelectorAll('input[type="radio"]');
    const texts = q.querySelectorAll('input[type="text"]');
    let value = '';
    radios.forEach(r => { if (r.checked) value = r.value; });
    texts.forEach(t => { if (t.value.trim()) value = t.value.trim(); });
    if (value) answers.push({ question_id: parseInt(qid), value });
  });

  try {
    const res = await fetch('/api/survey/' + slug, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        answers,
        submittedAt: new Date().toISOString(),
        timeSpentSeconds: null,
        respondentId: ''
      })
    });
    const data = await res.json();
    if (data.success) {
      formView.style.display = 'none';
      thankyouView.style.display = 'flex';
      window.scrollTo(0, 0);
    } else {
      alert('Lỗi: ' + (data.error || 'Không thể gửi khảo sát'));
      btnSubmit.disabled = false;
      btnSubmit.textContent = 'Gửi khảo sát';
    }
  } catch (err) {
    alert('Lỗi kết nối: ' + err.message);
    btnSubmit.disabled = false;
    btnSubmit.textContent = 'Gửi khảo sát';
  }
});
</script>
