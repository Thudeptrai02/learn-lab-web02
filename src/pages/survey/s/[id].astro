---
export const prerender = false;
const { id } = Astro.params;
const surveyId = id;
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Khảo sát</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: linear-gradient(135deg, #e8e0f0 0%, #f0eef4 50%, #e0e8f0 100%);
    color: #202124;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }

  .header-bar {
    background: #fff;
    border-bottom: 1px solid #e0e0e0;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .header-bar svg { width: 20px; height: 20px; color: #5f6368; }
  .header-bar span { font-size: 13px; color: #5f6368; font-weight: 500; letter-spacing: .3px; }

  .container { max-width: 640px; margin: 0 auto; padding: 24px 16px 80px; flex: 1; width: 100%; }

  .survey-header {
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
    border-radius: 12px;
    padding: 28px 24px 24px;
    margin-bottom: 20px;
    color: #fff;
    box-shadow: 0 4px 24px rgba(124,58,237,.25);
  }
  .survey-header h1 { font-size: 24px; font-weight: 700; line-height: 1.3; }
  .survey-header p { margin-top: 6px; font-size: 14px; opacity: .85; line-height: 1.5; }
  .survey-header .required-note { margin-top: 12px; font-size: 12px; opacity: .7; }

  .card {
    background: #fff;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 12px;
    border: 1px solid #e0e0e0;
    transition: box-shadow .2s;
  }
  .card:hover { box-shadow: 0 1px 6px rgba(0,0,0,.06); }

  .q-title {
    font-size: 14px;
    font-weight: 600;
    color: #202124;
    line-height: 1.5;
    margin-bottom: 12px;
    display: flex;
    gap: 4px;
  }
  .q-required { color: #d93025; }

  .likert-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
  }
  .likert-grid.likert7 { grid-template-columns: repeat(7, 1fr); }

  .likert-option {
    padding: 10px 4px;
    border: 1px solid #dadce0;
    border-radius: 8px;
    cursor: pointer;
    font-size: 11px;
    font-weight: 500;
    color: #5f6368;
    transition: all .15s;
    text-align: center;
    line-height: 1.3;
    user-select: none;
  }
  .likert-option:hover {
    border-color: #7c3aed;
    background: #f5f0ff;
  }
  .likert-option.selected {
    border-color: #7c3aed;
    background: #ede7f6;
    color: #7c3aed;
    font-weight: 600;
    box-shadow: 0 0 0 1px #7c3aed;
  }

  .choice-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 1px solid #dadce0;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    color: #202124;
    transition: all .15s;
    user-select: none;
  }
  .choice-option:hover {
    border-color: #7c3aed;
    background: #f5f0ff;
  }
  .choice-option.selected {
    border-color: #7c3aed;
    background: #ede7f6;
    box-shadow: 0 0 0 1px #7c3aed;
  }
  .choice-option .radio-circle {
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 2px solid #5f6368;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: all .15s;
  }
  .choice-option.selected .radio-circle {
    border-color: #7c3aed;
    background: #7c3aed;
    box-shadow: inset 0 0 0 3px #fff;
  }

  .text-input {
    width: 100%;
    padding: 10px 0;
    border: none;
    border-bottom: 1px solid #dadce0;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    background: transparent;
    transition: border-color .15s;
  }
  .text-input:focus { border-bottom-color: #7c3aed; border-bottom-width: 2px; }
  .text-input::placeholder { color: #9aa0a6; }

  .rating-group { display: flex; gap: 8px; flex-wrap: wrap; }
  .rating-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid #dadce0;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    color: #5f6368;
    background: #fff;
    transition: all .15s;
    display: flex; align-items: center; justify-content: center;
    user-select: none;
  }
  .rating-btn:hover { border-color: #7c3aed; color: #7c3aed; }
  .rating-btn.selected {
    border-color: #7c3aed;
    background: #7c3aed;
    color: #fff;
    box-shadow: 0 2px 8px rgba(124,58,237,.3);
  }

  .submit-area {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: #fff;
    border-top: 1px solid #e0e0e0;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 100;
  }
  .submit-area .progress-container { flex: 1; }
  .submit-area .progress-bar {
    height: 4px;
    background: #e0e0e0;
    border-radius: 2px;
    overflow: hidden;
  }
  .submit-area .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #7c3aed, #a78bfa);
    border-radius: 2px;
    transition: width .3s ease;
    width: 0%;
  }
  .submit-area .progress-text { font-size: 11px; color: #5f6368; margin-top: 2px; }

  .btn-submit {
    background: #7c3aed;
    color: #fff;
    border: none;
    padding: 10px 28px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all .15s;
    white-space: nowrap;
  }
  .btn-submit:hover { background: #6d28d9; box-shadow: 0 2px 12px rgba(124,58,237,.3); }
  .btn-submit:disabled { opacity: .5; cursor: not-allowed; box-shadow: none; }

  .thankyou-screen {
    text-align: center;
    padding: 48px 24px;
    animation: fadeUp .5s ease;
  }
  .thankyou-screen .check-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #a78bfa);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    font-size: 28px;
    color: #fff;
    box-shadow: 0 4px 20px rgba(124,58,237,.3);
  }
  .thankyou-screen h2 { font-size: 22px; font-weight: 700; color: #202124; margin-bottom: 8px; }
  .thankyou-screen p { font-size: 14px; color: #5f6368; line-height: 1.6; }

  .loader { text-align: center; padding: 64px 24px; }
  .loader .spinner {
    width: 40px; height: 40px;
    border: 3px solid #e0e0e0;
    border-top-color: #7c3aed;
    border-radius: 50%;
    animation: spin .8s linear infinite;
    margin: 0 auto 16px;
  }
  .loader p { color: #5f6368; font-size: 14px; }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .error-screen { text-align: center; padding: 64px 24px; }
  .error-screen .error-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: #fce8e6;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
    font-size: 28px;
  }
  .error-screen h2 { font-size: 18px; font-weight: 600; color: #202124; margin-bottom: 6px; }
  .error-screen p { font-size: 13px; color: #5f6368; }

  .toast {
    position: fixed; top: 16px; left: 50%; transform: translateX(-50%) translateY(-80px);
    padding: 10px 20px; border-radius: 8px; color: #fff; font-size: 13px; font-weight: 500;
    box-shadow: 0 4px 20px rgba(0,0,0,.15); transition: transform .3s ease; z-index: 999;
    white-space: nowrap;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }
  .toast-success { background: #188038; }
  .toast-error { background: #d93025; }

  @media (max-width: 640px) {
    .container { padding: 16px 12px 80px; }
    .survey-header { padding: 20px 16px; border-radius: 8px; }
    .survey-header h1 { font-size: 20px; }
    .card { padding: 16px; border-radius: 8px; }
    .likert-grid { gap: 4px; }
    .likert-option label { padding: 8px 2px; font-size: 10px; }
    .submit-area { padding: 10px 12px; flex-direction: row; }
    .btn-submit { padding: 10px 20px; font-size: 13px; }
  }
</style>
</head>
<body>

<div class="header-bar">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  <span>LearnLab · Khảo sát</span>
</div>

<div class="container" id="app">
  <div class="loader" id="loader">
    <div class="spinner"></div>
    <p>Đang tải khảo sát...</p>
  </div>
</div>

<div class="submit-area" id="submit-area" style="display:none">
  <div class="progress-container">
    <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
    <div class="progress-text" id="progress-text">0%</div>
  </div>
  <button class="btn-submit" id="submit-btn" onclick="submitForm()">📨 Gửi</button>
</div>

<div id="toast" class="toast"></div>

<script is:inline>
  const SURVEY_ID = '{surveyId}';
  let surveyData = null;
  const state = {};

  function qs(s) { return document.querySelector(s); }
  function byId(id) { return document.getElementById(id); }

  function showToast(msg, type) {
    const t = byId('toast');
    t.textContent = msg; t.className = 'toast toast-' + type;
    requestAnimationFrame(() => t.classList.add('show'));
    clearTimeout(t._hide);
    t._hide = setTimeout(() => t.classList.remove('show'), 4000);
  }

  function updateProgress() {
    if (!surveyData) return;
    const qs = surveyData.questions || [];
    const total = qs.length;
    if (total === 0) return;
    let answered = 0;
    qs.forEach((q, i) => {
      if (q.type === 'text') {
        if (state['q_' + i] && state['q_' + i].trim()) answered++;
      } else {
        if (state['q_' + i] !== undefined) answered++;
      }
    });
    const pct = Math.round((answered / total) * 100);
    byId('progress-fill').style.width = pct + '%';
    byId('progress-text').textContent = answered + '/' + total;
  }

  async function loadSurvey() {
    try {
      const r = await fetch('/api/survey/' + SURVEY_ID);
      const json = await r.json();
      if (!json.ok || !json.data) throw new Error(json.error || 'Không tìm thấy khảo sát');

      surveyData = json.data;
      renderForm(surveyData);
    } catch (e) {
      byId('app').innerHTML = `
        <div class="error-screen">
          <div class="error-icon">😅</div>
          <h2>Khảo sát không tồn tại</h2>
          <p>${escHtml(e.message)}</p>
        </div>`;
    }
  }

  function setAnswer(qIdx, value) {
    state['q_' + qIdx] = value;
    updateProgress();
    const qDiv = document.getElementById('q_' + qIdx);
    if (!qDiv) return;
    qDiv.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
    const selEl = qDiv.querySelector('[data-v="' + value + '"]');
    if (selEl) selEl.classList.add('selected');
  }

  function renderForm(survey) {
    const qs = survey.questions || [];
    if (qs.length === 0) {
      byId('app').innerHTML = '<div class="error-screen"><div class="error-icon">📝</div><h2>Khảo sát trống</h2><p>Khảo sát này chưa có câu hỏi.</p></div>';
      return;
    }

    let html = '<div class="survey-header"><h1>' + escHtml(survey.title || 'Khảo sát') + '</h1>' +
      (survey.description ? '<p>' + escHtml(survey.description) + '</p>' : '') +
      '<div class="required-note">* Bắt buộc</div></div>';

    qs.forEach((q, i) => {
      html += '<div class="card"><div class="q-title">' + (i+1) + '. ' + escHtml(q.title) +
        (q.required ? '<span class="q-required">*</span>' : '') + '</div><div id="q_' + i + '">';

      if (q.type === 'likert5' || q.type === 'likert7') {
        html += '<div class="likert-grid' + (q.type === 'likert7' ? ' likert7' : '') + '">';
        (q.options || []).forEach(function(opt, oi) {
          var val = oi + 1;
          var sel = state['q_' + i] === val ? ' selected' : '';
          html += '<div class="likert-option' + sel + '" data-q="' + i + '" data-v="' + val + '" onclick="setAnswer(' + i + ',' + val + ')">' + escHtml(opt) + '</div>';
        });
        html += '</div>';
      }

      else if (q.type === 'multiple_choice') {
        html += '<div style="display:flex;flex-direction:column;gap:6px">';
        (q.labels || []).forEach(function(l, li) {
          var val = li + 1;
          var sel = state['q_' + i] === val ? ' selected' : '';
          html += '<div class="choice-option' + sel + '" data-q="' + i + '" data-v="' + val + '" onclick="setAnswer(' + i + ',' + val + ')">' +
            '<span class="radio-circle"></span>' + escHtml(l || 'Lựa chọn ' + (li+1)) + '</div>';
        });
        html += '</div>';
      }

      else if (q.type === 'text') {
        html += '<textarea class="text-input" rows="2" placeholder="Nhập câu trả lời của bạn..." oninput="state[\'q_' + i + '\']=this.value;updateProgress()">' + (state['q_' + i] || '') + '</textarea>';
      }

      else if (q.type === 'rating') {
        html += '<div class="rating-group">';
        [1,2,3,4,5].forEach(function(v) {
          var sel = state['q_' + i] === v ? ' selected' : '';
          html += '<div class="rating-btn' + sel + '" data-q="' + i + '" data-v="' + v + '" onclick="setAnswer(' + i + ',' + v + ')">' + v + '</div>';
        });
        html += '</div>';
      }

      html += '</div></div>';
    });

    byId('app').innerHTML = html;
    byId('submit-area').style.display = 'flex';
    updateProgress();
  }

  async function submitForm() {
    if (!surveyData) return;
    var qs = surveyData.questions || [];
    var btn = byId('submit-btn');
    btn.disabled = true; btn.textContent = '⏳ Đang gửi...';

    var answers = {};
    var missing = false;

    qs.forEach(function(q, i) {
      if (q.required) {
        if (q.type === 'text' && (!state['q_' + i] || !state['q_' + i].trim())) missing = true;
        else if (q.type !== 'text' && state['q_' + i] === undefined) missing = true;
      }
      if (state['q_' + i] !== undefined && state['q_' + i] !== '') {
        answers[q.id] = q.type === 'text' ? state['q_' + i] : Number(state['q_' + i]);
      }
    });

    if (missing) {
      showToast('⚠️ Vui lòng trả lời tất cả câu hỏi bắt buộc', 'error');
      btn.disabled = false; btn.textContent = '📨 Gửi';
      return;
    }

    try {
      var r = await fetch('/api/response', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ survey_id: SURVEY_ID, answers: answers, submitted_at: new Date().toISOString() })
      });
      var json = await r.json();
      if (!json.ok) throw new Error(json.error);

      byId('app').innerHTML = '<div class="thankyou-screen"><div class="check-icon">✓</div><h2>Hoàn thành khảo sát</h2><p>Cảm ơn bạn đã tham gia!<br>Câu trả lời của bạn đã được ghi nhận.</p></div>';
      byId('submit-area').style.display = 'none';
    } catch (e) {
      showToast('❌ ' + e.message, 'error');
      btn.disabled = false; btn.textContent = '📨 Gửi';
    }
  }

  function escHtml(s) { var d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

  loadSurvey();
</script>
</body></html>
