---
import Layout from '../../../layouts/Layout.astro';
export const prerender = false;
const { id } = Astro.params;
const surveyId = id;
---
<Layout title="Khảo sát - LearnLab">
<div class="survey-form-wrap" style="flex:1;display:flex;flex-direction:column;background:linear-gradient(135deg,#e8e0f0 0%,#f0eef4 50%,#e0e8f0 100%)">
<style is:global>
  .survey-form-wrap .header-bar {
    background: #fff; border-bottom: 1px solid #e0e0e0; padding: 12px 24px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .survey-form-wrap .header-bar svg { width: 20px; height: 20px; color: #5f6368; }
  .survey-form-wrap .header-bar span { font-size: 13px; color: #5f6368; font-weight: 500; letter-spacing: .3px; }
  .survey-form-wrap .container { max-width: 640px; margin: 0 auto; padding: 24px 16px 80px; flex: 1; width: 100%; }
  .survey-form-wrap .survey-header {
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); border-radius: 12px;
    padding: 28px 24px 24px; margin-bottom: 20px; color: #fff; box-shadow: 0 4px 24px rgba(124,58,237,.25);
  }
  .survey-form-wrap .survey-header h1 { font-size: 24px; font-weight: 700; line-height: 1.3; }
  .survey-form-wrap .survey-header p { margin-top: 6px; font-size: 14px; opacity: .85; line-height: 1.5; }
  .survey-form-wrap .survey-header .required-note { margin-top: 12px; font-size: 12px; opacity: .7; }
  .survey-form-wrap .card { background: #fff; border-radius: 12px; padding: 20px 24px; margin-bottom: 12px; border: 1px solid #e0e0e0; }
  .survey-form-wrap .q-title { font-size: 14px; font-weight: 600; color: #202124; line-height: 1.5; margin-bottom: 12px; display: flex; gap: 4px; }
  .survey-form-wrap .q-required { color: #d93025; }
  .survey-form-wrap .likert-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .survey-form-wrap .likert-grid.likert7 { grid-template-columns: repeat(7, 1fr); }
  .survey-form-wrap .likert-option {
    padding: 10px 4px; border: 1px solid #dadce0; border-radius: 8px; cursor: pointer;
    font-size: 11px; font-weight: 500; color: #5f6368; transition: all .15s;
    text-align: center; line-height: 1.3; user-select: none;
  }
  .survey-form-wrap .likert-option:hover { border-color: #7c3aed; background: #f5f0ff; }
  .survey-form-wrap .likert-option.selected { border-color: #7c3aed; background: #ede7f6; color: #7c3aed; font-weight: 600; box-shadow: 0 0 0 1px #7c3aed; }
  .survey-form-wrap .choice-option { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border: 1px solid #dadce0; border-radius: 8px; cursor: pointer; font-size: 14px; color: #202124; transition: all .15s; user-select: none; }
  .survey-form-wrap .choice-option:hover { border-color: #7c3aed; background: #f5f0ff; }
  .survey-form-wrap .choice-option.selected { border-color: #7c3aed; background: #ede7f6; box-shadow: 0 0 0 1px #7c3aed; }
  .survey-form-wrap .choice-option .radio-circle { width: 18px; height: 18px; border-radius: 50%; border: 2px solid #5f6368; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all .15s; }
  .survey-form-wrap .choice-option.selected .radio-circle { border-color: #7c3aed; background: #7c3aed; box-shadow: inset 0 0 0 3px #fff; }
  .survey-form-wrap .text-input { width: 100%; padding: 10px 0; border: none; border-bottom: 1px solid #dadce0; font-size: 14px; font-family: inherit; outline: none; background: transparent; }
  .survey-form-wrap .text-input:focus { border-bottom-color: #7c3aed; border-bottom-width: 2px; }
  .survey-form-wrap .text-input::placeholder { color: #9aa0a6; }
  .survey-form-wrap .rating-group { display: flex; gap: 8px; flex-wrap: wrap; }
  .survey-form-wrap .rating-btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid #dadce0; cursor: pointer; font-size: 16px; font-weight: 600; color: #5f6368; background: #fff; transition: all .15s; display: flex; align-items: center; justify-content: center; user-select: none; }
  .survey-form-wrap .rating-btn:hover { border-color: #7c3aed; color: #7c3aed; }
  .survey-form-wrap .rating-btn.selected { border-color: #7c3aed; background: #7c3aed; color: #fff; box-shadow: 0 2px 8px rgba(124,58,237,.3); }
  .survey-form-wrap .submit-area { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1px solid #e0e0e0; padding: 12px 16px; display: flex; align-items: center; gap: 12px; z-index: 100; }
  .survey-form-wrap .submit-area .progress-container { flex: 1; }
  .survey-form-wrap .submit-area .progress-bar { height: 4px; background: #e0e0e0; border-radius: 2px; overflow: hidden; }
  .survey-form-wrap .submit-area .progress-fill { height: 100%; background: linear-gradient(90deg, #7c3aed, #a78bfa); border-radius: 2px; transition: width .3s ease; width: 0%; }
  .survey-form-wrap .submit-area .progress-text { font-size: 11px; color: #5f6368; margin-top: 2px; }
  .survey-form-wrap .btn-submit { background: #7c3aed; color: #fff; border: none; padding: 10px 28px; border-radius: 8px; font-size: 14px; font-weight: 600; font-family: inherit; cursor: pointer; transition: all .15s; white-space: nowrap; }
  .survey-form-wrap .btn-submit:hover { background: #6d28d9; box-shadow: 0 2px 12px rgba(124,58,237,.3); }
  .survey-form-wrap .btn-submit:disabled { opacity: .5; cursor: not-allowed; box-shadow: none; }
  .survey-form-wrap .thankyou-screen { text-align: center; padding: 48px 24px; }
  .survey-form-wrap .thankyou-screen .check-icon { width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #7c3aed, #a78bfa); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 28px; color: #fff; box-shadow: 0 4px 20px rgba(124,58,237,.3); }
  .survey-form-wrap .thankyou-screen h2 { font-size: 22px; font-weight: 700; color: #202124; margin-bottom: 8px; }
  .survey-form-wrap .thankyou-screen p { font-size: 14px; color: #5f6368; line-height: 1.6; }
  .survey-form-wrap .loader { text-align: center; padding: 64px 24px; }
  .survey-form-wrap .loader .spinner { width: 40px; height: 40px; border: 3px solid #e0e0e0; border-top-color: #7c3aed; border-radius: 50%; animation: spin .8s linear infinite; margin: 0 auto 16px; }
  .survey-form-wrap .loader p { color: #5f6368; font-size: 14px; }
  .survey-form-wrap .error-screen { text-align: center; padding: 64px 24px; }
  .survey-form-wrap .error-screen .error-icon { width: 64px; height: 64px; border-radius: 50%; background: #fce8e6; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 28px; }
  .survey-form-wrap .error-screen h2 { font-size: 18px; font-weight: 600; color: #202124; margin-bottom: 6px; }
  .survey-form-wrap .error-screen p { font-size: 13px; color: #5f6368; }
  .survey-form-wrap .toast { position: fixed; top: 16px; left: 50%; transform: translateX(-50%) translateY(-80px); padding: 10px 20px; border-radius: 8px; color: #fff; font-size: 13px; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,.15); transition: transform .3s ease; z-index: 999; white-space: nowrap; }
  .survey-form-wrap .toast.show { transform: translateX(-50%) translateY(0); }
  .survey-form-wrap .toast-success { background: #188038; }
  .survey-form-wrap .toast-error { background: #d93025; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 640px) {
    .survey-form-wrap .container { padding: 16px 12px 80px; }
    .survey-form-wrap .survey-header { padding: 20px 16px; border-radius: 8px; }
    .survey-form-wrap .survey-header h1 { font-size: 20px; }
    .survey-form-wrap .card { padding: 16px; border-radius: 8px; }
    .survey-form-wrap .likert-grid { gap: 4px; }
    .survey-form-wrap .likert-option { padding: 8px 2px; font-size: 10px; }
    .survey-form-wrap .submit-area { padding: 10px 12px; }
    .survey-form-wrap .btn-submit { padding: 10px 20px; font-size: 13px; }
  }
</style>

<div class="header-bar">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  <span>LearnLab · Khảo sát</span>
</div>

<div class="container" id="app">
  <div class="loader" id="loader">
    <div class="spinner"></div>
    <p>Đang tải khảo sát...</p>
  </div>
</div>

<div class="submit-area" id="submit-area" style="display:none">
  <div class="progress-container">
    <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
    <div class="progress-text" id="progress-text">0%</div>
  </div>
  <button class="btn-submit" id="submit-btn" onclick="submitForm()">📨 Gửi</button>
</div>

<div id="toast" class="toast"></div>

<script is:inline>
  const SURVEY_ID = '{surveyId}';
  let surveyData = null;
  const state = {};

  function qs(s) { return document.querySelector(s); }
  function byId(id) { return document.getElementById(id); }

  function showToast(msg, type) {
    const t = byId('toast');
    t.textContent = msg; t.className = 'toast toast-' + type;
    requestAnimationFrame(() => t.classList.add('show'));
    clearTimeout(t._hide);
    t._hide = setTimeout(() => t.classList.remove('show'), 4000);
  }

  function updateProgress() {
    if (!surveyData) return;
    const qs = surveyData.questions || [];
    const total = qs.length;
    if (total === 0) return;
    let answered = 0;
    qs.forEach((q, i) => {
      if (q.type === 'text') {
        if (state['q_' + i] && state['q_' + i].trim()) answered++;
      } else {
        if (state['q_' + i] !== undefined) answered++;
      }
    });
    const pct = Math.round((answered / total) * 100);
    byId('progress-fill').style.width = pct + '%';
    byId('progress-text').textContent = answered + '/' + total;
  }

  async function loadSurvey() {
    try {
      const r = await fetch('/api/survey/' + SURVEY_ID);
      const json = await r.json();
      if (!json.ok || !json.data) throw new Error(json.error || 'Không tìm thấy khảo sát');
      surveyData = json.data;
      renderForm(surveyData);
    } catch (e) {
      byId('app').innerHTML = '<div class="error-screen"><div class="error-icon">😅</div><h2>Khảo sát không tồn tại</h2><p>' + escHtml(e.message) + '</p></div>';
    }
  }

  function setAnswer(qIdx, value) {
    state['q_' + qIdx] = value;
    updateProgress();
    const qDiv = document.getElementById('q_' + qIdx);
    if (!qDiv) return;
    qDiv.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
    const selEl = qDiv.querySelector('[data-v="' + value + '"]');
    if (selEl) selEl.classList.add('selected');
  }

  function renderForm(survey) {
    const qs = survey.questions || [];
    if (qs.length === 0) {
      byId('app').innerHTML = '<div class="error-screen"><div class="error-icon">📝</div><h2>Khảo sát trống</h2><p>Khảo sát này chưa có câu hỏi.</p></div>';
      return;
    }
    let html = '<div class="survey-header"><h1>' + escHtml(survey.title || 'Khảo sát') + '</h1>' +
      (survey.description ? '<p>' + escHtml(survey.description) + '</p>' : '') +
      '<div class="required-note">* Bắt buộc</div></div>';
    qs.forEach((q, i) => {
      html += '<div class="card"><div class="q-title">' + (i+1) + '. ' + escHtml(q.title) +
        (q.required ? '<span class="q-required">*</span>' : '') + '</div><div id="q_' + i + '">';
      if (q.type === 'likert5' || q.type === 'likert7') {
        html += '<div class="likert-grid' + (q.type === 'likert7' ? ' likert7' : '') + '">';
        (q.options || []).forEach(function(opt, oi) {
          var val = oi + 1;
          var sel = state['q_' + i] === val ? ' selected' : '';
          html += '<div class="likert-option' + sel + '" data-q="' + i + '" data-v="' + val + '" onclick="setAnswer(' + i + ',' + val + ')">' + escHtml(opt) + '</div>';
        });
        html += '</div>';
      } else if (q.type === 'multiple_choice') {
        html += '<div style="display:flex;flex-direction:column;gap:6px">';
        (q.labels || []).forEach(function(l, li) {
          var val = li + 1;
          var sel = state['q_' + i] === val ? ' selected' : '';
          html += '<div class="choice-option' + sel + '" data-q="' + i + '" data-v="' + val + '" onclick="setAnswer(' + i + ',' + val + ')">' +
            '<span class="radio-circle"></span>' + escHtml(l || 'Lựa chọn ' + (li+1)) + '</div>';
        });
        html += '</div>';
      } else if (q.type === 'text') {
        html += '<textarea class="text-input" rows="2" placeholder="Nhập câu trả lời của bạn..." oninput="state[\'q_' + i + '\']=this.value;updateProgress()">' + (state['q_' + i] || '') + '</textarea>';
      } else if (q.type === 'rating') {
        html += '<div class="rating-group">';
        [1,2,3,4,5].forEach(function(v) {
          var sel = state['q_' + i] === v ? ' selected' : '';
          html += '<div class="rating-btn' + sel + '" data-q="' + i + '" data-v="' + v + '" onclick="setAnswer(' + i + ',' + v + ')">' + v + '</div>';
        });
        html += '</div>';
      }
      html += '</div></div>';
    });
    byId('app').innerHTML = html;
    byId('submit-area').style.display = 'flex';
    updateProgress();
  }

  async function submitForm() {
    if (!surveyData) return;
    var qs = surveyData.questions || [];
    var btn = byId('submit-btn');
    btn.disabled = true; btn.textContent = '⏳ Đang gửi...';
    var answers = {};
    var missing = false;
    qs.forEach(function(q, i) {
      if (q.required) {
        if (q.type === 'text' && (!state['q_' + i] || !state['q_' + i].trim())) missing = true;
        else if (q.type !== 'text' && state['q_' + i] === undefined) missing = true;
      }
      if (state['q_' + i] !== undefined && state['q_' + i] !== '') {
        answers[q.id] = q.type === 'text' ? state['q_' + i] : Number(state['q_' + i]);
      }
    });
    if (missing) {
      showToast('⚠️ Vui lòng trả lời tất cả câu hỏi bắt buộc', 'error');
      btn.disabled = false; btn.textContent = '📨 Gửi'; return;
    }
    try {
      var r = await fetch('/api/response', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ survey_id: SURVEY_ID, answers: answers, submitted_at: new Date().toISOString() })
      });
      var json = await r.json();
      if (!json.ok) throw new Error(json.error);
      byId('app').innerHTML = '<div class="thankyou-screen"><div class="check-icon">✓</div><h2>Hoàn thành khảo sát</h2><p>Cảm ơn bạn đã tham gia!<br>Câu trả lời của bạn đã được ghi nhận.</p></div>';
      byId('submit-area').style.display = 'none';
    } catch (e) {
      showToast('❌ ' + e.message, 'error');
      btn.disabled = false; btn.textContent = '📨 Gửi';
    }
  }

  function escHtml(s) { var d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

  loadSurvey();
</script>
</div>
</Layout>