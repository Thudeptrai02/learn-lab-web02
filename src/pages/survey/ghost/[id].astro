---
export const prerender = false;
const { id: surveyId } = Astro.params;
---

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ghost Panel</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', system-ui, sans-serif; background: #0f0f1a; color: #e2e8f0; min-height: 100vh; }
  .topbar { background: #1a1a2e; border-bottom: 1px solid #2d2d44; padding: .75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; }
  .topbar h1 { font-size: 1rem; font-weight: 700; color: #a78bfa; }
  .topbar .badge { font-size: .7rem; background: #2d2d44; color: #94a3b8; padding: .15rem .5rem; border-radius: 999px; }
  .container { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem; }
  .card { background: #1a1a2e; border: 1px solid #2d2d44; border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem; }
  .card-title { font-weight: 600; font-size: .9rem; margin-bottom: .75rem; color: #a78bfa; display: flex; align-items: center; gap: .5rem; }
  .card-title .badge { font-size: .7rem; background: #2d2d44; color: #94a3b8; padding: .1rem .45rem; border-radius: 999px; font-weight: 400; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: .75rem; }
  label { font-size: .78rem; color: #94a3b8; display: block; margin-bottom: .25rem; }
  input, select { width: 100%; padding: .45rem .6rem; background: #0f0f1a; border: 1px solid #2d2d44; border-radius: 6px; color: #e2e8f0; font-size: .85rem; font-family: inherit; }
  input:focus, select:focus { outline: none; border-color: #7c3aed; }
  .btn { display: inline-flex; align-items: center; gap: .35rem; padding: .45rem .85rem; border: none; border-radius: 6px; font-size: .8rem; font-weight: 600; cursor: pointer; transition: all .15s; font-family: inherit; }
  .btn-primary { background: #7c3aed; color: #fff; }
  .btn-primary:hover { background: #6d28d9; }
  .btn-danger { background: #dc2626; color: #fff; }
  .btn-danger:hover { background: #b91c1c; }
  .btn-outline { background: transparent; color: #94a3b8; border: 1px solid #2d2d44; }
  .btn-outline:hover { background: #1a1a2e; }
  .btn-sm { padding: .3rem .55rem; font-size: .72rem; }
  .btn-success { background: #059669; color: #fff; }
  .btn-success:hover { background: #047857; }
  .btn-warning { background: #d97706; color: #fff; }
  .btn-warning:hover { background: #b45309; }
  .resp-item { border: 1px solid #2d2d44; border-radius: 8px; padding: .75rem; margin-bottom: .5rem; background: #12121f; }
  .resp-item:hover { border-color: #3d3d5c; }
  .resp-header { display: flex; justify-content: space-between; align-items: center; gap: .5rem; margin-bottom: .35rem; font-size: .78rem; }
  .resp-id { color: #64748b; font-family: monospace; font-size: .7rem; }
  .resp-ts { color: #a78bfa; font-weight: 600; }
  .resp-ts input { display: inline; width: auto; background: transparent; border: none; border-bottom: 1px solid #3d3d5c; color: #a78bfa; font-weight: 600; font-size: .78rem; padding: .1rem .25rem; }
  .resp-ts input:focus { border-color: #7c3aed; }
  .resp-answers { font-size: .75rem; color: #94a3b8; margin-top: .25rem; }
  .resp-answers span { margin-right: .75rem; }
  .toast { position: fixed; bottom: 2rem; right: 2rem; padding: .75rem 1.25rem; border-radius: 10px; color: #fff; font-size: .8rem; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,.3); transform: translateY(100px); opacity: 0; transition: all .3s; z-index: 999; }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast-success { background: #059669; }
  .toast-error { background: #dc2626; }
  .toast-info { background: #7c3aed; }
  .tab-bar { display: flex; gap: 0; border-bottom: 1px solid #2d2d44; margin-bottom: 1rem; }
  .tab-btn { padding: .5rem 1rem; border: none; background: none; cursor: pointer; font-size: .8rem; font-weight: 500; color: #64748b; border-bottom: 2px solid transparent; font-family: inherit; transition: all .15s; }
  .tab-btn:hover { color: #e2e8f0; }
  .tab-btn.active { color: #a78bfa; border-bottom-color: #7c3aed; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .empty { text-align: center; padding: 2rem; color: #64748b; font-size: .85rem; }
  hr { border: none; border-top: 1px solid #2d2d44; margin: .75rem 0; }
  .progress-bar { height: 4px; background: #2d2d44; border-radius: 2px; overflow: hidden; margin-top: .5rem; }
  .progress-bar div { height: 100%; background: #7c3aed; border-radius: 2px; transition: width .3s; }
  @media (max-width: 640px) { .grid-2 { grid-template-columns: 1fr; } .container { padding: .75rem; } }
</style>
</head>
<body>

<div class="topbar">
  <h1>👻 Ghost Panel <span class="badge">Chỉ bạn biết</span></h1>
  <div style="display:flex;gap:.4rem">
    <button class="btn btn-outline btn-sm" onclick="window.location.href='/survey/r/{surveyId}'">📊 Results</button>
    <button class="btn btn-outline btn-sm" onclick="window.location.href='/survey'">📋 Dashboard</button>
  </div>
</div>

<div class="container">
  <div class="card">
    <div class="card-title">📋 Thông tin khảo sát <span class="badge" id="resp-count">0 responses</span></div>
    <p id="survey-title" style="font-size:1.1rem;font-weight:600;color:#e2e8f0">Đang tải...</p>
    <p id="survey-desc" style="font-size:.8rem;color:#64748b;margin-top:.2rem"></p>
  </div>

  <div class="tab-bar">
    <button class="tab-btn active" onclick="switchTab('responses')">📝 Responses</button>
    <button class="tab-btn" onclick="switchTab('timestamps')">🕒 Timestamp Mass Editor</button>
    <button class="tab-btn" onclick="switchTab('generator')">⚡ Fake Generator</button>
  </div>

  <!-- TAB: Responses -->
  <div id="tab-responses" class="tab-content active">
    <div class="card">
      <div class="card-title" style="justify-content:space-between">
        <span>📝 Danh sách responses</span>
        <div style="display:flex;gap:.35rem">
          <button class="btn btn-danger btn-sm" onclick="deleteAllResponses()">🗑️ Xóa tất cả</button>
          <button class="btn btn-outline btn-sm" onclick="refreshResponses()">🔄 Refresh</button>
        </div>
      </div>
      <div id="responses-list"></div>
    </div>
  </div>

  <!-- TAB: Timestamp Mass Editor -->
  <div id="tab-timestamps" class="tab-content">
    <div class="card">
      <div class="card-title">🕒 Chỉnh sửa timestamp hàng loạt</div>
      <div class="grid-2" style="margin-bottom:.75rem">
        <div>
          <label>Dời tất cả timestamp lùi/về trước (giờ)</label>
          <div style="display:flex;gap:.35rem">
            <input type="number" id="shift-hours" value="0" step="1">
            <button class="btn btn-primary btn-sm" onclick="shiftAllTimestamps()">Áp dụng</button>
          </div>
        </div>
        <div>
          <label>Đặt lại timestamp ngẫu nhiên</label>
          <div style="display:flex;gap:.35rem">
            <select id="randomize-range" style="flex:1">
              <option value="day">Trong 1 ngày</option>
              <option value="week">Trong 7 ngày</option>
              <option value="month" selected>Trong 30 ngày</option>
              <option value="custom">Tùy chỉnh</option>
            </select>
            <button class="btn btn-warning btn-sm" onclick="randomizeTimestamps()">🔄 Random</button>
          </div>
        </div>
      </div>
      <hr>
      <div style="font-size:.8rem;color:#64748b">
        ⚠️ Mỗi response có thể chỉnh timestamp riêng ở tab "Responses" — bấm vào ô thời gian để sửa.
      </div>
    </div>
  </div>

  <!-- TAB: Fake Generator -->
  <div id="tab-generator" class="tab-content">
    <div class="card">
      <div class="card-title">⚡ Tạo timestamp giả hàng loạt</div>
      <p style="font-size:.78rem;color:#64748b;margin-bottom:.75rem">Sinh timestamp mới cho tất cả responses, phân bố đều theo khung giờ và khoảng ngày bạn chọn.</p>

      <div class="grid-3">
        <div>
          <label>Từ ngày</label>
          <input type="date" id="gen-date-start">
        </div>
        <div>
          <label>Đến ngày</label>
          <input type="date" id="gen-date-end">
        </div>
        <div>
          <label>Khung giờ (bắt đầu)</label>
          <select id="gen-hour-start">
            <option value="6">6:00</option><option value="7">7:00</option><option value="8">8:00</option>
            <option value="9" selected>9:00</option><option value="10">10:00</option><option value="11">11:00</option>
            <option value="12">12:00</option><option value="13">13:00</option><option value="14">14:00</option>
            <option value="15">15:00</option><option value="16">16:00</option><option value="17">17:00</option>
            <option value="18">18:00</option><option value="19">19:00</option><option value="20">20:00</option>
            <option value="21">21:00</option><option value="22">22:00</option>
          </select>
        </div>
        <div>
          <label>Khung giờ (kết thúc)</label>
          <select id="gen-hour-end">
            <option value="6">6:00</option><option value="7">7:00</option><option value="8">8:00</option>
            <option value="9">9:00</option><option value="10">10:00</option><option value="11">11:00</option>
            <option value="12">12:00</option><option value="13">13:00</option><option value="14">14:00</option>
            <option value="15">15:00</option><option value="16">16:00</option><option value="17">17:00</option>
            <option value="18">18:00</option><option value="19">19:00</option><option value="20">20:00</option>
            <option value="21">21:00</option><option value="22">22:00</option>
            <option value="23" selected>23:00</option>
          </select>
        </div>
        <div>
          <label>Đơn/giờ (tối thiểu)</label>
          <input type="number" id="gen-rate-min" value="1" min="1" max="20">
        </div>
        <div>
          <label>Đơn/giờ (tối đa)</label>
          <input type="number" id="gen-rate-max" value="3" min="1" max="20">
        </div>
        <div style="display:flex;flex-direction:column;justify-content:flex-end">
          <label>Tránh cuối tuần</label>
          <div style="display:flex;gap:.35rem">
            <label style="display:flex;align-items:center;gap:.3rem;font-size:.8rem;color:#94a3b8"><input type="checkbox" id="gen-skip-weekend" checked> Có</label>
            <label style="display:flex;align-items:center;gap:.3rem;font-size:.8rem;color:#94a3b8"><input type="checkbox" id="gen-weight-business"> Ưu tiên giờ hành chính</label>
          </div>
        </div>
      </div>

      <div style="margin-top:1rem;display:flex;gap:.5rem;flex-wrap:wrap">
        <button class="btn btn-primary" onclick="generateFakeTimestamps()">⚡ Tạo timestamp giả</button>
        <button class="btn btn-warning" onclick="generateAndApply()">🚀 Tạo & Áp dụng ngay</button>
        <span style="font-size:.78rem;color:#64748b;display:flex;align-items:center" id="gen-preview"></span>
      </div>
    </div>
  </div>
</div>

<div id="toast" class="toast"></div>

<script>
  const SURVEY_ID = '{surveyId}';
  let responses = [];
  let questions = [];
  let surveyTitle = '';

  function showToast(msg, type) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.className = 'toast toast-' + type;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3500);
  }

  function escHtml(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }
  function escAttr(s) { return (s ?? '').replace(/"/g, '&quot;'); }

  function switchTab(name) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.querySelector(`.tab-btn[onclick*="'${name}'"]`).classList.add('active');
    document.getElementById('tab-' + name).classList.add('active');
  }

  function refreshResponses() { loadData(); }

  async function loadData() {
    try {
      const [surveyRes, respRes] = await Promise.all([
        fetch('/api/survey/' + SURVEY_ID),
        fetch('/api/response?survey_id=' + SURVEY_ID)
      ]);
      const sJson = await surveyRes.json();
      const rJson = await respRes.json();
      if (!sJson.ok) throw new Error(sJson.error);
      questions = sJson.data.questions || [];
      surveyTitle = sJson.data.title || '';
      responses = rJson.data || [];

      document.getElementById('survey-title').textContent = '👻 ' + escHtml(surveyTitle);
      document.getElementById('survey-desc').textContent = escHtml(sJson.data.description || '');
      document.getElementById('resp-count').textContent = responses.length + ' responses';
      renderResponses();

      // Set default dates
      const ds = document.getElementById('gen-date-start');
      const de = document.getElementById('gen-date-end');
      if (!ds.value) { const d = new Date(); d.setDate(d.getDate() - 30); ds.value = d.toISOString().split('T')[0]; }
      if (!de.value) { de.value = new Date().toISOString().split('T')[0]; }
    } catch (e) {
      document.getElementById('responses-list').innerHTML = `<div class="empty">❌ Lỗi: ${escHtml(e.message)}</div>`;
    }
  }

  function renderResponses() {
    const list = document.getElementById('responses-list');
    if (responses.length === 0) {
      list.innerHTML = '<div class="empty">📭 Chưa có response nào</div>';
      return;
    }
    let html = '';
    responses.forEach((r, ri) => {
      const ts = new Date(r.submitted_at);
      const tsStr = ts.toLocaleString('vi-VN');
      const tsISO = r.submitted_at ? new Date(r.submitted_at).toISOString().slice(0,16) : '';
      html += `<div class="resp-item">
        <div class="resp-header">
          <span><span class="resp-id">#${ri + 1}</span></span>
          <span style="display:flex;gap:.35rem;align-items:center">
            <span class="resp-ts">
              🕒 <input type="datetime-local" value="${tsISO}" onchange="updateTimestamp('${r.id}', this.value, ${ri})" id="ts-input-${ri}">
            </span>
            <button class="btn btn-outline btn-sm" onclick="deleteResponse('${r.id}', ${ri})" style="color:#ef4444">✕</button>
          </span>
        </div>`;
      // Show answers summary
      html += `<div class="resp-answers">`;
      questions.slice(0, 3).forEach(q => {
        const val = r.answers?.[q.id];
        if (val !== undefined) html += `<span>${escHtml(q.title)}: <strong>${typeof val === 'number' ? val : escHtml(String(val)).slice(0, 30)}</strong></span>`;
      });
      if (questions.length > 3) html += `<span>… (+${questions.length - 3} câu)</span>`;
      html += `</div></div>`;
    });
    list.innerHTML = html;
  }

  async function updateTimestamp(id, newValue, index) {
    if (!newValue) return;
    const ts = new Date(newValue);
    if (isNaN(ts.getTime())) return;

    const btn = document.getElementById('ts-input-' + index);
    const originalColor = btn.style.borderBottomColor;
    btn.style.borderBottomColor = '#f59e0b';

    try {
      const r = await fetch('/api/response/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ submitted_at: ts.toISOString() })
      });
      const json = await r.json();
      if (json.ok) {
        responses[index].submitted_at = ts.toISOString();
        btn.style.borderBottomColor = '#059669';
        setTimeout(() => btn.style.borderBottomColor = '#3d3d5c', 1000);
      } else throw new Error(json.error);
    } catch (e) {
      showToast('❌ Lỗi: ' + e.message, 'error');
      btn.style.borderBottomColor = originalColor;
    }
  }

  async function deleteResponse(id, index) {
    if (!confirm('Xóa response #' + (index+1) + '?')) return;
    const r = await fetch('/api/response/' + id, { method: 'DELETE' });
    const json = await r.json();
    if (json.ok) {
      responses.splice(index, 1);
      renderResponses();
      document.getElementById('resp-count').textContent = responses.length + ' responses';
    } else alert('Lỗi: ' + json.error);
  }

  async function deleteAllResponses() {
    if (!confirm('Xóa TOÀN BỘ ' + responses.length + ' responses?')) return;
    for (const r of [...responses]) {
      await fetch('/api/response/' + r.id, { method: 'DELETE' });
    }
    responses = [];
    renderResponses();
    document.getElementById('resp-count').textContent = '0 responses';
    showToast('✅ Đã xóa tất cả', 'success');
  }

  async function shiftAllTimestamps() {
    const hours = parseInt(document.getElementById('shift-hours').value) || 0;
    if (hours === 0) { showToast('Nhập số giờ cần dời', 'error'); return; }
    if (!confirm('Dời ' + responses.length + ' responses ' + (hours > 0 ? 'lên ' + hours + ' giờ' : 'xuống ' + Math.abs(hours) + ' giờ') + '?')) return;

    let ok = 0;
    for (const r of responses) {
      const old = new Date(r.submitted_at);
      old.setHours(old.getHours() + hours);
      try {
        await fetch('/api/response/' + r.id, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ submitted_at: old.toISOString() })
        });
        r.submitted_at = old.toISOString();
        ok++;
      } catch(e) {}
    }
    renderResponses();
    showToast('✅ Đã dời ' + ok + '/' + responses.length + ' responses', 'success');
  }

  async function randomizeTimestamps() {
    const range = document.getElementById('randomize-range').value;
    if (!confirm('Randomize timestamp cho ' + responses.length + ' responses?')) return;

    let maxDays = 30;
    if (range === 'day') maxDays = 1;
    else if (range === 'week') maxDays = 7;
    else if (range === 'month') maxDays = 30;
    else if (range === 'custom') {
      const days = prompt('Trong vòng bao nhiêu ngày?', '30');
      if (!days) return;
      maxDays = parseInt(days) || 30;
    }

    const now = Date.now();
    let ok = 0;
    for (const r of responses) {
      const offset = Math.random() * maxDays * 24 * 60 * 60 * 1000;
      const newTs = new Date(now - offset);
      newTs.setHours(7 + Math.floor(Math.random() * 13));
      newTs.setMinutes(Math.floor(Math.random() * 60));
      try {
        await fetch('/api/response/' + r.id, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ submitted_at: newTs.toISOString() })
        });
        r.submitted_at = newTs.toISOString();
        ok++;
      } catch(e) {}
    }
    renderResponses();
    showToast('✅ Đã random ' + ok + '/' + responses.length + ' responses', 'success');
  }

  function generateSchedule() {
    const ds = document.getElementById('gen-date-start').value;
    const de = document.getElementById('gen-date-end').value;
    const hStart = parseInt(document.getElementById('gen-hour-start').value);
    const hEnd = parseInt(document.getElementById('gen-hour-end').value);
    const rateMin = parseInt(document.getElementById('gen-rate-min').value) || 1;
    const rateMax = parseInt(document.getElementById('gen-rate-max').value) || 3;
    const skipWeekend = document.getElementById('gen-skip-weekend').checked;
    const weightBusiness = document.getElementById('gen-weight-business').checked;

    if (!ds || !de) return [];

    const start = new Date(ds);
    const end = new Date(de);
    const schedule = [];
    const n = responses.length;

    for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
      const dow = d.getDay();
      if (skipWeekend && (dow === 0 || dow === 6)) continue;
      const dayStr = d.toISOString().slice(0, 10);

      for (let h = hStart; h <= hEnd; h++) {
        let count = rateMin + Math.floor(Math.random() * (rateMax - rateMin + 1));
        if (weightBusiness && h >= 9 && h <= 17) count = Math.round(count * 1.5);
        if (dow === 6 || dow === 0) count = Math.max(1, Math.round(count * 0.3));

        for (let i = 0; i < count; i++) {
          if (schedule.length >= n) break;
          const minute = Math.floor(Math.random() * 60);
          const second = Math.floor(Math.random() * 60);
          schedule.push(new Date(`${dayStr}T${String(h).padStart(2,'0')}:${String(minute).padStart(2,'0')}:${String(second).padStart(2,'0')}`));
        }
        if (schedule.length >= n) break;
      }
      if (schedule.length >= n) break;
    }

    schedule.sort((a, b) => a - b);
    return schedule;
  }

  function generateFakeTimestamps() {
    const sched = generateSchedule();
    const preview = document.getElementById('gen-preview');
    if (sched.length === 0) {
      preview.textContent = '⚠️ Không có lịch nào được tạo. Kiểm tra lại khoảng ngày.';
      return;
    }
    const first = sched[0].toLocaleDateString('vi-VN');
    const last = sched[sched.length - 1].toLocaleDateString('vi-VN');
    preview.innerHTML = `📋 <b>${sched.length}</b> timestamp: ${first} → ${last}`;
    return sched;
  }

  async function generateAndApply() {
    const sched = generateFakeTimestamps();
    if (!sched || sched.length === 0) { showToast('Không đủ lịch cho ' + responses.length + ' responses', 'error'); return; }
    if (sched.length < responses.length) {
      if (!confirm('⚠️ Chỉ có ' + sched.length + ' mốc thời gian nhưng có ' + responses.length + ' responses. Thiếu ' + (responses.length - sched.length) + '. Tiếp tục?')) return;
    }

    let ok = 0;
    for (let i = 0; i < responses.length; i++) {
      const ts = sched[i % sched.length];
      try {
        await fetch('/api/response/' + responses[i].id, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ submitted_at: ts.toISOString() })
        });
        responses[i].submitted_at = ts.toISOString();
        ok++;
      } catch(e) {}
    }
    renderResponses();
    showToast('✅ Đã áp dụng timestamp cho ' + ok + '/' + responses.length + ' responses', 'success');
    document.getElementById('gen-preview').textContent = '';
  }

  loadData();
</script>

</body></html>
