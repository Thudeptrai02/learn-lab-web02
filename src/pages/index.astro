---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Learn Lab | Nền tảng học tiếng Anh thông minh">
  
  <div id="page-loader" class="fixed inset-0 z-[100] bg-[#030305] flex flex-col items-center justify-center transition-opacity duration-500">
    <div class="h-10 w-10 animate-spin rounded-full border-4 border-slate-800 border-t-teal-400"></div>
  </div>

  <!-- ====== HERO: SPLIT-SCREEN ====== -->
  <section class="relative min-h-[100dvh] flex items-center overflow-hidden py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6 w-full relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        
        <!-- Left: Content -->
        <div class="pt-16 lg:pt-0">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-500/10 text-teal-300 font-bold text-xs mb-8 border border-teal-500/20 shadow-[0_0_15px_rgba(13,222,180,0.1)] reveal">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-400"></span>
            </span>
            Learn Lab 2026 mở cửa tự do
          </div>
          
          <h1 class="text-5xl md:text-7xl lg:text-[5.5rem] font-black text-white tracking-tighter leading-[0.95] reveal stagger-1">
            Chinh phục<br/>
            <span class="bg-gradient-to-r from-teal-300 via-teal-400 to-emerald-300 bg-clip-text text-transparent filter drop-shadow-[0_0_30px_rgba(13,222,180,0.15)]">tiếng Anh</span><br/>
            <span class="text-3xl md:text-4xl lg:text-5xl text-slate-400 font-bold">nhanh gấp 3 lần.</span>
          </h1>
          
          <p class="mt-8 text-base md:text-lg text-slate-400 max-w-lg leading-relaxed reveal stagger-2">
            Hệ thống học tập cá nhân hóa với Flashcard Spaced Repetition và công nghệ kiểm tra lỗi chính tả AI. Trải nghiệm tức thì không cần tài khoản!
          </p>
          
          <div class="mt-10 flex flex-wrap items-center gap-4 reveal stagger-3">
            <a href="/english-lab" class="group btn-premium bg-teal-400 text-neutral-950 shadow-[0_0_35px_rgba(13,222,180,0.25)] hover:bg-teal-300 hover:shadow-[0_0_45px_rgba(13,222,180,0.4)] hover:-translate-y-0.5 px-7 py-3 text-base duration-300 cursor-pointer">
              Bắt đầu miễn phí
              <span class="ml-2 w-7 h-7 rounded-full bg-neutral-950/10 flex items-center justify-center transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-[1px]">
                <svg class="w-4 h-4 text-neutral-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </span>
            </a>
            <a href="/free-resources" class="btn-premium bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white text-slate-300 px-7 py-3 text-base cursor-pointer">
              Tài liệu miễn phí
            </a>
          </div>
        </div>

        <!-- Right: Visual mockup area (Double-Bezel Nesting) -->
        <div class="hidden lg:block relative reveal stagger-2">
          <div class="double-bezel">
            <div class="double-bezel-inner aspect-[4/3] p-8 flex flex-col gap-6">
              
              <!-- Mock Header -->
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-teal-500/20 border border-teal-500/30 flex items-center justify-center">
                  <span class="text-teal-300 font-black text-lg">L</span>
                </div>
                <div class="flex-1 h-3 bg-white/5 rounded-full border border-white/5"></div>
                <div class="w-20 h-3 bg-teal-500/10 rounded-full border border-teal-500/10"></div>
              </div>
              
              <!-- Mock Content Grid -->
              <div class="flex-1 grid grid-cols-2 gap-4">
                <div class="rounded-2xl bg-white/[0.02] border border-white/5 p-4 flex flex-col justify-between">
                  <div class="w-8 h-8 rounded-lg bg-teal-500/20 border border-teal-500/30 flex items-center justify-center">
                    <span class="text-teal-400 text-xs">A</span>
                  </div>
                  <div>
                    <div class="h-2 bg-slate-500/30 rounded-full w-3/4 mb-2"></div>
                    <div class="h-2 bg-slate-500/20 rounded-full w-1/2"></div>
                  </div>
                </div>
                <div class="rounded-2xl bg-white/[0.02] border border-white/5 p-4 flex flex-col justify-between">
                  <div class="w-8 h-8 rounded-lg bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center">
                    <span class="text-indigo-400 text-xs">B</span>
                  </div>
                  <div>
                    <div class="h-2 bg-slate-500/30 rounded-full w-3/4 mb-2"></div>
                    <div class="h-2 bg-slate-500/20 rounded-full w-1/2"></div>
                  </div>
                </div>
                <div class="rounded-2xl bg-white/[0.02] border border-white/5 p-4 col-span-2">
                  <div class="flex gap-3 mb-4">
                    <div class="h-10 w-10 rounded-full bg-teal-500/10 border border-teal-500/20 flex items-center justify-center">
                      <span class="text-teal-400 text-xs">🚀</span>
                    </div>
                    <div class="flex-1">
                      <div class="h-2 bg-slate-500/30 rounded-full w-1/3 mb-2"></div>
                      <div class="h-2 bg-slate-500/20 rounded-full w-1/2"></div>
                    </div>
                  </div>
                  <div class="grid grid-cols-4 gap-2">
                    <div class="aspect-square rounded-xl bg-teal-500/10 border border-teal-500/10 hover:bg-teal-500/20 transition-colors"></div>
                    <div class="aspect-square rounded-xl bg-teal-500/5 border border-teal-500/5 hover:bg-teal-500/15 transition-colors"></div>
                    <div class="aspect-square rounded-xl bg-teal-500/10 border border-teal-500/10 hover:bg-teal-500/20 transition-colors"></div>
                    <div class="aspect-square rounded-xl bg-teal-500/5 border border-teal-500/5 hover:bg-teal-500/15 transition-colors"></div>
                  </div>
                </div>
              </div>

            </div>
          </div>
          <!-- Ambient Glow under mockup -->
          <div class="absolute -inset-4 bg-teal-500/5 rounded-[2.5rem] blur-2xl -z-10"></div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== PILL NAV: TRUY CẬP NHANH ====== -->
  <div class="sticky top-20 z-40 bg-neutral-950/60 backdrop-blur-xl border-y border-white/5 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 py-4 overflow-x-auto scrollbar-none">
      <div class="flex gap-3 min-w-max justify-center md:justify-start">
        <a href="/english-lab/cambridge" class="shrink-0 px-5 py-2.5 rounded-full bg-teal-500 text-neutral-950 font-bold text-xs shadow-lg shadow-teal-500/20 hover:bg-teal-400 transition-colors">Cambridge</a>
        <a href="/english-lab/toeic/flashcards" class="shrink-0 px-5 py-2.5 rounded-full bg-white/5 border border-white/5 text-slate-300 font-bold text-xs hover:bg-white/10 hover:text-white transition-colors">Flashcards</a>
        <a href="/english-lab/toeic/dictation" class="shrink-0 px-5 py-2.5 rounded-full bg-white/5 border border-white/5 text-slate-300 font-bold text-xs hover:bg-white/10 hover:text-white transition-colors">Dictation</a>
        <a href="/lego" class="shrink-0 px-5 py-2.5 rounded-full bg-white/5 border border-white/5 text-slate-300 font-bold text-xs hover:bg-white/10 hover:text-white transition-colors">Lego Grammar</a>
        <a href="/english-lab/ielts" class="shrink-0 px-5 py-2.5 rounded-full bg-white/5 border border-white/5 text-slate-300 font-bold text-xs hover:bg-white/10 hover:text-white transition-colors">IELTS</a>
        <a href="/english-lab/toeic" class="shrink-0 px-5 py-2.5 rounded-full bg-white/5 border border-white/5 text-slate-300 font-bold text-xs hover:bg-white/10 hover:text-white transition-colors">TOEIC</a>
        <a href="/zen-mode" class="shrink-0 px-5 py-2.5 rounded-full bg-white/5 border border-white/5 text-slate-300 font-bold text-xs hover:bg-white/10 hover:text-white transition-colors">Zen Mode</a>
        <a href="/video-generator" class="shrink-0 px-5 py-2.5 rounded-full bg-emerald-500/15 border border-emerald-500/25 text-emerald-300 font-bold text-xs hover:bg-emerald-500/30 hover:text-white transition-colors">Video AI</a>
      </div>
    </div>
  </div>

  <!-- ====== BENTO GRID: HỆ SINH THÁI ====== -->
  <section class="py-32 relative">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      
      <div class="mb-20 reveal">
        <span class="text-[10px] uppercase tracking-[0.2em] font-black text-teal-400 bg-teal-500/10 px-3.5 py-1.5 rounded-full border border-teal-500/20">Học tập hiệu quả</span>
        <h2 class="text-4xl md:text-6xl font-black text-white tracking-tight mt-6 leading-tight">
          Hệ sinh thái<br/>
          <span class="bg-gradient-to-r from-teal-300 to-emerald-300 bg-clip-text text-transparent">English Lab</span>
        </h2>
        <p class="mt-4 text-base md:text-lg text-slate-400 max-w-lg leading-relaxed">Bộ công cụ toàn diện hỗ trợ bạn tối ưu hóa từ vựng, ngữ pháp, phản xạ nghe và kỹ năng làm bài.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Cambridge Tests - Featured (col-span-2) -->
        <a href="/english-lab/cambridge" class="group relative lg:col-span-2 rounded-[28px] overflow-hidden min-h-[340px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(13,222,180,0.1)] border border-white/5 bg-gradient-to-br from-teal-950/20 via-neutral-950/70 to-slate-950/40 p-1.5 reveal stagger-1">
          <div class="relative w-full h-full rounded-[22px] bg-neutral-950/50 p-8 md:p-10 flex flex-col justify-end overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-tr from-teal-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            
            <div class="mb-6 inline-flex w-12 h-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            </div>
            <h3 class="text-3xl font-black text-white mb-3">Cambridge Tests</h3>
            <p class="text-slate-400 max-w-md mb-8 leading-relaxed text-sm md:text-base">Luyện thi KET, PET, FCE trực quan với hệ thống tự động chấm điểm và giải thích đáp án chi tiết.</p>
            <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:text-teal-300 group-hover:gap-3.5 transition-all duration-300">
              Khám phá ngay
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </span>
            <div class="absolute -top-10 -right-10 w-48 h-48 bg-teal-500/10 rounded-full blur-3xl opacity-50 group-hover:opacity-80 transition-opacity duration-700"></div>
          </div>
        </a>

        <!-- Smart Flashcards -->
        <a href="/english-lab/toeic/flashcards" class="group relative rounded-[28px] overflow-hidden min-h-[340px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/5 bg-neutral-950/40 p-1.5 reveal stagger-2">
          <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
            <div class="mb-6 inline-flex w-12 h-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" /></svg>
            </div>
            <h3 class="text-2xl font-black text-white mb-2">Smart Flashcards</h3>
            <p class="text-slate-400 mb-8 leading-relaxed text-sm">Học từ vựng khoa học theo phương pháp lặp lại ngắt quãng (Spaced Repetition).</p>
            <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
              Học ngay
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </span>
          </div>
        </a>

        <!-- Pro Dictation -->
        <a href="/english-lab/toeic/dictation" class="group relative rounded-[28px] overflow-hidden min-h-[340px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/5 bg-neutral-950/40 p-1.5 reveal stagger-2">
          <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
            <div class="mb-6 inline-flex w-12 h-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /></svg>
            </div>
            <h3 class="text-2xl font-black text-white mb-2">Dictation</h3>
            <p class="text-slate-400 mb-8 leading-relaxed text-sm">Luyện nghe chép chính tả với trình kiểm tra lỗi tự động ngay khi gõ.</p>
            <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
              Luyện ngay
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </span>
          </div>
        </a>

        <!-- Lego Grammar -->
        <a href="/lego" class="group relative rounded-[28px] overflow-hidden min-h-[340px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(16,185,129,0.1)] border border-white/5 bg-gradient-to-br from-emerald-950/20 via-neutral-950/70 to-slate-950/40 p-1.5 reveal stagger-3">
          <div class="relative w-full h-full rounded-[22px] bg-[#0c0c12]/50 p-8 flex flex-col justify-end overflow-hidden">
            <div class="absolute inset-0 bg-[url('https://picsum.photos/seed/lego-grammar/800/600')] bg-cover bg-center opacity-5 mix-blend-overlay"></div>
            <div class="mb-6 inline-flex w-12 h-12 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 group-hover:bg-emerald-500 group-hover:text-neutral-950 transition-colors duration-500">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
            </div>
            <h3 class="text-2xl font-black text-white mb-2">Lego Grammar</h3>
            <p class="text-slate-400 mb-8 leading-relaxed text-sm">Học cấu trúc ngữ pháp thông qua việc lắp ghép các khối từ S-V-O trực quan.</p>
            <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
              Chơi ngay
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </span>
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-emerald-500/5 rounded-full blur-3xl opacity-60"></div>
          </div>
        </a>

        <!-- TOEIC Master -->
        <a href="/english-lab/toeic" class="group relative rounded-[28px] overflow-hidden min-h-[340px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/5 bg-neutral-950/40 p-1.5 reveal stagger-3">
          <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
            <div class="mb-6 inline-flex w-12 h-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
            </div>
            <h3 class="text-2xl font-black text-white mb-2">TOEIC Master</h3>
            <p class="text-slate-400 mb-8 leading-relaxed text-sm">Kho đề thi thử TOEIC chuẩn hóa, cập nhật liên tục kèm giải thích từ giáo viên.</p>
            <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
              Luyện thi
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </span>
          </div>
        </a>

        <!-- IELTS Pro -->
        <a href="/english-lab/ielts" class="group relative rounded-[28px] overflow-hidden min-h-[340px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/5 bg-neutral-950/40 p-1.5 reveal stagger-3">
          <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
            <div class="mb-6 inline-flex w-12 h-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
            </div>
            <h3 class="text-2xl font-black text-white mb-2">IELTS Pro</h3>
            <p class="text-slate-400 mb-8 leading-relaxed text-sm">Luyện tập kỹ năng đọc và tích lũy vốn từ vựng chuyên sâu phục vụ kỳ thi IELTS.</p>
            <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
              Khám phá
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </span>
          </div>
        </a>

        <!-- Video AI Generator -->
        <a href="/video-generator" class="group relative rounded-[28px] overflow-hidden min-h-[340px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(16,185,129,0.15)] border border-white/5 bg-gradient-to-br from-teal-950/30 via-neutral-950/70 to-slate-950/40 p-1.5 reveal stagger-3">
          <div class="relative w-full h-full rounded-[22px] bg-[#0c0c12]/50 p-8 flex flex-col justify-end overflow-hidden">
