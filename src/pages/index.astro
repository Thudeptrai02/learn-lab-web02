---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Learn Lab | Nền tảng tiếng Anh thông minh">
  
  {/* Màn hình Loading mỏng nhẹ */}
  <div id="page-loader" class="fixed inset-0 z-[100] bg-white flex flex-col items-center justify-center transition-opacity duration-500">
    <div class="h-10 w-10 animate-spin rounded-full border-4 border-slate-200 border-t-teal-600"></div>
  </div>

  {/* PHẦN 1: MÀN HÌNH CHÀO KHÁCH (Đã bỏ cái Nav rác của tôi, giữ nguyên Layout của sếp) */}
  <div class="relative pt-12 pb-20 overflow-hidden">
    <div class="absolute top-0 inset-x-0 h-64 bg-gradient-to-b from-teal-50/50 to-transparent -z-10"></div>
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-50 text-teal-700 font-bold text-sm mb-8 border border-teal-100 shadow-sm">
        <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"></span></span>
        Learn Lab 2026 mở cửa tự do
      </div>
      <h1 class="text-5xl md:text-7xl font-black text-slate-900 tracking-tight leading-[1.15]">
        Chinh phục tiếng Anh <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-emerald-500">nhanh gấp 3 lần.</span>
      </h1>
      <p class="mt-6 text-lg text-slate-600 max-w-2xl mx-auto font-medium leading-relaxed">
        Hệ thống học tập cá nhân hóa với Flashcard Spaced Repetition và công nghệ check lỗi chính tả AI. Không cần tài khoản vẫn trải nghiệm được!
      </p>
    </div>
  </div>

  {/* PHẦN 2: BẢNG ĐIỀU KHIỂN CÔNG CỤ */}
  <div class="flex-grow bg-slate-50 border-t border-slate-200">
    <div class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-6 py-10">
        <h1 class="text-3xl font-black text-slate-900">
          Sẵn sàng học tập, <span id="dash-username" class="text-teal-600">bạn nhé</span>! 🚀
        </h1>
        <p class="mt-2 text-slate-500 font-medium text-sm">Chọn một công cụ bên dưới để bắt đầu luyện tập ngay lập tức.</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        {/* Nút vào thi Cambridge */}
        <a href="/english-lab/cambridge" class="group bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover:shadow-xl hover:shadow-emerald-100 hover:border-emerald-300 transition-all hover:-translate-y-1 relative overflow-hidden">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-6 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Cambridge Tests</h3>
          <p class="text-slate-500 text-sm font-medium leading-relaxed mb-6">Luyện thi KET, PET, FCE với hệ thống tự động chấm điểm.</p>
          <span class="text-emerald-600 font-bold text-sm flex items-center gap-1 group-hover:gap-2 transition-all">Vào thi ngay <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
        </a>

        {/* Nút học Flashcards */}
        <a href="/english-lab/toeic/flashcards" class="group bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover:shadow-xl hover:shadow-teal-100 hover:border-teal-300 transition-all hover:-translate-y-1 relative overflow-hidden">
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center mb-6 group-hover:bg-teal-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Smart Flashcards</h3>
          <p class="text-slate-500 text-sm font-medium leading-relaxed mb-6">Ôn tập từ vựng ngắt quãng giúp nhớ lâu, quên chậm.</p>
          <span class="text-teal-600 font-bold text-sm flex items-center gap-1 group-hover:gap-2 transition-all">Học ngay <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
        </a>

        {/* Nút luyện Dictation */}
        <a href="/english-lab/toeic/dictation" class="group bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover:shadow-xl hover:shadow-sky-100 hover:border-sky-300 transition-all hover:-translate-y-1 relative overflow-hidden">
          <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center mb-6 group-hover:bg-sky-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Pro Dictation</h3>
          <p class="text-slate-500 text-sm font-medium leading-relaxed mb-6">Luyện nghe chép chính tả với Audio cắt sẵn từng câu.</p>
          <span class="text-sky-600 font-bold text-sm flex items-center gap-1 group-hover:gap-2 transition-all">Luyện nghe <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
        </a>

        {/* Nút chơi Lego Grammar */}
        <a href="/lego" class="group bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover:shadow-xl hover:shadow-amber-100 hover:border-amber-300 transition-all hover:-translate-y-1 relative overflow-hidden">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center mb-6 group-hover:bg-amber-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Lego Grammar</h3>
          <p class="text-slate-500 text-sm font-medium leading-relaxed mb-6">Nắm chắc ngữ pháp qua việc lắp ghép các khối từ.</p>
          <span class="text-amber-600 font-bold text-sm flex items-center gap-1 group-hover:gap-2 transition-all">Chơi ngay <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
        </a>

      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  const loader = document.getElementById('page-loader');
  const dashUsername = document.getElementById('dash-username');

  async function initPage() {
    const { data: { session } } = await supabase.auth.getSession();
    
    // Tắt loading
    if (loader) {
      loader.classList.add('opacity-0');
      setTimeout(() => loader.classList.add('hidden'), 300);
    }

    if (session) {
      // Đã login thì đổi chữ "bạn nhé" thành Tên học viên
      const name = session.user.user_metadata?.fullname || session.user.email.split('@')[0];
      if (dashUsername) dashUsername.textContent = name;
    }
  }

  initPage();
</script>