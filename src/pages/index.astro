---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bảng điều khiển | Learn Lab">
  <main class="min-h-screen bg-slate-50">
    
    <div id="loading-screen" class="flex flex-col items-center justify-center min-h-screen">
       <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-teal-600"></div>
       <p class="mt-4 text-slate-500 font-medium">Đang chuẩn bị phòng học...</p>
    </div>

    <div id="dashboard-content" class="hidden">
      <header class="bg-white border-b border-slate-200 px-6 py-8">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
          <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">
              Chào mừng trở lại, <span id="user-name" class="text-teal-600">Học viên</span>! 👋
            </h1>
            <p class="text-slate-500 text-sm mt-1">Hôm nay sếp định chinh phục bài Test nào?</p>
          </div>
          <button id="logout-btn" class="text-xs font-bold text-slate-400 hover:text-rose-500 transition-colors uppercase tracking-widest border border-slate-200 px-4 py-2 rounded-xl">
            Đăng xuất
          </button>
        </div>
      </header>

      <section class="max-w-6xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          
          <a href="/english-lab/toeic/flashcards" class="group relative overflow-hidden rounded-3xl bg-white p-8 shadow-sm border-2 border-slate-100 transition-all hover:border-teal-500 hover:shadow-xl hover:-translate-y-2">
            <div class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-50 text-teal-600 group-hover:bg-teal-600 group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Từ Vựng (Flashcards)</h3>
            <p class="mt-2 text-slate-500 text-sm leading-relaxed">Ghi nhớ từ vựng TOEIC bằng phương pháp Spaced Repetition cực kỳ hiệu quả.</p>
            <div class="mt-6 flex items-center text-sm font-bold text-teal-600">
              Vào học ngay <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </div>
          </a>

          <a href="/lego" class="group relative overflow-hidden rounded-3xl bg-white p-8 shadow-sm border-2 border-slate-100 transition-all hover:border-amber-500 hover:shadow-xl hover:-translate-y-2">
            <div class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-50 text-amber-600 group-hover:bg-amber-600 group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Lego Grammar 🧱</h3>
            <p class="mt-2 text-slate-500 text-sm leading-relaxed">Học ngữ pháp theo phong cách xếp hình. Lắp ghép các khối để tạo thành câu chuẩn.</p>
            <div class="mt-6 flex items-center text-sm font-bold text-amber-600">
              Thử thách ngay <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </div>
          </a>

          <a href="/english-lab/toeic/dictation" class="group relative overflow-hidden rounded-3xl bg-white p-8 shadow-sm border-2 border-slate-100 transition-all hover:border-indigo-500 hover:shadow-xl hover:-translate-y-2">
            <div class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Chép Chính Tả (Dictation)</h3>
            <p class="mt-2 text-slate-500 text-sm leading-relaxed">Tăng khả năng nghe sâu bằng cách gõ lại từng câu. Có Audio cắt sẵn từng giây.</p>
            <div class="mt-6 flex items-center text-sm font-bold text-indigo-600">
              Bắt đầu nghe <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </div>
          </a>

        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  const loadingScreen = document.getElementById('loading-screen');
  const dashboardContent = document.getElementById('dashboard-content');
  const userNameEl = document.getElementById('user-name');
  const logoutBtn = document.getElementById('logout-btn');

  async function checkUser() {
    try {
      // 1. Kiểm tra session từ Supabase
      const { data: { session }, error } = await supabase.auth.getSession();

      // 2. Nếu chưa đăng nhập hoặc lỗi kết nối -> Đá ra trang login ngay lập tức
      if (error || !session) {
        console.warn("Chưa đăng nhập, chuyển hướng...");
        window.location.href = "/login";
        return; 
      }

      // 3. Nếu đã đăng nhập thành công -> Lấy tên user
      const meta = session.user.user_metadata;
      const fullName = meta?.full_name || session.user.email?.split('@')[0] || "Học viên";
      
      if (userNameEl) userNameEl.textContent = fullName;

      // 4. CHỐT HẠ: Tắt vòng xoay và hiện dashboard
      loadingScreen?.classList.add('hidden');
      dashboardContent?.classList.remove('hidden');

    } catch (err) {
      // Nếu có lỗi hệ thống (ví dụ Supabase URL sai) -> Vẫn cho ra login để web không bị treo
      console.error("Lỗi script:", err);
      window.location.href = "/login";
    }
  }

  // Chạy ngay khi tải trang
  checkUser();

  // Xử lý nút đăng xuất
  logoutBtn?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = "/login";
  });
</script>