---
import Layout from '../../../layouts/Layout.astro';

// DỮ LIỆU ĐÃ ĐƯỢC TÔI LỌC SẠCH VÀ NHÚNG THẲNG VÀO ĐÂY
const testData = {
  title: "KET (A2) READING & WRITING - TEST 01",
  parts: [
    {
      name: "PART 1",
      instruction: "For each question, choose the correct answer.",
      type: "multiple-choice",
      questions: [
        { id: 1, text: "Please note: this afternoon's football class will be tomorrow instead, as Mr Hall is away today.", a: "There is no football class today.", b: "Mr Hall can't come to the football class tomorrow.", c: "You can choose to go to the football class today or tomorrow.", ans: "A" },
        { id: 2, text: "Hi Jane, Have you finished with that book I lent you? It's just that my brother needs it for a school project. Thanks, Louise", a: "Louise is offering to lend Jane a book.", b: "Louise wants her book back from Jane.", c: "Louise's brother has borrowed a book from Jane.", ans: "B" },
        { id: 3, text: "Picnic area: No ball games here – please use the other side of the park.", a: "You can buy food somewhere else in the park.", b: "Please don't eat while you are playing sport here.", c: "This is a place for eating and you can't play football here.", ans: "C" },
        { id: 4, text: "Museum open from 12. Children must be with an adult.", a: "Adults can take children to the museum in the morning.", b: "Adults with children over 12 will enjoy the museum.", c: "Children can visit the museum if they are with an adult.", ans: "C" },
        { id: 5, text: "From: Mrs Monmouth. Hello, This week, please don't use the car to get to school. Coming on foot is healthy and doesn't take much time.", a: "to ask pupils to walk to school", b: "to tell pupils to get to school on time", c: "to explain about a health problem at school", ans: "A" },
        { id: 6, text: "Pedro's Pizza Bar: Buy two pizzas at the same time, and we'll give you a third one for free! Mon-Fri only.", a: "Pedro's Pizza Bar isn't open at weekends", b: "The third time you visit, you get a free pizza.", c: "Three pizzas cost the same as two.", ans: "C" }
      ]
    },
    {
      name: "PART 2",
      instruction: "For each question, choose the correct answer (A, B, or C).",
      type: "matching",
      passage: `
        <div class="grid md:grid-cols-3 gap-4 text-sm">
          <div class="bg-blue-50 p-4 rounded-lg"><strong>A. Eureka!</strong><br>Hands-on experience, visitors can pick up any object. Buy a ticket and come back for free for a year. Next to Halifax station.</div>
          <div class="bg-green-50 p-4 rounded-lg"><strong>B. Museum of Museums</strong><br>Things are lent by other museums. Lots of vehicles (ice-cream vans, motorbikes, public transport).</div>
          <div class="bg-yellow-50 p-4 rounded-lg"><strong>C. Cinema Museum</strong><br>Bought things from cinemas closing down (posters, wooden seating, uniforms). Need to book a guide for an organised tour.</div>
        </div>
      `,
      questions: [
        { id: 7, text: "Which museum has an exhibition of clothes?", ans: "C" },
        { id: 8, text: "Which museum is full of things which visitors can touch?", ans: "A" },
        { id: 9, text: "Which museum is a good place to learn about how people travelled in the past?", ans: "B" },
        { id: 10, text: "Which museum can you visit again for free after you pay once?", ans: "A" },
        { id: 11, text: "Which museum do you need to contact before you visit?", ans: "C" },
        { id: 12, text: "Which museum shows things that were borrowed from other places?", ans: "B" },
        { id: 13, text: "Which museum has some furniture which wasn't needed any more?", ans: "C" }
      ]
    },
    {
      name: "PART 3",
      instruction: "Read the blog and choose the correct answer.",
      type: "multiple-choice-long",
      passage: `
        <div class="bg-slate-50 p-6 rounded-xl border-l-4 border-teal-500 italic">
          <h3 class="font-bold mb-2">Will's blog</h3>
          <p>My dad said, 'Why don't we have a street party?'... I helped to make the web page... It was interesting to see that the buildings on the street haven't changed at all! My mum was a bit worried... but the party was fantastic! I really liked speaking to an old lady called Louisa...</p>
        </div>
      `,
      questions: [
        { id: 14, text: "Why was Will surprised?", a: "His father wanted to have a street party.", b: "There hasn't been a street party for a long time.", c: "Many people remembered the last street party.", ans: "B" },
        { id: 15, text: "What did the photos from 1977 show?", a: "The street still looks the same now.", b: "There are more children living in the street now.", c: "The same people still live on the street now.", ans: "A" },
        { id: 16, text: "Why was Will's mother worried?", a: "She thought that the party was too expensive.", b: "She thought that people might not come to the party.", c: "She thought that the guests might not talk to each other.", ans: "C" },
        { id: 17, text: "Will and his friends enjoyed", a: "hearing Louisa's stories.", b: "meeting Louisa's friends.", c: "telling Louisa about their lives.", ans: "A" },
        { id: 18, text: "What is the best title for the article?", a: "Why I love street parties", b: "The street party we had", c: "How to have a street party.", ans: "B" }
      ]
    },
    {
      name: "PART 4",
      instruction: "Choose the correct word for each gap.",
      type: "multiple-choice",
      passage: "<p class='font-medium'>Red pandas live in Nepal... as (19) _____ as in China. They (20) _____ a lot of their time in trees... Scientists believe the number is (24) _____ because forests are smaller.</p>",
      questions: [
        { id: 19, text: "19. Nepal, Myanmar, India and Bhutan, as ____ as in China.", a: "soon", b: "much", c: "well", ans: "C" },
        { id: 20, text: "20. They ____ a lot of their time in trees.", a: "spend", b: "live", c: "take", ans: "A" },
        { id: 24, text: "24. The number of red pandas is ____ because forests are smaller.", a: "little", b: "low", c: "short", ans: "B" }
      ]
    },
    {
      name: "PART 5",
      instruction: "Write ONE word for each gap.",
      type: "fill-blank",
      passage: "<div class='bg-yellow-50 p-4 border border-yellow-200 rounded'>Dear Aunt Nel, Thank you very much (0) for the book... kind (25) ____ you. I'm really interested (27) ____ that kind of thing... I go back (29) ____ school next week.</div>",
      questions: [
        { id: 25, text: "25. It was very kind ____ you.", ans: "OF" },
        { id: 27, text: "27. I'm really interested ____ that kind of thing.", ans: "IN" },
        { id: 29, text: "29. I go back ____ school next week.", ans: "TO" }
      ]
    },
    {
      name: "PART 6",
      instruction: "Write 25 words or more.",
      type: "writing",
      text: "From Francis: Hi, It's great to meet you this weekend. Where is the best place to meet? What would you like to do? Shall I bring anything?"
    },
    {
      name: "PART 7",
      instruction: "Look at the three pictures. Write the story (35 words or more).",
      type: "writing",
      image: "https://englishpracticetest.net/wp-content/uploads/2022/01/ket-practice-reading-and-writing-test-01-part-7.jpg"
    }
  ]
};

const allAnswers = {};
testData.parts.forEach(p => p.questions?.forEach(q => allAnswers[q.id] = q.ans));
---

<Layout title={testData.title}>
  <div class="fixed top-0 left-0 w-full z-50 bg-white/80 backdrop-blur-md border-b-2 border-slate-900 py-3 px-6 flex justify-between items-center shadow-sm">
    <h1 class="font-black text-slate-900 uppercase tracking-tighter text-sm md:text-lg">{testData.title}</h1>
    <div class="flex items-center gap-4">
      <div id="score-circle" class="w-10 h-10 bg-slate-900 text-white rounded-full flex items-center justify-center font-black text-lg shadow-lg">--</div>
      <button id="finish-btn" class="bg-teal-600 text-white px-6 py-2 rounded-full font-black text-sm hover:bg-teal-700 transition-all active:scale-95 shadow-md">NỘP BÀI</button>
    </div>
  </div>

  <main class="max-w-4xl mx-auto pt-24 pb-32 px-4 md:px-0">
    <div id="ans-store" class="hidden" data-ans={JSON.stringify(allAnswers)}></div>

    {testData.parts.map((part) => (
      <section class="mb-16 animate-in fade-in slide-in-from-bottom-4 duration-700">
        <div class="inline-block bg-slate-900 text-white px-4 py-1 rounded-t-lg font-black text-xs tracking-widest mb-0 uppercase">{part.name}</div>
        <div class="bg-white border-4 border-slate-900 p-6 md:p-10 rounded-b-2xl rounded-tr-2xl shadow-[8px_8px_0px_0px_rgba(15,23,42,1)]">
          <p class="text-slate-500 font-bold italic mb-8 text-sm md:text-base">" {part.instruction} "</p>

          {part.passage && <div class="mb-10 p-5 bg-white border-2 border-slate-100 rounded-2xl shadow-inner leading-relaxed text-slate-700" set:html={part.passage}></div>}
          {part.image && <img src={part.image} class="w-full max-w-lg mx-auto mb-10 rounded-xl shadow-lg border-2 border-slate-900" />}
          {part.text && <div class="mb-8 p-5 bg-teal-50 border-2 border-teal-200 rounded-xl font-medium text-teal-900 italic" set:html={part.text}></div>}

          <div class="space-y-12">
            {part.questions?.map((q) => (
              <div class="q-container relative group">
                <div class="flex items-start gap-4">
                  <span class="bg-slate-900 text-white w-8 h-8 flex items-center justify-center font-black rounded-lg shrink-0 shadow-sm">{q.id}</span>
                  <div class="flex-1">
                    <p class="text-lg font-bold text-slate-800 mb-6 leading-snug" set:html={q.text}></p>
                    
                    {part.type !== 'fill-blank' ? (
                      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        {['A', 'B', 'C'].map((opt) => (
                          <label class="ans-label cursor-pointer flex items-center gap-3 p-4 border-2 border-slate-100 rounded-xl hover:border-teal-500 hover:bg-teal-50/50 transition-all duration-200 relative overflow-hidden group/opt">
                            <input type="radio" name={`q-${q.id}`} value={opt} data-q={q.id} class="sr-only choice-radio" />
                            <div class="w-6 h-6 border-2 border-slate-200 rounded-full flex items-center justify-center group-hover/opt:border-teal-500 transition-colors radio-circle">
                               <div class="w-3 h-3 bg-teal-500 rounded-full opacity-0 transition-opacity dot"></div>
                            </div>
                            <span class="text-slate-700 font-bold">{opt}. <span class="font-medium text-slate-600">{q[opt.toLowerCase()] || ''}</span></span>
                          </label>
                        ))}
                      </div>
                    ) : (
                      <input type="text" data-q={q.id} class="fill-input w-full max-w-xs p-4 border-4 border-slate-100 rounded-xl font-black text-center uppercase tracking-widest focus:border-teal-500 outline-none transition-all placeholder:text-slate-200" placeholder="..." />
                    )}
                  </div>
                </div>
              </div>
            ))}

            {part.type === 'writing' && (
              <div class="mt-4 writing-box">
                <textarea class="w-full h-48 p-6 bg-slate-50 border-2 border-slate-100 rounded-2xl outline-none focus:border-teal-500 transition-all font-medium text-slate-700 leading-relaxed shadow-inner" placeholder="Type your response here..."></textarea>
                <button class="ai-check-btn mt-4 w-full bg-slate-900 text-white font-black py-4 rounded-xl hover:bg-teal-600 transition-all shadow-md active:scale-[0.98]">CHẤM ĐIỂM BẰNG AI ✨</button>
              </div>
            )}
          </div>
        </div>
      </section>
    ))}
  </main>
</Layout>

<script is:inline>
  const ANSWERS = JSON.parse(document.getElementById('ans-store').getAttribute('data-ans'));

  document.getElementById('finish-btn').onclick = function() {
    let score = 0;
    
    // Chấm trắc nghiệm
    document.querySelectorAll('.choice-radio').forEach(input => {
      const qId = input.getAttribute('data-q');
      const label = input.closest('.ans-label');
      const dot = label.querySelector('.dot');
      
      if (input.checked) {
        if (input.value === ANSWERS[qId]) {
          score++;
          label.classList.add('border-green-500', 'bg-green-50');
        } else {
          label.classList.add('border-red-500', 'bg-red-50');
        }
      }
      if (input.value === ANSWERS[qId]) {
        label.classList.add('border-green-500');
        dot.classList.remove('opacity-0');
      }
    });

    // Chấm điền từ
    document.querySelectorAll('.fill-input').forEach(input => {
      const qId = input.getAttribute('data-q');
      const val = input.value.trim().toUpperCase();
      if (val === ANSWERS[qId]) {
        score++;
        input.classList.add('border-green-500', 'bg-green-50', 'text-green-700');
      } else {
        input.classList.add('border-red-500', 'bg-red-50', 'text-red-700');
        input.value = `${val} (Correct: ${ANSWERS[qId]})`;
      }
    });

    document.getElementById('score-circle').innerText = score;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Logic AI chấm bài (Sếp cần config API endpoint này sau)
  document.querySelectorAll('.ai-check-btn').forEach(btn => {
    btn.onclick = () => alert("Tính năng chấm AI đang được kết nối với server LearnLab của sếp!");
  });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');
  body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
  .ans-label:has(input:checked) { border-color: #0d9488; background-color: #f0fdfa; }
  .ans-label:has(input:checked) .dot { opacity: 1; }
  .ans-label:has(input:checked) .radio-circle { border-color: #0d9488; }
</style>