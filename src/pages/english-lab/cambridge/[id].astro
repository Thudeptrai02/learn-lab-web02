---
import Layout from '../../../layouts/Layout.astro';
export const prerender = true;

export async function getStaticPaths() {
  const jsonFiles = import.meta.glob('../../../data/cambridge/*.json', { eager: true });
  return Object.values(jsonFiles).map((test: any) => ({
    params: { id: test.default.test_id },
    props: { test: test.default }
  }));
}
const { test } = Astro.props;
---

<Layout title={test.title}>
  <div class="h-screen flex flex-col bg-[#F3F4F6] font-['Plus_Jakarta_Sans',sans-serif] overflow-hidden">
    <header class="h-14 bg-slate-900 text-white flex items-center justify-between px-6 shrink-0 shadow-xl z-50">
      <div class="flex items-center gap-4">
        <span class="bg-emerald-500 text-slate-900 px-2 py-0.5 rounded font-black text-[10px]">A2 KEY</span>
        <h1 class="text-sm font-bold tracking-tight opacity-90">{test.title}</h1>
      </div>
      <div class="flex items-center gap-8">
        <div class="flex items-center gap-2 border-r border-slate-700 pr-6">
          <span class="text-[9px] uppercase opacity-50 font-black">Score</span>
          <span id="score" class="text-xl font-black text-emerald-400 leading-none">--</span>
        </div>
        <button id="submit" class="bg-emerald-500 hover:bg-emerald-400 text-slate-900 px-6 py-2 rounded-lg font-bold text-xs transition-all uppercase tracking-widest active:scale-95">Finish Test</button>
      </div>
    </header>

    <div class="flex-1 flex overflow-hidden">
      <aside class="w-1/2 overflow-y-auto p-8 md:p-12 bg-white border-r border-slate-200 custom-scroll">
        <div class="max-w-xl ml-auto">
          {test.parts.map((part) => (
            <div class="mb-20 last:mb-0">
              <div class="flex items-center gap-3 mb-8">
                <span class="bg-slate-100 text-slate-500 px-3 py-1 rounded font-black text-[9px] uppercase tracking-[0.2em]">{part.part_name}</span>
                <div class="h-px flex-1 bg-slate-100"></div>
              </div>

              {/* HIỂN THỊ BIỂN BÁO (Dành cho Part 1) */}
              {part.notices && part.notices.length > 0 && (
                <div class="space-y-6 mb-10">
                  {part.notices.map((notice) => (
                    <div class="notice-box bg-yellow-50 p-6 border-2 border-slate-200 rounded-lg shadow-sm text-center font-bold text-slate-800 text-lg leading-snug" set:html={notice} />
                  ))}
                </div>
              )}

              {/* HIỂN THỊ VĂN BẢN BÀI ĐỌC (Dành cho các Part còn lại) */}
              <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed text-lg italic" set:html={part.passage} />
            </div>
          ))}
        </div>
      </aside>

      <section class="w-1/2 overflow-y-auto p-8 md:p-12 bg-slate-50 custom-scroll">
        <div class="max-w-md">
          {test.parts.map((part) => (
            <div class="mb-16">
              <h3 class="text-[10px] font-black text-indigo-500 mb-8 uppercase tracking-[0.3em] border-l-4 border-indigo-500 pl-4">Answer Sheet - {part.part_name}</h3>
              <div class="space-y-8">
                {part.questions?.map((q) => (
                  <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 group">
                    <div class="flex gap-4 mb-6">
                      <span class="w-8 h-8 bg-slate-900 text-white flex items-center justify-center rounded-lg font-black text-sm shrink-0">{q.id}</span>
                      <p class="font-bold text-slate-800 leading-snug" set:html={q.text}></p>
                    </div>
                    
                    {/* KIỂM TRA NẾU CÓ OPTIONS THÌ HIỆN TRẮC NGHIỆM */}
                    {q.options ? (
                      <div class="grid grid-cols-1 gap-2">
                        {Object.entries(q.options).map(([key, val]) => (
                          <label class="ans-row flex items-center gap-4 p-4 border-2 border-slate-50 rounded-xl cursor-pointer transition-all hover:border-indigo-500 hover:bg-indigo-50/30 group/opt">
                            <input type="radio" name={`q-${q.id}`} value={key} data-q={q.id} data-ans={q.ans} class="sr-only q-radio" />
                            <div class="w-5 h-5 rounded-full border-2 border-slate-200 flex items-center justify-center radio-ui transition-all group-hover/opt:border-indigo-500">
                              <div class="w-2.5 h-2.5 bg-indigo-500 rounded-full scale-0 transition-transform"></div>
                            </div>
                            <span class="text-sm font-black text-slate-400 w-4">{key}</span>
                            <span class="text-sm text-slate-600 font-semibold" set:html={val}></span>
                          </label>
                        ))}
                      </div>
                    ) : (
                      /* NẾU KHÔNG CÓ OPTIONS THÌ HIỆN Ô ĐIỀN TỪ (PART 5) */
                      <input type="text" data-q={q.id} data-ans={q.ans} class="q-fill w-full p-4 bg-slate-50 border-2 border-slate-100 rounded-xl font-black text-center uppercase tracking-widest focus:border-indigo-500 focus:bg-white outline-none transition-all" placeholder="Type here..." />
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<script is:inline>
  document.getElementById('submit').onclick = () => {
    let score = 0;
    // Chấm trắc nghiệm
    document.querySelectorAll('.q-radio').forEach(input => {
      const row = input.closest('.ans-row');
      const correct = input.getAttribute('data-ans')?.trim().toUpperCase();
      if (input.checked) {
        if (input.value === correct) {
          score++;
          row.style.borderColor = "#10b981"; row.style.backgroundColor = "#ecfdf5";
        } else {
          row.style.borderColor = "#ef4444"; row.style.backgroundColor = "#fef2f2";
        }
      }
      if (input.value === correct) {
        row.querySelector('.radio-ui').style.backgroundColor = "#10b981";
        row.querySelector('.radio-ui').style.borderColor = "#10b981";
        row.querySelector('.radio-ui div').style.transform = "scale(1)";
      }
    });
    // Chấm điền từ
    document.querySelectorAll('.q-fill').forEach(input => {
      const correct = input.getAttribute('data-ans')?.trim().toUpperCase();
      if (input.value.trim().toUpperCase() === correct && correct !== "") {
        score++;
        input.style.borderColor = "#10b981"; input.style.backgroundColor = "#ecfdf5";
      } else {
        input.style.borderColor = "#ef4444"; input.style.backgroundColor = "#fef2f2";
        input.value = `${input.value} (Key: ${correct})`;
      }
    });
    document.getElementById('score').innerText = score;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');
  body { overflow: hidden; }
  .custom-scroll::-webkit-scrollbar { width: 5px; }
  .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  
  .ans-row:has(input:checked) { border-color: #4f46e5 !important; background-color: #f5f3ff !important; }
  .ans-row:has(input:checked) .radio-ui { border-color: #4f46e5; background-color: #4f46e5; }
  .ans-row:has(input:checked) .radio-ui div { transform: scale(1); background-color: white; }

  .notice-box { position: relative; background-image: radial-gradient(#d1d5db 0.5px, transparent 0.5px); background-size: 10px 10px; }
</style>