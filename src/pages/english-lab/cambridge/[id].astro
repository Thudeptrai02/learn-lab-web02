---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

// 1. Dành cho chế độ Static (Prerender)
export async function getStaticPaths() {
  const examEntries = await getCollection('exams');
  return examEntries.map(entry => ({
    params: { id: entry.id }, 
    props: { entry },
  }));
}

// 2. Lấy ID từ URL
const { id } = Astro.params;
let { entry } = Astro.props;

// 3. CƠ CHẾ BẢO VỆ: Nếu entry bị undefined (lỗi sếp đang gặp), 
// ta sẽ chủ động tìm đề thi trong bộ sưu tập 'exams' dựa trên ID.
if (!entry && id) {
  entry = await getEntry('exams', id);
}

// 4. Nếu vẫn không thấy đề thi (URL sai), chuyển hướng về trang 404 để không bị sập web
if (!entry) {
  return Astro.redirect('/404');
}

// 5. Lúc này entry đã chắc chắn tồn tại, render sẽ không còn lỗi
const { Content } = await render(entry);
const { title, parts } = entry.data;
---

<Layout title={title}>
  <div class="h-screen flex flex-col bg-white overflow-hidden font-['Plus_Jakarta_Sans',sans-serif]">
    
    <header class="h-16 border-b bg-slate-900 text-white flex items-center justify-between px-8 shrink-0 z-50">
      <div class="flex items-center gap-4">
        <div class="bg-emerald-500 text-slate-900 w-9 h-9 flex items-center justify-center rounded-xl font-black shadow-lg">L</div>
        <div>
          <h1 class="text-xs font-extrabold tracking-widest uppercase opacity-80">{title}</h1>
          <p class="text-[9px] text-emerald-400 font-bold uppercase tracking-[0.2em] mt-0.5">LearnLab Exam System</p>
        </div>
      </div>
      
      <div class="flex items-center gap-10">
        <div class="flex items-center gap-3">
          <span class="text-[10px] font-black uppercase opacity-40">Score</span>
          <span id="final-score" class="text-3xl font-black text-emerald-400 leading-none">--</span>
        </div>
        <button id="submit-btn" class="bg-emerald-500 hover:bg-emerald-400 text-slate-900 px-8 py-2.5 rounded-xl font-black text-xs transition-all uppercase tracking-widest active:scale-95 shadow-lg shadow-emerald-500/20">
          Submit Test
        </button>
      </div>
    </header>

    <div class="flex-1 flex overflow-hidden">
      <aside class="w-1/2 overflow-y-auto p-12 bg-slate-50 border-r border-slate-200 custom-scroll">
        <div class="max-w-2xl ml-auto prose prose-slate prose-img:rounded-3xl">
          <Content />
        </div>
      </aside>

      <section class="w-1/2 overflow-y-auto p-12 bg-white custom-scroll shadow-inner">
        <div class="max-w-md">
          <div class="mb-12 border-b border-slate-100 pb-6">
            <h3 class="font-black text-slate-900 text-2xl tracking-tight mb-2">Answer Sheet</h3>
            <p class="text-slate-400 text-xs font-bold uppercase tracking-widest italic">Chọn đáp án chính xác bên dưới</p>
          </div>

          <div class="space-y-16">
            {parts && parts.map((part) => (
              <div class="part-section">
                <div class="flex items-center gap-3 mb-8">
                   <span class="bg-indigo-600 text-white px-3 py-1 rounded font-black text-[10px] uppercase tracking-widest">{part.part_name}</span>
                   <div class="h-px flex-1 bg-slate-100"></div>
                </div>

                <div class="space-y-10">
                  {part.questions && part.questions.map((q) => (
                    <div class="question-item group">
                      <div class="flex items-start gap-4 mb-5">
                        <span class="w-8 h-8 bg-slate-100 text-slate-400 flex items-center justify-center rounded-lg font-black text-sm group-hover:bg-slate-900 group-hover:text-white transition-all shadow-sm">
                          {q.id}
                        </span>
                        <div class="pt-1">
                          <p class="font-bold text-slate-700 text-sm leading-relaxed" set:html={q.text}></p>
                        </div>
                      </div>

                      <div class="pl-12">
                        {q.options ? (
                          <div class="grid grid-cols-1 gap-2">
                            {Object.entries(q.options).map(([key, val]) => (
                              <label class="ans-box flex items-center gap-4 p-4 border-2 border-slate-50 rounded-2xl cursor-pointer hover:border-indigo-500 hover:bg-indigo-50/30 transition-all group/opt">
                                <input type="radio" name={`q-${q.id}`} value={key} data-ans={q.ans} class="sr-only q-radio" />
                                <div class="w-5 h-5 rounded-full border-2 border-slate-200 flex items-center justify-center radio-circle transition-all group-hover/opt:border-indigo-500">
                                  <div class="w-2.5 h-2.5 bg-indigo-500 rounded-full scale-0 transition-transform"></div>
                                </div>
                                <span class="text-xs font-black text-slate-400 uppercase w-4">{key}</span>
                                <span class="text-sm text-slate-600 font-semibold">{val}</span>
                              </label>
                            ))}
                          </div>
                        ) : (
                          q.type === 'gap-fill' && (
                            <input 
                              type="text" 
                              data-ans={q.ans} 
                              class="q-input-text w-full p-4 bg-slate-50 border-2 border-slate-100 rounded-2xl font-black text-center uppercase tracking-widest focus:border-indigo-500 focus:bg-white outline-none transition-all shadow-inner" 
                              placeholder="Type your answer..." 
                            />
                          )
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script is:inline>
  document.getElementById('submit-btn').onclick = () => {
    let score = 0;
    
    document.querySelectorAll('.q-radio').forEach(input => {
      const box = input.closest('.ans-box');
      const correct = input.getAttribute('data-ans')?.trim().toUpperCase();
      if (input.checked) {
        if (input.value === correct) {
          score++;
          box.style.borderColor = "#10b981"; box.style.backgroundColor = "#ecfdf5";
        } else {
          box.style.borderColor = "#ef4444"; box.style.backgroundColor = "#fef2f2";
        }
      }
      if (input.value === correct) {
        box.querySelector('.radio-circle').style.backgroundColor = "#10b981";
        box.querySelector('.radio-circle').style.borderColor = "#10b981";
        box.querySelector('.radio-circle div').style.transform = "scale(1)";
      }
    });

    document.querySelectorAll('.q-input-text').forEach(input => {
      const correct = input.getAttribute('data-ans')?.trim().toUpperCase();
      if (input.value.trim().toUpperCase() === correct && correct !== "") {
        score++;
        input.style.borderColor = "#10b981"; input.style.backgroundColor = "#ecfdf5";
      } else {
        input.style.borderColor = "#ef4444"; input.style.backgroundColor = "#fef2f2";
        if (input.value) input.value = `${input.value} (Key: ${correct})`;
      }
    });

    document.getElementById('final-score').innerText = score;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
</script>

<style is:global>
  body { overflow: hidden; background: #fff; }
  .ans-box:has(input:checked) { border-color: #4f46e5 !important; background-color: #f5f3ff; }
  .ans-box:has(input:checked) .radio-circle { border-color: #4f46e5 !important; background-color: #4f46e5; }
  .ans-box:has(input:checked) .radio-circle div { transform: scale(1) !important; background-color: white; }
  .custom-scroll::-webkit-scrollbar { width: 5px; }
  .custom-scroll::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
  table { width: 100%; border-collapse: collapse; margin: 2rem 0; border: 1px solid #f1f5f9; }
  td, th { border: 1px solid #f1f5f9; padding: 1rem; font-size: 0.9rem; }
</style>