---
import Layout from '../../../layouts/Layout.astro';

// 1. Chỉ định đây là trang tĩnh (Bắt buộc cho Astro 5)
export const prerender = true;

export async function getStaticPaths() {
  // Quét toàn bộ file JSON trong thư mục data
  const jsonFiles = import.meta.glob('../../../data/cambridge/*.json', { eager: true });
  
  return Object.values(jsonFiles).map((test: any) => {
    const data = test.default;
    return {
      params: { id: data.test_id || "error" },
      props: { testData: data }
    };
  });
}

const { testData } = Astro.props;

// Chuẩn bị kho đáp án để chấm điểm (Dành cho các câu hỏi có ID)
const allAnswers = {};
testData.parts.forEach(p => {
  p.questions?.forEach(q => {
    allAnswers[q.id] = q.ans || q.answer || "";
  });
});
---

<Layout title={testData.title}>
  <div class="min-h-screen bg-[#F9FAFB] pb-32 font-['Plus_Jakarta_Sans',sans-serif]">
    
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-slate-200 py-4 px-6 md:px-12 shadow-sm">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 bg-emerald-600 rounded-2xl flex items-center justify-center text-white font-black shadow-lg shadow-emerald-100">L</div>
          <div>
            <h1 class="font-black text-slate-900 uppercase text-xs md:text-sm tracking-tight">{testData.title}</h1>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Cambridge A2 Practice</p>
          </div>
        </div>
        
        <div class="flex items-center gap-6">
          <div class="hidden md:block text-right">
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Your Score</p>
            <p id="score-val" class="text-2xl font-black text-emerald-600">--</p>
          </div>
          <button id="submit-btn" class="bg-slate-900 text-white px-8 py-3 rounded-2xl font-black text-xs hover:bg-emerald-600 hover:scale-105 active:scale-95 transition-all shadow-xl">SUBMIT TEST</button>
        </div>
      </div>
    </nav>

    <div id="ans-store" class="hidden" data-ans={JSON.stringify(allAnswers)}></div>

    <main class="max-w-4xl mx-auto mt-12 px-4 md:px-0">
      {testData.parts.map((part, pIdx) => (
        <section class="mb-20 group">
          <div class="flex items-center gap-4 mb-8">
            <span class="text-5xl font-black text-slate-100 italic group-hover:text-emerald-50 transition-colors">0{pIdx + 1}</span>
            <div class="bg-slate-900 text-white px-4 py-1.5 rounded-xl font-black text-[10px] uppercase tracking-[0.2em]">
              {part.part_name}
            </div>
            <div class="h-[1px] flex-1 bg-slate-200/60"></div>
          </div>

          <div class="bg-white rounded-[2.5rem] border border-slate-100 p-8 md:p-14 shadow-[0_30px_60px_-15px_rgba(0,0,0,0.02)] transition-all hover:shadow-2xl hover:shadow-emerald-500/5">
            
            {/* NỘI DUNG CHÍNH (Văn bản + Câu hỏi trộn lẫn trong passage) */}
            <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-lg mb-12 passage-render" set:html={part.passage} />

            {/* KHU VỰC NHẬP ĐÁP ÁN (DÀNH CHO DỮ LIỆU CÀO TRỘN LẪN) */}
            <div class="mt-12 pt-12 border-t border-slate-50">
              <div class="flex items-center gap-2 mb-8">
                <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
                <p class="text-xs font-black text-slate-400 uppercase tracking-widest italic">Input your answers below</p>
              </div>

              {/* Nếu JSON có mảng questions (Dữ liệu sạch) */}
              {part.questions && part.questions.length > 0 ? (
                <div class="space-y-12">
                  {part.questions.map((q) => (
                    <div class="flex flex-col md:flex-row gap-6">
                      <span class="w-10 h-10 bg-slate-50 text-slate-400 flex items-center justify-center rounded-xl font-black text-lg shrink-0">{q.id}</span>
                      <div class="flex-1">
                        <p class="text-xl font-bold text-slate-800 mb-6" set:html={q.text}></p>
                        {q.a && (
                          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            {['A', 'B', 'C'].map(opt => (
                              <label class="ans-label cursor-pointer flex items-center gap-3 p-4 border-2 border-slate-50 rounded-2xl hover:border-emerald-500 hover:bg-emerald-50/50 transition-all group/opt">
                                <input type="radio" name={`q-${q.id}`} value={opt} data-q={q.id} class="sr-only q-input" />
                                <div class="w-5 h-5 border-2 border-slate-200 rounded-full flex items-center justify-center radio-ui transition-all group-hover/opt:border-emerald-500">
                                  <div class="w-2 h-2 bg-white rounded-full opacity-0"></div>
                                </div>
                                <span class="text-slate-700 font-bold uppercase">{opt}. <span class="font-medium lowercase ml-1" set:html={q[opt.toLowerCase()]}></span></span>
                              </label>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                /* Nếu JSON không có questions (Phòng hờ dữ liệu cào lỗi) - Hiện bảng trả lời nhanh */
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
                   {[...Array(6)].map((_, i) => (
                      <div class="flex flex-col gap-2">
                        <span class="text-[10px] font-black text-slate-300 text-center uppercase tracking-tighter">Ans {i + 1}</span>
                        <input type="text" placeholder="..." class="w-full p-4 bg-slate-50 border-2 border-transparent rounded-2xl font-black text-center uppercase focus:bg-white focus:border-emerald-500 outline-none transition-all shadow-inner" />
                      </div>
                   ))}
                </div>
              )}
            </div>
          </div>
        </section>
      ))}
    </main>
  </div>
</Layout>

<script is:inline>
  const ANSWERS = JSON.parse(document.getElementById('ans-store').getAttribute('data-ans'));

  document.getElementById('submit-btn').onclick = () => {
    let score = 0;
    document.querySelectorAll('.q-input').forEach(input => {
      const qId = input.getAttribute('data-q');
      const correct = ANSWERS[qId]?.trim().toUpperCase();
      const label = input.closest('.ans-label');

      if (input.checked) {
        if (input.value === correct) {
          score++;
          label.style.borderColor = "#10b981";
          label.style.backgroundColor = "#f0fdf4";
        } else {
          label.style.borderColor = "#ef4444";
          label.style.backgroundColor = "#fef2f2";
        }
      }
      
      // Hiện đáp án đúng
      if (input.value === correct) {
        label.style.borderColor = "#10b981";
        label.querySelector('.radio-ui').style.backgroundColor = "#10b981";
        label.querySelector('.radio-ui').style.borderColor = "#10b981";
        label.querySelector('.radio-ui div').style.opacity = "1";
      }
    });

    document.getElementById('score-val').innerText = score;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
</script>

<style is:global>
  /* CÀI ĐẶT FONT & RESET */
  body { background-color: #f9fafb; -webkit-font-smoothing: antialiased; }

  /* ĐỊNH DẠNG NỘI DUNG VĂN BẢN (Dành cho dữ liệu cào) */
  .passage-render p { margin-bottom: 1.5rem; }
  .passage-render img { max-width: 100%; border-radius: 2rem; margin: 3rem auto; display: block; box-shadow: 0 30px 60px -12px rgba(0,0,0,0.08); }
  .passage-render table { width: 100% !important; border-collapse: collapse; margin: 2rem 0; background: white; border-radius: 1.5rem; overflow: hidden; border: 1px solid #f1f5f9; }
  .passage-render td { border: 1px solid #f1f5f9; padding: 1.25rem; font-size: 0.95rem; }
  
  /* HIỆU ỨNG CHỌN ĐÁP ÁN */
  .ans-label:has(input:checked) { border-color: #10b981 !important; background-color: #f0fdf4 !important; box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.1); }
  .ans-label:has(input:checked) .radio-ui { border-color: #10b981; background-color: #10b981; }
  .ans-label:has(input:checked) .radio-ui div { opacity: 1; }

  /* ẨN RÁC */
  p:empty { display: none; }
</style>