---
export const prerender = true;
// Lùi 6 lần để ra tới src
import Layout from '../../../../../../layouts/Layout.astro';
import ReadingExam from '../../../../../../components/exam/reading/ReadingExam.astro'; 

export async function getStaticPaths() {
  const jsonFiles = import.meta.glob('../../../../../../data/reading/*.json', { eager: true });
  let paths = [];

  for (const path in jsonFiles) {
    const fileName = path.split('/').pop().replace('.json', '').toLowerCase();
    paths.push({
      params: { level: 'a2-ket', test_id: fileName },
      props: { examData: jsonFiles[path].default }
    });
  }
  return paths;
}

const { test_id } = Astro.params;
const { examData } = Astro.props;
---

<Layout title={`Reading - ${test_id.toUpperCase()}`}>
  <ReadingExam questions={examData} testTitle={`Reading & Writing: ${test_id.toUpperCase()}`} />
</Layout>