---
export const prerender = true;

// Import Layout và Component bằng 5 bậc
import Layout from '../../../../../layouts/Layout.astro';
import ReadingExam from '../../../../../components/exam/reading/ReadingExam.astro'; 

export async function getStaticPaths() {
  // Dùng đường dẫn TUYỆT ĐỐI /src/... để chắc chắn 100% tóm được file JSON
  const jsonFiles = import.meta.glob('/src/data/exams/reading/*.json', { eager: true });
  
  return Object.keys(jsonFiles).map((path) => {
    const fileName = path.split('/').pop().replace('.json', '').toLowerCase().trim();
    return {
      params: { level: 'a2-ket', test_id: fileName },
      props: { examData: jsonFiles[path].default },
    };
  });
}

const { test_id } = Astro.params;
const { examData } = Astro.props;
---

<Layout title={`Reading - ${test_id.toUpperCase()}`}>
  <ReadingExam questions={examData} testTitle={`Reading: ${test_id.toUpperCase()}`} />
</Layout>