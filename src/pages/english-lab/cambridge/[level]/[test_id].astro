---
// src/pages/exam/[id].astro

// 1. Import Master Engine từ thư mục components
import ReadingExam from '../../../../components/exam/ReadingExam.astro';

// 2. Hàm tự động quét tất cả file JSON trong thư mục data/exams
export async function getStaticPaths() {
  const examFiles = await Astro.glob('../../data/exams/*.json');
  
  return examFiles.map(file => {
    // Lấy tên file làm đường link (VD: ket-test.json -> ket-test)
    const id = file.file.split('/').pop().replace('.json', '');
    return {
      params: { id },
      props: { examData: file.default }
    };
  });
}

const { id } = Astro.params;
const { examData } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cambridge KET - Đề {id}</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-50 antialiased">
    
    <ReadingExam questions={examData} testTitle={`Cambridge KET - Đề ${id}`} />

  </body>
</html>