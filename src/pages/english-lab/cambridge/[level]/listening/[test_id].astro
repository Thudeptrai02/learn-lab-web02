---
export const prerender = true;

// Import Layout và Component bằng 5 bậc
import Layout from '../../../../../layouts/Layout.astro';
import ListeningExam from '../../../../../components/exam/listening/ListeningExam.astro'; 

export async function getStaticPaths() {
  // Dùng đường dẫn TUYỆT ĐỐI /src/... 
  const jsonFiles = import.meta.glob('/src/data/exams/listening/*.json', { eager: true });
  
  return Object.keys(jsonFiles).map((path) => {
    const fileName = path.split('/').pop().replace('.json', '').toLowerCase().trim();
    return {
      params: { level: 'a2-ket', test_id: fileName },
      props: { examData: jsonFiles[path].default },
    };
  });
}

const { test_id } = Astro.params;
const { examData } = Astro.props;
---

<Layout title={`Listening - ${test_id.toUpperCase()}`}>
  <ListeningExam questions={examData} testTitle={`Listening: ${test_id.toUpperCase()}`} />
</Layout>