---
// src/pages/english-lab/[level]/listening/[test_id].astro

// 1. Nhảy 5 lần (../../../../..) để tìm thấy bộ não Listening
import ListeningExam from '../../../../../components/exam/listening/ListeningExam.astro';
import BaseLayout from '../../../../../layouts/BaseLayout.astro'; 

export async function getStaticPaths() {
  // 2. Nhảy 5 lần để quét toàn bộ file JSON trong kho dữ liệu Listening
  const allTests = await Astro.glob('../../../../../data/listening/*.json');
  
  return allTests.map((test) => {
    // Lấy tên file làm ID (ví dụ: "ket-l-01.json" -> "ket-l-01")
    const test_id = test.file.split('/').pop().split('.').shift();
    
    return {
      // Vì nằm trong thư mục [level] và file [test_id], ta phải trả về cả 2 params này
      params: { 
        level: 'a2-ket', // Sếp có thể tùy biến logic lấy level từ tên file nếu cần
        test_id: test_id 
      },
      props: { examData: test.default },
    };
  });
}

const { test_id } = Astro.params;
const { examData } = Astro.props;
---

<BaseLayout title={`Listening Test - ${test_id.toUpperCase()}`}>
  <main class="min-h-screen bg-slate-50">
    {/* 3. Truyền dữ liệu JSON đã nạp được vào giao diện Listening */}
    <ListeningExam 
      questions={examData} 
      testTitle={`Cambridge A2 Key Listening - ${test_id.toUpperCase()}`} 
    />
  </main>
</BaseLayout>