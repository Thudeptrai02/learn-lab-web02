---
import Layout from '../../../layouts/Layout.astro';
import { getCambridgeData } from '../../../lib/cambridge.js';

export async function getStaticPaths() {
  // Lấy dữ liệu đã nhóm từ lib
  const data = await getCambridgeData();
  
  // Tạo ra các đường link dựa trên Mã Đề
  return Object.keys(data).map((maDe) => {
    return {
      params: { ma_de: maDe }, 
      props: { parts: data[maDe] }, 
    };
  });
}

const { ma_de } = Astro.params;
const { parts } = Astro.props;

const tenHienThi = ma_de ? ma_de.replace(/-/g, ' ').toUpperCase() : "BÀI THI";
---

<Layout title={`${tenHienThi} | Learn Lab Cambridge`}>
  <main class="max-w-5xl mx-auto py-12 px-4 sm:px-6 lg:px-8 bg-slate-50 min-h-screen pt-24">
    
    {!parts || parts.length === 0 ? (
      <div class="text-center py-20 bg-white rounded-3xl border border-red-200 shadow-sm">
        <div class="text-6xl mb-4">🚨</div>
        <h1 class="text-3xl font-bold text-red-500 mb-4">LỖI DỮ LIỆU!</h1>
        <p class="text-lg text-slate-600">Không tìm thấy nội dung cho mã đề: {ma_de}</p>
      </div>
    ) : (
      <>
        <div class="text-center mb-16">
          <span class="bg-teal-100 text-teal-800 font-bold px-4 py-1.5 rounded-full text-sm tracking-widest uppercase mb-4 inline-block">
            Cambridge Assessment
          </span>
          <h1 class="text-4xl md:text-5xl font-black text-slate-900 mt-4 mb-4">{tenHienThi}</h1>
        </div>

        {parts.map((p) => (
          <section class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden mb-12">
            <div class="bg-slate-800 px-8 py-5">
              <h2 class="text-xl font-bold text-white">{p.Part}</h2>
            </div>
            
            <div class="p-8 cambridge-content" set:html={p.Noi_Dung} />

            <div class="bg-teal-50/50 p-6 border-t border-slate-100">
              <details class="group cursor-pointer">
                <summary class="font-bold text-teal-700 flex items-center select-none bg-white border border-teal-100 px-6 py-3 rounded-xl shadow-sm hover:shadow-md transition-all w-max">
                  <span class="mr-2">💡</span> Xem Đáp Án / Bài Mẫu
                  <span class="ml-4 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="mt-6 p-6 bg-white border border-teal-100 rounded-2xl text-slate-800 font-medium whitespace-pre-line leading-relaxed shadow-inner">
                  {p.Dap_An}
                </div>
              </details>
            </div>
          </section>
        ))}
      </>
    )}
  </main>
</Layout>

<style is:global>
  /* --- BỘ CSS THUẦN HÓA DIVI BUILDER --- */
  .cambridge-content { font-family: 'Inter', system-ui, sans-serif; }
  .cambridge-content .et_pb_row { display: flex; flex-wrap: wrap; gap: 2rem; margin-bottom: 2rem; }
  .cambridge-content .et_pb_column { flex: 1; min-width: 0; }
  .cambridge-content .et_pb_column_2_5 { flex: 0 0 50px; font-size: 1.25rem; color: #0f766e; }
  .cambridge-content .et_pb_column_3_5 { flex: 1; }
  .cambridge-content table { width: 100%; border-collapse: separate; border-spacing: 0; border-radius: 0.75rem; overflow: hidden; border: 1px solid #e2e8f0; margin: 2rem 0; }
  .cambridge-content td { padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; vertical-align: middle; }
  .cambridge-content tr:last-child td { border-bottom: none; }
  .cambridge-content td:last-child { border-right: none; }
  .cambridge-content tr:nth-child(even) { background-color: #f8fafc; }
  .cambridge-content p { margin-bottom: 1.25rem; line-height: 1.8; color: #334155; font-size: 1.05rem; }
  .cambridge-content strong { color: #0f172a; font-weight: 700; }
  .cambridge-content img { max-width: 100%; height: auto; border-radius: 1rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); margin: 2rem auto; display: block; }
  .cambridge-content .et_pb_text_align_center { text-align: center; }
</style>