---
import Layout from '../../../layouts/Layout.astro';
import { getCambridgeData } from '../../../lib/cambridge.js';

export async function getStaticPaths() {
  const catalog = await getCambridgeData();
  // Tạo đường dẫn dựa trên các mã đề có trong Sheet
  return Object.keys(catalog).map(id => ({ params: { ma_de: id } }));
}

const { ma_de } = Astro.params;
const catalog = await getCambridgeData();

// Tìm dữ liệu không phân biệt hoa thường
const rawRows = catalog[ma_de.toLowerCase()] || [];

const partsGroup = {};
const allAnswers = {};

rawRows.forEach(row => {
   // Lib đã lowercase nên ta gọi row.part
   const pName = (row.part || 'BÀI THI').toUpperCase().trim();
   
   if(!partsGroup[pName]) {
      partsGroup[pName] = { passage: '', questions: [] };
   }
   
   // Lấy đoạn văn / Ảnh từ cột doan_van
   if (row.doan_van && !partsGroup[pName].passage) {
      partsGroup[pName].passage = row.doan_van;
   }
   
   const qNum = (row.so_cau || '').toString().trim();
   if (qNum) {
      partsGroup[pName].questions.push(row);
      // Lấy đáp án từ cột dap_an
      if (row.dap_an) {
         allAnswers[qNum] = row.dap_an.toUpperCase().trim();
      }
   }
});
---

<Layout title={ma_de.toUpperCase() + ' | Learn Lab'}>
  
  <div class="fixed bottom-0 left-0 w-full z-50 bg-white border-t-[3px] border-slate-900 py-3 px-4 md:px-8 flex justify-between items-center shadow-[0_-5px_20px_rgba(0,0,0,0.1)]">
    <div class="flex items-center gap-3">
      <div id="score-val" class="w-12 h-12 bg-slate-900 text-white rounded-full flex items-center justify-center font-black text-xl shadow-inner">--</div>
      <div class="font-black text-slate-900 uppercase text-sm hidden sm:block">KẾT QUẢ</div>
    </div>
    <button type="button" id="submit-btn" class="bg-teal-600 text-white px-8 md:px-12 py-3 rounded-full font-black hover:bg-teal-700 transition-all shadow-lg">NỘP BÀI CHẤM ĐIỂM</button>
  </div>

  <div id="ans-data" class="hidden">{JSON.stringify(allAnswers)}</div>

  <main class="max-w-4xl mx-auto py-10 md:py-16 px-4 pb-32 min-h-screen">
    <h1 class="text-3xl md:text-4xl font-black text-slate-900 mb-10 text-center uppercase border-b-4 border-slate-900 pb-4">{ma_de}</h1>

    {Object.keys(partsGroup).length === 0 && (
       <div class="text-center p-20 border-4 border-dashed rounded-2xl text-slate-400 font-bold">
         Không tìm thấy dữ liệu. Sếp kiểm tra cột Ma_De trong Sheet nhé!
       </div>
    )}

    {Object.keys(partsGroup).map((partName) => {
      const partData = partsGroup[partName];
      const isPart5 = partName.includes("PART 5");
      const isWriting = partName.includes("PART 6") || partName.includes("PART 7");

      return (
        <section class="mb-14 md:mb-20">
          <div class="bg-slate-900 text-white inline-block px-5 py-2 rounded-t-xl font-black">{partName}</div>
          <div class="bg-white border-[3px] border-slate-900 p-5 md:p-10 rounded-b-xl rounded-tr-xl shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
            
            {/* ĐOẠN VĂN / ẢNH */}
            {partData.passage && (
              <div class="mb-8 p-6 bg-slate-50 border-2 border-slate-200 rounded-xl text-lg leading-relaxed content-html" set:html={partData.passage}></div>
            )}

            <div class="space-y-10">
              {partData.questions.map((q) => (
                <div class="q-block">
                  {/* Ô VUÔNG PART 1 CHUẨN ẢNH */}
                  {partName.includes("PART 1") && q.cau_hoi && (
                    <div class="border border-black p-5 mb-5 max-w-[380px] text-base leading-relaxed bg-white" set:html={q.cau_hoi}></div>
                  )}

                  <div class="flex items-start gap-4">
                    <span class="bg-slate-900 text-white w-9 h-9 flex items-center justify-center font-black rounded-lg shrink-0 mt-1">{q.so_cau}</span>
                    
                    <div class="flex-1">
                      {!partName.includes("PART 1") && q.cau_hoi && q.cau_hoi !== '...' && (
                        <div class="font-bold text-lg mb-4 text-slate-800" set:html={q.cau_hoi}></div>
                      )}

                      {/* TRẮC NGHIỆM */}
                      {!isPart5 && !isWriting && q.a && (
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                          {['a', 'b', 'c'].map((char) => (
                            <label class="ans-label cursor-pointer flex items-start gap-3 p-3 rounded-xl border-2 border-slate-200 hover:border-teal-400 transition-all">
                              <input type="radio" name={'q-' + q.so_cau} value={char.toUpperCase()} data-q={q.so_cau} class="mt-1 w-5 h-5 accent-teal-600 choice-radio" />
                              <span class="ans-text flex-1">
                                <strong class="mr-1">{char.toUpperCase()}.</strong> <span set:html={q[char]}></span>
                              </span>
                            </label>
                          ))}
                        </div>
                      )}

                      {/* ĐIỀN TỪ (PART 5) */}
                      {isPart5 && (
                        <input type="text" data-q={q.so_cau} class="p5-input p-3 border-2 border-slate-300 rounded-lg w-full sm:w-64 uppercase font-black text-center focus:border-teal-500 outline-none" placeholder="..." />
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>

            {/* TỰ LUẬN */}
            {isWriting && (
              <div class="mt-10 pt-10 border-t-2 border-slate-100 writing-area">
                <textarea class="w-full h-48 p-5 bg-slate-50 border-2 border-slate-200 rounded-xl outline-none" placeholder="Nhập bài làm của bạn..."></textarea>
                <button type="button" class="ai-btn mt-4 w-full bg-slate-900 text-white font-black py-4 rounded-xl hover:bg-teal-600 transition-all">✨ AI CHẤM ĐIỂM</button>
                <div class="ai-res hidden mt-6 p-6 bg-teal-50 border-2 border-teal-200 rounded-xl"></div>
              </div>
            )}
          </div>
        </section>
      );
    })}
  </main>
</Layout>

<script is:inline>
  const allAnswers = JSON.parse(document.getElementById('ans-data').textContent);

  document.getElementById('submit-btn').onclick = function() {
    let score = 0;
    
    document.querySelectorAll('.ans-text').forEach(el => {
        el.style.removeProperty('color');
        el.style.removeProperty('font-weight');
        el.style.removeProperty('text-decoration');
    });
    
    document.querySelectorAll('.choice-radio').forEach(input => {
      const q = input.getAttribute('data-q');
      const isCorrectValue = input.value === allAnswers[q];
      const label = input.closest('label');
      const textSpan = label ? label.querySelector('.ans-text') : null;

      if (input.checked) {
          if (isCorrectValue) {
              score++;
              if (textSpan) {
                textSpan.style.setProperty('color', '#16a34a', 'important');
                textSpan.style.setProperty('font-weight', 'bold', 'important');
              }
          } else {
              if (textSpan) {
                textSpan.style.setProperty('color', '#dc2626', 'important');
                textSpan.style.setProperty('text-decoration', 'line-through', 'important');
              }
          }
      }
      if (isCorrectValue && textSpan) {
          textSpan.style.setProperty('color', '#16a34a', 'important');
          textSpan.style.setProperty('font-weight', 'bold', 'important');
      }
    });

    document.querySelectorAll('.p5-input').forEach(input => {
      const q = input.getAttribute('data-q');
      const val = input.value.trim().toUpperCase();
      input.classList.remove('border-green-500', 'bg-green-50', 'border-red-500', 'bg-red-50');

      if (val === allAnswers[q]) {
        score++;
        input.classList.add('border-green-500', 'bg-green-50');
      } else {
        input.classList.add('border-red-500', 'bg-red-50');
        input.value = allAnswers[q] || ''; 
      }
    });

    document.getElementById('score-val').innerText = score;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
</script>

<style is:global>
  .content-html img { max-width: 100%; height: auto; display: block; margin: 1.5rem auto; border-radius: 8px; }
  .q-block { overflow-wrap: break-word; }
  .content-html table { width: 100% !important; border-collapse: collapse; margin: 1rem 0; }
  .content-html td { border: 1px solid #cbd5e1; padding: 0.5rem; }
</style>