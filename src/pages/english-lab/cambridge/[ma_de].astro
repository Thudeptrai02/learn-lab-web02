---
import Layout from '../../../layouts/Layout.astro';
import { getCambridgeData } from '../../../lib/cambridge.js';

export async function getStaticPaths() {
  const catalog = await getCambridgeData();
  return Object.keys(catalog).map(id => ({ params: { ma_de: id.trim() } }));
}

const { ma_de } = Astro.params;
const catalog = await getCambridgeData();
const cleanUrl = ma_de ? ma_de.trim().toLowerCase() : "";
const correctKey = Object.keys(catalog).find(key => key.trim().toLowerCase() === cleanUrl);

// Lấy dữ liệu thô từ file CSV của sếp
const rawRows = correctKey ? catalog[correctKey] : [];

// 1. CHUẨN BỊ DỮ LIỆU TỪ CSV CỦA SẾP
const partsGroup = {};
const allAnswers = {};

rawRows.forEach(row => {
   // Xử lý Part: Dựa vào logic thông thường của đề KET hoặc cột tự định nghĩa
   // Giả định sếp có cột "Part" trong CSV. Nếu không có, ta gộp tất cả vào "PART 1" làm mặc định.
   const pName = row.Part ? row.Part.toUpperCase().trim() : 'TEST PART'; 
   
   if(!partsGroup[pName]) {
      partsGroup[pName] = { passage: '', questions: [] };
   }
   
   // Xử lý câu hỏi và đáp án
   const qNum = row.ID ? row.ID.toString().trim() : '';
   
   if (qNum) {
      partsGroup[pName].questions.push(row);
      
      // Lấy đáp án đúng từ cột "Correct Answer"
      if (row['Correct Answer']) {
         allAnswers[qNum] = row['Correct Answer'].toString().trim().toUpperCase();
      }
   }
});
---

<Layout title={ma_de.replace(/-/g, ' ') + ' | Learn Lab'}>
  
  {/* THANH ĐIỀU KHIỂN NỘP BÀI */}
  <div class="fixed bottom-0 left-0 w-full z-50 bg-white border-t-[3px] border-slate-900 py-3 px-4 md:px-8 flex justify-between items-center shadow-[0_-5px_20px_rgba(0,0,0,0.1)]">
    <div class="flex items-center gap-3">
      <div id="score-val" class="w-12 h-12 bg-slate-900 text-white rounded-full flex items-center justify-center font-black text-xl shadow-inner">--</div>
      <div class="font-black text-slate-900 uppercase text-sm md:text-base hidden sm:block">KẾT QUẢ BÀI LÀM</div>
    </div>
    <button type="button" id="submit-btn" class="bg-teal-600 text-white px-8 md:px-12 py-3 rounded-full font-black text-sm md:text-base hover:bg-teal-700 transition-transform hover:-translate-y-1 shadow-lg tracking-wide">NỘP BÀI CHẤM ĐIỂM</button>
  </div>

  <div id="ans-data" class="hidden">{JSON.stringify(allAnswers)}</div>

  <main class="max-w-4xl mx-auto py-10 md:py-16 px-4 sm:px-6 pb-32 min-h-screen bg-slate-50 md:bg-white">
    <h1 class="text-3xl md:text-4xl font-black text-slate-900 mb-12 text-center uppercase tracking-tighter border-b-4 border-slate-900 pb-4">{ma_de.replace(/-/g, ' ')}</h1>

    {/* VÒNG LẶP RENDER TỪ DỮ LIỆU CSV */}
    {Object.keys(partsGroup).map((partName) => {
      const partData = partsGroup[partName];
      const questions = partData.questions;

      return (
        <section class="mb-16 md:mb-20 part-container">
          <div class="bg-slate-900 text-white inline-block px-5 md:px-6 py-2 rounded-t-xl font-black text-base md:text-lg tracking-wider">{partName}</div>
          <div class="bg-white border-[3px] md:border-4 border-slate-900 p-5 md:p-10 rounded-b-xl rounded-tr-xl shadow-[6px_6px_0px_0px_rgba(15,23,42,1)]">
            
            <div class="space-y-10">
              {questions.map((q) => {
                const isPart5 = partName.indexOf("PART 5") > -1;
                const isWriting = partName.indexOf("PART 6") > -1 || partName.indexOf("PART 7") > -1;

                return (
                  <div class="q-block border-b-2 border-slate-100 pb-8 last:border-0 last:pb-0">
                    
                    {/* HỘP NỘI DUNG (BIỂN BÁO / ĐOẠN VĂN MỞ ĐẦU) */}
                    {q.Question && (
                      <div class="mb-6">
                        {/* Nếu là Part 1 -> Hiển thị dạng hộp viền đen (biển báo) */}
                        {partName.indexOf("PART 1") > -1 ? (
                           <div class="border-[1.5px] border-slate-900 p-5 rounded-md text-slate-900 font-medium text-base leading-relaxed max-w-[400px]" set:html={q.Question}></div>
                        ) : (
                           /* Các Part khác -> Hiển thị text bình thường */
                           <div class="text-slate-800 text-base md:text-lg leading-relaxed font-medium" set:html={q.Question}></div>
                        )}
                      </div>
                    )}

                    <div class="flex items-start gap-4">
                      {/* SỐ CÂU */}
                      <span class="bg-slate-900 text-white w-9 h-9 flex items-center justify-center font-black rounded-lg shrink-0 text-lg shadow-sm mt-1">{q.ID}</span>
                      
                      <div class="flex-1 w-full">
                        {/* KHU VỰC TRẮC NGHIỆM (A, B, C) */}
                        {(!isPart5 && !isWriting && q['Option A']) && (
                          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-1 w-full">
                            {['A', 'B', 'C'].map((char) => {
                              const optKey = 'Option ' + char;
                              const optText = q[optKey];
                              if (!optText) return null;
                              
                              return (
                                <label class="ans-label cursor-pointer flex items-start gap-3 p-3 rounded-xl border-2 border-slate-200 bg-white hover:bg-slate-50 hover:border-teal-400 transition-all group w-full">
                                  <input type="radio" name={'q-' + q.ID} value={char} data-q={q.ID} class="mt-1 w-5 h-5 flex-shrink-0 accent-teal-600 choice-radio" />
                                  <span class="ans-text flex-1 text-slate-700 leading-snug">
                                    <strong class="text-slate-900 mr-1">{char}.</strong> <span set:html={optText}></span>
                                  </span>
                                </label>
                              )
                            })}
                          </div>
                        )}

                        {/* KHU VỰC ĐIỀN TỪ (PART 5) */}
                        {isPart5 && (
                          <div class="mt-1">
                             <input type="text" data-q={q.ID} class="p5-input p-3 border-2 border-slate-300 rounded-lg w-full sm:w-64 uppercase font-black text-center text-lg focus:border-teal-500 outline-none shadow-inner" placeholder="..." />
                          </div>
                        )}
                      </div>
                    </div>
                    
                  </div>
                )
              })}
            </div>

          </div>
        </section>
      );
    })}
  </main>
</Layout>

<script is:inline>
  const allAnswers = JSON.parse(document.getElementById('ans-data').textContent);

  document.getElementById('submit-btn').onclick = function() {
    let score = 0;
    
    // 1. Reset màu sắc
    document.querySelectorAll('.ans-label').forEach(function(label) {
        label.classList.remove('border-green-500', 'bg-green-50', 'border-red-500', 'bg-red-50');
        const textSpan = label.querySelector('.ans-text');
        const boldSpan = label.querySelector('strong');
        if(textSpan) textSpan.classList.remove('text-green-700', 'text-red-600', 'line-through', 'font-bold');
        if(boldSpan) boldSpan.classList.remove('text-green-700', 'text-red-600');
    });
    
    // 2. Chấm Trắc nghiệm
    document.querySelectorAll('.choice-radio').forEach(function(input) {
      const q = input.getAttribute('data-q');
      const isChecked = input.checked;
      const isCorrectValue = input.value === allAnswers[q];
      
      const label = input.closest('.ans-label');
      const textSpan = label.querySelector('.ans-text');
      const boldSpan = label.querySelector('strong');

      if (isChecked) {
          if (isCorrectValue) {
              score++;
              label.classList.add('border-green-500', 'bg-green-50');
              textSpan.classList.add('text-green-700', 'font-bold');
              boldSpan.classList.add('text-green-700');
          } else {
              label.classList.add('border-red-500', 'bg-red-50');
              textSpan.classList.add('text-red-600', 'line-through');
              boldSpan.classList.add('text-red-600');
          }
      }
      
      // Luôn highlight đáp án đúng (khung viền xanh)
      if (isCorrectValue) {
          label.classList.add('border-green-500');
          textSpan.classList.add('text-green-700', 'font-bold');
          boldSpan.classList.add('text-green-700');
      }
    });

    // 3. Chấm Điền từ Part 5
    document.querySelectorAll('.p5-input').forEach(function(input) {
      const q = input.getAttribute('data-q');
      const val = input.value.trim().toUpperCase();
      
      input.classList.remove('border-green-500', 'bg-green-50', 'text-green-700', 'border-red-500', 'bg-red-50', 'text-red-700');

      if (val === allAnswers[q]) {
        score++;
        input.classList.add('border-green-500', 'bg-green-50', 'text-green-700');
      } else {
        input.classList.add('border-red-500', 'bg-red-50', 'text-red-700');
        input.value = allAnswers[q] ? allAnswers[q] : ''; 
      }
    });

    document.getElementById('score-val').innerText = score;
    document.getElementById('submit-btn').innerText = "LÀM LẠI BÀI";
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
</script>

<style is:global>
  /* Fix lỗi tràn chữ cho mọi nội dung được render từ CSV */
  .q-block { 
      overflow-wrap: break-word; 
      word-wrap: break-word; 
  }
  .q-block img { 
      max-width: 100%; 
      height: auto; 
      margin: 1rem auto; 
      display: block; 
      border-radius: 8px; 
  }
</style>