---
import Layout from '../../../layouts/Layout.astro';
import { getCambridgeData } from '../../../lib/cambridge.js';

export async function getStaticPaths() {
  const catalog = await getCambridgeData();
  return Object.keys(catalog).map(id => ({ params: { ma_de: id.trim() } }));
}

const { ma_de } = Astro.params;
const catalog = await getCambridgeData();
const cleanUrl = ma_de ? ma_de.trim().toLowerCase() : "";
const correctKey = Object.keys(catalog).find(key => key.trim().toLowerCase() === cleanUrl);

const parts = correctKey ? catalog[correctKey] : [];

// Trích xuất đáp án chuẩn để chấm điểm
const allAnswers = {};
parts.forEach(p => {
  const tokens = p.Dap_An.trim().split(/\s+/);
  for (let i = 0; i < tokens.length - 1; i++) {
    if (!isNaN(tokens[i])) { allAnswers[tokens[i]] = tokens[i+1].toUpperCase(); i++; }
  }
});
---

<Layout title="Cambridge Exam | Learn Lab">
  {/* THANH ĐIỂM DƯỚI CÙNG */}
  <div class="fixed bottom-0 left-0 w-full z-50 bg-white border-t-2 border-slate-900 py-4 px-8 flex justify-between items-center shadow-2xl">
    <div class="flex items-center gap-4">
      <div id="score-val" class="w-14 h-14 bg-slate-900 text-white rounded-full flex items-center justify-center font-black text-2xl">--</div>
      <div class="font-black text-slate-900 uppercase tracking-tighter">Kết quả chấm điểm</div>
    </div>
    <button id="submit-all" class="bg-teal-600 text-white px-12 py-4 rounded-full font-black text-lg hover:scale-105 transition-transform">NỘP BÀI</button>
  </div>

  <main class="max-w-4xl mx-auto py-20 px-6 pb-40">
    <h1 class="text-5xl font-black mb-16 text-center tracking-tighter uppercase border-b-8 border-slate-900 pb-8">{ma_de.replace(/-/g, ' ')}</h1>

    {parts.map((p) => {
      const isWriting = p.Part.toLowerCase().includes("part 6") || p.Part.toLowerCase().includes("part 7");
      return (
        <section class="mb-32 exam-section" data-part={p.Part}>
          <div class="bg-slate-900 text-white inline-block px-8 py-3 rounded-t-3xl font-black text-xl mb-0">{p.Part}</div>
          <div class="bg-white border-4 border-slate-900 p-8 md:p-12 rounded-b-3xl rounded-tr-3xl shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]">
            
            {/* NỘI DUNG ĐỀ: SẼ ĐƯỢC JS BIẾN ĐỔI THÀNH CÁC NÚT BẤM */}
            <div class="content-body" set:html={p.Noi_Dung} />

            {isWriting && (
              <div class="mt-12 pt-12 border-t-4 border-slate-100">
                <p class="font-black text-slate-400 mb-4 uppercase tracking-widest">Your Writing Answer:</p>
                <textarea class="w-full h-64 p-8 bg-slate-50 border-4 border-slate-200 rounded-3xl text-xl outline-none focus:border-teal-500 transition-colors" placeholder="Type your story/message..."></textarea>
                <button class="ai-btn mt-6 w-full bg-slate-900 text-white font-black py-5 rounded-2xl hover:bg-teal-600 transition-all">✨ AI CHẤM ĐIỂM WRITING</button>
                <div class="ai-res hidden mt-8 p-8 bg-teal-50 border-4 border-teal-200 rounded-3xl"></div>
              </div>
            )}
          </div>
        </section>
      )
    })}
  </main>
</Layout>

<script define:vars={{ allAnswers }}>
  // 🎯 MAGIC: BIẾN CHỮ THÀNH NÚT BẤM TRỰC TIẾP TRÊN ĐỀ
  document.querySelectorAll('.content-body').forEach(body => {
    let lastQ = null;
    body.querySelectorAll('p').forEach(p => {
      const txt = p.innerText.trim();
      
      // 1. Nhận diện số câu (VD: "1", "2")
      if (/^\d+$/.test(txt)) {
        lastQ = txt;
        p.className = "q-num-marker font-black text-4xl mt-12 mb-6 text-slate-900 border-l-8 border-slate-900 pl-6";
        return;
      }

      // 2. Nhận diện dòng đáp án (VD: "A notice", "B ...")
      if (lastQ && /^[A-C][\s\.]/.test(txt)) {
        const char = txt[0].toUpperCase();
        p.className = "choice-btn cursor-pointer p-5 mb-3 rounded-2xl border-2 border-slate-100 bg-slate-50 font-bold transition-all hover:bg-white hover:border-teal-400";
        p.setAttribute('data-q', lastQ);
        p.setAttribute('data-opt', char);

        p.onclick = () => {
          body.querySelectorAll(`.choice-btn[data-q="${lastQ}"]`).forEach(el => el.classList.remove('active-choice'));
          p.classList.add('active-choice');
        };
      }
    });
  });

  // 📝 CHẤM ĐIỂM
  document.getElementById('submit-all').onclick = () => {
    let score = 0;
    const choices = document.querySelectorAll('.choice-btn.active-choice');
    
    // Reset màu
    document.querySelectorAll('.choice-btn').forEach(el => el.classList.remove('is-correct', 'is-wrong', 'show-right'));

    choices.forEach(c => {
      const q = c.getAttribute('data-q');
      const opt = c.getAttribute('data-opt');
      if (opt === allAnswers[q]) { score++; c.classList.add('is-correct'); }
      else { c.classList.add('is-wrong'); }
    });

    // Hiện đáp án đúng cho các câu chưa làm hoặc làm sai
    document.querySelectorAll('.choice-btn').forEach(c => {
      if (c.getAttribute('data-opt') === allAnswers[c.getAttribute('data-q')]) c.classList.add('show-right');
    });

    document.getElementById('score-val').innerText = score;
    document.getElementById('submit-all').innerText = "LÀM LẠI";
  };

  // 🤖 AI WRITING
  document.querySelectorAll('.ai-btn').forEach(btn => {
    btn.onclick = async () => {
      const container = btn.parentElement;
      const text = container.querySelector('textarea').value;
      const resBox = container.querySelector('.ai-res');
      if (text.split(' ').length < 15) return alert("Viết dài tí sếp ơi!");

      btn.innerText = "ĐANG CHẤM...";
      const res = await fetch('/api/grade-writing', { method: 'POST', body: JSON.stringify({ userText: text, partName: "A2 Writing" }) });
      const data = await res.json();
      resBox.innerHTML = `<h4 class="font-black text-teal-700 text-2xl mb-4">SCORE: ${data.content+data.organisation+data.language}/15</h4><p class="font-bold text-teal-900">${data.feedback}</p>`;
      resBox.classList.remove('hidden'); btn.classList.add('hidden');
    }
  });
</script>

<style is:global>
  /* CHỐNG ÉP CHỮ - DÀN TRANG TỰ DO */
  .content-body .et_pb_row, .content-body [class*="et_pb_column"] { 
    display: block !important; width: 100% !important; max-width: 100% !important; padding: 0 !important; margin: 0 0 1.5rem 0 !important; float: none !important;
  }
  .content-body p { margin-bottom: 1rem !important; font-size: 1.2rem; line-height: 1.8; color: #334155; }

  /* STYLE BIỂN BÁO PART 1 */
  [data-part*="Part 1"] p[style*="center"], [data-part*="Part 1"] .et_pb_text_align_center {
    border: 6px solid #000 !important; padding: 3rem !important; border-radius: 4px !important; background: #fff !important; font-weight: 900 !important; text-align: center !important; font-size: 1.5rem !important; color: #000 !important; margin: 3rem auto !important; max-width: 500px !important; text-transform: uppercase;
  }

  /* NÚT CHỌN */
  .active-choice { background: #111827 !important; color: #fff !important; border-color: #111827 !important; transform: translateX(10px); }
  .is-correct.active-choice { background: #15803d !important; border-color: #15803d !important; }
  .is-wrong.active-choice { background: #b91c1c !important; border-color: #b91c1c !important; }
  .show-right:not(.active-choice) { border: 4px dashed #15803d !important; color: #15803d !important; }
</style>