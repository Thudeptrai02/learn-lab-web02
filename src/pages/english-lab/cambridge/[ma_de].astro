---
import Layout from '../../../layouts/Layout.astro';
import { getCambridgeData } from '../../../lib/cambridge.js';

export async function getStaticPaths() {
  const catalog = await getCambridgeData();
  // Tự động tạo trang cho tất cả mã đề có trong Sheet
  return Object.keys(catalog).map(id => ({ params: { ma_de: id.toLowerCase().trim() } }));
}

const { ma_de } = Astro.params;
const catalog = await getCambridgeData();
const rows = catalog[ma_de.toLowerCase()] || [];

// Nhóm theo Part
const parts = {};
const allAnswers = {};

rows.forEach(r => {
  const pName = r.part.toUpperCase();
  if (!parts[pName]) parts[pName] = { questions: [] };
  parts[pName].questions.push(r);
  allAnswers[r.so_cau] = r.dap_an.toUpperCase();
});
---

<Layout title={`${ma_de.toUpperCase()} | Test`}>
  {/* THANH ĐIỂM */}
  <div class="fixed bottom-0 left-0 w-full z-50 bg-slate-900 border-t-2 border-teal-500 p-4 flex justify-between items-center text-white">
    <div class="flex items-center gap-4">
      <div id="score-box" class="w-12 h-12 bg-white text-slate-900 rounded-full flex items-center justify-center font-black text-2xl shadow-inner">--</div>
      <span class="font-bold">KẾT QUẢ</span>
    </div>
    <button id="submit-btn" class="bg-teal-500 px-10 py-3 rounded-full font-black hover:bg-teal-400 transition-all shadow-lg">NỘP BÀI CHẤM ĐIỂM</button>
  </div>

  <div id="ans-data" class="hidden">{JSON.stringify(allAnswers)}</div>

  <main class="max-w-4xl mx-auto py-12 px-4 pb-32">
    <h1 class="text-4xl font-black text-slate-900 mb-10 text-center uppercase border-b-4 border-slate-900 pb-4">{ma_de}</h1>

    {Object.keys(parts).map(pName => (
      <section class="mb-16">
        <div class="bg-slate-900 text-white inline-block px-6 py-2 rounded-t-xl font-black tracking-widest">{pName}</div>
        <div class="bg-white border-4 border-slate-900 p-6 md:p-10 rounded-b-xl rounded-tr-xl shadow-[8px_8px_0px_0px_rgba(15,23,42,1)]">
          
          <div class="space-y-12">
            {parts[pName].questions.map(q => (
              <div class="question-item">
                {/* HIỂN THỊ ĐOẠN VĂN HOẶC ẢNH */}
                {q.doan_van && <div class="mb-6 p-4 bg-slate-50 border-2 border-slate-100 rounded-xl" set:html={q.doan_van} />}

                <div class="flex items-start gap-4">
                  <span class="bg-slate-900 text-white w-9 h-9 flex items-center justify-center font-black rounded shrink-0">{q.so_cau}</span>
                  <div class="flex-1">
                    <p class="font-bold text-lg mb-4 text-slate-800" set:html={q.cau_hoi} />
                    
                    {/* ĐÁP ÁN A, B, C */}
                    {q.a && (
                      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        {['a', 'b', 'c'].map(opt => (
                          <label class="ans-label cursor-pointer flex items-center gap-3 p-4 rounded-xl border-2 border-slate-100 bg-slate-50 hover:border-teal-500 transition-all">
                            <input type="radio" name={`q-${q.so_cau}`} value={opt.toUpperCase()} data-q={q.so_cau} class="mt-1 w-4 h-4 accent-teal-600 choice-radio" />
                            <span class="ans-text">
                              <strong class="uppercase">{opt}.</strong> <span set:html={q[opt]} />
                            </span>
                          </label>
                        ))}
                      </div>
                    )}

                    {/* Ô ĐIỀN TỪ (PART 5) */}
                    {!q.a && (
                       <input type="text" data-q={q.so_cau} class="p5-input mt-2 p-3 border-2 border-slate-300 rounded-lg w-full sm:w-64 uppercase font-black text-center focus:border-teal-500 outline-none" placeholder="..." />
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>
</Layout>

<script is:inline>
  const allAnswers = JSON.parse(document.getElementById('ans-data').textContent);

  document.getElementById('submit-btn').onclick = function() {
    let score = 0;
    // Chấm trắc nghiệm
    document.querySelectorAll('.choice-radio').forEach(input => {
      const q = input.getAttribute('data-q');
      const label = input.closest('.ans-label');
      if (input.checked && input.value === allAnswers[q]) score++;
      if (input.value === allAnswers[q]) label.style.borderColor = "#10b981";
      else if (input.checked) label.style.borderColor = "#ef4444";
    });
    // Chấm điền từ
    document.querySelectorAll('.p5-input').forEach(input => {
      const q = input.getAttribute('data-q');
      if (input.value.trim().toUpperCase() === allAnswers[q]) {
        score++;
        input.style.borderColor = "#10b981";
      } else {
        input.style.borderColor = "#ef4444";
        input.value = allAnswers[q];
      }
    });
    document.getElementById('score-box').innerText = score;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
</script>