---
import Layout from '../../../layouts/Layout.astro';

// 1. QUÉT TẤT CẢ FILE JSON ĐỀ THI (Dùng cho Astro 5)
const jsonFiles = import.meta.glob('../../../data/cambridge/*.json', { eager: true });
const tests = Object.values(jsonFiles).map((f: any) => f.default);
---

<Layout title="Cambridge | Learn Lab">
  <main class="min-h-screen bg-emerald-50/40 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-5xl space-y-8">

      {/* BANNER CHÍNH - GIỮ NGUYÊN */}
      <div class="rounded-[28px] border border-emerald-100 bg-white px-6 py-8 shadow-sm sm:px-8 sm:py-10">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.3em] text-emerald-600">English Lab</p>
            <h1 class="mt-3 text-3xl font-extrabold text-slate-900 sm:text-4xl">Cambridge A2 + B1</h1>
            <p class="mt-3 max-w-xl text-base leading-7 text-slate-500">
              Xây nền tiếng Anh chắc từng bước — từ vựng, dictation và bài luyện phù hợp trình độ A2 và B1.
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-2 sm:items-end">
            <span class="inline-flex rounded-full bg-emerald-50 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-emerald-600">
              3 chủ đề · 30 câu dictation
            </span>
            <span class="inline-flex rounded-full bg-emerald-600 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-white">
              Kho {tests.length}+ Đề Thi
            </span>
          </div>
        </div>
      </div>

      {/* CÔNG CỤ LUYỆN TẬP */}
      <div>
        <p class="mb-3 px-1 text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Công cụ luyện tập</p>
        <div class="grid gap-4 sm:grid-cols-3">
          <a href="/english-lab/cambridge/flashcards" class="group flex flex-col rounded-[24px] border border-emerald-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-xl">🃏</div>
            <h2 class="mt-4 text-lg font-extrabold text-slate-900">Flashcards</h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">Lật card, đánh dấu đã thuộc. Từ vựng gần gũi.</p>
          </a>

          <a href="/english-lab/cambridge/dictation" class="group flex flex-col rounded-[24px] border border-emerald-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-xl">🎧</div>
            <h2 class="mt-4 text-lg font-extrabold text-slate-900">Dictation</h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">Nghe câu → gõ lại real-time → xem kết quả xanh/đỏ.</p>
          </a>

          {/* NÚT PRACTICE TESTS - LINK XUỐNG DƯỚI */}
          <a href="#exam-list" class="group flex flex-col rounded-[24px] border border-emerald-200 bg-emerald-600 p-6 shadow-lg transition hover:-translate-y-1">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-white/20 text-white text-xl">📝</div>
            <h2 class="mt-4 text-lg font-extrabold text-white">Practice Tests</h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-emerald-100">
              Làm full bài Test KET/PET được cập nhật tự động từ hệ thống.
            </p>
            <p class="mt-5 text-sm font-bold text-white">Xem danh sách đề ↓</p>
          </a>
        </div>
      </div>

      {/* DANH SÁCH ĐỀ THI ĐÃ CÀO (MỚI THÊM) */}
      <div id="exam-list" class="scroll-mt-24">
        <p class="mb-3 px-1 text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Đề thi sẵn có ({tests.length})</p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-2">
          {tests.map((test) => (
            <a href={`/english-lab/cambridge/${test.test_id}`} class="flex items-center justify-between rounded-[24px] border border-slate-100 bg-white p-5 shadow-sm transition hover:border-emerald-500 hover:shadow-md group">
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 font-black">
                  {test.test_id.split('-')[1] || "01"}
                </div>
                <div>
                  <h3 class="font-extrabold text-slate-900 group-hover:text-emerald-600 transition-colors uppercase text-sm">
                    {test.title}
                  </h3>
                  <p class="text-xs text-slate-400 font-medium">Reading & Writing • 32 Questions</p>
                </div>
              </div>
              <div class="h-8 w-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-300 group-hover:bg-emerald-600 group-hover:text-white transition-all">
                →
              </div>
            </a>
          ))}
        </div>
      </div>

      {/* CHỦ ĐỀ CÓ SẴN - GIỮ NGUYÊN */}
      <div>
        <p class="mb-3 px-1 text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Chủ đề từ vựng</p>
        <div class="grid gap-4 sm:grid-cols-3">
          {/* ... các thẻ Daily Life, Travel... giữ nguyên như file cũ của sếp ... */}
        </div>
      </div>

      <div class="pb-10">
        <a href="/english-lab" class="text-sm font-semibold text-slate-400 hover:text-slate-600 flex items-center gap-2">
          <span>←</span> Quay lại English Lab
        </a>
      </div>

    </div>
  </main>
</Layout>