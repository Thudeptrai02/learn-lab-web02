---
// =================================================================
// ĐƯỜNG DẪN: src/pages/english-lab/cambridge/index.astro
// =================================================================
import Layout from '../../../layouts/Layout.astro';
import Papa from 'papaparse';

let allExams = [];

// 1. QUÉT FILE JSON TRONG MÁY (Dùng lùi 3 cấp: ../../../)
try {
  const jsonFiles = import.meta.glob('../../../data/exams/*.json', { eager: true });
  const jsonExams = Object.keys(jsonFiles).map(path => {
    const fileName = path.split('/').pop().replace('.json', '');
    return {
      id: fileName,
      title: `Reading & Writing: ${fileName.toUpperCase()}`,
      level: 'a2-ket', // Mặc định cho đề JSON là KET hoặc sếp có thể tách từ tên file
      type: 'READING'
    };
  });
  allExams = [...jsonExams];
} catch(e) {
  console.error("Lỗi quét JSON:", e);
}

// 2. HÚT TỪ MASTER SHEET (Link sếp vừa gửi)
const MASTER_URL = 'https://docs.google.com/spreadsheets/d/1KBlvcqTgURW1Z6EGUKL5xkEOE4MX5pIhAVNZ6eecH04/gviz/tq?tqx=out:csv&gid=0';

try {
  const res = await fetch(MASTER_URL);
  const text = await res.text();
  const parsed = Papa.parse(text, { header: true, skipEmptyLines: true });
  
  const sheetExams = parsed.data
    .filter(row => row.ID)
    .map(row => ({
      id: String(row.ID).trim(),
      title: row.Title || String(row.ID).trim(),
      level: String(row.Level || 'a2-ket').toLowerCase().trim(),
      type: 'LISTENING'
    }));
    
  allExams = [...allExams, ...sheetExams];
} catch(e) {
  console.error("Lỗi Google Sheets:", e);
}
---

<Layout title="Thư viện đề thi Cambridge">
  <main class="min-h-screen bg-[#F8FAFC] py-16 px-4 font-['Plus_Jakarta_Sans']">
    <div class="max-w-5xl mx-auto">
      
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 uppercase tracking-tight mb-4">Cambridge English Lab</h1>
        <p class="text-slate-500 font-bold uppercase tracking-widest text-sm flex items-center gap-2">
            <span class="w-8 h-1 bg-blue-500 rounded-full"></span>
            Tất cả trình độ
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {allExams.map((exam) => (
          <a href={`/english-lab/cambridge/${exam.level}/${exam.id.toLowerCase()}`} 
             class="group bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            
            <div class="flex items-center gap-3 mb-4">
              <span class={`text-[10px] font-black px-3 py-1.5 rounded-xl uppercase tracking-widest text-white shadow-lg
                ${exam.type === 'READING' ? 'bg-emerald-500 shadow-emerald-100' : 'bg-blue-500 shadow-blue-100'}`}>
                {exam.type}
              </span>
              <span class="text-slate-300 font-bold text-xs uppercase">{exam.level}</span>
            </div>
            
            <h3 class="text-2xl font-black text-slate-800 leading-tight group-hover:text-blue-600 transition-colors mb-6">
              {exam.title}
            </h3>

            <div class="flex items-center gap-2 text-blue-600 font-black text-sm group-hover:translate-x-2 transition-all">
               LÀM BÀI NGAY 
               <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7-7 7" />
               </svg>
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>
</Layout>