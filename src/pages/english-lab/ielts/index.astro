---
import Layout from '../../../layouts/Layout.astro';

// DANH SÁCH ĐỀ THI (Sếp thêm bớt ở đây, nhớ ID phải khớp tên Tab trên Google Sheet)
const exams = [
  { id: 'Test_1', title: 'IELTS Reading - Test 1', questions: 40, time: 60 },
  { id: 'Test_2', title: 'IELTS Reading - Test 2', questions: 40, time: 60 },
];
---

<Layout title="IELTS | Learn Lab">
  <main class="min-h-screen bg-sky-50/40 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-5xl space-y-12"> <div class="rounded-[28px] border border-sky-100 bg-white px-6 py-8 shadow-sm sm:px-8 sm:py-10">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.3em] text-sky-600">English Lab</p>
            <h1 class="mt-3 text-3xl font-extrabold text-slate-900 sm:text-4xl">IELTS</h1>
            <p class="mt-3 max-w-xl text-base leading-7 text-slate-500">
              Từ vựng, dictation và bài luyện theo từng kỹ năng — học đúng trọng tâm, không lan man.
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-2 sm:items-end">
            <span class="inline-flex rounded-full bg-sky-50 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-sky-600">
              3 chủ đề · 30 câu dictation
            </span>
            <span class="inline-flex rounded-full bg-emerald-50 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-emerald-600">
              Reading Mock Test · Mới
            </span>
          </div>
        </div>
      </div>

      <div>
        <p class="mb-3 px-1 text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Công cụ luyện tập</p>
        <div class="grid gap-4 sm:grid-cols-3">

          <a href="/english-lab/ielts/flashcards" class="group flex flex-col rounded-[24px] border border-sky-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-50 text-xl">🃏</div>
            <h2 class="mt-4 text-lg font-extrabold text-slate-900">Flashcards</h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">
              Lật card, đánh dấu đã thuộc. Học từ vựng học thuật theo chủ đề mỗi ngày 5–10 phút.
            </p>
            <p class="mt-5 text-sm font-semibold text-sky-600 group-hover:text-sky-700">Mở Flashcards →</p>
          </a>

          <a href="/english-lab/ielts/dictation" class="group flex flex-col rounded-[24px] border border-sky-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-50 text-xl">🎧</div>
            <h2 class="mt-4 text-lg font-extrabold text-slate-900">Dictation</h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">
              Nghe câu → gõ lại real-time → xem kết quả xanh/đỏ từng từ. Streak 🔥 khi đúng liên tiếp.
            </p>
            <p class="mt-5 text-sm font-semibold text-sky-600 group-hover:text-sky-700">Luyện Dictation →</p>
          </a>

          <a href="#mock-tests" class="group flex flex-col rounded-[24px] border border-sky-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md ring-2 ring-transparent hover:ring-sky-100">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-50 text-xl shadow-sm">📝</div>
            <div class="mt-4 flex items-center gap-2">
              <h2 class="text-lg font-extrabold text-slate-900">Mock Tests</h2>
              <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-600 animate-pulse">Live</span>
            </div>
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">
              Luyện đề Reading sát với đề thi thật. Giao diện chia đôi chuẩn xác, có giải thích đáp án chi tiết.
            </p>
            <p class="mt-5 text-sm font-semibold text-sky-600 group-hover:text-sky-700">Chọn đề thi →</p>
          </a>

        </div>
      </div>

      <div id="mock-tests" class="scroll-mt-8">
        <p class="mb-3 px-1 text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Thư viện đề thi Reading</p>
        <div class="grid gap-4 sm:grid-cols-2">
          {exams.map((exam) => (
            <div class="group flex flex-col justify-between rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-sky-300 hover:shadow-md">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-flex items-center gap-1.5 rounded-lg bg-sky-50 px-2.5 py-1 text-xs font-bold text-sky-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.132.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5s3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    Reading
                  </span>
                </div>
                <h3 class="text-xl font-extrabold text-slate-900 mb-2">{exam.title}</h3>
                <div class="flex items-center gap-4 text-sm font-medium text-slate-500 mb-6">
                  <span class="flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    {exam.time} phút
                  </span>
                  <span class="flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                    {exam.questions} câu
                  </span>
                </div>
              </div>
              
              <a href={`/english-lab/ielts/${exam.id}`} class="flex w-full items-center justify-center rounded-xl bg-slate-50 py-3 text-sm font-bold text-slate-600 transition group-hover:bg-sky-50 group-hover:text-sky-600">
                Bắt đầu thi →
              </a>
            </div>
          ))}
        </div>
      </div>

      <div>
        <p class="mb-3 px-1 text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Chủ đề có sẵn</p>
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="rounded-[24px] border border-slate-100 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-sky-600">Environment</p>
            <p class="mt-2 text-sm leading-6 text-slate-500">Môi trường, biến đổi khí hậu và phát triển bền vững — chủ đề hay gặp nhất trong IELTS.</p>
            <div class="mt-4 flex gap-2">
              <a href="/english-lab/ielts/dictation" class="rounded-xl bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-600 hover:bg-sky-100">Dictation</a>
              <a href="/english-lab/ielts/flashcards" class="rounded-xl bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-600 hover:bg-sky-100">Flashcard</a>
            </div>
          </div>
          <div class="rounded-[24px] border border-slate-100 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-sky-600">Education</p>
            <p class="mt-2 text-sm leading-6 text-slate-500">Giáo dục, công nghệ trong lớp học và vai trò của giáo viên trong xã hội hiện đại.</p>
            <div class="mt-4 flex gap-2">
              <a href="/english-lab/ielts/dictation" class="rounded-xl bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-600 hover:bg-sky-100">Dictation</a>
              <a href="/english-lab/ielts/flashcards" class="rounded-xl bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-600 hover:bg-sky-100">Flashcard</a>
            </div>
          </div>
          <div class="rounded-[24px] border border-slate-100 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-sky-600">Health & Lifestyle</p>
            <p class="mt-2 text-sm leading-6 text-slate-500">Sức khỏe thể chất, sức khỏe tâm thần và lối sống lành mạnh trong xã hội hiện đại.</p>
            <div class="mt-4 flex gap-2">
              <a href="/english-lab/ielts/dictation" class="rounded-xl bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-600 hover:bg-sky-100">Dictation</a>
              <a href="/english-lab/ielts/flashcards" class="rounded-xl bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-600 hover:bg-sky-100">Flashcard</a>
            </div>
          </div>
        </div>
      </div>

      <div class="pb-4">
        <a href="/english-lab" class="text-sm font-semibold text-slate-400 hover:text-slate-600">
          ← Quay lại English Lab
        </a>
      </div>

    </div>
  </main>
</Layout>