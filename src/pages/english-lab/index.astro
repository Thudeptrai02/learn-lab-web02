---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Learn Lab | Nền tảng luyện thi TOEIC, IELTS & Cambridge thông minh">
  
  <main class="w-full overflow-hidden">
    
    <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28">
      <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-teal-500/20 bg-teal-500/10 px-4 py-2 text-xs font-bold text-teal-300 shadow-sm backdrop-blur-sm">
          <span class="flex h-2 w-2 rounded-full bg-teal-400 animate-pulse"></span>
          Cập nhật thuật toán Flashcard 2.0
        </div>

        <h1 class="mx-auto max-w-4xl text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.1] reveal">
          Làm chủ tiếng Anh
          <span class="bg-gradient-to-r from-teal-300 via-teal-400 to-emerald-300 bg-clip-text text-transparent filter drop-shadow-[0_0_30px_rgba(13,222,180,0.15)]">dễ dàng hơn bao giờ hết.</span>
        </h1>

        <p class="mx-auto mt-8 max-w-2xl text-base md:text-lg leading-relaxed text-slate-400 reveal stagger-1">
          Nền tảng luyện thi TOEIC, IELTS ứng dụng phương pháp <strong class="text-white">Spaced Repetition</strong> và <strong class="text-white">AI Dictation</strong>. Tối ưu thời gian, tăng điểm thần tốc.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row reveal stagger-2">
          <a id="hero-main-btn" href="/login" class="group btn-premium w-full bg-teal-400 text-neutral-950 shadow-[0_0_35px_rgba(13,222,180,0.25)] hover:bg-teal-300 hover:shadow-[0_0_45px_rgba(13,222,180,0.4)] hover:-translate-y-0.5 px-8 py-4 text-lg duration-300 cursor-pointer sm:w-auto">
            Bắt đầu học ngay
            <span class="ml-2 w-7 h-7 rounded-full bg-neutral-950/10 flex items-center justify-center transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-[1px]">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section id="ecosystem" class="py-24 relative border-t border-white/5 bg-neutral-950/20">
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        
        <div class="text-center max-w-3xl mx-auto mb-20 reveal">
          <span class="text-[10px] uppercase tracking-[0.2em] font-black text-teal-400 bg-teal-500/10 px-3.5 py-1.5 rounded-full border border-teal-500/20">Nội dung học tập</span>
          <h2 class="text-3xl md:text-5xl font-black text-white tracking-tight mt-6">Hệ sinh thái English Lab</h2>
          <p class="mt-4 text-base md:text-lg text-slate-400 leading-relaxed">Bốn trụ cột giúp bạn phát triển toàn diện cả Từ vựng, Ngữ pháp, Kỹ năng Nghe và Chiến thuật làm bài.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- Smart Flashcards -->
          <a href="/english-lab/toeic/flashcards" class="group relative rounded-[28px] overflow-hidden min-h-[260px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/5 bg-neutral-950/40 p-1.5 reveal stagger-1">
            <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
              <div class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" /></svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Smart Flashcards</h3>
              <p class="text-slate-400 leading-relaxed text-sm mb-6">Học từ vựng lặp lại ngắt quãng giúp nhớ lâu gấp 3 lần.</p>
              <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
                Học ngay
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </span>
            </div>
          </a>

          <!-- Lego Grammar -->
          <a href="/lego" class="group relative rounded-[28px] overflow-hidden min-h-[260px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(16,185,129,0.1)] border border-white/5 bg-gradient-to-br from-emerald-950/20 via-neutral-950/70 to-slate-950/40 p-1.5 reveal stagger-1">
            <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
              <div class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 group-hover:bg-emerald-500 group-hover:text-neutral-950 transition-colors duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Lego Grammar</h3>
              <p class="text-slate-400 leading-relaxed text-sm mb-6">Học ngữ pháp trực quan. Lắp ghép khối màu thành câu chuẩn S-V-O.</p>
              <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
                Chơi ngay
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </span>
            </div>
          </a>

          <!-- Pro Dictation -->
          <a href="/english-lab/toeic/dictation" class="group relative rounded-[28px] overflow-hidden min-h-[260px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/5 bg-neutral-950/40 p-1.5 reveal stagger-2">
            <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
              <div class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Pro Dictation</h3>
              <p class="text-slate-400 leading-relaxed text-sm mb-6">Nghe chép chính tả với hệ thống kiểm tra lỗi ngay khi gõ.</p>
              <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
                Luyện ngay
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </span>
            </div>
          </a>

          <!-- Mock Exams -->
          <a href="/english-lab/toeic" class="group relative rounded-[28px] overflow-hidden min-h-[260px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/5 bg-neutral-950/40 p-1.5 reveal stagger-2">
            <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
              <div class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Mock Exams</h3>
              <p class="text-slate-400 leading-relaxed text-sm mb-6">Kho đề thi thử cập nhật mới. Giải thích đáp án chi tiết.</p>
              <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
                Luyện thi
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </span>
            </div>
          </a>

          <!-- Vocab in Context -->
          <a href="/english-lab/toeic/vocab-context" class="group relative rounded-[28px] overflow-hidden min-h-[260px] flex transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] border border-white/5 bg-neutral-950/40 p-1.5 reveal stagger-3 md:col-span-2">
            <div class="relative w-full h-full rounded-[22px] bg-neutral-950/30 p-8 flex flex-col justify-end overflow-hidden">
              <div class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-500/10 border border-teal-500/20 text-teal-400 group-hover:bg-teal-500 group-hover:text-neutral-950 transition-colors duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Vocab in Context (AI)</h3>
              <p class="text-slate-400 leading-relaxed text-sm mb-6">Tăng tốc độ nhớ từ vựng bằng cách học qua ngữ cảnh. AI sẽ tạo ra các đoạn văn chuẩn TOEIC chứa những từ bạn muốn học kèm theo bài tập đọc hiểu tự động.</p>
              <span class="inline-flex items-center gap-2 text-xs font-bold text-teal-400 group-hover:gap-3.5 transition-all duration-300">
                Trải nghiệm ngay
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </span>
            </div>
          </a>

        </div>
      </div>
    </section>

  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase.js';

  const heroMainBtn = document.getElementById('hero-main-btn');

  // --- KIỂM TRA TRẠNG THÁI ĐĂNG NHẬP ---
  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();

    if (session && heroMainBtn) {
      // Đổi nút "Bắt đầu học ngay" thành "Tiếp tục học tập" và trượt xuống khu vực học tập
      heroMainBtn.href = "#ecosystem";
      heroMainBtn.innerHTML = `Tiếp tục học tập <span class="ml-2 w-7 h-7 rounded-full bg-neutral-950/10 flex items-center justify-center transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-[1px]"><svg class="w-4 h-4 text-neutral-950 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg></span>`;
    }
  }

  checkAuth();

  // Scroll entry animation
  document.addEventListener('DOMContentLoaded', () => {
    const reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(el => observer.observe(el));
    }
  });
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    filter: blur(8px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
  .stagger-1 { transition-delay: 150ms; }
  .stagger-2 { transition-delay: 300ms; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; filter: none; }
  }
</style>