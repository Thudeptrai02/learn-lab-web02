---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="TOEIC Reading - PDF Viewer">
  <div class="h-screen w-full flex flex-col">
    
    {/* Header */}
    <header class="bg-slate-900 text-white px-4 py-3 flex items-center justify-between shrink-0">
      <a href="/english-lab/toeic" class="hover:text-indigo-300 transition-colors">
        ← Quay lại
      </a>
      <h1 class="text-base font-semibold">TEST 1 - Reading Comprehension</h1>
      <div class="w-16"></div>
    </header>

    {/* PDF Viewer - dùng thẻ object đơn giản */}
    <object
      data="/pdfs/SCRIPT%20RC_1.pdf"
      type="application/pdf"
      class="w-full flex-1"
      style="min-height: calc(100vh - 60px);"
    >
      <p>Trình duyệt không hỗ trợ xem PDF. 
         <a href="/pdfs/SCRIPT%20RC_1.pdf">Tải file PDF</a>
      </p>
    </object>

  </div>
</Layout>