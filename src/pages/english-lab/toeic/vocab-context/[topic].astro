---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';

const { topic } = Astro.params;
const decodedTopic = decodeURIComponent(topic);

// Tìm bài đọc đã sinh sẵn
const allPassages = import.meta.glob('../../../../data/passages/*.json', { eager: true });
const targetKey = Object.keys(allPassages).find(key => key.endsWith(`/${decodedTopic}.json`));
const passageData = targetKey ? (allPassages[targetKey].default || allPassages[targetKey]) : null;

// Tìm danh sách từ vựng gốc
const allVocabs = import.meta.glob('../../../../data/**/*.json', { eager: true });
const vocabKey = Object.keys(allVocabs).find(key => key.endsWith(`/${decodedTopic}.json`) && !key.includes('/exams/') && !key.includes('/passages/'));
const vocabData = vocabKey ? (allVocabs[vocabKey].default || allVocabs[vocabKey]) : [];
const words = Array.isArray(vocabData) ? vocabData.map(item => item.word).filter(Boolean) : [];

if (!passageData) {
  // Nếu chưa có bài đọc, render màn hình báo lỗi nhẹ nhàng
  return new Response(`
    <html><head><meta charset="UTF-8"><title>Chưa có bài đọc</title><script src="https://cdn.tailwindcss.com"></script></head>
    <body class="bg-slate-50 min-h-screen flex items-center justify-center p-4">
      <div class="bg-white p-8 rounded-2xl shadow-sm border max-w-md text-center">
        <h1 class="text-2xl font-bold text-slate-800 mb-2">Chưa có bài đọc!</h1>
        <p class="text-slate-500 mb-6">Chủ đề <strong>${topic}</strong> chưa được Admin tạo bài đọc. Vui lòng quay lại sau nhé.</p>
        <a href="/english-lab/toeic/flashcards/${topic}" class="px-5 py-2.5 bg-teal-600 text-white font-bold rounded-lg hover:bg-teal-700">Quay lại Flashcard</a>
      </div>
    </body></html>
  `, {
    status: 404,
    headers: { 'Content-Type': 'text/html; charset=utf-8' }
  });
}

// Bôi đậm từ vựng trong bài đọc
let enText = passageData.passage_en;
words.forEach(word => {
  if (word.length > 2) {
    const escapeRegExp = (str) => str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp("\\b(" + escapeRegExp(word) + ")\\b", 'gi');
    enText = enText.replace(regex, '<span class="text-teal-400 font-black bg-teal-500/10 px-1.5 py-0.5 rounded-md border border-teal-500/20 shadow-sm">$1</span>');
  }
});

const pageTitle = `Luyện tập: ${topic.toUpperCase()}`;
const clientData = JSON.stringify(passageData.questions);
---

<Layout title={pageTitle}>
  <Header />
  
  <main class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    
    <div class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <a href={`/english-lab/toeic/flashcards/${topic}`} class="text-[11px] font-black uppercase tracking-widest text-slate-400 hover:text-teal-500 transition-colors flex items-center gap-2 mb-3">
           <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
           Quay lại bài Flashcard
        </a>
        <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight">{pageTitle}</h1>
      </div>
      <div class="px-5 py-2.5 rounded-2xl bg-slate-900 text-white shadow-lg flex items-center gap-2 border border-slate-800 self-start">
        <span class="text-[10px] text-teal-400 uppercase tracking-widest font-bold">Chế độ</span>
        <span class="font-bold text-sm">Đọc Hiểu</span>
      </div>
    </div>

    <!-- Kết quả -->
    <div class="space-y-8">
      
      <!-- Đoạn văn -->
      <div class="bg-slate-900 rounded-[2rem] shadow-2xl border border-slate-800 p-8 md:p-10 relative overflow-hidden">
        <!-- Background decoration -->
        <div class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 rounded-full bg-teal-500/10 blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-64 h-64 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"></div>
        
        <div class="relative z-10">
          <h2 class="text-xl font-black text-white mb-8 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 text-teal-400 flex items-center justify-center backdrop-blur-sm border border-white/5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            </div>
            Đoạn văn Ngữ cảnh
          </h2>
          
          <div class="text-slate-300 text-lg md:text-[19px] leading-[1.8] whitespace-pre-line mb-8 font-medium" set:html={enText}></div>
          
          <div class="border-t border-white/10 pt-6">
            <button id="toggleTranslationBtn" class="text-teal-400 text-sm font-bold hover:text-teal-300 transition-all flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path></svg>
              <span>Hiển thị bản dịch tiếng Việt</span>
            </button>
            <div id="passageVi" class="text-slate-400 italic whitespace-pre-line hidden border-l-2 border-teal-500/30 pl-5 py-2 mt-4 text-[15px] leading-relaxed bg-white/5 rounded-r-xl p-4">{passageData.passage_vi}</div>
          </div>
        </div>
      </div>

      <!-- Bài tập -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-200 p-8 md:p-10">
        <h2 class="text-xl font-black text-slate-900 mb-8 flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-100">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
          </div>
          Kiểm tra Mức độ Hiểu
        </h2>
        
        <div id="questionsContainer" class="space-y-8">
          {passageData.questions.map((q, qIndex) => (
            <div class="question-block p-6 md:p-8 bg-slate-50 rounded-2xl border border-slate-200 transition-all">
              <p class="font-bold text-slate-900 mb-6 text-lg leading-relaxed">{qIndex + 1}. {q.question}</p>
              <div class="space-y-3 flex flex-col pl-1 md:pl-4">
                {q.options.map((opt, optIndex) => {
                  const cleanOpt = opt.replace(/^[A-D]\.\s*/i, '');
                  const labelText = ['A', 'B', 'C', 'D'][optIndex] + '. ' + cleanOpt;
                  return (
                    <label class={`flex items-start gap-4 p-4 rounded-xl hover:bg-white hover:shadow-sm cursor-pointer transition-all border border-transparent hover:border-slate-200 option-label-${qIndex}-${optIndex}`}>
                      <input type="radio" name={`q${qIndex}`} value={optIndex} class="mt-1 w-5 h-5 text-teal-600 focus:ring-teal-500 border-slate-300" />
                      <span class="text-slate-800 font-medium text-[15px]">{labelText}</span>
                    </label>
                  );
                })}
              </div>
              <div id={`explanation-${qIndex}`} class="mt-6 p-5 rounded-xl bg-teal-50/50 text-slate-700 text-[15px] leading-relaxed hidden border border-teal-100 animate-fade-in shadow-inner">
                <strong class="text-teal-700 uppercase tracking-widest text-[11px] mb-2 block font-black flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  Giải thích chi tiết
                </strong>
                {q.explanation}
              </div>
            </div>
          ))}
        </div>
        
        <button 
          id="submitAnswersBtn" 
          class="mt-10 px-6 py-5 bg-teal-600 hover:bg-teal-700 text-white font-black text-[15px] uppercase tracking-wider rounded-2xl transition-all w-full shadow-xl shadow-teal-600/20 hover:-translate-y-1"
        >
          Nộp Bài & Xem Giải Thích
        </button>
      </div>
      
    </div>
  </main>
</Layout>

<style>
  .animate-fade-in { animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script define:vars={{ clientData }}>
  const questions = JSON.parse(clientData);

  const toggleTranslationBtn = document.getElementById('toggleTranslationBtn');
  const passageVi = document.getElementById('passageVi');
  const submitAnswersBtn = document.getElementById('submitAnswersBtn');

  // Toggle Translation
  if (toggleTranslationBtn && passageVi) {
    toggleTranslationBtn.addEventListener('click', () => {
      passageVi.classList.toggle('hidden');
      if (passageVi.classList.contains('hidden')) {
        toggleTranslationBtn.textContent = '+ Xem bản dịch tiếng Việt';
      } else {
        toggleTranslationBtn.textContent = '- Ẩn bản dịch';
      }
    });
  }

  // Submit answers
  if (submitAnswersBtn) {
    submitAnswersBtn.addEventListener('click', () => {
      let score = 0;
      let allAnswered = true;
      
      questions.forEach((q, qIndex) => {
        const selected = document.querySelector(`input[name="q${qIndex}"]:checked`);
        if (!selected) {
          allAnswered = false;
        }
      });

      if (!allAnswered && !confirm("Bạn chưa trả lời hết các câu hỏi. Vẫn muốn nộp bài?")) {
        return;
      }
      
      questions.forEach((q, qIndex) => {
        const selected = document.querySelector(`input[name="q${qIndex}"]:checked`);
        const selectedVal = selected ? parseInt(selected.value) : -1;
        
        q.options.forEach((_, optIndex) => {
          const label = document.querySelector(`.option-label-${qIndex}-${optIndex}`);
          label.classList.remove('hover:bg-slate-200', 'cursor-pointer'); 
          
          if (optIndex === q.correct_answer_index) {
            label.classList.add('bg-green-100', 'border', 'border-green-300');
          } else if (optIndex === selectedVal) {
            label.classList.add('bg-rose-100', 'border', 'border-rose-300');
          } else {
            label.classList.add('opacity-50');
          }
          
          const radio = document.querySelector(`input[name="q${qIndex}"][value="${optIndex}"]`);
          if (radio) radio.disabled = true;
        });
        
        if (selectedVal === q.correct_answer_index) {
          score++;
        }

        const exp = document.getElementById(`explanation-${qIndex}`);
        if(exp) exp.classList.remove('hidden');
      });

      submitAnswersBtn.textContent = `Thành tích: ${score}/${questions.length} câu đúng`;
      submitAnswersBtn.disabled = true;
      submitAnswersBtn.className = "mt-8 px-6 py-4 bg-slate-800 text-white font-black text-[15px] uppercase tracking-wider rounded-xl transition-all w-full opacity-90 cursor-default";
      
      // Auto scroll to top of questions
      document.getElementById('questionsContainer').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>
