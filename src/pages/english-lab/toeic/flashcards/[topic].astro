---
import Layout from '../../../../layouts/Layout.astro';

// 1. DÀNH CHO SSG
export async function getStaticPaths() {
  const jsonFilesPaths = import.meta.glob('../../../../data/**/*.json', { eager: true });
  let cardsData = [];
  Object.values(jsonFilesPaths).forEach(file => {
    const fileData = file.default || [];
    const validCards = fileData.filter(c => c.word && String(c.word).trim() !== '' && c.topic && String(c.topic).trim() !== '');
    cardsData = [...cardsData, ...validCards];
  });

  const uniqueTopics = [...new Set(cardsData.map(c => String(c.topic).trim()))];
  
  return uniqueTopics.map(t => {
    return { params: { topic: t } };
  });
}

// 2. LOGIC LẤY DATA DÀNH CHO SSR 
const { topic } = Astro.params;

const jsonFiles = import.meta.glob('../../../../data/**/*.json', { eager: true });
let allCards = [];
Object.values(jsonFiles).forEach(file => {
  const fileData = file.default || [];
  const validCards = fileData.filter(c => c.word && String(c.word).trim() !== '' && c.topic && String(c.topic).trim() !== '');
  allCards = [...allCards, ...validCards];
});

const decodedTopic = decodeURIComponent(topic);
let cards = allCards.filter(c => String(c.topic).trim() === decodedTopic);

let topicName = decodedTopic.replace(/-/g, ' ').toUpperCase();

if (!cards || cards.length === 0) {
  cards = [{ word: 'Trống', meaning: 'Chưa có dữ liệu', partOfSpeech: '-', example: '', synonyms: '' }];
}
---

<Layout title={`${topicName} - Flashcards | Learn Lab`}>
  <main class="min-h-screen bg-slate-50 px-4 py-10 sm:px-6 lg:px-8 lg:py-14 overflow-x-hidden">
    <section class="mx-auto max-w-4xl rounded-2xl border border-slate-200 bg-white px-4 py-8 shadow-sm sm:px-10 sm:py-10">
      
      <!-- HEADER PHÒNG HỌC -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-8">
        <div>
          <a href="/english-lab/toeic/flashcards" class="text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-teal-600 transition-colors">&larr; Trở về kho từ vựng</a>
          <h1 class="mt-2 text-2xl font-extrabold text-slate-900 sm:text-3xl"><span class="text-teal-600">{topicName}</span></h1>
        </div>
        <div class="inline-flex rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 shadow-inner">
          <span id="progress-text">Đang tải...</span>
        </div>
      </div>

      <!-- KHU VỰC THẺ 3D -->
      <div id="flashcards-view">
        <div id="card-stage" class="relative mx-auto max-w-md h-[400px] transition-all duration-300 ease-out">
          
          <div class="absolute inset-x-6 top-4 bottom-0 rounded-3xl bg-slate-100 border border-slate-200"></div>
          <div class="absolute inset-x-3 top-2 bottom-0 rounded-3xl bg-slate-50 border border-slate-200 shadow-sm"></div>

          <div class="[perspective:1200px] relative z-10 w-full h-full">
            <button id="flashcard" class="group relative block w-full h-full text-left focus:outline-none cursor-pointer" aria-label="Flip flashcard">
              <div id="flashcard-inner" class="relative w-full h-full rounded-3xl transition-transform duration-700 [transform-style:preserve-3d]">
                
                <!-- MẶT TRƯỚC (TIẾNG ANH) -->
                <div class="absolute inset-0 w-full h-full flex flex-col rounded-3xl border-2 border-slate-100 bg-white p-8 shadow-xl [backface-visibility:hidden]">
                  <p class="text-xs font-bold uppercase tracking-widest text-slate-300">Front</p>
                  <div class="flex flex-1 flex-col items-center justify-center text-center">
                    <p class="mt-2 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-slate-500 mb-4" id="card-pos-front">POS</p>
                    <h2 id="card-word" class="text-4xl sm:text-5xl font-black text-slate-800 tracking-tight">Word</h2>
                    <p id="card-ipa" class="text-lg text-teal-600 font-medium mt-2">/ipa/</p>
                    <p id="card-example" class="mt-6 text-base text-slate-600 font-medium leading-relaxed italic">"Example"</p>
                  </div>
                  <p class="text-center text-sm font-bold text-slate-300 animate-pulse">Nhấp để lật thẻ</p>
                </div>

                <!-- MẶT SAU (TIẾNG VIỆT) -->
                <div class="absolute inset-0 w-full h-full flex flex-col rounded-3xl border border-slate-700 bg-gradient-to-br from-slate-800 to-slate-900 p-8 shadow-xl [backface-visibility:hidden] [transform:rotateY(180deg)] text-white">
                  <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Back</p>
                  <div class="flex flex-1 flex-col items-center justify-center text-center">
                    <p class="mt-2 inline-flex rounded-full bg-slate-700 px-3 py-1 text-xs font-bold uppercase tracking-widest text-teal-400 mb-4" id="card-pos-back">POS</p>
                    <h3 id="card-meaning" class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight">Meaning</h3>
                    
                    <div class="mt-8 w-full rounded-2xl bg-slate-800/80 p-5 border border-slate-700">
                      <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Từ đồng nghĩa</p>
                      <div id="card-synonyms" class="flex flex-wrap gap-2 justify-center"></div>
                    </div>
                  </div>
                  <p class="text-center text-sm font-bold text-slate-500">Nhấp để xem lại mặt trước</p>
                </div>

              </div>
            </button>
          </div>
        </div>

        <!-- NÚT ĐIỀU KHIỂN -->
        <div id="study-actions" class="mt-12 mx-auto grid max-w-md gap-4 grid-cols-2">
          <button id="not-known" class="inline-flex items-center justify-center rounded-2xl border-2 border-rose-100 bg-white px-5 py-4 text-sm font-bold text-rose-500 transition-all hover:bg-rose-50 hover:border-rose-200">
            Chưa thuộc
          </button>
          <button id="known" class="inline-flex items-center justify-center rounded-2xl bg-teal-600 px-5 py-4 text-sm font-bold text-white transition-all hover:bg-teal-500 shadow-lg shadow-teal-200">
            Đã thuộc
          </button>
        </div>

        <!-- MÀN HÌNH HOÀN THÀNH -->
        <div id="done-box" class="mt-10 hidden mx-auto max-w-md rounded-3xl border-2 border-teal-100 bg-white p-10 text-center shadow-xl">
          <div class="text-6xl mb-6">🎉</div>
          <h3 class="text-2xl font-black text-slate-800">Tuyệt vời sếp ơi!</h3>
          <p class="mt-2 text-sm font-medium text-slate-500 mb-8">Bạn đã hoàn thành toàn bộ từ vựng của chủ đề này.</p>
          <div class="flex justify-center">
            <a href="/english-lab/toeic/flashcards" class="inline-flex items-center justify-center rounded-xl bg-teal-600 px-8 py-3 text-sm font-bold text-white transition-all hover:bg-teal-500 shadow-lg shadow-teal-200">
              Học chủ đề khác
            </a>
          </div>
        </div>
      </div>

    </section>
  </main>
</Layout>

<script define:vars={{ cards }}>
  let learningQueue = [...cards]; 
  let currentIndex = 0;
  let isFlipped = false;
  let isAnimating = false;

  const progress = document.getElementById('progress-text');
  const flashcard = document.getElementById('flashcard');
  const flashcardInner = document.getElementById('flashcard-inner');
  const cardStage = document.getElementById('card-stage');

  const word = document.getElementById('card-word');
  const ipa = document.getElementById('card-ipa');
  const example = document.getElementById('card-example');
  const meaning = document.getElementById('card-meaning');
  const posFront = document.getElementById('card-pos-front');
  const posBack = document.getElementById('card-pos-back');
  const synonymsContainer = document.getElementById('card-synonyms');

  const knownBtn = document.getElementById('known');
  const notKnownBtn = document.getElementById('not-known');
  const doneBox = document.getElementById('done-box');
  const studyActions = document.getElementById('study-actions');

  function playWordAudio(wordText) {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel(); 
      const utterance = new SpeechSynthesisUtterance(wordText);
      utterance.lang = 'en-US'; 
      utterance.rate = 0.9;     
      window.speechSynthesis.speak(utterance);
    }
  }

  function resetCardFace() {
    isFlipped = false;
    flashcardInner?.style.setProperty('transform', 'rotateY(0deg)');
  }

  function renderCard() {
    const card = learningQueue[currentIndex];
    if (!card) return;

    if (progress) progress.textContent = `Còn ${learningQueue.length - currentIndex} thẻ`;
    
    if (word) word.textContent = card.word || 'Unknown';
    if (ipa) ipa.textContent = card.ipa ? card.ipa : '';
    if (example) example.textContent = card.example ? `"${card.example}"` : "";
    if (meaning) meaning.textContent = card.meaning || 'Chưa có nghĩa';
    if (posFront) posFront.textContent = card.partOfSpeech || '-';
    if (posBack) posBack.textContent = card.partOfSpeech || '-';
    
    if (synonymsContainer) {
      synonymsContainer.innerHTML = ''; 
      let synArray = [];
      if (typeof card.synonyms === 'string' && card.synonyms.trim() !== '') {
         synArray = card.synonyms.split(',').map(s => s.trim());
      } else if (Array.isArray(card.synonyms)) {
         synArray = card.synonyms;
      }

      if (synArray.length > 0) {
        synArray.forEach(syn => {
          const span = document.createElement('span');
          span.className = 'px-3 py-1 bg-slate-700/50 rounded-lg text-sm font-bold text-slate-300 border border-slate-600';
          span.textContent = syn;
          synonymsContainer.appendChild(span);
        });
      } else {
        synonymsContainer.innerHTML = '<span class="text-slate-500 text-sm font-medium">Không có dữ liệu</span>';
      }
    }
    resetCardFace();
  }

  function flipCard() {
    if (isAnimating) return;
    if (!isFlipped) {
      isFlipped = true;
      flashcardInner?.style.setProperty('transform', 'rotateY(180deg)');
      playWordAudio(learningQueue[currentIndex].word);
    } else {
      isFlipped = false;
      flashcardInner?.style.setProperty('transform', 'rotateY(0deg)');
    }
  }

  function animateNextCard() {
    if (!cardStage) return Promise.resolve();
    return new Promise((resolve) => {
      cardStage.style.opacity = '0';
      cardStage.style.transform = 'translateX(70px) rotate(4deg) scale(0.96)';
      setTimeout(() => resolve(), 260);
    });
  }

  function animateCardIn() {
    if (!cardStage) return;
    cardStage.style.opacity = '0';
    cardStage.style.transform = 'translateX(-70px) rotate(-4deg) scale(0.96)';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        cardStage.style.opacity = '1';
        cardStage.style.transform = 'translateX(0) rotate(0deg) scale(1)';
      });
    });
  }

  async function handleCardAnswer(isKnown) {
    if (isAnimating) return;
    isAnimating = true;
    await animateNextCard();

    if (!isKnown) {
      learningQueue.push(learningQueue[currentIndex]);
    }

    currentIndex += 1;

    if (currentIndex >= learningQueue.length) {
      flashcard?.classList.add('hidden');
      cardStage?.classList.add('hidden');
      studyActions?.classList.add('hidden');
      doneBox?.classList.remove('hidden');
      if (progress) progress.textContent = `Hoàn thành!`;
      isAnimating = false;
      return;
    }

    renderCard();
    animateCardIn();
    setTimeout(() => { isAnimating = false; }, 280);
  }

  flashcard?.addEventListener('click', flipCard);
  knownBtn?.addEventListener('click', () => handleCardAnswer(true));
  notKnownBtn?.addEventListener('click', () => handleCardAnswer(false));

  if (cardStage) {
    cardStage.style.opacity = '1';
    cardStage.style.transform = 'translateX(0) rotate(0deg) scale(1)';
  }

  renderCard();
</script>