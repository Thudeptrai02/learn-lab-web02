---
import Layout from '../../../../layouts/Layout.astro';

// 🚀 ĐƯỜNG DẪN 5 CẤP: Đảm bảo tìm đúng thư mục data ở thư mục gốc
const flashcardModules = import.meta.glob('../../../../../data/TOEIC_FLASH CARD/*.json', { eager: true });

// Xử lý dữ liệu và lấy số để sắp xếp
const allDays = Object.entries(flashcardModules).map(([path, module]) => {
  const fileName = path.split('/').pop().replace('.json', '');
  const dayNumber = parseInt(fileName.match(/\d+/)?.[0] || '0');
  
  return { 
    name: fileName.toUpperCase(), 
    order: dayNumber, 
    count: (module.default || module).length || 0 
  };
});

// Sắp xếp tự nhiên (1, 2, 3... thay vì 1, 10, 11)
allDays.sort((a, b) => a.order - b.order);

// Gom nhóm 10 ngày / chặng
const chunks = [];
for (let i = 0; i < allDays.length; i += 10) {
  chunks.push({
    title: `CHẶNG ${chunks.length + 1}`,
    range: `Ngày ${i + 1} - ${Math.min(i + 10, allDays.length)}`,
    days: allDays.slice(i, i + 10)
  });
}
---

<Layout title="TOEIC Flashcards - Hacker Series">
  <div class="max-w-5xl mx-auto p-6 bg-slate-50 min-h-screen font-sans">
    <div class="mb-10 text-center">
      <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter mb-2">
        Hacker TOEIC Vocabulary
      </h1>
      <p class="text-slate-500 font-medium">30 ngày chinh phục từ vựng mục tiêu 800+</p>
    </div>

    <div class="space-y-8">
      {chunks.map((chunk, idx) => (
        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
          
          <div class="p-6 bg-slate-900 flex justify-between items-center text-white">
            <div>
              <h2 class="font-black text-xl tracking-tight">{chunk.title}</h2>
              <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mt-1">{chunk.range}</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-teal-500 flex items-center justify-center font-black text-lg shadow-inner">
              0{idx + 1}
            </div>
          </div>
          
          <div class="p-6 grid grid-cols-2 sm:grid-cols-5 gap-4">
            {chunk.days.map((day) => (
              <a 
                href={`/english-lab/toeic/flashcards/${day.order}`} 
                class="flex flex-col items-center justify-center p-5 rounded-2xl border-2 border-slate-50 bg-slate-50 hover:border-teal-500 hover:bg-white hover:shadow-xl transition-all group text-center"
              >
                <span class="text-[10px] font-black text-slate-400 group-hover:text-teal-500 uppercase tracking-widest mb-1">Day</span>
                <span class="text-3xl font-black text-slate-800 group-hover:text-teal-600 leading-none mb-3">{day.order}</span>
                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-slate-200 text-slate-500 group-hover:bg-teal-100 group-hover:text-teal-700 transition-colors">
                  {day.count} từ
                </span>
              </a>
            ))}
          </div>
          
        </div>
      ))}
    </div>
  </div>
</Layout>