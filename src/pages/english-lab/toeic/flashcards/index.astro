---
import Layout from '../../../../layouts/Layout.astro';

// 🚀 1. QUÉT TOÀN BỘ FILE JSON TRONG THƯ MỤC DATA (Loại trừ thư mục exams)
const allFiles = import.meta.glob('../../../../data/**/*.json', { eager: true });
const vocabFiles = Object.entries(allFiles).filter(([path]) => !path.includes('/exams/'));

// 🚀 2. TỰ ĐỘNG GOM NHÓM THEO TÊN THƯ MỤC
const collections = {};

vocabFiles.forEach(([path, module]) => {
  const parts = path.split('/');
  const fileName = parts.pop().replace('.json', ''); // VD: Day 1, Part 1
  const folderName = parts.pop().replace(/_/g, ' '); // VD: TOEIC FLASH CARD, SYNONYMS

  if (!collections[folderName]) collections[folderName] = [];

  // Trích xuất số để sắp xếp thông minh (VD: Day 1, Day 2...)
  const order = parseInt(fileName.match(/\d+/)?.[0] || '0');
  
  collections[folderName].push({
    name: fileName,
    order: order,
    count: (module.default || module).length || 0
  });
});

// 🚀 3. SẮP XẾP BÀI HỌC BÊN TRONG TỪNG THƯ MỤC
const groupedData = Object.keys(collections).map(folder => {
  const items = collections[folder];
  items.sort((a, b) => a.order - b.order); // Sắp xếp theo số thứ tự
  return {
    title: folder.toUpperCase(),
    items: items
  };
});
---

<Layout title="Kho Từ Vựng | Learn Lab">
  <div class="max-w-6xl mx-auto p-6 bg-slate-50 min-h-screen font-sans">
    
    <div class="mb-12 text-center mt-4">
      <h1 class="text-4xl md:text-5xl font-black text-slate-900 uppercase tracking-tighter mb-3">
        Hệ Thống Từ Vựng
      </h1>
      <p class="text-slate-500 font-medium text-lg">Chọn bộ từ vựng bạn muốn ôn luyện hôm nay</p>
    </div>

    <div class="space-y-12">
      {groupedData.map((group) => (
        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-200 overflow-hidden">
          
          {/* HEADER CỦA BỘ TỪ VỰNG (Tự động lấy tên Thư mục) */}
          <div class="p-6 md:px-10 bg-slate-900 flex items-center justify-between text-white border-b-4 border-teal-500">
            <div class="flex items-center gap-5">
              <div class="w-14 h-14 rounded-2xl bg-teal-500/20 text-teal-400 flex items-center justify-center">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
              </div>
              <div>
                <h2 class="font-black text-2xl md:text-3xl tracking-tight uppercase">{group.title}</h2>
                <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mt-1">{group.items.length} Bài học</p>
              </div>
            </div>
          </div>
          
          {/* DANH SÁCH CÁC BÀI HỌC (Tự động lấy tên file JSON) */}
          <div class="p-6 md:p-10 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
            {group.items.map((item) => (
              <a 
                href={`/english-lab/toeic/flashcards/${encodeURIComponent(item.name)}`} 
                class="flex flex-col items-center justify-center p-6 rounded-2xl border-2 border-slate-100 bg-slate-50 hover:border-teal-500 hover:bg-white hover:-translate-y-1 hover:shadow-xl hover:shadow-teal-100/50 transition-all duration-300 group text-center"
              >
                <span class="text-xl font-black text-slate-700 group-hover:text-teal-600 leading-tight mb-4">
                  {item.name}
                </span>
                <span class="text-[11px] font-bold px-3.5 py-1.5 rounded-full bg-slate-200 text-slate-500 group-hover:bg-teal-100 group-hover:text-teal-700 transition-colors">
                  {item.count} từ vựng
                </span>
              </a>
            ))}
          </div>
          
        </div>
      ))}
    </div>
  </div>
</Layout>