---
import Layout from '../../../layouts/Layout.astro';

// 🚀 Tự động quét file JSON
const jsonModules = import.meta.glob('../../../data/*.json', { eager: true });
const jsonFiles = Object.values(jsonModules);
const rawData = jsonFiles.length > 0 ? (jsonFiles[0].default || jsonFiles[0]) : [];

const examData = {
  title: "English Lab - TOEIC Simulation",
  duration: 120 
};

let groupedSets = [];
let currentGroup = null;

// 🚀 BỘ PARSER: Bóc tách giải thích
function parseExp(html, part) {
    if (!html) return null;
    let res = { dichCauHoi: '', dichScript: '', giai: '', tu: [], danChung: '' };
    let parts = html.split(/<br>\s*<br>\s*-+\s*<br>\s*<br>/);
    
    parts.forEach(p => {
        if (p.includes('👉 Giải thích:')) {
            let content = p.replace('<b>👉 Giải thích:</b>', '').trim();
            
            let dcMatch = content.match(/Dẫn chứng:\s*(?:"([^"]+)"|([^\(]+))/);
            if (dcMatch) {
                let dcText = (dcMatch[1] || dcMatch[2]).trim();
                dcText = dcText.replace(/\.{3,}$/g, '').trim(); 
                if (dcText.includes('...')) dcText = dcText.split('...')[0].trim(); 
                res.danChung = dcText;
            }

            content = content.replace(/Dẫn chứng:/g, '<span class="dc-label">📌 Dẫn chứng:</span>');
            content = content.replace(/Paraphrase:/g, '<br><span class="para-label">🔄 Paraphrase:</span>');
            res.giai = content;
            
        } else if (p.includes('🌎 Dịch nghĩa:')) {
            let content = p.replace('<b>🌎 Dịch nghĩa:</b><br>', '').trim();
            if (part >= 3 && part !== 5) res.dichScript = content;
            else res.dichCauHoi = content;
            
        } else if (p.includes('📚 Từ vựng:')) {
            let content = p.replace(/<b>📚 Từ vựng:<\/b>(<br>)?/g, '').trim();
            let items = content.split(/<br>|;|\s+(?=[a-zA-Z-']+(?:\s+[a-zA-Z-']+){0,3}\s*\((?:n|v|adj|adv|prep|conj|phr|v\/n|n\/v)\))/i);
            
            items.forEach(item => {
                let text = item.replace(/&nbsp;/g, ' ').replace(/<\/?[^>]+(>|$)/g, "").trim(); 
                if(!text) return;
                
                let word = text; let meaning = "";
                if(text.indexOf(':') !== -1) {
                    let tvParts = text.split(':');
                    word = tvParts[0].trim(); meaning = tvParts.slice(1).join(':').trim();
                } else if(text.indexOf(')') !== -1) {
                    let idx = text.indexOf(')') + 1;
                    word = text.substring(0, idx).trim(); meaning = text.substring(idx+1).trim();
                } else if(text.indexOf('-') !== -1) {
                    let tvParts = text.split('-');
                    word = tvParts[0].trim(); meaning = tvParts.slice(1).join('-').trim();
                }
                if (word) res.tu.push({ w: word, m: meaning });
            });
        }
    });
    return res;
}

rawData.forEach(q => {
  const gId = q.groupId || ("single-" + q.questionNumber);
  q.parsedExp = parseExp(q.explanationHtml, q.part);

  if (!currentGroup || currentGroup.groupId !== gId) {
    currentGroup = {
      groupId: gId,
      part: q.part,
      audio: q.audio,
      image: q.image,
      passageHtml: q.passageHtml,
      transcript: q.transcript || "",
      questions: []
    };
    groupedSets.push(currentGroup);
  }
  currentGroup.questions.push(q);
});

const totalQuestions = rawData.length;

const toeicParts = [
  { name: "Part 1: Photographs", num: 1 },
  { name: "Part 2: Question-Response", num: 2 },
  { name: "Part 3: Conversations", num: 3 },
  { name: "Part 4: Talks", num: 4 },
  { name: "Part 5: Incomplete Sentences", num: 5 },
  { name: "Part 6: Text Completion", num: 6 },
  { name: "Part 7: Reading Comprehension", num: 7 },
];

// Helper function xử lý passage HTML
function processPassageHtml(html, questions) {
  if (!html) return '';
  let result = html;
  
  // Thay thế ______[123] bằng dropdown
  questions.forEach(q => {
    const blankPattern = new RegExp('_{6,}\\\\[' + q.questionNumber + '\\\\]', 'g');
    if (blankPattern.test(result) && q.options) {
      const optionsArray = Object.entries(q.options);
      let optionsHtml = '<select class="toeic-blank-select" data-qnum="' + q.questionNumber + '" data-correct="' + q.correctAnswer + '">';
      optionsHtml += '<option value="">-- Chọn đáp án --</option>';
      optionsArray.forEach(([letter, text]) => {
        optionsHtml += '<option value="' + letter + '">' + letter + '. ' + text + '</option>';
      });
      optionsHtml += '</select>';
      result = result.replace(blankPattern, optionsHtml);
    }
  });
  
  // Format email - giống web Đậu TOEIC
  if (result.includes('From:') && result.includes('To:') && result.includes('Subject:')) {
    // Bọc trong email container với style đẹp
    if (!result.includes('email-container')) {
      result = '<div class="email-container">' + result + '</div>';
    }
    // Thêm class cho bảng email header
    result = result.replace(/<table/g, '<table class="email-header-table"');
  }
  
  return result;
}
---

<Layout title={examData.title}>
  
  <header class="fixed top-0 left-0 right-0 h-14 md:h-16 bg-slate-900 flex items-center justify-between px-2 md:px-6 z-50 shadow-md">
    <div class="flex items-center gap-2 md:gap-3">
      <a href="/english-lab/toeic" class="inline-flex items-center text-sm font-semibold text-slate-300 hover:bg-slate-800 h-8 md:h-9 px-2 md:px-3 rounded-md transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mr-1.5"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
        <span class="hidden sm:inline">Thoát</span>
      </a>
    </div>

    <div class="flex flex-col items-center">
      <h1 class="text-white text-base md:text-lg font-bold hidden sm:block tracking-wide">{examData.title}</h1>
      <span class="text-indigo-400 text-xs font-semibold uppercase tracking-widest mt-0.5">CÂU <span id="header-q-range">1</span> / {totalQuestions}</span>
    </div>

    <div class="flex items-center gap-2 md:gap-3">
      <button id="toggle-bilingual" class="hidden sm:flex items-center gap-1.5 h-8 px-3 rounded-md bg-slate-800 text-slate-300 text-xs font-semibold hover:bg-slate-700 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m5 8 6 6"></path><path d="m4 14 6-6 2-3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path></svg>
        <span>Song ngữ</span>
      </button>
      <div class="hidden sm:flex items-center gap-1.5 h-8 px-3 rounded-md bg-slate-800 text-emerald-400 text-[15px] font-mono font-bold shadow-inner border border-slate-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span id="timer">{examData.duration}:00</span>
      </div>
    </div>
  </header>

  <main id="exam-main" data-duration={examData.duration} class="h-screen bg-slate-50 pt-14 md:pt-16 pb-[72px] flex justify-center overflow-hidden font-sans">
    <div class="w-full h-full flex flex-col" id="scroll-container">
      
      {groupedSets.map((set, idx) => {
         const hasMedia = Boolean(set.audio || set.image || set.passageHtml || set.transcript);
         const isCenterFocus = !hasMedia; 
         
         let instructionText = "SELECT THE BEST RESPONSE TO EACH QUESTION.";
         
         const qsInGroup = set.questions.map(q => q.questionNumber);
         const qRangeStr = qsInGroup.length > 1 ? (qsInGroup[0] + "-" + qsInGroup[qsInGroup.length-1]) : String(qsInGroup[0]);
         const firstQ = set.questions[0];
         const hasExtraData = firstQ && firstQ.parsedExp && (firstQ.parsedExp.dichScript || firstQ.parsedExp.tu.length > 0);
         
         // Xử lý passage HTML
         const processedHtml = processPassageHtml(set.passageHtml, set.questions);

         return (
        <div id={"group-" + idx} class={"question-group w-full h-full overflow-y-auto custom-scrollbar p-4 md:p-6 lg:p-8 animate-fade-in " + (idx === 0 ? 'block' : 'hidden')}>
          
          <div class={"w-full flex h-full " + (isCenterFocus ? 'flex-col items-center max-w-3xl mx-auto' : 'flex-col lg:flex-row gap-8')}>
              
              {/* CỘT TRÁI: PASSAGE + AUDIO */}
              {hasMedia && (
              <div class="w-full lg:w-[48%] flex flex-col lg:border-r border-slate-200 lg:pr-8 h-fit lg:max-h-[calc(100vh-140px)] lg:sticky lg:top-4 lg:overflow-y-auto custom-scrollbar pb-10">
                 
                 <p class="text-blue-700 text-[14px] font-bold mb-5 tracking-wide uppercase">
                    {instructionText}
                 </p>

                 {set.audio && (
                  <div class="rounded-xl bg-white border border-slate-200 mb-6 p-2 flex items-center shadow-sm">
                    <audio controls class="w-full h-10 outline-none bg-transparent audio-player" data-group={idx}>
                      <source src={set.audio}/>
                    </audio>
                  </div>
                 )}

                 {set.image && (
                   <div class="flex justify-center mb-6">
                      <img src={set.image} alt="Reference" class="max-w-full max-h-[400px] rounded-xl shadow-sm object-contain border border-slate-200 bg-white p-3" />
                   </div>
                 )}

                 {/* TABS */}
                 {hasExtraData && (
                     <div class="review-mode-only mb-4 border-b border-gray-200 flex gap-4">
                         <button class="tab-btn active pb-3 text-[13px] font-bold uppercase tracking-wider text-blue-600 border-b-2 border-blue-600 transition-colors" data-target={`tab-script-${idx}`}>Audio Script</button>
                         {firstQ.parsedExp.dichScript && <button class="tab-btn pb-3 text-[13px] font-bold uppercase tracking-wider text-gray-400 hover:text-gray-700 border-b-2 border-transparent transition-colors" data-target={`tab-dich-${idx}`}>Dịch Bài Đọc</button>}
                         {firstQ.parsedExp.tu.length > 0 && <button class="tab-btn pb-3 text-[13px] font-bold uppercase tracking-wider text-gray-400 hover:text-gray-700 border-b-2 border-transparent transition-colors" data-target={`tab-vocab-${idx}`}>Từ Vựng</button>}
                     </div>
                 )}

                 {/* TAB 1: SCRIPT */}
                 <div id={`tab-script-${idx}`} class="tab-content block animate-fade-in">
                     {processedHtml && (
                       <div class="min-w-0 max-w-none leading-relaxed break-words text-[15px] text-slate-800 dau-toeic-passage highlight-target mb-6 passage-content" data-group={qRangeStr} set:html={processedHtml}></div>
                     )}

                     {set.transcript && (
                       <div class="review-mode-only pb-6 pt-2">
                          <div class="p-6 pt-7 rounded-xl bg-white border border-gray-200 shadow-sm min-w-0 overflow-hidden relative">
                             <div class="absolute -top-1 left-4 bg-slate-900 text-white text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded shadow flex items-center gap-1.5">
                                <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path></svg> Audio Script
                             </div>
                             <div class="text-gray-600 text-[15px] mt-2 leading-[1.8] break-words whitespace-pre-wrap highlight-target italic passage-content" data-group={qRangeStr} set:html={set.transcript}></div>
                          </div>
                       </div>
                     )}
                 </div>

                 {/* TAB 2: DỊCH BÀI ĐỌC */}
                 {firstQ && firstQ.parsedExp.dichScript && (
                     <div id={`tab-dich-${idx}`} class="tab-content hidden review-mode-only animate-fade-in pb-6 pt-2">
                         <div class="p-5 rounded-xl bg-[#f0f7ff] border border-[#cce3fd] relative overflow-hidden">
                            <div class="absolute left-0 top-0 bottom-0 w-[5px] bg-blue-500"></div>
                            <p class="text-[13px] font-bold text-blue-600 mb-3 uppercase tracking-wide flex items-center gap-2 ml-2">
                               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg> Dịch bài đọc / Hội thoại
                            </p>
                            <div class="text-[15px] leading-relaxed text-gray-700 ml-2 passage-content" set:html={firstQ.parsedExp.dichScript}></div>
                         </div>
                     </div>
                 )}

                 {/* TAB 3: TỪ VỰNG */}
                 {firstQ && firstQ.parsedExp.tu.length > 0 && (
                     <div id={`tab-vocab-${idx}`} class="tab-content hidden review-mode-only animate-fade-in pb-6 pt-2">
                         <div class="p-6 rounded-xl bg-[#fffbeb] border border-[#fef08a]">
                            <p class="text-[13px] font-bold text-rose-500 mb-5 uppercase tracking-widest flex items-center gap-1.5">
                               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0-3.332.477-4.5 1.253"></path></svg> Focus Vocabulary
                            </p>
                            <div class="flex flex-wrap gap-3">
                               {firstQ.parsedExp.tu.map((tv, tvIdx) => (
                                  <div key={tvIdx} class="inline-flex items-baseline gap-1.5 px-4 py-2 rounded-full bg-white border border-[#fde047] text-[13.5px] shadow-sm hover:shadow-md transition-shadow cursor-default">
                                     <span class="font-bold text-amber-900">{tv.w}</span>
                                     {tv.m && <span class="text-gray-600">— {tv.m}</span>}
                                  </div>
                               ))}
                            </div>
                         </div>
                     </div>
                 )}
              </div>
              )}

              {/* CỘT PHẢI: CÂU HỎI */}
              <div class={"w-full flex flex-col " + (isCenterFocus ? 'w-full' : 'lg:w-[52%] lg:pl-2 h-fit lg:max-h-full lg:overflow-y-auto custom-scrollbar pb-24')}>
                 
                 {!isCenterFocus && (
                    <div class="text-[13px] text-slate-500 flex items-center gap-3 mb-6 hidden lg:flex">
                        <span class="px-2.5 py-1 rounded bg-slate-200 font-bold text-slate-700">Nhóm câu {qRangeStr}</span>
                        <span class="text-slate-400 font-medium">({qsInGroup.length} câu hỏi)</span>
                    </div>
                 )}

                 <div class="space-y-8">
                 {set.questions.map((q) => {
                     const qNum = q.questionNumber;
                     const isListeningNoText = q.part === 1 || q.part === 2;
                     let optionsArray = ['A', 'B', 'C', 'D'];
                     if (q.part === 2) optionsArray = ['A', 'B', 'C'];

                     return (
                     <div id={"q-container-" + qNum} class="transition-all relative p-5 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md">
                        
                        <input type="hidden" class="q-danchung" data-qnum={qNum} value={q.parsedExp?.danChung || ""} />

                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                           <span class="font-black text-slate-900 text-lg flex items-center gap-2">
                               <div class="w-8 h-8 rounded bg-indigo-50 text-indigo-700 flex items-center justify-center text-[15px] shadow-inner">{qNum}</div>
                           </span>
                           <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-slate-100 text-slate-500 text-[11px] font-bold uppercase tracking-wider status-badge">Bỏ qua</span>
                        </div>
                        
                        {!isListeningNoText && q.question && (
                           <div class="mb-5 pl-1">
                              <p class="font-semibold text-slate-800 text-[15.5px] leading-snug question-text" set:html={q.question}></p>
                           </div>
                        )}

                        {/* UI ĐÁP ÁN */}
                        <div class="space-y-2.5 mb-2">
                           {optionsArray.map((letter) => {
                             const optText = q.options[letter];
                             if (!isListeningNoText && !optText) return null; 
                             
                             return (
                             <label class="relative flex items-center justify-between p-3.5 rounded-xl border-2 border-transparent bg-slate-50 hover:border-indigo-300 hover:bg-indigo-50/50 cursor-pointer transition-all duration-200 option-label group" data-letter={letter}>
                                <input type="radio" name={"q-" + qNum} value={letter} class="answer-radio hidden" data-qnum={qNum} />
                                
                                <div class="flex items-center gap-3 flex-1">
                                   <div class="w-7 h-7 flex-shrink-0 flex items-center justify-center rounded-full bg-white border border-slate-200 shadow-sm group-hover:border-indigo-400 transition-colors letter-box">
                                       <span class="font-bold text-slate-500 text-[13px] option-letter-display">{letter}</span>
                                   </div>
                                   {!isListeningNoText && optText && (
                                      <span class="option-text text-slate-700 font-medium text-[15px]" set:html={optText}></span>
                                   )}
                                </div>
                                
                                <div class="w-6 h-6 flex items-center justify-center flex-shrink-0 icon-container hidden">
                                   <svg class="w-5 h-5 text-emerald-500 correct-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                   <svg class="w-5 h-5 text-rose-500 wrong-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                                </div>
                             </label>
                             )
                           })}
                        </div>

                        {/* GIẢI THÍCH */}
                        {q.parsedExp && (
                           <div class="review-mode-only mt-6 pt-5 border-t border-dashed border-slate-200 animate-fade-in">
                              
                              {q.parsedExp.dichCauHoi && (
                                 <div class="p-4 rounded-xl bg-[#f0f7ff] border border-[#cce3fd] mb-3 shadow-sm">
                                    <p class="text-[13px] font-bold text-[#0284c7] mb-2 flex items-center gap-1.5">
                                       <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8l6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6"></path></svg> Dịch câu hỏi
                                    </p>
                                    <div class="text-[14px] leading-relaxed text-slate-700 parsed-dich-content" data-dich={q.parsedExp.dichCauHoi} data-correct={q.correctAnswer}></div>
                                 </div>
                              )}

                              {q.parsedExp.giai && (
                                 <div class="p-4 rounded-xl bg-[#fbf5ff] border border-[#eaddff] mb-1 shadow-sm">
                                    <p class="text-[12px] font-bold text-[#9333ea] mb-3 uppercase tracking-wide flex items-center gap-1.5">
                                       <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.937 15.5A2 2 0 008.5 14.063l-6.135-1.582a.5.5 0 010-.962L8.5 9.936A2 2 0 009.937 8.5l1.582-6.135a.5.5 0 01.963 0L14.063 8.5A2 2 0 0015.5 9.937l6.135 1.581a.5.5 0 010 .964L15.5 14.063a2 2 0 00-1.437 1.437l-1.582 6.135a.5.5 0 01-.963 0zM20 3v4M22 5h-4M4 17v2M5 18H3"></path></svg> Giải thích chi tiết
                                    </p>
                                    <div class="text-slate-700 text-[14.5px] leading-relaxed explanation-content" set:html={q.parsedExp.giai}></div>
                                 </div>
                              )}
                           </div>
                        )}
                     </div>
                   )})}
                 </div>

              </div>

          </div>
        </div>
      )})}
    </div>
    
    {/* BOTTOM BAR */}
    <div class="fixed bottom-0 left-0 right-0 h-[64px] bg-white border-t border-slate-200 flex items-center justify-between px-3 md:px-6 z-40 shadow-[0_-10px_15px_-3px_rgba(0,0,0,0.05)]">
        
        <div class="flex items-center gap-2">
            <button class="hidden md:inline-flex items-center gap-2 text-sm border-2 h-10 px-4 rounded-xl bg-white border-slate-200 text-slate-700 font-bold hover:border-indigo-500 hover:text-indigo-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg> Báo lỗi
            </button>
            <button id="btn-open-menu" class="inline-flex items-center gap-2 text-sm border-2 h-10 px-4 rounded-xl bg-white border-slate-200 text-slate-700 font-bold hover:border-indigo-500 hover:text-indigo-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg> <span class="hidden sm:inline">Bảng Câu Hỏi</span>
            </button>
        </div>

        <div class="flex items-center gap-2">
            <button id="btn-prev" class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 18l-6-6 6-6"></path></svg>
            </button>
            <div class="inline-flex items-center justify-center h-10 px-4 rounded-xl bg-indigo-50 text-indigo-700 text-[13px] font-bold">
                <span id="bottom-q-range">1/200</span>
            </div>
            <button id="btn-next" class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 18l6-6-6-6"></path></svg>
            </button>
            <button id="btn-pre-submit" class="inline-flex items-center gap-2 text-sm h-10 px-6 rounded-xl bg-emerald-500 text-white font-bold hover:bg-emerald-600 transition-colors ml-2 shadow-md hover:-translate-y-0.5">
                Nộp Bài
            </button>
        </div>
    </div>

    {/* MODAL BẢNG CÂU HỎI */}
    <div id="q-menu-modal" class="fixed inset-0 bg-slate-900/60 z-[100] hidden items-center justify-center backdrop-blur-sm transition-opacity opacity-0">
       <div class="bg-white rounded-3xl shadow-2xl w-[95%] max-w-5xl max-h-[85vh] flex flex-col transform scale-95 transition-transform duration-300" id="q-menu-content">
          <div class="flex items-center justify-between p-5 border-b border-slate-100">
             <h2 class="text-xl font-black text-slate-800 flex items-center gap-2">OVERVIEW</h2>
             <button id="btn-close-menu" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-rose-100 hover:text-rose-600 text-slate-500 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
             </button>
          </div>
          <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
             <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {toeicParts.map(partInfo => {
                  const qsInPart = rawData.filter(q => q.part === partInfo.num);
                  if (qsInPart.length === 0) return null;
                  return (
                    <div>
                      <h4 class="font-bold text-slate-400 text-[12px] uppercase tracking-widest mb-3 border-b border-slate-100 pb-2">{partInfo.name}</h4>
                      <div class="grid grid-cols-6 sm:grid-cols-8 gap-2.5">
                        {qsInPart.map(q => {
                           const groupIdx = groupedSets.findIndex(set => set.questions.some(sq => sq.questionNumber === q.questionNumber));
                           return (
                          <button 
                            id={"palette-btn-" + q.questionNumber} 
                            data-groupidx={groupIdx}
                            class="palette-btn w-full aspect-square flex items-center justify-center rounded-xl border-2 border-slate-100 bg-white text-slate-600 text-[13px] font-bold hover:border-indigo-400 hover:text-indigo-600 transition-all hover:-translate-y-0.5"
                          >
                            {q.questionNumber}
                          </button>
                        )})}
                      </div>
                    </div>
                  );
                })}
             </div>
          </div>
       </div>
    </div>

    {/* MODAL XÁC NHẬN NỘP BÀI */}
    <div id="confirm-modal" class="fixed inset-0 bg-slate-900/60 z-[110] hidden items-center justify-center backdrop-blur-sm transition-opacity opacity-0">
       <div class="bg-white rounded-3xl shadow-2xl w-[90%] max-w-sm p-8 text-center transform scale-95 transition-transform duration-300" id="confirm-content">
           <div class="w-16 h-16 bg-rose-100 text-rose-500 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
           </div>
           <h3 class="text-xl font-black text-slate-800 mb-2">Chốt nộp bài?</h3>
           <p class="text-slate-500 text-[15px] mb-8 leading-relaxed">Bạn sẽ không thể thay đổi đáp án sau khi nộp.</p>
           <div class="flex gap-3">
               <button id="btn-cancel-submit" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3.5 rounded-xl transition-colors">Quay Lại</button>
               <button id="btn-confirm-submit" class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3.5 rounded-xl transition-colors shadow-md">Nộp Bài Ngay</button>
           </div>
       </div>
    </div>

    {/* MODAL KẾT QUẢ */}
    <div id="result-modal" class="fixed inset-0 bg-slate-900/80 z-[120] hidden items-center justify-center backdrop-blur-lg transition-opacity opacity-0">
       <div class="bg-white rounded-[2rem] shadow-2xl w-[90%] max-w-md p-10 text-center transform scale-95 transition-transform duration-300" id="result-content">
           <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="Trophy" class="w-28 h-28 mx-auto mb-6 drop-shadow-lg animate-bounce" />
           <h3 class="text-2xl font-black text-slate-800 mb-2 uppercase">KẾT QUẢ BÀI THI</h3>
           <p class="text-slate-500 text-sm mb-6">Bạn đã hoàn thành bài thi TOEIC!</p>
           
           <div class="bg-slate-50 border border-slate-100 rounded-2xl p-5 mb-8 grid grid-cols-2 gap-4 shadow-inner">
              <div>
                 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-1">Số Câu Đúng</p>
                 <p class="text-4xl font-black text-indigo-600"><span id="res-score">0</span><span class="text-lg text-slate-400">/200</span></p>
              </div>
              <div>
                 <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-1">Thời Gian</p>
                 <p class="text-2xl font-black text-emerald-500 mt-2" id="res-time">00:00</p>
              </div>
           </div>

           <button id="btn-close-result" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-4 rounded-xl transition-all shadow-lg hover:-translate-y-1">
               Xem Giải Thích Chi Tiết
           </button>
       </div>
    </div>

  </main>

  <script define:vars={{ groupedSets, totalQuestions, durationMinutes: examData.duration }}>
    document.addEventListener('DOMContentLoaded', () => {
      let timerInterval;
      let timeLeft = durationMinutes * 60;
      let currentGroupIdx = 0;
      const totalGroups = groupedSets.length;
      let isReviewMode = false;
      let finalScore = 0;
      let userAnswers = {};
      let isBilingualOn = false;

      const timerEl = document.getElementById('timer');
  
      timerInterval = setInterval(() => {
        if (timeLeft > 0) {
          timeLeft--;
          const m = Math.floor(timeLeft/60).toString().padStart(2,'0');
          const s = (timeLeft%60).toString().padStart(2,'0');
          if(timerEl) timerEl.textContent = m + ":" + s;
        } else {
          clearInterval(timerInterval);
          processSubmit(); 
        }
      }, 1000);

      // 🚀 TOGGLE SONG NGỮ
      const toggleBtn = document.getElementById('toggle-bilingual');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          isBilingualOn = !isBilingualOn;
          if (isBilingualOn) {
            document.body.classList.add('show-vi');
            toggleBtn.classList.add('bg-blue-600', 'text-white');
            toggleBtn.classList.remove('bg-slate-800', 'text-slate-300');
          } else {
            document.body.classList.remove('show-vi');
            toggleBtn.classList.remove('bg-blue-600', 'text-white');
            toggleBtn.classList.add('bg-slate-800', 'text-slate-300');
          }
        });
      }

      function updateNavigation() {
          const currentSet = groupedSets[currentGroupIdx];
          const qs = currentSet.questions;
          let rangeStr = qs.length > 1 ? (qs[0].questionNumber + "-" + qs[qs.length-1].questionNumber) : String(qs[0].questionNumber);
          
          document.getElementById('header-q-range').innerText = rangeStr;
          document.getElementById('bottom-q-range').innerText = rangeStr + " / " + totalQuestions;

          document.querySelectorAll('.question-group').forEach((el, idx) => {
              if (idx === currentGroupIdx) {
                  el.classList.remove('hidden'); el.classList.add('block');
              } else {
                  el.classList.add('hidden'); el.classList.remove('block');
              }
          });

          document.getElementById('btn-prev').disabled = currentGroupIdx === 0;
          document.getElementById('btn-next').disabled = currentGroupIdx === totalGroups - 1;
          document.getElementById('scroll-container').scrollTo({ top: 0, behavior: 'smooth' });

          if (!isReviewMode) {
              document.querySelectorAll('.audio-player').forEach(a => a.pause());
              const currentAudio = document.querySelector('.audio-player[data-group="' + currentGroupIdx + '"]');
              if (currentAudio) {
                  currentAudio.currentTime = 0;
                  currentAudio.play().catch(e => console.log("Click vào trang để autoplay"));
                  currentAudio.onended = function() {
                      if (currentGroupIdx < totalGroups - 1 && !isReviewMode) {
                          currentGroupIdx++;
                          updateNavigation();
                      }
                  };
              }
          }
          
          document.querySelectorAll('.tab-btn').forEach(b => {
              if(b.dataset.target && b.dataset.target.includes('script')) {
                  b.classList.add('text-blue-600', 'border-blue-600', 'active'); 
                  b.classList.remove('text-gray-400', 'border-transparent');
              } else {
                  b.classList.remove('text-blue-600', 'border-blue-600', 'active'); 
                  b.classList.add('text-gray-400', 'border-transparent');
              }
          });
          document.querySelectorAll('.tab-content').forEach(c => {
              if(c.id && c.id.includes('script')) { c.classList.remove('hidden'); c.classList.add('block'); } 
              else { c.classList.remove('block'); c.classList.add('hidden'); }
          });
      }
      
      updateNavigation();

      function saveUserAnswer(qNum, letter) {
        userAnswers[qNum] = letter;
      }

      document.getElementById('btn-prev')?.addEventListener('click', () => {
          if (currentGroupIdx > 0) { currentGroupIdx--; updateNavigation(); }
      });
      document.getElementById('btn-next')?.addEventListener('click', () => {
          if (currentGroupIdx < totalGroups - 1) { currentGroupIdx++; updateNavigation(); }
      });

      // RADIO
      document.querySelectorAll('.answer-radio').forEach(radio => {
        radio.addEventListener('change', (e) => {
          if(isReviewMode) return;
          const qNum = parseInt(e.target.dataset.qnum);
          const selectedLetter = e.target.value;
          saveUserAnswer(qNum, selectedLetter);
          const container = document.getElementById("q-container-" + qNum);
          
          container.querySelectorAll('.option-label').forEach(lbl => {
             lbl.classList.remove('border-indigo-400', 'bg-indigo-50/50');
             lbl.classList.add('border-transparent', 'bg-slate-50');
             const lBox = lbl.querySelector('.letter-box');
             if(lBox) { lBox.classList.remove('border-indigo-400'); lBox.classList.add('border-slate-200'); }
             const lDisp = lbl.querySelector('.option-letter-display');
             if(lDisp) { lDisp.classList.remove('text-indigo-600'); lDisp.classList.add('text-slate-500'); }
          });

          const selectedLabel = e.target.closest('.option-label');
          selectedLabel.classList.remove('border-transparent', 'bg-slate-50');
          selectedLabel.classList.add('border-indigo-400', 'bg-indigo-50/50');
          
          const selLBox = selectedLabel.querySelector('.letter-box');
          if(selLBox) { selLBox.classList.remove('border-slate-200'); selLBox.classList.add('border-indigo-400'); }
          const selLDisp = selectedLabel.querySelector('.option-letter-display');
          if(selLDisp) { selLDisp.classList.remove('text-slate-500'); selLDisp.classList.add('text-indigo-600'); }

          const badge = container.querySelector('.status-badge');
          badge.textContent = "Đã chọn";
          badge.classList.replace('bg-slate-100', 'bg-indigo-100');
          badge.classList.replace('text-slate-500', 'text-indigo-700');

          const pBtn = document.getElementById("palette-btn-" + qNum);
          if (pBtn && !pBtn.classList.contains('bg-indigo-500')) {
              pBtn.classList.replace('border-slate-100', 'border-indigo-500');
              pBtn.classList.replace('bg-white', 'bg-indigo-500');
              pBtn.classList.replace('text-slate-600', 'text-white');
          }
        });
      });

      // DROPDOWN PART 6
      document.addEventListener('change', (e) => {
        if (e.target.classList && e.target.classList.contains('toeic-blank-select')) {
          const qNum = parseInt(e.target.dataset.qnum);
          const selectedLetter = e.target.value;
          if (selectedLetter) {
            saveUserAnswer(qNum, selectedLetter);
            const container = document.getElementById("q-container-" + qNum);
            if (container) {
              const badge = container.querySelector('.status-badge');
              if (badge && badge.textContent === 'Bỏ qua') {
                badge.textContent = "Đã chọn";
                badge.classList.replace('bg-slate-100', 'bg-indigo-100');
                badge.classList.replace('text-slate-500', 'text-indigo-700');
              }
            }
            const pBtn = document.getElementById("palette-btn-" + qNum);
            if (pBtn && !pBtn.classList.contains('bg-indigo-500')) {
              pBtn.classList.replace('border-slate-100', 'border-indigo-500');
              pBtn.classList.replace('bg-white', 'bg-indigo-500');
              pBtn.classList.replace('text-slate-600', 'text-white');
            }
          }
        }
      });

      // MODAL MENU
      const modalMenu = document.getElementById('q-menu-modal');
      const modalMenuContent = document.getElementById('q-menu-content');
      document.getElementById('btn-open-menu')?.addEventListener('click', () => {
          modalMenu.classList.remove('hidden'); modalMenu.classList.add('flex');
          setTimeout(() => { modalMenu.classList.remove('opacity-0'); modalMenuContent.classList.remove('scale-95'); modalMenuContent.classList.add('scale-100'); }, 10);
      });
      document.getElementById('btn-close-menu')?.addEventListener('click', closeMenu);
      modalMenu.addEventListener('click', (e) => { if(e.target === modalMenu) closeMenu(); });
      function closeMenu() {
          modalMenu.classList.add('opacity-0'); modalMenuContent.classList.remove('scale-100'); modalMenuContent.classList.add('scale-95');
          setTimeout(() => { modalMenu.classList.remove('flex'); modalMenu.classList.add('hidden'); }, 300);
      }

      document.querySelectorAll('.palette-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetGroupIdx = parseInt(e.currentTarget.dataset.groupidx);
          if (!isNaN(targetGroupIdx)) {
              currentGroupIdx = targetGroupIdx;
              updateNavigation();
              closeMenu();
          }
        });
      });

      // SUBMIT
      const confirmModal = document.getElementById('confirm-modal');
      const confirmContent = document.getElementById('confirm-content');
      document.getElementById('btn-pre-submit')?.addEventListener('click', () => {
          if (isReviewMode) { window.location.href = "/english-lab/toeic"; return; }
          confirmModal.classList.remove('hidden'); confirmModal.classList.add('flex');
          setTimeout(() => { confirmModal.classList.remove('opacity-0'); confirmContent.classList.remove('scale-95'); confirmContent.classList.add('scale-100'); }, 10);
      });
      document.getElementById('btn-cancel-submit')?.addEventListener('click', () => {
          confirmModal.classList.add('opacity-0'); confirmContent.classList.remove('scale-100'); confirmContent.classList.add('scale-95');
          setTimeout(() => { confirmModal.classList.remove('flex'); confirmModal.classList.add('hidden'); }, 300);
      });
      document.getElementById('btn-confirm-submit')?.addEventListener('click', () => {
          confirmModal.classList.add('opacity-0');
          setTimeout(() => { confirmModal.classList.remove('flex'); confirmModal.classList.add('hidden'); processSubmit(); }, 300);
      });

      function processSubmit() {
        clearInterval(timerInterval);
        isReviewMode = true;
        document.body.classList.add('review-mode'); 
        document.querySelectorAll('.audio-player').forEach(a => a.pause());

        const submitBtn = document.getElementById('btn-pre-submit');
        submitBtn.innerHTML = "Thoát & Lưu";
        submitBtn.classList.replace('bg-emerald-500', 'bg-slate-800');
        submitBtn.classList.replace('hover:bg-emerald-600', 'hover:bg-slate-900');
        
        // Lấy đáp án từ dropdown
        document.querySelectorAll('.toeic-blank-select').forEach(select => {
          const qNum = parseInt(select.dataset.qnum);
          const selectedLetter = select.value;
          if (selectedLetter) {
            saveUserAnswer(qNum, selectedLetter);
          }
        });

        // HIGHLIGHT
        const highlightColors = [
            'bg-amber-100 border-l-4 border-amber-400',     
            'bg-sky-100 border-l-4 border-sky-400',         
            'bg-emerald-100 border-l-4 border-emerald-400', 
            'bg-purple-100 border-l-4 border-purple-400',   
            'bg-rose-100 border-l-4 border-rose-400'        
        ];

        document.querySelectorAll('.highlight-target').forEach(el => {
            let html = el.innerHTML;
            let groupQStr = el.dataset.group; 
            if (groupQStr) {
                let range = groupQStr.split('-');
                let min = parseInt(range[0]);
                let max = range.length > 1 ? parseInt(range[1]) : min;
                
                for (let i = min; i <= max; i++) {
                    let dcInput = document.querySelector('.q-danchung[data-qnum="' + i + '"]');
                    if (dcInput && dcInput.value && dcInput.value.length > 5) {
                        let danChung = dcInput.value;
                        let words = danChung.replace(/[.,!?\"'”’“‘]/g, '').trim().split(/\s+/);
                        if (words.length > 3) words = words.slice(0, 8); 
                        
                        let fuzzyPattern = words.map(w => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('(?:\\s|<[^>]+>|&nbsp;)+');
                        let regex = new RegExp("(" + fuzzyPattern + "(?:[^<]*?(?:<[^>]+>[^<]*?)*?[.,!?\"'”’“‘]*)?)", "i");
                        
                        let colorStr = highlightColors[(i - min) % highlightColors.length];
                        html = html.replace(regex, '<mark class="' + colorStr + ' rounded-r-md px-2 py-1 shadow-sm inline-block leading-relaxed my-1"><span class="inline-flex items-center justify-center min-w-[20px] h-[20px] px-1 rounded-sm bg-slate-900 text-white text-[10px] font-black mr-2 transform -translate-y-px shadow-sm">' + i + '</span>$1</mark>');
                    }
                }
            }
            el.innerHTML = html;
        });

        // DỊCH CÂU HỎI
        document.querySelectorAll('.parsed-dich-content').forEach(el => {
            let content = el.dataset.dich;
            let correct = el.dataset.correct;
            if(!content) return;
            let finalHtml = content;
            ['A', 'B', 'C', 'D'].forEach(letter => {
                let isCorrect = (letter === correct);
                let colorClass = isCorrect ? 'text-emerald-600 font-bold bg-emerald-50 px-1 rounded' : 'text-slate-600';
                let letterRegex = new RegExp("\\(" + letter + "\\)", "g");
                finalHtml = finalHtml.replace(letterRegex, '<br><span class="' + colorClass + ' mt-1 block">(' + letter + ')</span>');
            });
            finalHtml = finalHtml.replace(/\)\.<\/span>/g, ')</span>'); 
            el.innerHTML = finalHtml;
        });

        // CHẤM ĐIỂM
        finalScore = 0;
        groupedSets.forEach(set => {
          set.questions.forEach(q => {
            const qNum = q.questionNumber;
            const container = document.getElementById("q-container-" + qNum);
            const userChoice = userAnswers[qNum];
            const correctAnswer = q.correctAnswer;
            
            const labels = container.querySelectorAll('.option-label');
            const radios = container.querySelectorAll('.answer-radio');
            
            radios.forEach(r => { r.disabled = true; });
            
            labels.forEach(lbl => {
                const letter = lbl.dataset.letter;
                const optLetter = lbl.querySelector('.option-letter-display');
                const optText = lbl.querySelector('.option-text');
                const iconCorrect = lbl.querySelector('.correct-icon');
                const iconWrong = lbl.querySelector('.wrong-icon');
                const lBox = lbl.querySelector('.letter-box');
                const iconContainer = lbl.querySelector('.icon-container');

                lbl.classList.remove('border-indigo-400', 'bg-indigo-50/50', 'hover:bg-indigo-50/50', 'cursor-pointer', 'border-transparent', 'bg-slate-50');
                lbl.classList.add('cursor-default', 'border-transparent', 'bg-white'); 
                if (lBox) lBox.classList.remove('border-indigo-400');
                if (optLetter) optLetter.classList.remove('text-white');
                if (iconContainer) iconContainer.classList.remove('hidden');
                
                if (letter === correctAnswer) {
                    lbl.classList.replace('border-transparent', 'border-emerald-500');
                    lbl.classList.replace('bg-white', 'bg-emerald-50');
                    if (lBox) lBox.classList.add('bg-emerald-500', 'border-emerald-500');
                    if (optLetter) optLetter.classList.add('hidden');
                    if (iconCorrect) iconCorrect.classList.remove('hidden');
                    if (optText) optText.classList.add('text-emerald-700', 'font-bold');
                } else if (letter === userChoice && userChoice !== correctAnswer) {
                    lbl.classList.replace('border-transparent', 'border-rose-300');
                    lbl.classList.replace('bg-white', 'bg-rose-50');
                    if (lBox) lBox.classList.add('bg-rose-500', 'border-rose-500');
                    if (optLetter) optLetter.classList.add('hidden');
                    if (iconWrong) iconWrong.classList.remove('hidden');
                    if (optText) optText.classList.add('text-rose-700', 'font-bold');
                } else {
                    lbl.classList.add('opacity-40'); 
                }
            });

            const badge = container.querySelector('.status-badge');
            const pBtn = document.getElementById("palette-btn-" + qNum);
            
            if (userChoice === correctAnswer) {
                finalScore++;
                if (badge) { badge.innerHTML = 'Đúng'; badge.classList.replace('bg-indigo-100', 'bg-emerald-100'); badge.classList.replace('text-indigo-700', 'text-emerald-700'); }
                if(pBtn) { pBtn.className = "palette-btn w-full aspect-square flex items-center justify-center rounded-xl border-2 border-emerald-500 bg-emerald-500 text-white text-[13px] font-bold shadow-md"; }
            } else if (userChoice) {
                if (badge) { badge.innerHTML = 'Sai'; badge.classList.replace('bg-indigo-100', 'bg-rose-100'); badge.classList.replace('text-indigo-700', 'text-rose-700'); }
                if(pBtn) { pBtn.className = "palette-btn w-full aspect-square flex items-center justify-center rounded-xl border-2 border-rose-500 bg-rose-500 text-white text-[13px] font-bold shadow-md"; }
            } else {
                if(pBtn) { pBtn.className = "palette-btn w-full aspect-square flex items-center justify-center rounded-xl border-2 border-slate-200 bg-slate-100 text-slate-400 text-[13px] font-bold"; }
            }
          });
        });

        const timeUsed = (durationMinutes * 60) - timeLeft;
        const mUsed = Math.floor(timeUsed/60).toString().padStart(2,'0');
        const sUsed = (timeUsed%60).toString().padStart(2,'0');
        
        document.getElementById('res-score').innerText = finalScore;
        document.getElementById('res-time').innerText = mUsed + ":" + sUsed;

        const resultModal = document.getElementById('result-modal');
        const resultContent = document.getElementById('result-content');
        resultModal.classList.remove('hidden'); resultModal.classList.add('flex');
        setTimeout(() => { resultModal.classList.remove('opacity-0'); resultContent.classList.remove('scale-95'); resultContent.classList.add('scale-100'); }, 10);

        document.getElementById('btn-close-result')?.addEventListener('click', () => {
            resultModal.classList.add('opacity-0'); resultContent.classList.remove('scale-100'); resultContent.classList.add('scale-95');
            setTimeout(() => { resultModal.classList.remove('flex'); resultModal.classList.add('hidden'); }, 300);
            currentGroupIdx = 0; 
            updateNavigation();
        });
      }
    });
  </script>

 <style is:global>
    /* ========== STYLE CƠ BẢN ========== */
    .review-mode-only { display: none; }
    body.review-mode .review-mode-only { display: block; }
    
    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }

    /* ========== PASSAGE STYLE ========== */
    .dau-toeic-passage { 
      font-family: 'Georgia', 'Times New Roman', serif; 
      font-size: 16px;
      line-height: 1.75;
