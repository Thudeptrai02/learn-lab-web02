---
import Layout from '../../../../layouts/Layout.astro';
// 1. IMPORT TRỰC TIẾP FILE JSON SẾP VỪA CÀO
import rawData from '../../../../data/test_data.json';

const examData = {
  title: "Đề Thi Thử TOEIC (JSON Version)",
  duration: 120 // 120 phút
};

const totalQuestions = rawData.length;

// 2. THUẬT TOÁN GOM NHÓM (Từ JSON phẳng -> Cấu trúc chia cột)
let groupedSets = [];
let currentGroup = null;

rawData.forEach(q => {
  // Dùng groupId để biết các câu nào đi chung 1 đoạn văn/audio
  const gId = q.groupId || `single-${q.questionNumber}`;
  
  if (!currentGroup || currentGroup.groupId !== gId) {
    currentGroup = {
      groupId: gId,
      part: q.part,
      audio: q.audio,
      image: q.image,
      passageHtml: q.passageHtml,
      questions: []
    };
    groupedSets.push(currentGroup);
  }
  currentGroup.questions.push(q);
});

const toeicParts = [
  { name: "Part 1: Photographs", num: 1 },
  { name: "Part 2: Question-Response", num: 2 },
  { name: "Part 3: Conversations", num: 3 },
  { name: "Part 4: Talks", num: 4 },
  { name: "Part 5: Incomplete Sentences", num: 5 },
  { name: "Part 6: Text Completion", num: 6 },
  { name: "Part 7: Reading Comprehension", num: 7 },
];
---

<Layout title={`${examData.title} | Thi Thử TOEIC`}>
  
  <!-- MÀN HÌNH CHỜ -->
  <div id="intro-screen" class="fixed inset-0 bg-[#f8f9fa] z-[100] flex flex-col items-center justify-center transition-opacity duration-500">
    <div class="bg-white p-10 rounded-2xl shadow-xl border border-gray-100 max-w-lg w-full text-center mx-4">
      <div class="w-20 h-20 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-900 mb-2 uppercase">{examData.title}</h1>
      <p class="text-gray-500 mb-8 text-sm">Tổng số câu: {totalQuestions} câu • Thời gian: {examData.duration} phút</p>
      <button id="btn-start-exam" class="w-full bg-[#2d8cf0] hover:bg-[#2d8cf0]/90 text-white font-semibold text-lg py-3 rounded-lg shadow-sm transition-all">
        BẮT ĐẦU LÀM BÀI
      </button>
    </div>
  </div>

  <!-- HEADER GIAO DIỆN ĐẬU TOEIC -->
  <header class="fixed top-0 left-0 right-0 h-14 md:h-16 bg-[#1e3a5f] shadow-sm z-50 flex items-center justify-between px-2 md:px-6">
    <div class="flex items-center gap-2 md:gap-4">
      <a href="/english-lab/toeic" class="inline-flex items-center justify-center text-sm font-medium text-white hover:bg-white/10 rounded-md h-8 px-2 md:px-3 transition-colors">
        <svg class="w-4 h-4 mr-1 md:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        <span class="hidden sm:inline">Quay lại</span>
      </a>
    </div>

    <div class="flex flex-col items-center">
      <h1 class="text-white text-base font-semibold hidden sm:block truncate">{examData.title}</h1>
      <span class="text-white/80 text-xs mt-0.5"><span id="answered-count-header">0</span>/{totalQuestions}</span>
    </div>

    <div class="flex items-center gap-2 md:gap-3">
      <div class="flex items-center gap-1.5 h-8 md:h-9 px-2 md:px-3 rounded-md bg-white/10 text-white text-xs md:text-sm font-mono">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span id="timer">{examData.duration}:00</span>
      </div>
      <button id="btn-toggle-menu" class="hidden md:flex items-center gap-1.5 h-8 md:h-9 px-2 md:px-3 rounded-md bg-white/10 text-white text-xs md:text-sm hover:bg-white/20 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
      <button id="btn-submit" class="h-8 md:h-9 px-3 md:px-4 rounded-md bg-[#4caf50] hover:bg-[#45a049] text-white text-xs md:text-sm font-semibold shadow-sm transition-colors">
        Nộp bài
      </button>
    </div>
  </header>

  <!-- MENU BẢNG CÂU HỎI BÊN PHẢI -->
  <div id="drawer-menu" class="fixed top-14 md:top-16 right-0 bottom-0 w-72 bg-white border-l border-gray-200 shadow-xl z-40 transform translate-x-full transition-transform duration-300 overflow-y-auto pb-10">
    <div class="p-4 md:p-6">
      <div class="flex items-center justify-between mb-4 sticky top-0 bg-white py-2 border-b border-gray-100 z-10">
        <h3 class="font-bold text-gray-800">Bảng câu hỏi</h3>
        <span class="text-xs font-semibold text-gray-500 bg-gray-100 px-2 py-1 rounded"><span id="answered-count">0</span>/{totalQuestions}</span>
      </div>
      <div class="space-y-6">
        {toeicParts.map(partInfo => {
          const qsInPart = rawData.filter(q => q.part === partInfo.num);
          if (qsInPart.length === 0) return null;
          return (
            <div>
              <h4 class="font-semibold text-gray-600 text-sm mb-2">{partInfo.name}</h4>
              <div class="grid grid-cols-5 gap-2">
                {qsInPart.map(q => (
                  <button 
                    id={`palette-btn-${q.questionNumber}`} 
                    data-target={`q-container-${q.questionNumber}`}
                    class="palette-btn w-full aspect-square flex items-center justify-center rounded border border-gray-200 text-gray-600 text-xs font-medium hover:border-[#2d8cf0] hover:text-[#2d8cf0] transition-colors"
                  >
                    {q.questionNumber}
                  </button>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- MAIN KHU VỰC LÀM BÀI CHIA 2 CỘT -->
  <main id="exam-main" data-duration={examData.duration} class="min-h-screen bg-[#f8f9fa] pt-[4.5rem] md:pt-20 pb-24 px-2 md:px-4 flex justify-center">
    <div class="w-full max-w-[1400px] flex flex-col data-[panel-group-direction=vertical]:flex-col flex-1" style="height: calc(100vh - 100px);">
      
      {groupedSets.map((set, idx) => {
         const isFullWidth = set.part === 2 || set.part === 5;
         return (
        <div id={`group-${idx}`} class="questions-set w-full flex flex-col lg:flex-row gap-4 mb-8">
          
          {/* CỘT TRÁI: PASSAGE / AUDIO */}
          {!isFullWidth && (
          <div class="w-full lg:w-1/2 flex flex-col border border-gray-200 bg-white rounded-lg overflow-hidden h-fit lg:max-h-[calc(100vh-120px)] lg:sticky top-[80px]">
            <div class="p-4 md:p-6 overflow-y-auto custom-scrollbar">
               <div class="mb-4 text-[#2d8cf0] text-sm md:text-base font-medium">
                  {set.part === 1 ? "Select the statement that best describes what you see in the picture." : 
                   set.part >= 3 && set.part <= 4 ? "Select the best response to each question." : 
                   "Read the texts and answer the questions."}
               </div>

               {set.audio && (
                <div class="rounded-xl bg-gray-50 border border-gray-200 mb-6 p-3 flex items-center gap-3">
                  <audio controls class="w-full h-10 auto-scroll-audio main-audio" data-group-idx={idx} data-part={set.part}>
                    <source src={set.audio}/>
                  </audio>
                </div>
               )}

               {set.image && (
                 <div class="flex justify-center mb-4">
                    <img src={set.image} alt="Reference" class="max-w-full max-h-[400px] rounded-lg shadow-sm object-contain" loading="lazy" />
                 </div>
               )}

               {set.passageHtml && (
                 <div class="min-w-0 max-w-none leading-relaxed break-words text-[15px] text-gray-800 dau-toeic-passage" set:html={set.passageHtml}></div>
               )}
            </div>
          </div>
          )}

          {/* CỘT PHẢI: CÂU HỎI */}
          <div class={`w-full flex flex-col ${isFullWidth ? 'max-w-4xl mx-auto' : 'lg:w-1/2'} bg-[#f8f9fa] overflow-y-auto custom-scrollbar lg:max-h-[calc(100vh-120px)] rounded-lg p-1`}>
             
             {isFullWidth && set.audio && (
                <div class="rounded-xl bg-white border border-gray-200 shadow-sm mb-6 p-4">
                  <audio controls class="w-full h-10 auto-scroll-audio main-audio" data-group-idx={idx} data-part={set.part}>
                    <source src={set.audio}/>
                  </audio>
                </div>
             )}

             <div class="space-y-4">
               {set.questions.map((q) => {
                 const qNum = q.questionNumber;
                 return (
                 <div id={`q-container-${qNum}`} class="p-4 rounded-lg border transition-all border-gray-200 bg-white question-item scroll-mt-24 group">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-xs font-medium status-badge">Chưa trả lời</span>
                    </div>
                    
                    <div class="mb-4">
                       <p class="text-gray-800 font-medium text-[15px]" set:html={q.question || `Câu ${qNum}`}></p>
                    </div>

                    <div class="space-y-1.5">
                       {['A','B','C','D'].map((letter) => {
                         const optText = q.options[letter];
                         if(!optText) return null; // Bỏ qua nếu không có đáp án (VD: Part 2 chỉ có A B C)
                         return (
                         <label class="flex items-start gap-2 p-2.5 rounded-md border transition-all text-sm border-gray-100 bg-gray-50 hover:bg-gray-100 cursor-pointer option-label">
                            <input 
                              type="radio" 
                              name={`q-${qNum}`} 
                              value={letter} 
                              class="answer-radio hidden" 
                              data-qnum={qNum}
                            />
                            <div class="flex items-center gap-1 min-w-[20px] pt-0.5 option-icon">
                                <svg class="hidden w-3.5 h-3.5 text-[#4caf50]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                            </div>
                            <span class="flex-1 text-gray-700 option-text"><span class="font-medium mr-1.5">({letter})</span><span set:html={optText}></span></span>
                         </label>
                         )
                       })}
                    </div>
                 </div>
               )})}
             </div>

          </div>
        </div>
      )})}
    </div>
  </main>

  <script define:vars={{ groupedSets, totalQuestions }}>
    document.addEventListener('DOMContentLoaded', () => {
      let timerInterval;
      let timeLeft;

      function startTimer() {
        const durationMin = parseInt(document.getElementById('exam-main').dataset.duration) || 120;
        timeLeft = durationMin * 60; 
        const timerEl = document.getElementById('timer');
    
        timerInterval = setInterval(() => {
          if (timeLeft > 0) {
            timeLeft--;
            const m = Math.floor(timeLeft/60).toString().padStart(2,'0');
            const s = (timeLeft%60).toString().padStart(2,'0');
            if(timerEl) timerEl.textContent = `${m}:${s}`;
            if (timeLeft < 300) timerEl.classList.add('text-rose-400', 'animate-pulse'); 
          } else {
            clearInterval(timerInterval);
            alert("⏰ Đã hết thời gian làm bài! Hệ thống đang tự động nộp bài.");
            forceSubmit();
          }
        }, 1000);
      }

      document.getElementById('btn-start-exam')?.addEventListener('click', () => {
        document.getElementById('intro-screen').classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => document.getElementById('intro-screen').style.display = 'none', 500);
        startTimer();
      });

      document.getElementById('btn-toggle-menu')?.addEventListener('click', () => {
         document.getElementById('drawer-menu')?.classList.toggle('translate-x-full')
      });

      let answeredCount = 0;
      document.querySelectorAll('.answer-radio').forEach(radio => {
        radio.addEventListener('change', (e) => {
          const qNum = e.target.dataset.qnum;
          const container = document.getElementById(`q-container-${qNum}`);
          
          container.querySelectorAll('.option-label').forEach(lbl => {
             lbl.classList.remove('border-[#4caf50]', 'bg-[#e8f5e9]');
             lbl.classList.add('border-gray-100', 'bg-gray-50');
             lbl.querySelector('.option-text').classList.remove('text-[#2e7d32]', 'font-medium');
             lbl.querySelector('.option-icon svg').classList.add('hidden');
          });

          const selectedLabel = e.target.closest('.option-label');
          selectedLabel.classList.remove('border-gray-100', 'bg-gray-50');
          selectedLabel.classList.add('border-[#4caf50]', 'bg-[#e8f5e9]');
          selectedLabel.querySelector('.option-text').classList.add('text-[#2e7d32]', 'font-medium');
          selectedLabel.querySelector('.option-icon svg').classList.remove('hidden');

          const badge = container.querySelector('.status-badge');
          badge.textContent = "Đã trả lời";
          badge.classList.replace('bg-gray-100', 'bg-blue-100');
          badge.classList.replace('text-gray-600', 'text-blue-700');

          const btn = document.getElementById(`palette-btn-${qNum}`);
          if (btn && !btn.classList.contains('bg-[#2d8cf0]')) {
            btn.classList.replace('border-gray-200', 'border-[#2d8cf0]');
            btn.classList.replace('text-gray-600', 'text-white');
            btn.classList.add('bg-[#2d8cf0]');
            answeredCount++;
            document.getElementById('answered-count').innerText = answeredCount;
            document.getElementById('answered-count-header').innerText = answeredCount;
          }
        });
      });

      document.querySelectorAll('.palette-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetId = e.target.dataset.target;
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetEl.classList.add('ring-2', 'ring-[#2d8cf0]', 'shadow-md');
            setTimeout(() => targetEl.classList.remove('ring-2', 'ring-[#2d8cf0]', 'shadow-md'), 1500);
          }
        });
      });

      document.getElementById('btn-submit')?.addEventListener('click', () => {
        if (confirm("Chốt nộp bài nhé sếp?")) forceSubmit();
      });

      function forceSubmit() {
        clearInterval(timerInterval);
        const finalResults = { score: 0, details: [] };
        
        // Trải phẳng lại Data để map dễ dàng cho trang kết quả của sếp
        const flatQuestions = [];
        groupedSets.forEach((set, setIdx) => {
          set.questions.forEach(q => {
            flatQuestions.push({
              ...q, 
              group_id: set.groupId || setIdx,
              audio: set.audio || "", 
              image: set.image || "", 
              passage: set.passageHtml || ""
            });
          });
        });

        flatQuestions.forEach(q => {
          const qNum = q.questionNumber;
          const selectedRadio = document.querySelector(`input[name="q-${qNum}"]:checked`);
          const userChoiceIndex = selectedRadio ? ['A','B','C','D'].indexOf(selectedRadio.value) : -1;
          
          let correctIndex = ['A','B','C','D'].indexOf(q.correctAnswer);
          const isCorrect = userChoiceIndex !== -1 && userChoiceIndex === correctIndex;
          if (isCorrect) finalResults.score++;

          // Lưu data với format y hệt trang cũ để trang "result" và "review" đọc được bình thường
          finalResults.details.push({
            id: qNum, 
            part: q.part, 
            group_id: q.group_id, 
            audio: q.audio, 
            image: q.image, 
            passage: q.passage,
            text: q.question || "", 
            options: [q.options.A, q.options.B, q.options.C, q.options.D].filter(Boolean), // Gom Object thành Array
            userChoice: userChoiceIndex, 
            correct: correctIndex, 
            isCorrect: isCorrect,
            explanation: q.explanationHtml || "", 
            transcript: q.transcript || ""
          });
        });

        localStorage.setItem('toeic_latest_result', JSON.stringify(finalResults));
        // Chuyển hướng sang trang kết quả cũ của sếp
        window.location.href = "/english-lab/toeic/result";
      }
    });
  </script>

  <style is:global>
    /* STYLE HTML TỪ ĐẬU TOEIC */
    .dau-toeic-passage table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    .dau-toeic-passage td, .dau-toeic-passage th { border: 1px solid #999; padding: 6px 12px; vertical-align: top; }
    .dau-toeic-passage p { margin-bottom: 12px; }
    
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background-color: #cbd5e1; }
  </style>
</Layout>