---
import Layout from '../../../layouts/Layout.astro';
import { getExamCatalog } from '../../../lib/loadExam.js';

// Lấy danh mục đề thi từ Master Sheet mới
const catalog = await getExamCatalog();

const practiceTools = [
  { title: "Ôn từ vựng", icon: "📔", link: "/english-lab/toeic/flashcards", color: "text-blue-500" },
  { title: "Luyện nghe", icon: "🎧", link: "/english-lab/toeic/dictation", color: "text-purple-500" },
  { title: "Khóa học", icon: "🎓", link: "#", color: "text-rose-500" },
  { title: "Thi thử", icon: "🏆", link: "#kho-de-thi", color: "text-amber-500", hot: true },
];

// Tự động phân loại đề theo Series và Năm
const groupedExams = {};
Object.entries(catalog).forEach(([id, data]) => {
  const series = data.series || 'KHÁC';
  const year = data.year || 'Tổng hợp';
  
  if (!groupedExams[series]) groupedExams[series] = {};
  if (!groupedExams[series][year]) groupedExams[series][year] = [];
  
  groupedExams[series][year].push({ id, ...data });
});
---

<Layout title="TOEIC Hub | Hệ Thống Luyện Thi">
  <div class="min-h-screen bg-slate-50 p-6 lg:p-12 font-sans">
    <div class="max-w-7xl mx-auto space-y-16">
      
      <div class="bg-gradient-to-r from-slate-900 to-slate-800 rounded-[2.5rem] p-10 md:p-16 shadow-2xl relative overflow-hidden">
        <div class="relative z-10">
          <h1 class="text-4xl md:text-6xl font-black text-white tracking-tight mb-4 uppercase">TOEIC Hub</h1>
          <p class="text-slate-300 text-lg md:text-xl font-medium max-w-xl">Hệ thống quản lý đề thi thông minh. Dữ liệu được cập nhật trực tiếp từ Google Sheets của sếp.</p>
        </div>
        <div class="absolute -right-10 -bottom-10 text-white/5 text-[15rem] font-black italic select-none pointer-events-none">TOEIC</div>
      </div>

      <section>
        <div class="flex items-center gap-4 mb-8">
          <div class="w-2 h-8 bg-teal-500 rounded-full"></div>
          <h2 class="text-2xl md:text-3xl font-black text-slate-800 uppercase tracking-tight">Khu Vực Ôn Luyện</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {practiceTools.map(t => (
            <a href={t.link} class="bg-white p-8 rounded-3xl text-center border border-slate-200 shadow-sm hover:border-teal-400 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative group">
              {t.hot && <span class="absolute -top-3 -right-3 bg-rose-500 text-white text-xs font-black px-3 py-1.5 rounded-full shadow-md animate-bounce">HOT</span>}
              <div class={`text-5xl mb-4 group-hover:scale-110 transition-transform duration-300 ${t.color}`}>{t.icon}</div>
              <p class="font-black text-slate-700 uppercase tracking-widest text-sm">{t.title}</p>
            </a>
          ))}
        </div>
      </section>

      <section id="kho-de-thi" class="scroll-mt-24">
        <div class="flex items-center gap-4 mb-10">
          <div class="w-2 h-8 bg-indigo-500 rounded-full"></div>
          <h2 class="text-2xl md:text-3xl font-black text-slate-800 uppercase tracking-tight">Kho Đề Thi Thử</h2>
        </div>

        <div class="space-y-12">
          {Object.entries(groupedExams).map(([series, yearsGroup]) => (
            <div class="bg-white rounded-[2rem] border border-slate-200 shadow-sm p-8 md:p-10">
              <div class="flex items-center gap-4 mb-8 border-b border-slate-100 pb-4">
                <h3 class="text-3xl font-black text-slate-800 uppercase tracking-widest">{series}</h3>
                <span class="bg-indigo-100 text-indigo-700 font-bold px-3 py-1 rounded-lg text-sm">Series</span>
              </div>

              <div class="space-y-6">
                {Object.entries(yearsGroup).map(([year, tests]) => (
                  
                  /* 🟢 BẮT ĐẦU: FOLDER CHỨA ĐỀ THI GỌN GÀNG */
                  <details class="group bg-white rounded-2xl border-2 border-slate-100 hover:border-teal-100 overflow-hidden transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
                    
                    <summary class="flex items-center justify-between p-5 md:p-6 cursor-pointer select-none outline-none hover:bg-slate-50 transition-colors list-none">
                      <div class="flex items-center gap-5">
                        <div class="w-14 h-14 bg-indigo-50 text-indigo-500 rounded-2xl flex items-center justify-center group-open:bg-teal-50 group-open:text-teal-500 transition-colors">
                          <svg class="w-7 h-7 block group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                          <svg class="w-7 h-7 hidden group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z"></path></svg>
                        </div>
                        <div>
                          <h4 class="text-xl font-black text-slate-700">{series} {year}</h4>
                          <p class="text-sm font-bold text-slate-400 mt-1 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-teal-400"></span> Gồm {tests.length} đề thi
                          </p>
                        </div>
                      </div>
                      <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 group-open:rotate-180 transition-transform duration-300 shadow-inner">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                      </div>
                    </summary>
                    
                    <div class="p-6 md:p-8 pt-2 border-t border-slate-100 bg-slate-50/50">
                      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5 mt-4">
                        {tests.map(test => (
                          <a href={`/english-lab/toeic/${test.id}`} class="group/btn flex flex-col items-center justify-center bg-white border-2 border-slate-200 p-6 rounded-2xl hover:bg-teal-50 hover:border-teal-400 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
                            <div class="w-12 h-12 bg-slate-50 rounded-full shadow-inner flex items-center justify-center text-slate-400 group-hover/btn:bg-white group-hover/btn:text-teal-500 transition-all mb-4">
                              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            </div>
                            <span class="font-black text-slate-700 text-lg group-hover/btn:text-teal-700 text-center leading-tight">{test.title}</span>
                            <span class="text-xs text-slate-500 font-bold mt-3 bg-slate-100 px-3 py-1.5 rounded-lg group-hover/btn:bg-teal-100 group-hover/btn:text-teal-700">{test.duration} phút</span>
                          </a>
                        ))}
                      </div>
                    </div>

                  </details>
                  /* 🟢 KẾT THÚC FOLDER */

                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>