---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Đăng ký | Learn Lab">
  <main class="flex min-h-[calc(100vh-76px)] w-full bg-slate-50 justify-center items-center p-6">
    
    <div class="w-full max-w-[480px] bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8 sm:p-10 relative overflow-hidden">
      <div class="absolute -top-20 -left-20 w-40 h-40 bg-emerald-50 rounded-full blur-3xl"></div>

      <div class="relative text-center mb-8">
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Tạo tài khoản 🚀</h1>
        <p class="mt-2 text-sm font-medium text-slate-500">Tham gia hệ thống học tập thông minh ngay hôm nay.</p>
      </div>

      <div class="relative flex flex-col gap-3 mb-8">
        <button id="btn-google" class="flex w-full items-center justify-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm font-bold text-slate-700 shadow-sm transition-all hover:bg-slate-50 active:scale-[0.98]">
          <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google" />
          Đăng ký siêu tốc với Google
        </button>
        <button id="btn-facebook" class="flex w-full items-center justify-center gap-3 rounded-2xl bg-[#1877F2] px-4 py-3.5 text-sm font-bold text-white shadow-sm transition-all hover:bg-[#166FE5] active:scale-[0.98]">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" /></svg>
          Đăng ký siêu tốc với Facebook
        </button>
      </div>

      <div class="relative mb-6">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-100"></div></div>
        <div class="relative flex justify-center text-xs font-bold uppercase tracking-wider text-slate-400 bg-white px-4 mx-auto w-fit">Hoặc điền thông tin</div>
      </div>

      <div id="auth-message" class="hidden mb-5 p-3.5 rounded-xl text-sm font-bold text-center"></div>

      <form id="register-form" class="relative space-y-4">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5 ml-1">Họ và tên</label>
          <input name="fullname" type="text" required placeholder="Ví dụ: Nguyễn Văn A" class="block w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-slate-900 placeholder:text-slate-400 focus:border-teal-500 focus:ring-4 focus:ring-teal-50 transition-all font-medium bg-slate-50/50 focus:bg-white outline-none" />
        </div>
        
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5 ml-1">Email của bạn</label>
          <input name="email" type="email" required placeholder="name@example.com" class="block w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-slate-900 placeholder:text-slate-400 focus:border-teal-500 focus:ring-4 focus:ring-teal-50 transition-all font-medium bg-slate-50/50 focus:bg-white outline-none" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1.5 ml-1">Mật khẩu</label>
            <input name="password" type="password" required minlength="6" placeholder="••••••••" class="block w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-slate-900 placeholder:text-slate-400 focus:border-teal-500 focus:ring-4 focus:ring-teal-50 transition-all font-medium bg-slate-50/50 focus:bg-white outline-none" />
          </div>
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1.5 ml-1">Nhập lại</label>
            <input name="confirm-password" type="password" required minlength="6" placeholder="••••••••" class="block w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-slate-900 placeholder:text-slate-400 focus:border-teal-500 focus:ring-4 focus:ring-teal-50 transition-all font-medium bg-slate-50/50 focus:bg-white outline-none" />
          </div>
        </div>

        <button id="submit-btn" type="submit" class="mt-4 w-full rounded-2xl bg-slate-900 px-4 py-4 text-sm font-bold text-white shadow-lg transition-all hover:bg-teal-600 hover:shadow-teal-200 hover:-translate-y-0.5 active:scale-[0.98] flex justify-center items-center">
          Hoàn tất đăng ký
        </button>
      </form>

      <p class="mt-8 text-center text-sm font-medium text-slate-500">
        Đã có tài khoản? <a href="/login" class="font-bold text-teal-600 hover:text-teal-700">Đăng nhập ngay</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  // Chặn user nếu đã login
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) window.location.href = "/";
  });

  const form = document.getElementById('register-form');
  const msgBox = document.getElementById('auth-message');
  const submitBtn = document.getElementById('submit-btn');

  function showMsg(text, isErr) {
    msgBox.textContent = text;
    msgBox.classList.remove('hidden');
    msgBox.className = `mb-5 p-3.5 rounded-xl text-sm font-bold text-center ${isErr ? 'bg-rose-50 text-rose-600 border border-rose-100' : 'bg-emerald-50 text-emerald-600 border border-emerald-100'}`;
  }

  // --- Lắng nghe nút Google ---
  document.getElementById('btn-google')?.addEventListener('click', async (e) => {
    e.preventDefault();
    await supabase.auth.signInWithOAuth({ provider: 'google' });
  });

  // --- Lắng nghe nút Facebook ---
  document.getElementById('btn-facebook')?.addEventListener('click', async (e) => {
    e.preventDefault();
    await supabase.auth.signInWithOAuth({ provider: 'facebook' });
  });

  // --- Lắng nghe Form Email truyền thống ---
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const data = new FormData(form);
    const fullname = data.get('fullname');
    const email = data.get('email');
    const pass = data.get('password');
    const confirm = data.get('confirm-password');

    if (pass !== confirm) {
        return showMsg('Mật khẩu xác nhận không khớp. Sếp gõ lại nhé!', true);
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = `<svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

    const { error } = await supabase.auth.signUp({
      email, 
      password: pass,
      options: { data: { fullname } }
    });
    
    if (error) {
      showMsg(error.message, true);
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Hoàn tất đăng ký';
    } else {
      showMsg("Đăng ký thành công! Đang đưa sếp vào hệ thống...", false);
      setTimeout(() => window.location.href = "/", 1000);
    }
  });
</script>