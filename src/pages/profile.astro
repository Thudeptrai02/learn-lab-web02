---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hồ sơ cá nhân | Learn Lab">
  <main class="min-h-screen bg-slate-50 py-10 px-6">
    <div class="max-w-2xl mx-auto">
      
      <a href="/" class="inline-flex items-center text-sm font-bold text-slate-500 hover:text-teal-600 transition-colors mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Quay lại Bảng điều khiển
      </a>

      <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-200">
        <div class="mb-8">
          <h1 class="text-3xl font-black text-slate-900 tracking-tight">Hồ sơ của sếp 👤</h1>
          <p class="mt-2 text-slate-500 font-medium">Cập nhật thông tin để AI "soi gương" chuẩn xác hơn nhé.</p>
        </div>

        <div id="status-message" class="hidden mb-6 p-4 rounded-xl text-sm font-bold text-center"></div>

        <form id="profile-form" class="space-y-5 hidden">
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1.5">Họ và tên</label>
            <input id="fullname" type="text" required class="w-full rounded-xl border-2 border-slate-200 px-4 py-3 text-slate-900 focus:border-teal-500 focus:outline-none focus:ring-4 focus:ring-teal-50 transition-all font-medium" />
          </div>

          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1.5">Nghề nghiệp hiện tại</label>
            <select id="job-title" required class="w-full rounded-xl border-2 border-slate-200 px-4 py-3 text-slate-900 focus:border-teal-500 focus:outline-none focus:ring-4 focus:ring-teal-50 transition-all font-medium bg-white">
              <option value="Developer">Lập trình viên (Developer)</option>
              <option value="Doctor">Y tế / Bác sĩ (Medical)</option>
              <option value="Accountant">Kế toán / Tài chính (Finance)</option>
              <option value="Student">Học sinh / Sinh viên</option>
              <option value="Marketing">Marketing / Sales</option>
              <option value="Other">Khác...</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1.5">Mục tiêu học tập</label>
            <select id="career-goal" required class="w-full rounded-xl border-2 border-slate-200 px-4 py-3 text-slate-900 focus:border-teal-500 focus:outline-none focus:ring-4 focus:ring-teal-50 transition-all font-medium bg-white">
              <option value="Promotion">Thăng tiến sự nghiệp</option>
              <option value="Interview">Phỏng vấn xin việc (Interview)</option>
              <option value="Communication">Giao tiếp với sếp/đồng nghiệp Tây</option>
              <option value="Exam">Thi lấy bằng (TOEIC/IELTS)</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1.5">Sở thích (Chủ đề quan tâm)</label>
            <input id="interests" type="text" class="w-full rounded-xl border-2 border-slate-200 px-4 py-3 text-slate-900 focus:border-teal-500 focus:outline-none focus:ring-4 focus:ring-teal-50 transition-all font-medium" />
          </div>

          <button id="save-btn" type="submit" class="mt-8 w-full bg-teal-600 text-white font-black py-4 rounded-xl shadow-lg hover:bg-teal-700 active:scale-95 transition-all">
            LƯU THÔNG TIN
          </button>
        </form>

        <div id="loading-skeleton" class="animate-pulse space-y-6">
          <div class="h-12 bg-slate-200 rounded-xl w-full"></div>
          <div class="h-12 bg-slate-200 rounded-xl w-full"></div>
          <div class="h-12 bg-slate-200 rounded-xl w-full"></div>
          <div class="h-12 bg-slate-200 rounded-xl w-full"></div>
        </div>

      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('profile-form');
  const loading = document.getElementById('loading-skeleton');
  const statusMsg = document.getElementById('status-message');
  const saveBtn = document.getElementById('save-btn');

  const inFullname = document.getElementById('fullname');
  const inJob = document.getElementById('job-title');
  const inGoal = document.getElementById('career-goal');
  const inInterests = document.getElementById('interests');

  function showMessage(text, isError) {
    statusMsg.textContent = text;
    statusMsg.classList.remove('hidden');
    statusMsg.className = `mb-6 p-4 rounded-xl text-sm font-bold text-center ${
      isError ? 'bg-rose-100 text-rose-700 border border-rose-200' : 'bg-emerald-100 text-emerald-700 border border-emerald-200'
    }`;
  }

  // 1. LẤY DỮ LIỆU CŨ LÊN FORM
  async function loadProfile() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/login';
      return;
    }

    const meta = session.user.user_metadata;
    
    // Đổ dữ liệu vào các ô input
    if(meta.full_name) inFullname.value = meta.full_name;
    if(meta.job_title) inJob.value = meta.job_title;
    if(meta.career_goal) inGoal.value = meta.career_goal;
    if(meta.interests) inInterests.value = meta.interests;

    // Giấu loading, hiện form
    loading.classList.add('hidden');
    form.classList.remove('hidden');
  }

  loadProfile();

  // 2. CẬP NHẬT DỮ LIỆU MỚI
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.innerHTML = "ĐANG LƯU...";

    const { data, error } = await supabase.auth.updateUser({
      data: {
        full_name: inFullname.value,
        job_title: inJob.value,
        career_goal: inGoal.value,
        interests: inInterests.value
      }
    });

    if (error) {
      showMessage("Lỗi rồi sếp ơi: " + error.message, true);
    } else {
      showMessage("🎉 Cập nhật thành công! AI đã ghi nhận thông tin mới.", false);
    }

    saveBtn.disabled = false;
    saveBtn.innerHTML = "LƯU THÔNG TIN";
  });
</script>