---
interface Props {
  pdfUrl: string;
}

const { pdfUrl } = Astro.props;
---

<div class="pdf-viewer-container h-full w-full relative">
  <iframe
    src={`/pdfjs-viewer/web/viewer.html?file=${encodeURIComponent(pdfUrl)}`}
    class="w-full h-full border-0"
    title="PDF Viewer"
    loading="lazy"
  />
</div>

<style is:global>
  .pdf-viewer-container iframe {
    min-height: 600px;
  }
</style>