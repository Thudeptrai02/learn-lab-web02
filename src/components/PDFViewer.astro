---
interface Props {
  pdfUrl: string;
}
const { pdfUrl } = Astro.props;
---

<div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-500">
  <div class="text-center p-8">
    <p class="font-bold mb-2">PDF Viewer</p>
    <p class="text-sm">{pdfUrl}</p>
    <a href={pdfUrl} target="_blank" class="mt-4 inline-block px-4 py-2 bg-teal-600 text-white rounded-xl text-sm font-bold hover:bg-teal-700 transition-colors" download>
      Tai PDF
    </a>
  </div>
</div>
