---
<nav class="flex w-full items-center justify-between">
  <div class="flex flex-1 items-center justify-center gap-10 text-sm font-bold text-slate-600">
    <a href="/" class="relative py-2 transition-colors hover:text-teal-700 group">
      Trang chủ
      <span class="absolute bottom-0 left-0 h-0.5 w-0 bg-teal-600 transition-all group-hover:w-full"></span>
    </a>
    
    <a href="/english-lab/toeic" class="relative py-2 text-slate-900 transition-colors hover:text-teal-700 group">
      TOEIC Lab
      <span class="absolute bottom-0 left-0 h-0.5 w-0 bg-teal-600 transition-all group-hover:w-full"></span>
    </a>
    
    <a href="/blog" class="relative py-2 transition-colors hover:text-teal-700 group">
      Blog
      <span class="absolute bottom-0 left-0 h-0.5 w-0 bg-teal-600 transition-all group-hover:w-full"></span>
    </a>

    <a href="/free-resources" class="relative py-2 transition-colors hover:text-teal-700 group">
      Tài liệu
      <span class="absolute bottom-0 left-0 h-0.5 w-0 bg-teal-600 transition-all group-hover:w-full"></span>
    </a>

    <a href="/zen-mode" class="group relative flex items-center gap-2 rounded-full bg-teal-50 px-4 py-2 text-teal-600 transition-all duration-300 hover:text-white overflow-hidden shadow-sm hover:shadow-md">
      <span class="relative z-10 uppercase tracking-widest text-[11px] font-black">Zen Mode</span>
      <svg class="relative z-10 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
      <div class="absolute inset-0 bg-gradient-to-r from-teal-400 to-teal-600 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out"></div>
    </a>
  </div>

  <div class="flex items-center gap-3 border-l border-slate-100 pl-8">
    <a href="/login" class="px-4 py-2 text-sm font-bold text-slate-700 transition-all hover:text-teal-700">
      Đăng nhập
    </a>
    <a href="/register" class="rounded-xl bg-teal-600 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-teal-100 transition-all hover:bg-teal-700 hover:-translate-y-0.5 active:scale-95">
      Đăng ký
    </a>
  </div>
</nav>

<style>
  /* Hiệu ứng gạch chân khi hover cho chuyên nghiệp */
  a {
    text-decoration: none;
  }
</style>