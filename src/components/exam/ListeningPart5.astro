---
// src/components/exam/Part5Inline.astro - Bản Final Đã Hiện Đáp Án
import MultipleChoice from './MultipleChoice.astro';

const { questions } = Astro.props;

// 1. Lấy nội dung đoạn văn từ câu đầu tiên
let passageHtml = questions[0]?.Passage || "";

// 2. CHUYỂN CÁC CHỖ TRỐNG THÀNH HUY HIỆU SỐ
questions.forEach((q: any) => {
  if (!q || !q.No) return;
  
  // Bắt chuẩn xác (25) ..... hoặc ____25____
  const gapRegex = new RegExp(`(?:\\.{2,}|_+|…+)?\\s*\\(?\\s*${q.No}\\s*\\)?\\s*(?:\\.{2,}|_+|…+)?`, 'g');
  
  // Biến thành Badge màu xanh lá
  const badge = `<span class="inline-flex items-center justify-center min-w-[2.5rem] px-2 h-7 rounded-md bg-emerald-100 text-emerald-800 font-black mx-1 border border-emerald-300 shadow-sm align-baseline">${q.No}</span>`;
  
  passageHtml = passageHtml.replace(gapRegex, badge);
});

// 3. TỰ ĐỘNG CHIA ĐOẠN ĐẸP MẮT (Bọc thẻ <p> thay vì để chữ dính liền)
const formattedPassage = passageHtml
  .split(/\r?\n/)
  .filter((l: string) => l.trim() !== "")
  .map((l: string) => `<p class="mb-4">${l}</p>`)
  .join("");
---

<div class="bg-white p-8 md:p-12 rounded-[3rem] border border-slate-200 shadow-sm relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-2 bg-emerald-500"></div>
  
  {/* BÀI ĐỌC ĐÃ ĐỤC LỖ */}
  <div class="prose prose-slate max-w-none text-lg leading-loose text-slate-700 font-medium text-justify mb-12" set:html={formattedPassage} />
  
  {/* KHU VỰC CHỌN ĐÁP ÁN A, B, C */}
  <div class="bg-slate-50 p-6 md:p-10 rounded-[2.5rem] border border-slate-100">
      <div class="flex justify-center mb-8">
          <h4 class="text-xl font-black text-slate-800 uppercase tracking-widest border-b-2 border-slate-200 pb-2">
             Chọn từ thích hợp
          </h4>
      </div>
      
      {/* Grid chia 2 cột để các câu hỏi đứng cạnh nhau cho tiết kiệm diện tích */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4">
         {questions.map((q: any) => {
            // Dọn rác văn bản: Chỉ hiện số câu (VD: "25.") chứ không lặp lại câu hỏi
            const cleanQ = { ...q, Question: q.No + '.' };
            return <MultipleChoice q={cleanQ} part={5} />
         })}
      </div>
  </div>
</div>