---
// src/components/exam/Part5Inline.astro
const { part } = Astro.props;
const questions = part.questions;
let passageHtml = part.passage;

const lines = passageHtml.split('\n');
const title = lines[0];
// Xóa tiêu đề khỏi đoạn text gốc và bọc lại với margin cực thấp (mb-2)
passageHtml = passageHtml.replace(title, '').trim();
passageHtml = passageHtml.replace(/\n\n/g, '<br/><br/>').replace(/\n/g, '<br/>');

questions.forEach(q => {
  const inputTag = `<input type="text" id="q-${q.ID}" name="${q.ID}" autocomplete="off" class="mx-1 w-20 border border-teal-200 bg-teal-50/50 text-center font-bold font-sans text-teal-800 outline-none focus:bg-teal-100 focus:border-teal-400 transition-all rounded shadow-sm text-[1rem] py-0.5 scroll-mt-32" placeholder="${q.Q_Num}" />`;
  passageHtml = passageHtml.replace(new RegExp(`\\(\\s*${q.Q_Num}\\s*\\)\\s*[_\\.]+`, 'g'), inputTag);
});
---

<div class="relative">
  <h3 class="text-xl md:text-2xl font-black text-slate-800 mb-2 text-center uppercase tracking-tight">{title}</h3>
  <div class="text-[1.1rem] md:text-[1.15rem] text-slate-800 font-serif leading-8 text-justify" set:html={passageHtml} />
</div>