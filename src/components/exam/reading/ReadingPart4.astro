---
// src/components/exam/ReadingPart4.astro
const { part } = Astro.props;
const passage = part.passage || "";
const questions = part.questions;

// Tách đoạn văn để chèn ô trống
const segments = passage.split(/(\(\d+\)\s*[\._]{2,})/g);
let title = "";
let contentSegments = segments;
if (segments[0].includes('\n')) {
  const parts = segments[0].split('\n');
  title = parts[0];
  contentSegments[0] = parts.slice(1).join('\n');
}
---

<div class="relative">
  {title && <h3 class="text-xl md:text-2xl font-black text-slate-800 mb-4 text-center uppercase tracking-tight">{title}</h3>}
  
  {/* FONT SERIF CHUẨN SÁCH, KHOẢNG CÁCH DÒNG LEADING-LOOSE SÁT NHAU */}
  <div class="text-[1.1rem] md:text-[1.15rem] text-slate-800 font-serif leading-loose text-justify">
    {contentSegments.map(seg => {
      const match = seg.match(/\((\d+)\)/);
      if (match) {
        const qNum = match[1];
        const qData = questions.find(q => parseInt(q.Q_Num) === parseInt(qNum));
        if (!qData) return <span>{seg}</span>;

        return (
          // 🚨 data-qid phải là qData.ID để file ReadingExam tìm được
          <div id={`q-${qData.ID}`} class="inline-block relative gap-component mx-1 scroll-mt-32" data-qnum={qNum} data-qid={qData.ID} data-user-answer="">
            
            <button type="button" class="gap-trigger inline-flex items-center gap-2 px-2 py-1 bg-teal-50/60 backdrop-blur-sm border border-teal-200 hover:border-teal-400 hover:bg-teal-100 rounded-md shadow-sm transition-all outline-none relative top-[1px]">
              
              {/* Huy hiệu số câu to rõ */}
              <span class="q-number w-6 h-6 flex items-center justify-center bg-teal-600 text-white font-black rounded text-[13px] shadow-sm leading-none transition-colors">
                 {qNum}
              </span>
              
              <span class="selected-text font-bold text-teal-900 tracking-wider min-w-[2.2rem] text-center font-sans text-[16px]">...</span>
              
              <svg class="w-3.5 h-3.5 text-teal-600 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            
            {/* MENU CHỌN ĐÁP ÁN (KÍNH MỜ) */}
            <div class="gap-menu absolute top-[calc(100%+4px)] left-0 min-w-[150px] bg-white/90 backdrop-blur-xl rounded-xl shadow-xl border border-teal-100 opacity-0 pointer-events-none transition-all duration-200 scale-95 origin-top-left z-50 p-1.5">
                {['A', 'B', 'C'].map(opt => qData[`Opt_${opt}`] && (
                  <button type="button" class="option-btn flex items-center gap-3 w-full text-left px-3 py-2 rounded-lg hover:bg-teal-500 hover:text-white transition-colors font-sans group/opt" data-val={opt}>
                    <span class="w-6 h-6 flex items-center justify-center bg-teal-100 text-teal-700 rounded font-black text-[10px] group-hover/opt:bg-white/20 group-hover/opt:text-white">{opt}</span>
                    <span class="font-bold text-[14px]">{qData[`Opt_${opt}`]}</span>
                  </button>
                ))}
            </div>
          </div>
        );
      }
      return <span set:html={seg.replace(/\n\n/g, '<br/><br/>').replace(/\n/g, ' ')}></span>;
    })}
  </div>
</div>

<style>
  .gap-component.is-active .gap-menu { opacity: 1; pointer-events: auto; transform: scale(1); }
  .gap-component.is-active .gap-trigger { border-color: #0d9488; background-color: #ccfbf1; }
  .gap-component.is-completed .gap-trigger .selected-text { color: #0f766e; }
  .gap-component.is-completed .gap-trigger svg { display: none; }
</style>

<script>
  document.querySelectorAll('.gap-component').forEach(comp => {
    const trigger = comp.querySelector('.gap-trigger');
    const options = comp.querySelectorAll('.option-btn');
    const display = comp.querySelector('.selected-text');

    trigger.addEventListener('click', (e) => {
      if (document.body.classList.contains('review-mode')) return;
      e.stopPropagation();
      const isActive = comp.classList.contains('is-active');
      document.querySelectorAll('.gap-component').forEach(c => c.classList.remove('is-active'));
      if (!isActive) comp.classList.add('is-active');
    });

    options.forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const val = opt.getAttribute('data-val');
        // Hiện tên đáp án vào ô
        display.textContent = opt.querySelector('span:last-child').textContent;
        comp.classList.remove('is-active');
        comp.classList.add('is-completed');
        
        // Ghi lại đáp án vào data attribute cho ReadingExam đọc
        comp.setAttribute('data-user-answer', val);
        
        const qId = comp.getAttribute('data-qid');
        document.dispatchEvent(new CustomEvent('dropdownAnswered', { detail: { id: qId } }));
      });
    });
  });
  document.addEventListener('click', () => document.querySelectorAll('.gap-component').forEach(c => c.classList.remove('is-active')));
</script>