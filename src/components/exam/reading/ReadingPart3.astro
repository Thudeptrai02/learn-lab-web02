---
// src/components/exam/ReadingPart3.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

function formatPassage(text) {
  if (!text) return "";
  const lines = text.split('\n').filter(l => l.trim() !== "");
  return lines.map((line, index) => {
    if (index === 0) return `<h3 class="text-2xl md:text-3xl font-black text-slate-800 mb-6 text-center uppercase tracking-tight">${line}</h3>`;
    return `<p class="mb-5 text-slate-800 leading-8 text-[1.1rem] font-serif text-justify">${line}</p>`;
  }).join("");
}
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start relative">
  {/* ĐỔI THÀNH lg:top-28 ĐỂ NÉ MENU TRÊN CÙNG CỦA WEB */}
  <div class="lg:col-span-7 bg-white p-8 md:p-12 rounded-2xl border border-slate-100 shadow-sm lg:sticky lg:top-28 self-start max-h-[calc(100vh-8rem)] overflow-y-auto custom-scrollbar">
    <div class="prose prose-slate max-w-none" set:html={formatPassage(part.passage)} />
  </div>

  <div class="lg:col-span-5 space-y-6 pt-2">
    {part.questions.map(q => (
       /* THÊM ID ĐỂ ĐỊNH VỊ CÂU HỎI */
       <div id={`q-${q.ID}`}>
          <MultipleChoice q={q} />
       </div>
    ))}
  </div>
</div>