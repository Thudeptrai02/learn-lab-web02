---
// src/components/exam/ReadingPart1.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

// Hàm "Biến hình" văn bản thành các vật thể đời thực
function renderPhysicalUI(passage, index) {
  if (!passage) return "";
  const lines = passage.split('\n').filter(l => l.trim() !== "");
  
  // Tự động xoay vòng 4 kiểu thiết kế cho 6 câu hỏi
  const type = index % 4; 

  if (type === 0) {
    // 1. BIỂN BÁO (Notice Board) - Nền đen chữ vàng
    return `
      <div class="bg-slate-800 text-white p-8 rounded-2xl shadow-lg w-full max-w-sm mx-auto relative border-4 border-slate-600 flex flex-col justify-center min-h-[220px]">
        <h3 class="text-xl md:text-2xl font-black uppercase text-center border-b-2 border-slate-500 pb-3 mb-5 text-yellow-400 tracking-widest">${lines[0]}</h3>
        <p class="text-center font-bold text-[16px] leading-relaxed">${lines.slice(1).join('<br/>')}</p>
      </div>`;
  }
  if (type === 1) {
    // 2. TIN NHẮN ĐIỆN THOẠI (Smartphone UI)
    return `
      <div class="bg-slate-100 rounded-[2.5rem] border-[8px] border-slate-800 shadow-xl w-full max-w-[280px] mx-auto p-4 flex flex-col h-full min-h-[250px]">
        <div class="w-12 h-1.5 bg-slate-800 rounded-full mx-auto mb-4"></div>
        <div class="text-center text-[10px] font-bold text-slate-400 mb-3 tracking-widest uppercase">Today 09:41</div>
        <div class="bg-[#25D366] text-white px-5 py-3.5 rounded-2xl rounded-tr-sm shadow-sm max-w-[85%] self-end">
           <p class="font-medium text-[15px] leading-relaxed">${passage.replace(/\n/g, '<br/>')}</p>
        </div>
      </div>`;
  }
  if (type === 2) {
    // 3. EMAIL / TRÌNH DUYỆT (Browser Window)
    const fromLine = lines.find(l => l.toLowerCase().includes('from:')) || lines[0];
    const rest = lines.filter(l => l !== fromLine && !l.toLowerCase().includes('to:'));
    return `
      <div class="bg-white rounded-xl border border-slate-200 shadow-lg w-full max-w-sm mx-auto overflow-hidden min-h-[220px] flex flex-col">
        <div class="bg-slate-100 px-4 py-2.5 flex items-center gap-2 border-b border-slate-200">
           <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div><div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div><div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
        </div>
        <div class="bg-slate-50 px-5 py-3 border-b border-slate-100">
           <p class="text-[11px] font-bold text-slate-500 uppercase">${fromLine}</p>
        </div>
        <div class="p-6 text-slate-700 font-medium text-[15px] leading-relaxed flex-1">${rest.join('<br/>')}</div>
      </div>`;
  }
  if (type === 3) {
    // 4. GIẤY NHỚ (Sticky Note) - Nền vàng, dán băng keo
    return `
      <div class="bg-[#fef08a] text-slate-800 p-8 pt-10 rounded-br-3xl shadow-[4px_4px_15px_rgba(0,0,0,0.1)] w-full max-w-sm mx-auto relative min-h-[220px] flex flex-col justify-center transform -rotate-1">
        <div class="absolute top-[-12px] left-1/2 -translate-x-1/2 w-16 h-6 bg-white/40 shadow-sm rotate-2 backdrop-blur-sm border border-white/50"></div>
        <p class="font-medium text-[17px] leading-loose text-center italic">${lines.join('<br/>')}</p>
      </div>`;
  }
}
---

<div class="space-y-10 py-6">
  {part.questions.map((q, index) => (
    <div id={`q-${q.ID}`} class="flex flex-col lg:flex-row gap-8 bg-white p-6 md:p-10 rounded-[2.5rem] border border-slate-100 shadow-sm items-center scroll-mt-32">
      
      {/* KHUNG HIỂN THỊ ĐA DẠNG */}
      <div class="w-full lg:w-5/12 bg-slate-50/50 p-6 md:p-10 rounded-3xl flex items-center justify-center border border-slate-100 border-dashed min-h-[300px]">
         <div class="w-full" set:html={renderPhysicalUI(q.Passage || q.passage, index)} />
      </div>
      
      {/* KHUNG CÂU HỎI TRẮC NGHIỆM */}
      <div class="w-full lg:w-7/12">
         <MultipleChoice q={q} isPart1={true} />
      </div>
    </div>
  ))}
</div>