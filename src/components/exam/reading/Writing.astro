---
// src/components/exam/Writing.astro
const { q } = Astro.props;
const partNum = parseInt(q.Part || q.part);

let rawPassage = q.Passage || "";
let cleanPassage = rawPassage;
let isPart6 = (partNum === 6);
let isPart7 = (partNum === 7);

let introText = "";
let emailBox = [];
let bulletPoints = [];
let outroText = "";

if (isPart7) {
    cleanPassage = cleanPassage.replace(/\[?Picture\s*\d\s*[:.-].*?\]?/gi, '').replace(/\n{2,}/g, '\n\n').trim();
}

const imageUrls = isPart7 && q.Image_URL
  ? q.Image_URL.split('|').map(u => u.trim()).filter(u => u.length > 0 && u.startsWith('http'))
  : [];

const proxyUrl = (u) => {
  if (!u || !u.startsWith('http')) return u;
  return `/api/proxy-image?url=${encodeURIComponent(u)}`;
};

if (isPart6) {
    const lines = cleanPassage.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    lines.forEach((line, index) => {
        const lowerLine = line.toLowerCase();
        if (line.startsWith('-') || line.startsWith('•') || line.startsWith('*')) {
            bulletPoints.push(line.replace(/^[-•*]\s*/, ''));
        } else if (lowerLine.includes('read') && index === 0) {
            introText = line;
        } else if (lowerLine.includes('write') && lowerLine.includes('words')) {
            outroText = line;
        } else {
            emailBox.push(line);
        }
    });
}
---

<div class="bg-white border border-slate-200 rounded-[2.5rem] p-8 md:p-12 shadow-sm relative transition-all hover:shadow-md">
  
  <div class="absolute top-8 right-8">
     <span class="bg-teal-100 text-teal-700 font-black px-4 py-2 rounded-xl text-sm uppercase tracking-widest shadow-sm border border-teal-200/50">Question {q.Q_Num}</span>
  </div>

  <h3 class="text-2xl font-black text-slate-800 mb-8 uppercase tracking-tight">Part {q.Part}</h3>

  {isPart7 && (
    <div class="mb-10">
      {imageUrls.length >= 3 ? (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
          {imageUrls.slice(0, 3).map((url, i) => (
            <div class="rounded-2xl overflow-hidden border-2 border-slate-200 bg-slate-50 shadow-sm group relative">
              <img src={proxyUrl(url)} alt={`Picture ${i + 1}`} class="w-full h-52 object-cover group-hover:scale-105 transition-transform duration-500 auto-crop-img" />
              <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-3">
                <span class="text-white text-xs font-black uppercase tracking-widest">Picture {i + 1}</span>
              </div>
            </div>
          ))}
        </div>
      ) : imageUrls.length === 1 ? (
        <div class="rounded-[2rem] overflow-hidden border-4 border-slate-50 shadow-md bg-slate-100 mb-6 flex items-center justify-center min-h-[250px] relative group">
          <img src={proxyUrl(imageUrls[0])} alt="Writing Prompt" class="w-full object-contain max-h-[400px] auto-crop-img" />
        </div>
      ) : (
        <div class="rounded-[2rem] overflow-hidden border-4 border-slate-50 shadow-md bg-slate-100 mb-6 flex flex-col items-center justify-center min-h-[250px] relative group">
          <div class="text-slate-400 font-bold flex flex-col items-center gap-2">
            <svg class="w-10 h-10 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            Dán link ảnh 3 tranh vào Image_URL (phân cách bằng dấu |)
          </div>
        </div>
      )}
      <p class="text-slate-800 font-serif text-[1.15rem] leading-8 text-justify border-l-[5px] border-teal-400 pl-5 bg-teal-50/40 py-4 pr-4 rounded-r-2xl" set:html={cleanPassage.replace(/\n/g, '<br/>')}></p>
    </div>
  )}

  {isPart6 && (
    <div class="mb-10">
      {introText && <p class="text-slate-500 font-bold mb-4 uppercase tracking-wider text-sm">{introText}</p>}
      {emailBox.length > 0 && (
         <div class="bg-slate-50 border border-slate-200 p-6 rounded-2xl mb-6 shadow-inner relative">
            <div class="absolute top-4 right-4 flex gap-1"><div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div><div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div><div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div></div>
            <p class="text-slate-800 font-serif text-[1.15rem] leading-8" set:html={emailBox.join('<br/>')}></p>
         </div>
      )}
      {bulletPoints.length > 0 && (
         <div class="mb-6 bg-teal-50/50 border border-teal-100 p-5 rounded-2xl">
            <p class="text-teal-800 font-bold mb-3 text-sm">In your email, you must:</p>
            <ul class="space-y-2">
               {bulletPoints.map(bullet => (
                  <li class="flex items-start gap-3 text-teal-900 font-medium">
                     <span class="text-teal-500 mt-1"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg></span>
                     <span set:html={bullet}></span>
                  </li>
               ))}
            </ul>
         </div>
      )}
      {outroText && <p class="text-rose-600 font-bold text-sm bg-rose-50 inline-block px-4 py-2 rounded-lg border border-rose-100">{outroText}</p>}
    </div>
  )}

  {/* 🚨 THÊM data-part ĐỂ BỘ ĐẾM BIẾT ĐANG Ở PART NÀO MÀ TÍNH LUẬT */}
  <div class="relative group writing-block">
    <textarea 
      name={q.ID}
      data-part={partNum}
      placeholder="Start typing your answer here..."
      class="writing-ta w-full min-h-[250px] p-8 pb-16 rounded-[2rem] border-2 border-slate-200 bg-slate-50/50 focus:bg-white focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 outline-none transition-all text-slate-700 font-medium text-[1.1rem] leading-relaxed resize-none custom-scrollbar"
    ></textarea>
    
    <div class="word-count-ui absolute bottom-6 right-6 bg-white px-4 py-2 rounded-xl border border-slate-200 shadow-sm text-xs font-black text-slate-500 uppercase tracking-widest flex items-center gap-2 transition-colors">
      <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
      <span>0</span> words
    </div>
  </div>

  <div class="explanation-box hidden mt-10 p-8 bg-emerald-50/80 backdrop-blur-md rounded-[2rem] border border-emerald-200 shadow-inner animate-in fade-in slide-in-from-top-4">
     <h5 class="text-emerald-700 font-black text-sm uppercase tracking-[0.2em] mb-4 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Sample Answer
     </h5>
     <div class="text-emerald-900 font-medium text-[1.1rem] leading-relaxed bg-white/80 p-6 rounded-2xl border border-emerald-100 shadow-sm" set:html={q.Answer.replace(/\n/g, '<br/>')}></div>
     {q.Explanation && (
        <div class="mt-5 pt-5 border-t border-emerald-200/50">
           <p class="text-emerald-800/80 text-sm font-bold leading-relaxed">{q.Explanation}</p>
        </div>
     )}

     <div class="ai-grading hidden mt-6 p-6 bg-gradient-to-br from-indigo-50 to-purple-50/80 backdrop-blur-md rounded-2xl border border-indigo-200 shadow-inner animate-in fade-in slide-in-from-top-4">
        <h5 class="text-indigo-700 font-black text-sm uppercase tracking-[0.2em] mb-5 flex items-center gap-2">
           <span class="bg-indigo-600 text-white px-2.5 py-1 rounded-lg text-[10px]">AI</span>
           Chấm điểm tự động
        </h5>
        <div class="grid grid-cols-3 gap-4 mb-5">
           <div class="bg-white/80 border border-indigo-100 rounded-2xl p-4 text-center shadow-sm">
              <div class="text-2xl font-black text-indigo-600 ai-content-score">-</div>
              <div class="text-[10px] font-black text-indigo-400 uppercase tracking-widest mt-1">Nội dung /5</div>
           </div>
           <div class="bg-white/80 border border-indigo-100 rounded-2xl p-4 text-center shadow-sm">
              <div class="text-2xl font-black text-indigo-600 ai-org-score">-</div>
              <div class="text-[10px] font-black text-indigo-400 uppercase tracking-widest mt-1">Bố cục /5</div>
           </div>
           <div class="bg-white/80 border border-indigo-100 rounded-2xl p-4 text-center shadow-sm">
              <div class="text-2xl font-black text-indigo-600 ai-lang-score">-</div>
              <div class="text-[10px] font-black text-indigo-400 uppercase tracking-widest mt-1">Ngôn ngữ /5</div>
           </div>
        </div>
        <div class="bg-white/90 p-5 rounded-2xl border border-indigo-100 shadow-sm">
           <p class="text-indigo-900 font-medium leading-relaxed ai-feedback-text"></p>
        </div>
     </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
</style>

<script>
  // AUTO-CROP ẢNH: cắt bỏ khoảng trắng viền
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.auto-crop-img').forEach(img => {
      let cropped = false;
      img.addEventListener('load', () => {
        if (cropped) return;
        if (!img.naturalWidth || !img.naturalHeight) return;
        try {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          let w = img.naturalWidth, h = img.naturalHeight;
          canvas.width = w; canvas.height = h;
          ctx.drawImage(img, 0, 0);

          const imageData = ctx.getImageData(0, 0, w, h);
          const data = imageData.data;
          const threshold = 250;

          function isWhite(x, y) {
            const i = (y * w + x) * 4;
            return data[i] >= threshold && data[i+1] >= threshold && data[i+2] >= threshold;
          }

          let top = 0;
          for (let y = 0; y < h; y++) { let all = true; for (let x = 0; x < w; x++) { if (!isWhite(x, y)) { all = false; break; } } if (!all) { top = y; break; } }
          let bottom = h - 1;
          for (let y = h - 1; y >= top; y--) { let all = true; for (let x = 0; x < w; x++) { if (!isWhite(x, y)) { all = false; break; } } if (!all) { bottom = y; break; } }
          let left = 0;
          for (let x = 0; x < w; x++) { let all = true; for (let y = top; y <= bottom; y++) { if (!isWhite(x, y)) { all = false; break; } } if (!all) { left = x; break; } }
          let right = w - 1;
          for (let x = w - 1; x >= left; x--) { let all = true; for (let y = top; y <= bottom; y++) { if (!isWhite(x, y)) { all = false; break; } } if (!all) { right = x; break; } }

          if (top < bottom && left < right) {
            const cw = right - left + 1, ch = bottom - top + 1;
            if (cw < w || ch < h) {
              cropped = true;
              const croppedCanvas = document.createElement('canvas');
              croppedCanvas.width = cw; croppedCanvas.height = ch;
              croppedCanvas.getContext('2d').drawImage(canvas, left, top, cw, ch, 0, 0, cw, ch);
              img.src = croppedCanvas.toDataURL();
            }
          }
        } catch (e) { /* ignore CORS/security errors */ }
      });
      if (img.complete) img.dispatchEvent(new Event('load'));
    });
  });

  // LOGIC ĐẾM TỪ & ĐỔI MÀU THÔNG MINH
  document.querySelectorAll('.writing-ta').forEach(ta => {
     ta.addEventListener('input', function() {
         const partNum = parseInt(this.getAttribute('data-part'));
         const ui = this.parentElement.querySelector('.word-count-ui');
         const span = ui.querySelector('span');
         const words = this.value.trim().split(/\s+/).filter(w => w.length > 0).length;
         
         span.innerText = words;

         // Reset toàn bộ màu sắc
         ui.className = "word-count-ui absolute bottom-6 right-6 px-4 py-2 rounded-xl border shadow-sm text-xs font-black uppercase tracking-widest flex items-center gap-2 transition-colors ";

         if (words === 0) {
             ui.classList.add('bg-white', 'border-slate-200', 'text-slate-500');
             return;
         }

         // Luật của Cambridge: Part 6 (25-35 từ), Part 7 (>= 35 từ)
         if (partNum === 6) {
             if (words < 25) ui.classList.add('bg-amber-100', 'border-amber-300', 'text-amber-700'); // Thiếu chữ
             else if (words <= 35) ui.classList.add('bg-emerald-100', 'border-emerald-400', 'text-emerald-700'); // Quá chuẩn
             else ui.classList.add('bg-rose-100', 'border-rose-400', 'text-rose-700'); // Lố chữ
         } else if (partNum === 7) {
             if (words < 35) ui.classList.add('bg-amber-100', 'border-amber-300', 'text-amber-700'); // Thiếu chữ
             else ui.classList.add('bg-emerald-100', 'border-emerald-400', 'text-emerald-700'); // Quá chuẩn
         }
     });
  });
</script>