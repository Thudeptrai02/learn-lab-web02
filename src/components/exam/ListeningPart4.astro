---
const { q } = Astro.props;

// THUẬT TOÁN TÁCH NGỮ CẢNH ĐỘC QUYỀN CHO PART 4
function parsePart4Question(text: string) {
    if (!text) return { context: '', mainQuestion: '' };
    
    // Đổi toàn bộ thẻ xuống dòng thành \n để xử lý
    let cleanText = text.replace(/\[BR\]|\|\||<br\s*\/?>/gi, '\n').trim();

    // 1. Tách chuẩn theo thẻ xuống dòng (Nếu Data cào chuẩn)
    if (cleanText.includes('\n')) {
        const parts = cleanText.split('\n');
        return { context: parts[0].trim(), mainQuestion: parts.slice(1).join(' ').trim() };
    }

    // 2. Tách bằng Dấu Chấm (.) trước các từ để hỏi (Which, What, Why...)
    const match = cleanText.match(/^(.*?(?:will hear|hear).*?[\.\?])\s*([A-Z].*)$/i);
    if (match && /^(Which|What|Why|Where|Who|How|When|Do|Does|Did|Is|Are)\b/i.test(match[2])) {
        return { context: match[1].trim(), mainQuestion: match[2].trim() };
    }

    // 3. Tách cưỡng bức (Dành cho Data lỗi mất dấu chấm)
    const aggressive = cleanText.match(/^(.*?(?:will hear|hear).*?)\s+(Which|What|Why|Where|Who|How|When|Do|Does|Did|Is|Are)(.*)/i);
    if (aggressive) {
        return {
            context: aggressive[1].trim() + ".", // Tự động bù thêm dấu chấm cho đẹp
            mainQuestion: (aggressive[2] + aggressive[3]).trim()
        };
    }

    // Mặc định
    return { context: '', mainQuestion: cleanText };
}

const { context, mainQuestion } = parsePart4Question(q.Question || "");

const options = [
    { key: 'A', text: q.Opt_A },
    { key: 'B', text: q.Opt_B },
    { key: 'C', text: q.Opt_C }
].filter(o => o.text);
---

<div class="bg-white p-6 md:p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-md transition-shadow relative">
    
    {/* KHU VỰC CÂU HỎI */}
    <div class="flex items-start gap-4 md:gap-5 mb-6">
        
        {/* Số thứ tự: Khối vuông xanh sáng */}
        <span class="bg-sky-500 text-white font-black w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-xl shrink-0 text-lg md:text-xl shadow-md mt-1">
            {q.Q_Num}
        </span>
        
        {/* Ngữ cảnh & Câu hỏi chính */}
        <div class="w-full pt-1">
            {/* Dòng Ngữ cảnh (You will hear...): Màu xám, in nghiêng */}
            {context && (
                <div class="text-slate-500 font-medium italic text-base md:text-lg mb-2 leading-relaxed">
                    {context}
                </div>
            )}
            {/* Dòng Câu hỏi chính: In đậm, to rõ */}
            <div class="text-lg md:text-xl font-bold text-slate-800 leading-relaxed" set:html={mainQuestion}></div>
        </div>
    </div>

    {/* KHU VỰC ĐÁP ÁN (A, B, C) - Thụt lề thẳng hàng với chữ câu hỏi */}
    <div class="space-y-4 ml-14 md:ml-16">
        {options.map((opt) => (
            <label class="flex items-start gap-4 p-4 rounded-2xl border-2 border-slate-100 cursor-pointer hover:border-sky-400 hover:bg-sky-50 transition-all group relative">
                <input type="radio" name={q.ID} value={opt.key} class="peer sr-only" />
                
                {/* Nút A, B, C */}
                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full border-2 border-slate-300 bg-white flex items-center justify-center text-sm md:text-base font-black text-slate-400 peer-checked:border-sky-500 peer-checked:bg-sky-500 peer-checked:text-white transition-all shrink-0 shadow-sm">
                    {opt.key}
                </div>
                
                {/* Text đáp án */}
                <div class="text-base md:text-lg text-slate-700 font-medium peer-checked:text-sky-800 peer-checked:font-bold transition-all pt-1 md:pt-1.5" set:html={opt.text}></div>
                
                <div class="submit-icon hidden absolute top-1/2 -translate-y-1/2 right-4 w-8 h-8 rounded-full bg-white shadow-sm text-base flex items-center justify-center font-bold border border-slate-100"></div>
            </label>
        ))}
    </div>

    {/* GIẢI THÍCH LỜI THOẠI */}
    {q.Explanation && (
        <div class="explanation-box hidden mt-8 p-6 bg-slate-50 rounded-2xl border border-slate-200 ml-14 md:ml-16">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-sm font-bold text-slate-500 uppercase tracking-wider">Đáp án đúng:</span>
                <span class="bg-emerald-500 text-white font-black px-3 py-1 rounded-lg">{q.Answer}</span>
            </div>
            <p class="text-slate-700 font-medium leading-relaxed" set:html={q.Explanation}></p>
        </div>
    )}

</div>