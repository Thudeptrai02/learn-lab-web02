---
const { q } = Astro.props;

let context = "";
let mainQuestion = q.Question || "";

if (q.Passage && q.Passage.toLowerCase().includes('hear')) {
    context = q.Passage.replace(/\[BR\]|\|\||<br\s*\/?>/gi, ' ').trim();
} else {
    let cleanText = mainQuestion.replace(/\[BR\]|\|\||<br\s*\/?>/gi, '\n').trim();
    if (cleanText.includes('\n')) {
        const parts = cleanText.split('\n');
        context = parts[0].trim();
        mainQuestion = parts.slice(1).join(' ').trim();
    } else {
        const match = cleanText.match(/^(.*?(?:will hear|hear).*?[\.\?])\s*([A-Z].*)$/i);
        if (match && /^(Which|What|Why|Where|Who|How|When|Do|Does|Did|Is|Are)\b/i.test(match[2])) {
            context = match[1].trim();
            mainQuestion = match[2].trim();
        } else {
            const aggressive = cleanText.match(/^(.*?(?:will hear|hear).*?)\s+(Which|What|Why|Where|Who|How|When|Do|Does|Did|Is|Are)(.*)/i);
            if (aggressive) {
                context = aggressive[1].trim() + ".";
                mainQuestion = (aggressive[2] + aggressive[3]).trim();
            }
        }
    }
}

mainQuestion = mainQuestion.replace(new RegExp(`^${q.Q_Num}\\s*[\\.\\:\\-]?\\s*`), '');

const options = [
    { key: 'A', text: q.Opt_A },
    { key: 'B', text: q.Opt_B },
    { key: 'C', text: q.Opt_C }
].filter(o => o.text);

// 🌟 TUYỆT CHIÊU FIX LỖI GOM NHÓM
const inputName = q.ID || `q_${q.Q_Num}`;
---

<div class="bg-white p-6 md:p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-md transition-shadow relative">
    
    <div class="flex items-start gap-4 md:gap-5 mb-5">
        <span class="bg-sky-500 text-white font-black w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-xl shrink-0 text-lg md:text-xl shadow-md mt-0.5">
            {q.Q_Num}
        </span>
        <div class="w-full">
            {context && <div class="text-slate-600 font-medium text-base md:text-lg mb-1.5 leading-relaxed">{context}</div>}
            <div class="text-lg md:text-xl font-bold text-slate-900 leading-relaxed" set:html={mainQuestion}></div>
        </div>
    </div>

    <div class="space-y-4 ml-14 md:ml-[68px]">
        {options.map((opt) => (
            <label class="flex items-start gap-4 p-4 rounded-2xl border-2 border-slate-100 cursor-pointer hover:border-sky-400 hover:bg-sky-50 transition-all group relative bg-slate-50/50">
                {/* 🌟 Gắn Input Name ở đây */}
                <input type="radio" name={inputName} value={opt.key} class="peer sr-only" />
                
                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full border-2 border-slate-300 bg-white flex items-center justify-center text-sm md:text-base font-black text-slate-400 peer-checked:border-sky-500 peer-checked:bg-sky-500 peer-checked:text-white transition-all shrink-0 shadow-sm">
                    {opt.key}
                </div>
                
                <div class="text-base md:text-lg text-slate-700 font-medium peer-checked:text-sky-800 peer-checked:font-bold transition-all pt-1 md:pt-1.5" set:html={opt.text}></div>
                
                <div class="submit-icon hidden absolute top-1/2 -translate-y-1/2 right-4 w-8 h-8 rounded-full bg-white shadow-sm text-base flex items-center justify-center font-bold border border-slate-100"></div>
            </label>
        ))}
    </div>

    {q.Explanation && (
        <div class="explanation-box hidden mt-8 p-6 bg-slate-50 rounded-2xl border border-slate-200 ml-14 md:ml-[68px]">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-sm font-bold text-slate-500 uppercase tracking-wider">Đáp án đúng:</span>
                <span class="bg-emerald-500 text-white font-black px-3 py-1 rounded-lg">{q.Answer}</span>
            </div>
            <p class="text-slate-700 font-medium leading-relaxed" set:html={q.Explanation}></p>
        </div>
    )}
</div>