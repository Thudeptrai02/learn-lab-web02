---
// src/components/exam/ReadingPart5.astro
const { part } = Astro.props;
let passageHtml = part.passage.replace(/\n/g, '<br/>');

part.questions.forEach(q => {
  const inputTag = `<input type="text" name="${q.ID}" placeholder="${q.Q_Num}" class="mx-1 w-24 border-b-2 border-slate-300 focus:border-emerald-500 bg-emerald-50/30 text-center font-black text-emerald-700 outline-none transition-all rounded-t-lg hover:bg-emerald-50" />`;
  passageHtml = passageHtml.replace(new RegExp(`\\(\\s*${q.Q_Num}\\s*\\)\\s*[_\\.]+`, 'g'), inputTag);
});
---
<div class="max-w-4xl mx-auto bg-white p-12 md:p-20 rounded-[4rem] border-2 border-slate-100 shadow-sm relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-3 bg-emerald-500"></div>
  <h2 class="text-2xl font-black text-slate-900 mb-10 flex items-center gap-3">
    <span class="w-10 h-10 bg-slate-900 text-white rounded-xl flex items-center justify-center text-sm">5</span>
    PART 5: OPEN CLOZE
  </h2>
  <div class="text-xl md:text-2xl text-slate-700 leading-[2.5] font-medium text-justify" set:html={passageHtml} />
</div>