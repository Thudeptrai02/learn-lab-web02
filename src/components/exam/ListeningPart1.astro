---
const { q } = Astro.props;

// Bắt chính xác URL của bức ảnh chứa 3 đáp án
const singleImage = q.Image || q.Image_Link || q.Image_URL || q.Image_A || q.Opt_A || "";

// 3 Đáp án A, B, C
const options = ['A', 'B', 'C'];

// Lọc sạch số thứ tự thừa bị dính trong câu hỏi
let cleanQuestion = (q.Question || "").replace(new RegExp(`^${q.Q_Num}\\s*[\\.\\:\\-]?\\s*`), '').trim();

// TẠO TÊN NHÓM RADIO ĐỘC QUYỀN ĐỂ FIX LỖI CHỌN ĐƯỢC 3 ĐÁP ÁN
const radioGroupName = `part1_q_${q.Q_Num || Math.random()}`;
---

<div class="bg-white p-6 md:p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-md transition-shadow relative">
    
    {/* KHU VỰC CÂU HỎI */}
    <div class="flex items-start gap-4 mb-8">
        <span class="bg-sky-500 text-white font-black w-10 h-10 flex items-center justify-center rounded-xl shrink-0 text-lg shadow-md mt-0.5">
            {q.Q_Num}
        </span>
        <div class="text-lg md:text-xl font-bold text-slate-900 leading-relaxed pt-1" set:html={cleanQuestion}></div>
    </div>

    {/* KHU VỰC HÌNH ẢNH VÀ NÚT BẤM (ĐƯỢC CĂN CHỈNH THẲNG HÀNG) */}
    <div class="w-full max-w-2xl mx-auto flex flex-col items-center">
        
        {/* Bức ảnh lớn chứa 3 ảnh nhỏ */}
        {singleImage && (
            <div class="w-full mb-6">
                <img 
                    src={singleImage} 
                    alt={`Question ${q.Q_Num}`} 
                    class="w-full h-auto object-contain mix-blend-multiply" 
                    loading="lazy"
                />
            </div>
        )}

        {/* Lưới 3 cột để căn giữa 3 nút bấm A, B, C khớp với 3 hình trên */}
        <div class="grid grid-cols-3 w-full">
            {options.map((key) => (
                <div class="flex justify-center">
                    <label class="relative cursor-pointer group flex flex-col items-center justify-center p-2 rounded-2xl transition-all">
                        
                        {/* Input Radio đã được gom nhóm chặt chẽ */}
                        <input type="radio" name={radioGroupName} value={key} class="peer sr-only" />
                        
                        {/* Nút Tròn (Kích thước vừa phải, thanh lịch) */}
                        <div class="w-10 h-10 md:w-12 md:h-12 rounded-full border-2 border-sky-500 bg-white flex items-center justify-center font-black text-sky-500 peer-checked:bg-sky-500 peer-checked:text-white transition-all shadow-sm text-lg hover:bg-sky-50">
                            {key}
                        </div>

                        {/* Icon chấm điểm ẩn (Xanh ngọc / Đỏ hồng) */}
                        <div class="submit-icon hidden absolute -top-1 -right-3 md:-right-4 w-6 h-6 rounded-full bg-white shadow-md text-xs flex items-center justify-center font-bold border border-slate-100 z-10"></div>
                    </label>
                </div>
            ))}
        </div>
    </div>

    {/* GIẢI THÍCH LỜI THOẠI (Ẩn, hiện khi nộp bài) */}
    {q.Explanation && (
        <div class="explanation-box hidden mt-8 p-6 bg-slate-50 rounded-2xl border border-slate-200">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-sm font-bold text-slate-500 uppercase tracking-wider">Đáp án đúng:</span>
                <span class="bg-emerald-500 text-white font-black px-3 py-1 rounded-lg">{q.Answer}</span>
            </div>
            <p class="text-slate-700 font-medium leading-relaxed text-base md:text-lg" set:html={q.Explanation}></p>
        </div>
    )}
</div>