---
// src/components/exam/ReadingPart4.astro - BẢN "BẤT KHẢ XÂM PHẠM"
const { q, options = {} } = Astro.props; 
const passage = q.Passage || "";

// Regex bắt đúng (19) .... của sếp
const parts = passage.split(/(\(\d+\)\s*\.{2,})/g);
---

<div class="reading-part-4-isolation not-prose">
  <div class="content-flow">
    {parts.map((part) => {
      const match = part.match(/\((\d+)\)/);
      if (match) {
        const qNum = match[1];
        const choices = options[qNum] || ["A", "B", "C"];
        
        return (
          <div class="gap-component" data-qnum={qNum}>
            <button type="button" class="gap-btn-custom">
              <span class="gap-num-badge">{qNum}</span>
              <span class="gap-text-val">........</span>
              {/* VẼ MŨI TÊN BẰNG CSS BORDER - CHỐNG XUNG ĐỘT TUYỆT ĐỐI */}
              <span class="gap-arrow-pure"></span>
            </button>
            
            <div class="gap-dropdown-list">
              {choices.map((choice) => (
                <div class="gap-choice-option">{choice}</div>
              ))}
            </div>
          </div>
        );
      }
      return <span class="text-segment">{part}</span>;
    })}
  </div>
</div>

<style is:global>
  /* 1. KHUNG CÁCH LY - ĐÈ BỆT FILE CHA */
  .reading-part-4-isolation {
    all: initial; /* Reset sạch sẽ để không bị file cha ảnh hưởng */
    display: block;
    max-width: 900px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: #ffffff;
    border: 3px solid #0f172a;
    border-radius: 2.5rem;
    box-shadow: 10px 10px 0px 0px #0f172a;
    font-family: 'Inter', sans-serif, system-ui; /* Ép font */
  }

  .content-flow {
    line-height: 3.8 !important;
    font-size: 1.2rem !important;
    color: #1e293b !important;
  }

  /* 2. Ô CHỌN - LAYOUT CỨNG */
  .gap-component {
    display: inline-block !important;
    position: relative !important;
    margin: 0 5px !important;
    vertical-align: middle !important;
  }

  .gap-btn-custom {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    min-width: 140px !important;
    height: 44px !important;
    padding: 0 12px !important;
    background: #f0fdf4 !important; /* Xanh nhạt */
    border: 2px solid #10b981 !important;
    border-radius: 12px !important;
    cursor: pointer !important;
    box-sizing: border-box !important;
  }

  .gap-btn-custom:hover {
    border-color: #0f172a !important;
    background: white !important;
  }

  .gap-num-badge {
    background: #10b981 !important;
    color: white !important;
    font-size: 11px !important;
    font-weight: 900 !important;
    width: 24px !important;
    height: 24px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 6px !important;
    flex-shrink: 0 !important;
  }

  .gap-text-val {
    flex: 1 !important;
    text-align: center !important;
    font-weight: 800 !important;
    color: #1e293b !important;
    font-size: 1rem !important;
  }

  /* 3. MŨI TÊN - VẼ BẰNG CSS BORDER (TAM GIÁC) */
  .gap-arrow-pure {
    width: 0 !important;
    height: 0 !important;
    border-left: 6px solid transparent !important;
    border-right: 6px solid transparent !important;
    border-top: 7px solid #64748b !important; /* Mũi tên màu xám đen */
    display: inline-block !important;
    margin-left: 6px !important;
    flex-shrink: 0 !important;
    transition: transform 0.2s !important;
  }

  .gap-component.is-active .gap-arrow-pure {
    transform: rotate(180deg) !important;
    border-top-color: #0f172a !important;
  }

  /* 4. MENU DROPDOWN */
  .gap-dropdown-list {
    display: none !important;
    position: absolute !important;
    top: 50px !important;
    left: 0 !important;
    width: 200px !important;
    background: white !important;
    border: 2px solid #0f172a !important;
    border-radius: 1rem !important;
    box-shadow: 6px 6px 0px 0px #0f172a !important;
    z-index: 9999 !important;
    overflow: hidden !important;
  }

  .gap-component.is-active .gap-dropdown-list {
    display: block !important;
  }

  .gap-choice-option {
    padding: 12px 20px !important;
    font-weight: 700 !important;
    color: #334155 !important;
    border-bottom: 1px solid #f1f5f9 !important;
    font-size: 1rem !important;
    cursor: pointer !important;
    text-align: left !important;
  }

  .gap-choice-option:hover {
    background: #f0fdf4 !important;
    color: #10b981 !important;
  }
</style>

<script>
  function initPart4() {
    const containers = document.querySelectorAll('.gap-component');
    
    containers.forEach(container => {
      const btn = container.querySelector('.gap-btn-custom');
      const valDisplay = container.querySelector('.gap-text-val');
      const options = container.querySelectorAll('.gap-choice-option');

      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = container.classList.contains('is-active');
        // Đóng các ô khác
        document.querySelectorAll('.gap-component').forEach(c => c.classList.remove('is-active'));
        if (!isOpen) container.classList.add('is-active');
      });

      options.forEach(opt => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          if (valDisplay) valDisplay.textContent = opt.textContent?.trim() || '';
          container.classList.remove('is-active');
          // Style hoàn thành
          if (btn) (btn as HTMLElement).style.borderColor = '#0f172a';
        });
      });
    });

    document.addEventListener('click', () => {
      document.querySelectorAll('.gap-component').forEach(c => c.classList.remove('is-active'));
    });
  }

  // Khởi chạy
  initPart4();
  document.addEventListener('astro:page-load', initPart4);
</script>