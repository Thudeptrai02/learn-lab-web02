---
// src/components/exam/ReadingPart4.astro
const { part } = Astro.props;
const passage = part.passage || "";
const questions = part.questions;

// Chia văn bản dựa trên các điểm (19) ....
const segments = passage.split(/(\(\d+\)\s*\.{2,})/g);
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
  <div class="lg:col-span-8 bg-white p-10 md:p-16 rounded-[3.5rem] border border-slate-200 shadow-sm sticky top-10">
    <h2 class="text-3xl font-black text-slate-900 mb-8 flex items-center gap-4">
      <span class="w-12 h-12 bg-emerald-500 text-white rounded-2xl flex items-center justify-center">4</span>
      PART 4
    </h2>
    <div class="text-lg md:text-xl text-slate-700 leading-[2.2] font-medium text-justify">
      {segments.map(seg => {
        const match = seg.match(/\((\d+)\)/);
        if (match) {
          const qNum = match[1];
          const qData = questions.find(q => parseInt(q.Q_Num) === parseInt(qNum));
          return (
            <div class="inline-block mx-1 relative group gap-dropdown" data-qnum={qNum}>
              <button class="bg-slate-100 border-2 border-slate-200 px-4 py-1 rounded-xl font-black text-emerald-600 hover:border-emerald-500 hover:bg-emerald-50 transition-all min-w-[100px]">
                ({qNum}) <span class="selected-val">.......</span>
              </button>
              <div class="dropdown-menu absolute bottom-full left-0 mb-2 w-32 bg-white rounded-2xl shadow-2xl border border-slate-100 opacity-0 pointer-events-none transition-all scale-90 origin-bottom z-50">
                {['A', 'B', 'C'].map(opt => qData[`Opt_${opt}`] && (
                  <button class="w-full text-left p-4 hover:bg-emerald-50 font-bold text-slate-700 first:rounded-t-2xl last:rounded-b-2xl transition-colors">
                    {opt}. {qData[`Opt_${opt}`]}
                  </button>
                ))}
              </div>
            </div>
          );
        }
        return <span>{seg}</span>;
      })}
    </div>
  </div>
  <div class="lg:col-span-4 bg-emerald-900 text-white p-10 rounded-[3rem] shadow-xl">
     <h4 class="font-black text-emerald-400 mb-4 uppercase tracking-widest text-xs">Hướng dẫn</h4>
     <p class="text-emerald-100/80 leading-relaxed font-medium">{part.guideline}</p>
  </div>
</div>

<script>
  document.querySelectorAll('.gap-dropdown').forEach(dropdown => {
    const btn = dropdown.querySelector('button');
    const menu = dropdown.querySelector('.dropdown-menu');
    
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.add('opacity-0', 'pointer-events-none'));
      menu.classList.toggle('opacity-0');
      menu.classList.toggle('pointer-events-none');
      menu.classList.toggle('scale-100');
    });

    menu.querySelectorAll('button').forEach(opt => {
      opt.addEventListener('click', () => {
        dropdown.querySelector('.selected-val').innerText = opt.innerText.split('.')[0];
        menu.classList.add('opacity-0', 'pointer-events-none');
        btn.classList.add('bg-emerald-500', 'text-white', 'border-emerald-600');
      });
    });
  });
  document.addEventListener('click', () => document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.add('opacity-0', 'pointer-events-none')));
</script>