---
// src/components/exam/ReadingPart23.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

function formatPassage(text) {
  return text.split('\n').map(line => {
    if (line.length < 50 && !line.match(/[.?!]$/)) 
      return `<h3 class="text-2xl font-black text-slate-900 mb-4 mt-8 first:mt-0">${line}</h3>`;
    return `<p class="mb-4 text-slate-700 leading-loose text-lg font-medium text-justify">${line}</p>`;
  }).join('');
}
---
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
  {/* Cột trái: Bài đọc ghim cố định */}
  <div class="lg:col-span-7 bg-white p-10 md:p-14 rounded-[3rem] border border-slate-100 shadow-sm lg:sticky lg:top-10 max-h-[88vh] overflow-y-auto custom-scrollbar">
    <div class="prose prose-emerald max-w-none" set:html={formatPassage(part.passage)} />
  </div>

  {/* Cột phải: Câu hỏi trắc nghiệm */}
  <div class="lg:col-span-5 space-y-6">
    <div class="bg-emerald-600 p-6 rounded-3xl text-white mb-6 shadow-lg shadow-emerald-100">
      <h2 class="text-xl font-black uppercase">Part {part.num}</h2>
      <p class="text-emerald-100 text-sm font-bold opacity-80 mt-1">{part.guideline}</p>
    </div>
    {part.questions.map(q => <MultipleChoice q={q} part={part.num} />)}
  </div>
</div>