---
// src/components/exam/ReadingPart2.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

function parseProfiles(passage) {
  const sections = passage.split(/(?=[A-C]\.\s+)/);
  const colors = [
    { bg: 'bg-rose-50/50', text: 'text-rose-700' },
    { bg: 'bg-sky-50/50', text: 'text-sky-700' },
    { bg: 'bg-amber-50/50', text: 'text-amber-700' }
  ];

  return sections.filter(s => s.trim()).map((sec, i) => {
    const lines = sec.split('\n').filter(l => l.trim());
    return {
      letter: lines[0].match(/^[A-C]/)[0],
      name: lines[0].replace(/^[A-C]\.\s*/, ''),
      content: lines.slice(1).join('<br/><br/>'),
      theme: colors[i % 3]
    };
  });
}
const profiles = parseProfiles(part.passage);
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start relative">
  {/* ĐỔI THÀNH lg:top-28 ĐỂ NÉ MENU TRÊN CÙNG CỦA WEB */}
  <div class="lg:col-span-6 space-y-6 lg:sticky lg:top-28 self-start max-h-[calc(100vh-8rem)] overflow-y-auto pr-2 custom-scrollbar">
    {profiles.map(p => (
      <div class={`${p.theme.bg} border border-slate-100 p-6 rounded-2xl`}>
        <div class="flex items-center gap-3 mb-3">
          <div class={`w-8 h-8 rounded-full bg-white flex items-center justify-center font-black shadow-sm ${p.theme.text}`}>{p.letter}</div>
          <h3 class="text-xl font-bold text-slate-800">{p.name}</h3>
        </div>
        <p class="text-slate-700 font-serif text-[1.05rem] leading-7 text-justify" set:html={p.content} />
      </div>
    ))}
  </div>
  
  <div class="lg:col-span-6 space-y-5">
    {part.questions.map(q => (
       /* THÊM ID CHỖ NÀY ĐỂ BẤM TỪ SIDEBAR LÀ NHẢY TỚI ĐÂY */
       <div id={`q-${q.ID}`}>
          <MultipleChoice q={q} />
       </div>
    ))}
  </div>
</div>