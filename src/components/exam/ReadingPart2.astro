---
// src/components/exam/ReadingPart2.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

// Hàm "chẻ" cục text Part 2 thành 3 thẻ nhân vật (Dựa vào chữ A., B., C.)
function parseProfiles(passage) {
  const profiles = [];
  const sections = passage.split(/(?=[A-C]\.\s+)/); // Cắt tại A. B. C.
  
  const colors = [
    { bg: 'bg-rose-50', border: 'border-rose-200', text: 'text-rose-600', dot: 'bg-rose-500' },
    { bg: 'bg-sky-50', border: 'border-sky-200', text: 'text-sky-600', dot: 'bg-sky-500' },
    { bg: 'bg-amber-50', border: 'border-amber-200', text: 'text-amber-600', dot: 'bg-amber-500' }
  ];

  sections.forEach((sec, index) => {
    if (!sec.trim()) return;
    const lines = sec.split('\n').filter(l => l.trim());
    const nameLine = lines[0]; // Ví dụ: "A. Alex"
    const letter = nameLine.match(/^[A-C]/) ? nameLine.match(/^[A-C]/)[0] : '';
    const name = nameLine.replace(/^[A-C]\.\s*/, '');
    const content = lines.slice(1).join('<br/><br/>');
    
    profiles.push({ letter, name, content, theme: colors[index % 3] });
  });

  return profiles;
}

const profiles = parseProfiles(part.passage);
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
  
  {/* CỘT TRÁI: 3 THẺ NHÂN VẬT (STICKY) */}
  <div class="lg:col-span-7 lg:sticky lg:top-10 max-h-[85vh] overflow-y-auto pr-4 custom-scrollbar space-y-6">
     {profiles.map(p => (
        <div class={`p-8 rounded-[2.5rem] border-2 ${p.theme.border} ${p.theme.bg} shadow-sm transform hover:-translate-y-1 transition-transform`}>
           <div class="flex items-center gap-4 mb-4 border-b border-white/50 pb-4">
              <div class={`w-12 h-12 rounded-2xl bg-white flex items-center justify-center font-black text-2xl shadow-sm ${p.theme.text}`}>
                 {p.letter}
              </div>
              <h3 class="text-2xl font-black text-slate-800">{p.name}</h3>
           </div>
           <p class="text-slate-700 font-medium text-[1.1rem] leading-relaxed text-justify">
              <span class={`float-left w-3 h-3 rounded-full mt-2 mr-3 ${p.theme.dot}`}></span>
              <span set:html={p.content}></span>
           </p>
        </div>
     ))}
  </div>

  {/* CỘT PHẢI: CÂU HỎI */}
  <div class="lg:col-span-5 space-y-6">
    <div class="bg-emerald-600 text-white p-8 rounded-[2rem] shadow-xl shadow-emerald-200/50 mb-8">
       <h4 class="font-black uppercase tracking-widest text-sm mb-2 opacity-80">Nhiệm vụ</h4>
       <p class="font-bold text-lg">{part.guideline}</p>
    </div>
    {part.questions.map(q => <MultipleChoice q={q} />)}
  </div>

</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
</style>