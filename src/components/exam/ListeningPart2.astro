---
const { questions = [], passage = "", partNum } = Astro.props;

let contextText = "For each question, write the correct answer in the gap. Write ONE word or a number or a date or a time.";
let notepadTitle = "Listening Part " + partNum;
let extraLines: string[] = [];

if (passage) {
    const lines = passage.split(/\[BR\]|\|\||\r\n|\n|<br\s*\/?>/).map((l: string) => l.trim()).filter((l: string) => l);
    
    if (lines.length > 1) {
        if (lines[0].toLowerCase().includes('hear') || lines[0].toLowerCase().includes('write')) {
            contextText = lines[0];
            notepadTitle = lines[1];
            extraLines = lines.slice(2);
        } else {
            notepadTitle = lines[0];
            extraLines = lines.slice(1);
        }
    } else if (lines.length === 1) {
        notepadTitle = lines[0];
    }
}

function parseQuestionLine(text: string) {
    if (!text) return { label: "", valueText: "" };
    const colonIdx = text.indexOf(':');
    if (colonIdx !== -1) {
        return {
            label: text.substring(0, colonIdx + 1).trim(),
            valueText: text.substring(colonIdx + 1)
        };
    }
    return { label: text, valueText: "" };
}

// Cột bên phải vẫn giữ màu Xanh Lá (Emerald) cho các con số câu hỏi
function formatValueWithInput(valueText: string, qNum: string|number, qId: string) {
    const inputHtml = `
        <span class="inline-flex items-center gap-2 border-b-2 border-slate-300 focus-within:border-emerald-500 transition-colors mx-1 pb-1">
            <span class="font-black text-base md:text-lg text-emerald-600 bg-emerald-50 px-3 py-1 rounded-xl shadow-sm shrink-0 leading-none">${qNum}</span>
            <input type="text" name="${qId}" class="exam-input w-28 md:w-48 bg-transparent border-none outline-none px-2 py-1 font-bold text-emerald-700 leading-none" autocomplete="off" />
        </span>
    `;
    
    if (valueText.match(/\.{3,}|_{3,}/)) {
        return valueText.replace(/\.{3,}|_{3,}/g, inputHtml);
    } else {
        return valueText + inputHtml; 
    }
}
---

<div class="w-full max-w-5xl mx-auto scroll-mt-24 md:scroll-mt-40" id={`q-${questions[0]?.Q_Num || questions[0]?.ID}`}>
    
    {/* KHỐI YÊU CẦU ĐỀ BÀI (ĐỒNG BỘ 100%) */}
    <div class="bg-sky-50/50 border border-sky-100 p-6 md:p-8 rounded-[2rem] mb-8 shadow-sm">
       <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
           <h4 class="text-sky-800 font-black uppercase text-sm tracking-widest flex items-center gap-2">
              <span>📝</span> YÊU CẦU ĐỀ BÀI
           </h4>
           <div class="bg-sky-200/50 text-sky-800 px-3 py-1.5 rounded-lg font-bold text-xs uppercase tracking-wider inline-block w-max">
               Part {partNum} • Questions {questions[0]?.Q_Num} - {questions[questions.length-1]?.Q_Num}
           </div>
       </div>
       <p class="text-sky-900 font-medium text-base md:text-lg leading-relaxed">{contextText}</p>
    </div>

    {/* KHUNG GHI CHÚ / SỔ TAY */}
    <div class="bg-white rounded-[2rem] border-2 border-slate-200 shadow-sm w-full p-8 md:p-12 relative overflow-hidden">
        
        <h4 class="text-2xl md:text-3xl font-black text-slate-900 mb-10 text-center uppercase tracking-wide border-b-2 border-slate-100 pb-6">
            {notepadTitle}
        </h4>

        <div class="grid grid-cols-[130px_1fr] sm:grid-cols-[160px_1fr] md:grid-cols-[190px_1fr] gap-x-4 gap-y-6 md:gap-y-8 max-w-2xl mx-auto text-lg md:text-xl text-slate-800 font-medium">
            
            {extraLines.map(line => {
                const { label, valueText } = parseQuestionLine(line);
                return (
                    <div class="contents">
                        <div class="font-bold text-slate-500 flex items-center md:items-end pb-1">{label}</div>
                        <div class="flex items-center md:items-end text-slate-500 italic font-semibold">{valueText}</div>
                    </div>
                )
            })}

            {questions.map((q: any) => {
                const { label, valueText } = parseQuestionLine(q.Question);
                return (
                    <div class="contents group">
                        <div class="font-bold text-slate-800 flex items-center md:items-end pb-1">
                            {label}
                        </div>
                        <div class="flex items-center flex-wrap gap-y-2 text-slate-700 leading-loose">
                            <span set:html={formatValueWithInput(valueText, q.Q_Num, q.ID)}></span>
                        </div>
                    </div>
                );
            })}
        </div>
    </div>
</div>