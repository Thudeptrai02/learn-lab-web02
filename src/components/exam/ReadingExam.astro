---
// src/components/exam/ReadingExam.astro
import ReadingPart1 from './ReadingPart1.astro';
import MultipleChoice from './MultipleChoice.astro';

const { questions = [], testTitle = "Cambridge Practice" } = Astro.props;

const parts = [1, 2, 3, 4, 5, 6, 7].map(num => {
  const pQs = questions.filter(q => parseInt(q.Part) === num);
  return pQs.length > 0 ? { num, questions: pQs, guideline: pQs[0].Part_Guideline, passage: pQs[0].Passage } : null;
}).filter(p => p !== null);
---

<div class="relative flex min-h-screen bg-[#F8FAFC] font-['Plus_Jakarta_Sans'] overflow-x-hidden">
  
  <aside id="sidebar" class="fixed left-0 top-0 h-full w-80 bg-white/80 backdrop-blur-2xl border-r border-slate-200 z-[100] transition-transform -translate-x-full shadow-2xl">
    <div class="p-8">
      <h3 class="text-xl font-black text-slate-900 uppercase mb-8">Tiến độ bài thi</h3>
      <div class="grid grid-cols-5 gap-3">
        {questions.map((q, i) => (
          <button class="w-10 h-10 rounded-xl border-2 border-slate-100 flex items-center justify-center font-bold text-slate-400 hover:border-emerald-500 transition-all cursor-pointer q-dot" data-q={q.Q_Num}>
            {i + 1}
          </button>
        ))}
      </div>
      <button id="btn-submit" class="w-full mt-12 bg-slate-900 text-white py-5 rounded-[2rem] font-black uppercase tracking-widest hover:bg-emerald-600 transition-all shadow-xl shadow-slate-200">
        Nộp bài & Check đáp án
      </button>
    </div>
    <button id="toggle-sidebar" class="absolute -right-12 top-10 w-12 h-12 bg-slate-900 text-white rounded-r-2xl flex items-center justify-center shadow-lg cursor-pointer group">
      <span class="transition-transform duration-500 text-xl group-hover:scale-125">➜</span>
    </button>
  </aside>

  <div class="flex-1 transition-all duration-500" id="main-content">
    <div class="max-w-6xl mx-auto px-6 py-12">
      {parts.map(p => (
        <div class="mb-40" id={`part-${p.num}`}>
          {p.num === 1 ? (
            <ReadingPart1 part={p} />
          ) : (
             <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
                <div class="lg:col-span-7 bg-white p-10 md:p-14 rounded-[3.5rem] border border-slate-100 shadow-sm lg:sticky lg:top-10 max-h-[85vh] overflow-y-auto">
                   <div class="passage-text prose prose-emerald max-w-none" data-evidence={p.questions[0].Evidence}>
                      <h2 class="text-3xl font-black text-slate-900 mb-8 uppercase tracking-tighter">Reading Text</h2>
                      <div class="text-lg leading-loose text-slate-700 font-medium" set:html={p.passage.replace(/\n/g, '<br/>')} />
                   </div>
                </div>
                <div class="lg:col-span-5 space-y-6">
                   {p.questions.map(q => <MultipleChoice q={q} />)}
                </div>
             </div>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const sidebar = document.getElementById('sidebar');
  const toggleBtn = document.getElementById('toggle-sidebar');
  const mainContent = document.getElementById('main-content');
  const submitBtn = document.getElementById('btn-submit');

  // 1. Sidebar Toggle
  toggleBtn.addEventListener('click', () => {
    const isOpen = sidebar.classList.toggle('translate-x-0');
    toggleBtn.querySelector('span').style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    if (window.innerWidth > 1280) mainContent.style.paddingLeft = isOpen ? '320px' : '0';
  });

  // 2. Submit Logic & Highlighter
  submitBtn.addEventListener('click', () => {
    // Hiện giải thích
    document.querySelectorAll('.explanation-box').forEach(el => el.classList.remove('hidden'));
    
    // Kích hoạt bôi màu Highlighter
    document.querySelectorAll('.passage-text').forEach(container => {
      const evidence = container.getAttribute('data-evidence');
      if (evidence && evidence.trim() !== "") {
        const content = container.innerHTML;
        const regex = new RegExp(`(${evidence.trim()})`, 'gi');
        container.innerHTML = content.replace(regex, `<mark class="bg-yellow-300 text-slate-900 px-1 rounded-md font-black shadow-sm">$1</mark>`);
      }
    });

    // Hiện Icon Đúng/Sai
    document.querySelectorAll('.option-label').forEach(label => {
      const input = label.querySelector('input');
      const icon = label.querySelector('.result-icon');
      icon.classList.remove('hidden');
      if (input.getAttribute('data-correct') === 'true') {
        icon.innerHTML = '✅';
        label.classList.add('border-emerald-500', 'bg-emerald-50');
      } else if (input.checked) {
        icon.innerHTML = '❌';
        label.classList.add('border-red-500', 'bg-red-50');
      }
    });

    alert("Đã nộp bài! Sếp hãy kiểm tra các dẫn chứng được bôi màu vàng trong văn bản nhé.");
  });
</script>