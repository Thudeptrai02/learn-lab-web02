---
// src/components/exam/ReadingExam.astro
import MultipleChoice from './MultipleChoice.astro';
import Part5Inline from './Part5Inline.astro';
import Writing from './Writing.astro'; 
// IMPORT 2 COMPONENT MỚI VÀO ĐÂY:
import ReadingPart2 from './ReadingPart2.astro';
import ReadingPart3 from './ReadingPart3.astro';

const { parts = [], testTitle = "Cambridge Exam" } = Astro.props;
const validParts = parts.filter((p: any) => p && typeof p.part_number === 'number' && Array.isArray(p.questions) && p.questions.length > 0);

// Chỉ giữ lại hàm formatReadingText cơ bản để dùng cho Part 4
function formatReadingText(rawText: string) {
  if (!rawText) return "";
  const lines = String(rawText).split(/\[BR\]|\|\||\r\n|\r|\n|\\n|<br\s*\/?>/).map(l => l.trim()).filter(l => l !== "");
  return lines.map(line => `<p class="mb-5 text-slate-800 leading-relaxed text-lg text-justify font-medium">${line}</p>`).join("");
}

function formatPart4PassageInline(rawText: string, questions: any[]) {
  if (!rawText) return "";
  let html = formatReadingText(rawText);
  questions.forEach(q => {
    const optionsHtml = ['A', 'B', 'C'].filter(opt => q[`Opt_${opt}`]).map(opt => `<option value="${opt}">${opt}. ${q[`Opt_${opt}`]}</option>`).join('');
    const selectHtml = `<select name="${q.ID}" class="exam-input inline-block appearance-none border-2 border-slate-300 bg-slate-50 hover:border-emerald-500 focus:border-emerald-500 outline-none text-center font-black text-emerald-800 px-3 py-1 mx-2 rounded-xl cursor-pointer shadow-sm"><option value="" disabled selected>${q.Q_Num}</option>${optionsHtml}</select><span id="result-${q.ID}" class="hidden font-black ml-1 text-sm"></span>`;
    html = html.replace(new RegExp(`\\(\\s*${q.Q_Num}\\s*\\)[ \\.]+`, 'g'), selectHtml);
  });
  return html;
}
---

<div class="relative min-h-screen bg-[#F1F5F9] pb-32 font-sans" id="exam-wrapper">
  
  {/* GIỮ NGUYÊN TOÀN BỘ TOPBAR & SIDEBAR HTML CỦA BẠN TẠI ĐÂY */}
  {/* ... */}
  
  <div class="pt-24 highlightable-area" id="exam-content">
    <div class="w-full mx-auto px-4 xl:px-12 flex items-start overflow-hidden lg:overflow-visible relative">
      
      {/* <aside id="exam-sidebar"> ... GIỮ NGUYÊN MENU CỦA BẠN ... </aside> */}

      <main class="flex-1 w-full min-w-0 pb-20 transition-all duration-500">
        
        {validParts.map((part: any) => {
          const pNum = part.part_number;
          const questions = part.questions;

          return (
          <section id={`section-part-${pNum}`} class="exam-section mb-16 md:mb-20">
            <div class="flex items-center gap-4 mb-6 md:mb-8">
              <div class="w-10 h-10 md:w-12 md:h-12 bg-slate-900 rounded-xl flex items-center justify-center text-emerald-400 font-black text-lg md:text-xl shadow-md rotate-3 shrink-0">{pNum}</div>
              <h2 class="text-2xl md:text-3xl font-black text-slate-900 uppercase tracking-tight">{pNum > 5 ? 'Writing Section' : 'Reading Section'}</h2>
            </div>

            {pNum === 1 && (
              <div class="flex flex-col gap-6 md:gap-8 w-full max-w-6xl mx-auto">
                {questions.map((q: any) => <div id={`q-${q.Q_Num}`} class="scroll-mt-24 md:scroll-mt-32"><MultipleChoice q={q} part={1} /></div>)}
              </div>
            )}

            {/* GỌI PART 2 Component */}
            {pNum === 2 && <ReadingPart2 part={part} />}

            {/* GỌI PART 3 Component */}
            {pNum === 3 && <ReadingPart3 part={part} />}

            {pNum === 4 && part.passage && (
              <div class="w-full bg-white p-6 md:p-12 rounded-[2rem] border border-slate-200 shadow-md">
                 <div class="prose max-w-none text-base md:text-lg leading-[2.6] md:leading-[2.8] text-slate-800" set:html={formatPart4PassageInline(part.passage, questions)} />
              </div>
            )}

            {pNum === 5 && <div id={`q-${questions[0]?.Q_Num}`} class="w-full scroll-mt-24 md:scroll-mt-32"><Part5Inline questions={questions} /></div>}
            
            {(pNum === 6 || pNum === 7) && (
              <div class="w-full flex flex-col gap-6 md:gap-8 max-w-5xl mx-auto">
                 {questions.map((q: any) => <div id={`q-${q.Q_Num}`} class="scroll-mt-24 md:scroll-mt-32"><Writing q={q} /></div>)}
              </div>
            )}
          </section>
          )
        })}
      </main>
    </div>
  </div>
  {/* GIỮ NGUYÊN RESULT DASHBOARD VÀ SCRIPT CỦA BẠN BÊN DƯỚI NÀY */}
</div>