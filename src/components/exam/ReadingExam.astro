---
// src/components/exam/ReadingExam.astro
import ReadingPart1 from './ReadingPart1.astro'; // Biển báo
import ReadingPart23 from './ReadingPart23.astro'; // Split-screen Matching/MCQ
import ReadingPart4 from './ReadingPart4.astro'; // Inline Dropdown
import ReadingPart5 from './ReadingPart5.astro'; // Inline Input
import ReadingWriting67 from './ReadingWriting67.astro'; // Writing

const { questions = [], testTitle = "Reading Practice" } = Astro.props;

// Phân nhóm câu hỏi
const parts = [1, 2, 3, 4, 5, 6, 7].map(num => {
  const pQs = questions.filter(q => parseInt(q.Part || q.part) === num);
  return pQs.length > 0 ? { num, questions: pQs, guideline: pQs[0].Part_Guideline, passage: pQs[0].Passage } : null;
}).filter(p => p !== null);
---

<div class="relative flex min-h-screen bg-slate-50 font-['Plus_Jakarta_Sans']">
  
  <aside id="sidebar" class="fixed left-0 top-0 h-full w-80 bg-white/90 backdrop-blur-xl border-r border-slate-200 z-[100] transition-transform -translate-x-full shadow-2xl">
    <div class="p-8">
      <div class="flex items-center justify-between mb-8">
        <h3 class="text-xl font-black text-slate-900 uppercase">Questions</h3>
        <span class="text-xs font-bold text-slate-400 bg-slate-100 px-2 py-1 rounded-lg">0/32</span>
      </div>
      <div class="grid grid-cols-5 gap-3">
        {questions.map((q, i) => (
          <button class="q-nav-btn w-10 h-10 rounded-xl border-2 border-slate-100 flex items-center justify-center font-bold text-slate-400 hover:border-emerald-500 transition-all" data-id={q.ID}>
            {i + 1}
          </button>
        ))}
      </div>
    </div>
    <button id="toggle-sidebar" class="absolute -right-12 top-10 w-12 h-12 bg-slate-900 text-white rounded-r-2xl flex items-center justify-center shadow-lg group">
      <span class="transform transition-transform group-hover:scale-125">➜</span>
    </button>
  </aside>

  <div class="flex-1 transition-all duration-500" id="main-content">
    <div class="max-w-7xl mx-auto px-6 py-12">
      <header class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6 bg-white p-10 rounded-[3rem] border border-slate-100 shadow-sm">
        <div>
           <span class="text-emerald-600 font-black text-sm uppercase tracking-widest bg-emerald-50 px-4 py-1.5 rounded-xl mb-4 inline-block">Cambridge Assessment</span>
           <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight uppercase leading-none">{testTitle}</h1>
        </div>
        <div class="flex items-center gap-4 bg-slate-900 text-white px-6 py-4 rounded-3xl shadow-xl">
           <div class="text-right">
              <p class="text-[10px] font-bold text-slate-400 uppercase">Time Remaining</p>
              <p class="text-2xl font-black font-mono tracking-tighter">60:00</p>
           </div>
           <div class="w-10 h-10 bg-emerald-500 rounded-2xl flex items-center justify-center">🕒</div>
        </div>
      </header>

      {parts.map(p => (
        <div class="mb-32">
          {p.num === 1 && <ReadingPart1 part={p} />}
          {(p.num === 2 || p.num === 3) && <ReadingPart23 part={p} />}
          {p.num === 4 && <ReadingPart4 part={p} />}
          {p.num === 5 && <ReadingPart5 part={p} />}
          {(p.num === 6 || p.num === 7) && <ReadingWriting67 part={p} />}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const sidebar = document.getElementById('sidebar');
  const toggleBtn = document.getElementById('toggle-sidebar');
  const mainContent = document.getElementById('main-content');

  toggleBtn.addEventListener('click', () => {
    const isOpen = sidebar.classList.toggle('translate-x-0');
    toggleBtn.querySelector('span').style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    // Đẩy nội dung chính nếu màn hình đủ lớn
    if (window.innerWidth > 1280) {
      mainContent.style.paddingLeft = isOpen ? '320px' : '0';
    }
  });
</script>