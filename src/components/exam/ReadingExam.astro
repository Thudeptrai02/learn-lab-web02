---
// src/components/exam/ReadingExam.astro
import ReadingPart1 from './ReadingPart1.astro';
import ReadingPart2 from './ReadingPart2.astro';
import ReadingPart3 from './ReadingPart3.astro';
import ReadingPart4 from './ReadingPart4.astro';
import Part5Inline from './Part5Inline.astro';
import Writing from './Writing.astro';

const { questions = [], testTitle = "Cambridge Reading & Writing" } = Astro.props;

const parts = [1, 2, 3, 4, 5, 6, 7].map(num => {
  const pQs = questions.filter(q => parseInt(q.Part || q.part) === num);
  if (pQs.length === 0) return null;
  return { num, questions: pQs, passage: pQs[0].Passage || pQs[0].passage || "" };
}).filter(p => p !== null);
---

<div class="flex min-h-screen bg-[#f8fafc] text-slate-800 font-sans relative">
  
  {/* NÚT NỘP BÀI GHIM GÓC DƯỚI BÊN PHẢI (TRÁNH ĐÈ MENU) */}
  <button id="btn-submit" class="fixed bottom-[5.5rem] right-6 lg:right-10 z-[105] bg-slate-900/95 backdrop-blur-md text-white font-black px-6 py-3.5 rounded-2xl shadow-[0_10px_30px_rgba(0,0,0,0.2)] hover:bg-teal-600 hover:-translate-y-1 transition-all duration-300 flex items-center gap-2 uppercase tracking-widest text-[13px] border border-white/10 group">
      <svg class="w-5 h-5 text-teal-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Nộp Bài
  </button>

  {/* HIGHLIGHT TOOLBAR */}
  <div id="highlighter-tools" class="fixed bottom-6 right-6 lg:right-10 bg-white/95 backdrop-blur-md p-3 rounded-2xl shadow-[0_10px_40px_rgba(0,0,0,0.15)] border border-slate-200 z-[90] flex items-center gap-3 transition-opacity duration-300">
      <button class="tool-btn w-8 h-8 rounded-full bg-[#fde047] shadow-sm transition-all border-2 border-transparent" data-action="highlight" data-color="#fef08a" title="Vàng"></button>
      <button class="tool-btn w-8 h-8 rounded-full bg-[#86efac] shadow-sm transition-all border-2 border-transparent" data-action="highlight" data-color="#bbf7d0" title="Xanh"></button>
      <button class="tool-btn w-8 h-8 rounded-full bg-[#f9a8d4] shadow-sm transition-all border-2 border-transparent" data-action="highlight" data-color="#fbcfe8" title="Hồng"></button>
      <div class="w-px h-6 bg-slate-200 mx-1"></div>
      <button class="tool-btn w-8 h-8 rounded-full bg-slate-100 border-2 border-slate-300 shadow-sm transition-all flex items-center justify-center text-slate-500" data-action="erase" title="Tẩy">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M16.24 3.56l4.2 4.2a1.5 1.5 0 0 1 0 2.12l-8.49 8.49a1.5 1.5 0 0 1-1.06.44H4.5a1.5 1.5 0 0 1-1.5-1.5v-6.39a1.5 1.5 0 0 1 .44-1.06l8.49-8.49a1.5 1.5 0 0 1 2.12 0zM4.5 17.31V18.8h1.5l8.13-8.13-1.5-1.5-8.13 8.13zM13.76 8.54l1.5 1.5 3.13-3.13-1.5-1.5-3.13 3.13z"></path><path d="M2 22h20v2H2z"></path></svg>
      </button>
  </div>

  {/* MODAL XÁC NHẬN NỘP BÀI */}
  <div id="confirm-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[200] hidden items-center justify-center opacity-0 transition-all duration-300 px-4">
    <div class="bg-white p-8 md:p-10 rounded-[2.5rem] shadow-2xl max-w-sm w-full text-center transform scale-95 transition-all duration-300">
        <div class="w-16 h-16 bg-amber-100 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-5"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
        <h3 class="text-2xl font-black text-slate-900 mb-2">Nộp bài ngay?</h3>
        <p class="text-slate-500 font-medium mb-8 italic">Vui lòng kiểm tra kỹ đáp án trước khi nhấn nộp bài.</p>
        <div class="flex gap-4">
           <button id="btn-cancel-submit" class="flex-1 bg-slate-100 text-slate-600 font-bold py-3.5 rounded-xl hover:bg-slate-200 transition-colors">Quay lại</button>
           <button id="btn-confirm-submit" class="flex-1 bg-teal-600 text-white font-bold py-3.5 rounded-xl hover:bg-teal-700 transition-colors shadow-lg shadow-teal-500/30">Nộp bài</button>
        </div>
    </div>
  </div>

  {/* MODAL KẾT QUẢ THỐNG KÊ */}
  <div id="score-modal" class="fixed inset-0 bg-slate-900/70 backdrop-blur-md z-[200] hidden items-center justify-center opacity-0 transition-all duration-300 px-4">
     <div class="bg-white p-10 md:p-12 rounded-[3.5rem] shadow-2xl max-w-lg w-full text-center transform scale-95 transition-all duration-300 relative overflow-hidden flex flex-col items-center">
         <div class="absolute -top-32 -right-32 w-64 h-64 bg-teal-400/20 rounded-full blur-3xl"></div>
         <h2 class="text-3xl font-black text-slate-900 mb-1 relative z-10 uppercase tracking-tighter">Kết Quả</h2>
         <div class="w-36 h-36 rounded-full border-[10px] border-slate-50 flex flex-col items-center justify-center mx-auto my-8 shadow-inner relative z-10 bg-white" id="score-circle">
             <span class="text-4xl font-black text-slate-800 tracking-tighter" id="score-text">0/30</span>
         </div>
         <div class="mb-8 relative z-10">
            <span id="cefr-badge" class="px-5 py-2 rounded-full font-black text-sm uppercase tracking-widest text-white shadow-md">Loading...</span>
         </div>
         <div class="grid grid-cols-3 gap-3 w-full mb-10 relative z-10">
            <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-4 flex flex-col items-center"><span class="text-2xl font-black text-emerald-600" id="stat-correct">0</span><span class="text-[9px] font-black text-emerald-800 uppercase tracking-widest mt-1">Đúng</span></div>
            <div class="bg-rose-50 border border-rose-100 rounded-2xl p-4 flex flex-col items-center"><span class="text-2xl font-black text-rose-600" id="stat-wrong">0</span><span class="text-[9px] font-black text-rose-800 uppercase tracking-widest mt-1">Sai</span></div>
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 flex flex-col items-center"><span class="text-2xl font-black text-slate-500" id="stat-skipped">0</span><span class="text-[9px] font-black text-slate-500 uppercase tracking-widest mt-1">Bỏ qua</span></div>
         </div>
         <button id="btn-close-modal" class="w-full bg-slate-900 text-white font-black py-4 rounded-2xl hover:bg-teal-600 transition-colors uppercase tracking-widest text-sm relative z-10 shadow-xl">Xem chi tiết giải đáp</button>
     </div>
  </div>

  <aside id="sidebar" class="fixed left-0 top-0 h-full w-72 bg-white border-r border-slate-200 z-[100] transition-transform duration-500 -translate-x-full shadow-2xl flex flex-col">
    <button id="toggle-sidebar" class="absolute top-1/2 -translate-y-1/2 -right-10 w-10 h-16 bg-teal-700 text-white rounded-r-xl shadow-[4px_0_15px_rgba(0,0,0,0.15)] flex items-center justify-center hover:bg-teal-800 transition-colors cursor-pointer outline-none">
       <svg id="arrow-icon" class="w-6 h-6 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
    </button>
    <div class="p-6 mt-14 flex-1 overflow-y-auto custom-scrollbar">
      <h3 class="text-lg font-black text-slate-800 uppercase mb-6 border-b pb-3">Menu Câu Hỏi</h3>
      <div class="space-y-8">
        {parts.map(p => (
          <div>
            <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-3">Part {p.num}</h4>
            <div class="grid grid-cols-5 gap-2">
              {p.questions.map(q => (
                <a href={`#q-${q.ID}`} data-target="sidebar-link" data-qid={q.ID} class="w-9 h-9 rounded-lg border-2 border-slate-200 flex items-center justify-center font-bold text-slate-500 hover:bg-teal-50 transition-all text-xs">
                  {q.Q_Num}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </aside>

  <div id="main-wrapper" class="flex-1 transition-all duration-500 ml-0 w-full pb-20 pt-8">
    <div class="max-w-6xl mx-auto py-12 px-4 md:px-8 mt-10 lg:mt-0">
      <header class="mb-14 border-b border-slate-200 pb-6"><h1 class="text-3xl md:text-4xl font-black text-slate-900 uppercase tracking-tight">{testTitle}</h1></header>

      {parts.map(p => (
        <div class="mb-24">
          <div class="mb-6 flex items-start gap-4">
             <div class="w-10 h-10 bg-teal-600 text-white flex items-center justify-center rounded-lg font-black text-xl shadow-sm shrink-0">{p.num}</div>
             <h2 class="text-2xl font-black text-slate-800 uppercase tracking-tight leading-none pt-1.5">Part {p.num}</h2>
          </div>
          <div class="animate-in fade-in duration-700">
              {p.num === 1 && <ReadingPart1 part={p} />}
              {p.num === 2 && <ReadingPart2 part={p} />}
              {p.num === 3 && <ReadingPart3 part={p} />}
              {[4, 5, 6, 7].includes(p.num) && (
                  <div class="max-w-4xl mx-auto w-full bg-white p-8 md:p-14 rounded-[3rem] shadow-sm border border-slate-200">
                      {p.num === 4 && <ReadingPart4 part={p} />}
                      {p.num === 5 && <Part5Inline part={p} />}
                      {(p.num === 6 || p.num === 7) && (
                          <div class="space-y-10">{p.questions.map(q => <div id={`q-${q.ID}`} class="scroll-mt-32"><Writing q={q} /></div>)}</div>
                      )}
                  </div>
              )}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  html { scroll-behavior: smooth; }
  .custom-scrollbar::-webkit-scrollbar { width: 5px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  .tool-btn.active-tool { border-color: #0f766e; transform: scale(1.15); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
  
  a[data-target="sidebar-link"].is-answered { background-color: #ccfbf1; border-color: #14b8a6; color: #0f766e; }
  body.review-mode a[data-target="sidebar-link"].is-correct { background-color: #10b981; border-color: #10b981; color: white; }
  body.review-mode a[data-target="sidebar-link"].is-incorrect { background-color: #f43f5e; border-color: #f43f5e; color: white; }
  body.review-mode input { pointer-events: none; }
  body.review-mode .gap-trigger { pointer-events: none; }
</style>

<script define:vars={{ questions }}>
  window.examData = questions;
</script>

<script>
  // 1. SIDEBAR & UTILS
  const sidebar = document.getElementById('sidebar');
  const toggleBtn = document.getElementById('toggle-sidebar');
  const arrowIcon = document.getElementById('arrow-icon');
  const mainWrapper = document.getElementById('main-wrapper');
  toggleBtn.addEventListener('click', () => {
    if (sidebar.classList.contains('-translate-x-full')) {
      sidebar.classList.remove('-translate-x-full'); arrowIcon.style.transform = 'rotate(180deg)';
      if (window.innerWidth > 1024) mainWrapper.style.marginLeft = '288px';
    } else {
      sidebar.classList.add('-translate-x-full'); arrowIcon.style.transform = 'rotate(0deg)';
      mainWrapper.style.marginLeft = '0';
    }
  });
  document.querySelectorAll('#sidebar a[data-target="sidebar-link"]').forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const targetElement = document.getElementById(this.getAttribute('href').substring(1));
      if (targetElement) window.scrollTo({ top: targetElement.getBoundingClientRect().top + window.pageYOffset - 120, behavior: "smooth" });
    });
  });

  // 2. TRACKING
  function markAsAnswered(qID, hasVal) {
    if(document.body.classList.contains('review-mode')) return;
    const link = document.querySelector(`a[data-qid="${qID}"]`);
    if (link) { if (hasVal) link.classList.add('is-answered'); else link.classList.remove('is-answered'); }
  }
  document.addEventListener('change', (e) => { if (e.target.type === 'radio') markAsAnswered(e.target.name, true); });
  document.addEventListener('input', (e) => { if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') markAsAnswered(e.target.name, e.target.value.trim().length > 0); });
  document.addEventListener('dropdownAnswered', (e) => markAsAnswered(e.detail.id, true));

  let currentTool = null; let currentColor = null;
  document.querySelectorAll('.tool-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.classList.contains('active-tool')) {
        btn.classList.remove('active-tool'); currentTool = null; currentColor = null;
      } else {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active-tool'));
        btn.classList.add('active-tool'); currentTool = btn.getAttribute('data-action'); currentColor = btn.getAttribute('data-color');
      }
    });
  });
  document.addEventListener('mouseup', () => {
    if (!currentTool) return;
    const selection = window.getSelection();
    if (!selection.rangeCount || selection.isCollapsed) return;
    document.designMode = "on";
    if (currentTool === 'erase') document.execCommand("hiliteColor", false, "transparent");
    else if (currentTool === 'highlight') document.execCommand("hiliteColor", false, currentColor);
    document.designMode = "off";
    selection.removeAllRanges();
  });

  // 3. AUTO-GRADING ENGINE
  const btnSubmit = document.getElementById('btn-submit');
  const confirmModal = document.getElementById('confirm-modal');
  const scoreModal = document.getElementById('score-modal');

  btnSubmit.addEventListener('click', () => { confirmModal.classList.remove('hidden'); confirmModal.classList.add('flex'); setTimeout(() => confirmModal.classList.remove('opacity-0'), 10); });
  document.getElementById('btn-cancel-submit').addEventListener('click', () => { confirmModal.classList.add('opacity-0'); setTimeout(() => { confirmModal.classList.add('hidden'); confirmModal.classList.remove('flex'); }, 300); });

  document.getElementById('btn-confirm-submit').addEventListener('click', () => {
    confirmModal.classList.add('opacity-0');
    setTimeout(() => { confirmModal.classList.add('hidden'); confirmModal.classList.remove('flex'); }, 300);

    document.body.classList.add('review-mode');
    document.getElementById('highlighter-tools').style.opacity = '0'; 
    btnSubmit.style.display = 'none';

    let score = 0, skipped = 0;
    const totalReadingQs = window.examData.filter(q => parseInt(q.Part) <= 5).length;

    window.examData.forEach(q => {
       const partNum = parseInt(q.Part);
       let isCorrect = false, userAnswer = null;

       if (partNum >= 6) { 
           const wBlock = document.getElementById(`q-${q.ID}`); 
           if(wBlock) wBlock.querySelector('.explanation-box')?.classList.remove('hidden'); 
           return; 
       }

       // DROPDOWN (Part 4)
       if (partNum === 4) {
           const gapComp = document.querySelector(`.gap-component[data-qid="${q.ID}"]`);
           if (gapComp) {
               userAnswer = gapComp.getAttribute('data-user-answer');
               if (!userAnswer) skipped++; else isCorrect = (userAnswer === q.Answer);
               
               const trigger = gapComp.querySelector('.gap-trigger');
               const numBadge = gapComp.querySelector('.q-number');
               const selectedText = gapComp.querySelector('.selected-text');
               
               if(isCorrect) {
                  if(trigger) { trigger.style.borderColor = '#10b981'; trigger.style.backgroundColor = '#ecfdf5'; }
                  if(numBadge) numBadge.style.backgroundColor = '#10b981';
                  if(selectedText) selectedText.style.color = '#047857';
               } else {
                  if(trigger) { trigger.style.borderColor = userAnswer ? '#f43f5e' : '#94a3b8'; trigger.style.backgroundColor = userAnswer ? '#fff1f2' : '#f8fafc'; }
                  if(numBadge) numBadge.style.backgroundColor = userAnswer ? '#f43f5e' : '#94a3b8';
                  if(selectedText) { selectedText.style.color = userAnswer ? '#be123c' : '#64748b'; if(userAnswer) selectedText.style.textDecoration = 'line-through'; }
                  
                  // Chèn thẳng đáp án bên cạnh
                  const correctText = q[`Opt_${q.Answer}`] || q.Answer;
                  const correctSpan = document.createElement('span');
                  correctSpan.className = "text-emerald-700 font-bold ml-2 px-2 py-0.5 bg-emerald-50 border border-emerald-300 rounded-lg inline-block font-serif text-[1.1rem] md:text-[1.15rem] leading-none align-middle shadow-sm";
                  correctSpan.innerText = `👉 ${q.Answer}. ${correctText}`;
                  gapComp.parentNode.insertBefore(correctSpan, gapComp.nextSibling);
               }
           }
       }
       // MCQ (Part 1, 2, 3)
       else if (q.Type === 'mcq') {
           const checked = document.querySelector(`input[name="${q.ID}"]:checked`);
           if (checked) { userAnswer = checked.value; isCorrect = (userAnswer === q.Answer); } else skipped++;
           const container = document.querySelector(`.mcq-container[data-qid="${q.ID}"]`);
           if (container) {
               container.classList.remove('bg-white', 'border-slate-100');
               if (userAnswer) {
                   if (isCorrect) container.classList.add('bg-emerald-50/70', 'backdrop-blur-sm', 'border-emerald-300', 'shadow-lg');
                   else container.classList.add('bg-rose-50/70', 'backdrop-blur-sm', 'border-rose-300', 'shadow-lg');
               } else container.classList.add('bg-slate-50', 'border-slate-300');
               container.querySelector('.explanation-box')?.classList.remove('hidden');
               container.querySelectorAll('.opt-label').forEach(label => {
                   const input = label.querySelector('input'); label.classList.remove('bg-white');
                   if (input.value === q.Answer) label.classList.add('border-emerald-500', 'bg-emerald-100/60');
                   else if (input.checked && !isCorrect) label.classList.add('border-rose-500', 'bg-rose-100/60');
               });
           }
       }
       // INPUT (Part 5)
       else if (partNum === 5) {
           const inputEl = document.getElementById(`q-${q.ID}`);
           if (inputEl) {
               userAnswer = inputEl.value.trim().toLowerCase();
               if (!userAnswer) skipped++; else isCorrect = (userAnswer === q.Answer.toLowerCase());
               if(isCorrect) { inputEl.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-700'); }
               else {
                  inputEl.classList.add(userAnswer ? 'border-rose-500' : 'border-slate-300', userAnswer ? 'bg-rose-50' : 'bg-slate-50', 'text-rose-700');
                  if(userAnswer) inputEl.classList.add('line-through');
                  
                  const span = document.createElement('span');
                  span.className = "text-emerald-700 font-bold ml-2 px-2 py-0.5 bg-emerald-50 border border-emerald-300 rounded-lg inline-block font-serif text-[1.1rem] md:text-[1.15rem] leading-none align-middle shadow-sm";
                  span.innerText = `👉 ${q.Answer}`;
                  inputEl.parentNode.insertBefore(span, inputEl.nextSibling);
               }
           }
       }

       // Update Sidebar Menu
       const sLink = document.querySelector(`a[data-qid="${q.ID}"]`);
       if (userAnswer) {
           if (isCorrect) { score++; sLink?.classList.add('is-correct'); } else sLink?.classList.add('is-incorrect');
       } else if(sLink) sLink.style.backgroundColor = '#e2e8f0';
    });

    // Cập nhật thống kê CEFR
    const wrong = totalReadingQs - score - skipped;
    document.getElementById('stat-correct').innerText = score;
    document.getElementById('stat-wrong').innerText = wrong;
    document.getElementById('stat-skipped').innerText = skipped;
    document.getElementById('score-text').innerText = `${score}/${totalReadingQs}`;
    
    const cefrBadge = document.getElementById('cefr-badge');
    const circle = document.getElementById('score-circle');
    if (score < 17) { cefrBadge.innerText = "Level A1"; cefrBadge.className = "px-5 py-2 rounded-full font-black text-xs uppercase tracking-widest text-white shadow-md bg-slate-400"; circle.style.borderColor = "#cbd5e1"; }
    else if (score <= 26) { cefrBadge.innerText = "Level A2 (Pass)"; cefrBadge.className = "px-5 py-2 rounded-full font-black text-xs uppercase tracking-widest text-white shadow-md bg-teal-500"; circle.style.borderColor = "#14b8a6"; }
    else { cefrBadge.innerText = "Level B1 (Merit)"; cefrBadge.className = "px-5 py-2 rounded-full font-black text-xs uppercase tracking-widest text-white shadow-md bg-emerald-500"; circle.style.borderColor = "#10b981"; }

    setTimeout(() => { scoreModal.classList.remove('hidden'); scoreModal.classList.add('flex'); setTimeout(() => scoreModal.classList.remove('opacity-0'), 10); }, 400);
  });

  document.getElementById('btn-close-modal').addEventListener('click', () => { scoreModal.classList.add('opacity-0'); setTimeout(() => { scoreModal.classList.add('hidden'); scoreModal.classList.remove('flex'); }, 300); });
</script>