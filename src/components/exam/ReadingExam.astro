---
import MultipleChoice from './MultipleChoice.astro';
import Writing from './Writing.astro';

const { questions = [], testTitle = "A2 Key Exam" } = Astro.props;

// Logic phân loại Part thông minh
const partNumbers = [...new Set(questions.map(q => parseInt(q.Part)))].sort((a, b) => a - b);
const parts = partNumbers.map(num => {
  const partQuestions = questions.filter(q => parseInt(q.Part) === num);
  return {
    num,
    guideline: partQuestions[0]?.Part_Guideline || "Answer the questions.",
    questions: partQuestions,
    passage: partQuestions[0]?.Passage || ""
  };
});

function processPassage(text, partNum) {
  if (!text) return "";
  const lines = text.split('\n').map(l => l.trim()).filter(l => l !== "");

  if (partNum === 2) {
    let html = '<div class="grid gap-6">';
    lines.forEach(line => {
      const match = line.match(/^([A-C])\s+(.*)/i);
      if (match) {
        html += `
          <div class="group bg-white border border-slate-100 rounded-3xl p-8 hover:border-emerald-300 transition-all shadow-sm flex gap-6">
            <div class="w-14 h-14 rounded-2xl bg-slate-50 flex items-center justify-center text-3xl font-black text-slate-200 group-hover:text-emerald-500 transition-colors shrink-0">${match[1]}</div>
            <div class="flex-1">
              <h4 class="font-black text-slate-800 text-xl mb-4">${match[2]}</h4>`;
      } else {
        html += `<p class="text-slate-600 leading-relaxed text-lg font-medium mb-3">${line}</p>`;
      }
      if (lines[lines.indexOf(line) + 1]?.match(/^([A-C])\s+/i) || lines.indexOf(line) === lines.length - 1) {
        html += '</div></div>';
      }
    });
    return html + '</div>';
  }

  return lines.map((line, i) => {
    if (i === 0 && line.length < 60 && !line.includes('.')) {
      return `<h3 class="text-3xl font-black text-slate-900 mb-10 text-center uppercase tracking-tighter">${line}</h3>`;
    }
    return `<p class="mb-6 text-slate-700 leading-relaxed text-lg font-medium text-justify">${line}</p>`;
  }).join("");
}
---

<main class="flex-1 space-y-20">
  {parts.map(part => (
    <section id={`part-${part.num}`} class="animate-in fade-in slide-in-from-bottom-8 duration-1000">
      <div class="flex items-center gap-5 mb-10">
        <span class="w-16 h-16 bg-slate-900 text-emerald-400 rounded-3xl flex items-center justify-center font-black text-2xl shadow-2xl rotate-3">{part.num}</span>
        <div>
          <h2 class="text-3xl font-black text-slate-900 tracking-tighter uppercase">Part {part.num}</h2>
          <p class="text-slate-400 font-bold text-sm tracking-widest">{part.guideline}</p>
        </div>
      </div>

      <div class="space-y-10">
        {part.passage && (
          <div class="bg-white border border-slate-100 rounded-[3rem] p-10 md:p-16 shadow-sm relative">
            <div class="prose prose-slate max-w-none" set:html={processPassage(part.passage, part.num)} />
          </div>
        )}

        <div class="grid gap-8">
          {part.questions.map(q => {
            const type = q.Type?.toLowerCase();
            if (type === 'mcq') return <MultipleChoice q={q} />;
            if (type === 'writing') return <Writing q={q} />;
            return null;
          })}
        </div>
      </div>
    </section>
  ))}
</main>