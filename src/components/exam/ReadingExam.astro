---
// src/components/exam/ReadingExam.astro
import ReadingPart1 from './ReadingPart1.astro';
import ReadingPart2 from './ReadingPart2.astro'; // UI Profile Cards
import ReadingPart3 from './ReadingPart3.astro'; // UI Split Screen
import ReadingPart4 from './ReadingPart4.astro'; // UI Dropdown Gap Fill
import Part5Inline from './Part5Inline.astro';   // UI Input Gap Fill
import Writing from './Writing.astro';           // UI Textarea & Word Count

const { questions = [], testTitle = "Cambridge Reading & Writing" } = Astro.props;

// Phân luồng dữ liệu JSON thành 7 Part
const parts = [1, 2, 3, 4, 5, 6, 7].map(num => {
  const pQs = questions.filter(q => parseInt(q.Part || q.part) === num);
  if (pQs.length === 0) return null;
  return { 
    num, 
    questions: pQs, 
    guideline: pQs[0].Part_Guideline || `Part ${num}`, 
    passage: pQs[0].Passage || "" 
  };
}).filter(p => p !== null);
---

<div class="min-h-screen bg-slate-50 font-['Plus_Jakarta_Sans'] py-12 px-4 md:px-8">
  <div class="max-w-7xl mx-auto">
    
    <header class="mb-20 text-center animate-in fade-in slide-in-from-top-8 duration-700">
       <span class="bg-emerald-100 text-emerald-700 font-black px-6 py-2 rounded-2xl text-sm tracking-widest uppercase mb-6 inline-block shadow-sm">A2 KET EXAM</span>
       <h1 class="text-4xl md:text-6xl font-black text-slate-900 uppercase tracking-tighter">{testTitle}</h1>
    </header>

    {parts.map(p => (
      <div class="mb-32">
        <div class="flex items-center gap-5 mb-12">
           <div class="w-16 h-16 bg-slate-900 text-emerald-400 flex items-center justify-center rounded-3xl font-black text-3xl shadow-xl shadow-slate-300 transform -rotate-3">{p.num}</div>
           <div>
              <h2 class="text-3xl font-black text-slate-900 uppercase tracking-tight">Part {p.num}</h2>
              <p class="text-slate-500 font-bold text-lg">{p.guideline}</p>
           </div>
        </div>

        {/* TRẠM ĐIỀU PHỐI GIAO DIỆN CỰC XỊN CHO TỪNG PART */}
        <div class="animate-in fade-in slide-in-from-bottom-10 duration-1000">
            {p.num === 1 && <ReadingPart1 part={p} />}
            {p.num === 2 && <ReadingPart2 part={p} />}
            {p.num === 3 && <ReadingPart3 part={p} />}
            {p.num === 4 && <ReadingPart4 part={p} />}
            {p.num === 5 && <Part5Inline part={p} />}
            {(p.num === 6 || p.num === 7) && (
                <div class="space-y-12">
                    {p.questions.map(q => <Writing q={q} />)}
                </div>
            )}
        </div>
      </div>
    ))}

  </div>
</div>