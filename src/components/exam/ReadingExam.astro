---
// src/components/exam/ReadingExam.astro - BẢN FINAL (TÍCH HỢP NỘP BÀI & CHẤM ĐIỂM)
import MultipleChoice from './MultipleChoice.astro';
import Part5Inline from './Part5Inline.astro';
import GapFill from './GapFill.astro'; 
import Writing from './Writing.astro'; 

const { parts } = Astro.props;

/**
 * PARSER 1: Dành cho Part 3
 */
function formatReadingText(rawText: string) {
  if (!rawText) return "";
  const lines = rawText.split(/\r?\n/).map(l => l.trim()).filter(l => l !== "");
  return lines.map((line, index) => {
    const isTitle = (index === 0) || (line.length < 50 && !line.match(/[.?!]$/));
    if (isTitle) {
      return `<h3 class="text-2xl md:text-3xl font-black text-slate-900 mb-6 mt-8 first:mt-0 tracking-tight leading-tight uppercase">${line}</h3>`;
    }
    return `<p class="mb-5 text-slate-700 leading-relaxed text-lg text-justify font-medium">${line}</p>`;
  }).join("");
}

/**
 * PARSER 2: ĐẶC NHIỆM CHO PART 2
 */
function parsePart2Passage(rawText: string) {
  if (!rawText) return null;
  const lines = rawText.split(/\r?\n/).map(l => l.trim()).filter(l => l !== "");
  if (lines.length === 0) return null;

  let mainTitle = lines[0]; 
  const sections = [];
  let currentSection = null;

  for (let i = 1; i < lines.length; i++) {
    let line = lines[i];
    if (line.length < 40 && !line.endsWith('.')) {
      if (currentSection) sections.push(currentSection);
      currentSection = { title: line, content: [] };
    } else {
      if (!currentSection) currentSection = { title: "", content: [] };
      currentSection.content.push(line);
    }
  }
  if (currentSection) sections.push(currentSection);
  return { mainTitle, sections };
}

/**
 * PARSER 3: CHUYÊN DỤNG CHO PART 4 (DROPDOWN TẠI CHỖ)
 */
function formatPart4Passage(rawText: string, questions: any[]) {
  if (!rawText) return "";
  let html = formatReadingText(rawText);
  questions.forEach(q => {
    if (!q || !q.Q_Num) return; 
    const gapPattern = `(?:\\.{2,}|_{2,}|…+)\\s*\\(?\\b${q.Q_Num}\\b\\?*\\s*(?:\\.{2,}|_{2,}|…+)?` + `|` + `\\(\\s*${q.Q_Num}\\s*\\)`;
    const gapRegex = new RegExp(gapPattern, 'g');
    html = html.replace(gapRegex, `|||GAP_${q.Q_Num}|||`);
  });

  questions.forEach(q => {
    if (!q || !q.Q_Num) return; 
    const optionsHtml = ['A', 'B', 'C'].filter(opt => q[`Opt_${opt}`]).map(opt => `<option value="${opt}">${opt}. ${q[`Opt_${opt}`]}</option>`).join('');
    const selectHtml = `<select name="${q.ID}" class="exam-input inline-block appearance-none border-b-2 border-slate-300 bg-emerald-50 hover:bg-emerald-100 focus:border-emerald-500 outline-none text-center font-black text-emerald-700 px-3 py-1 mx-1 rounded-t-md cursor-pointer transition-all shadow-sm min-w-[80px]">
        <option value="" disabled selected>${q.Q_Num}</option>
        ${optionsHtml}
    </select>`;
    html = html.split(`|||GAP_${q.Q_Num}|||`).join(selectHtml);
  });
  return html;
}
---

<div class="reading-writing-container pb-32">
  {parts.map(part => {
    const parsedPart2 = part.part_number === 2 ? parsePart2Passage(part.passage) : null;

    return (
    <div class="mb-24 last:mb-0">
      
      {/* HEADER PART */}
      <div class="flex items-center gap-6 mb-12 max-w-5xl mx-auto px-4">
        <div class="flex flex-col">
            <span class="text-[10px] font-black text-emerald-500 uppercase tracking-[0.3em] mb-1">
                {part.part_number <= 5 ? 'Reading Section' : 'Writing Section'}
            </span>
            <h2 class="text-3xl md:text-4xl font-black text-slate-900 uppercase italic">Part {part.part_number}</h2>
        </div>
        <div class="h-[2px] flex-1 bg-gradient-to-r from-slate-200 to-transparent"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 md:px-6">
        
        {/* PART 2 */}
        {part.part_number === 2 && parsedPart2 && (
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            <div class="lg:col-span-7 bg-white p-8 md:p-12 rounded-[3rem] shadow-sm border border-slate-100 lg:sticky lg:top-10 relative overflow-hidden">
               <div class="absolute top-0 left-0 w-2 h-full bg-emerald-500"></div>
               <h3 class="text-2xl md:text-3xl font-black text-center text-slate-900 mb-8 uppercase">{parsedPart2.mainTitle}</h3>
               <div class="flex flex-col gap-6">
                  {parsedPart2.sections.map(sec => (
                     <div class="bg-slate-50 p-6 md:p-8 rounded-3xl border border-slate-100">
                        {sec.title && <h4 class="text-xl font-black text-emerald-600 mb-4 border-b-2 border-emerald-100 pb-3">{sec.title}</h4>}
                        <div class="space-y-3">{sec.content.map(p => <p class="text-slate-700 leading-relaxed text-lg text-justify font-medium">{p}</p>)}</div>
                     </div>
                  ))}
               </div>
            </div>
            <div class="lg:col-span-5 flex flex-col gap-6">{part.questions.map(q => <MultipleChoice q={q} part={2} />)}</div>
          </div>
        )}

        {/* PART 3 */}
        {part.part_number === 3 && part.passage && (
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            <div class="lg:col-span-7 bg-white p-8 md:p-14 rounded-[3rem] shadow-sm border border-slate-100 lg:sticky lg:top-10 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-2 h-full bg-emerald-500"></div>
                <div class="reading-content prose prose-slate max-w-none" set:html={formatReadingText(part.passage)} />
            </div>
            <div class="lg:col-span-5 flex flex-col gap-6">{part.questions.map(q => <MultipleChoice q={q} part={3} />)}</div>
          </div>
        )}

        {/* PART 4 */}
        {part.part_number === 4 && part.passage && (
          <div class="max-w-4xl mx-auto">
            <div class="bg-white p-8 md:p-12 rounded-[3rem] shadow-sm border border-slate-200 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-2 bg-emerald-500"></div>
                <div class="reading-content prose prose-slate max-w-none text-lg leading-loose mb-10" set:html={formatPart4Passage(part.passage, part.questions)} />
                <div class="explanation-box space-y-4 pt-8 border-t-2 border-dashed border-slate-200 hidden">
                   <h4 class="font-black text-slate-800 text-xl uppercase">💡 Answer Key Part 4</h4>
                   <div class="grid sm:grid-cols-2 gap-4 mt-4">
                     {part.questions.filter((q: any) => q.Q_Num).map((q: any) => (
                       <div class="bg-amber-50 p-5 rounded-2xl border border-amber-200">
                         <span class="bg-amber-400 text-amber-900 font-black px-3 py-1 rounded-lg text-sm mr-2 shadow-sm uppercase">Câu {q.Q_Num}: {q.Answer}</span>
                         {q.Explanation && <p class="text-sm text-slate-700 font-medium leading-relaxed mt-2">{q.Explanation}</p>}
                       </div>
                     ))}
                   </div>
                </div>
            </div>
          </div>
        )}

        {/* PART 5, 6, 7, 1 ... (Giữ nguyên các logic cũ sếp đang chạy ngon) */}
        {part.part_number === 5 && <div class="max-w-4xl mx-auto"><Part5Inline questions={part.questions} /></div>}
        {(part.part_number === 6 || part.part_number === 7) && <div class="max-w-4xl mx-auto flex flex-col gap-8">{part.questions.map(q => <Writing q={q} />)}</div>}
        {part.part_number === 1 && <div class="max-w-4xl mx-auto flex flex-col gap-8">{part.questions.map(q => <MultipleChoice q={q} part={1} />)}</div>}

      </div>
    </div>
  )})}

  {/* NÚT NỘP BÀI CHỐT ĐƠN */}
  <div class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50">
    <button id="submit-exam" class="bg-emerald-600 hover:bg-emerald-700 text-white font-black px-12 py-5 rounded-full shadow-2xl transform transition-all hover:scale-105 active:scale-95 flex items-center gap-4 group">
      <span class="text-xl uppercase tracking-tighter">Nộp bài & Chấm điểm</span>
      <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center group-hover:rotate-12 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
    </button>
  </div>
</div>

<script define:vars={{ parts }}>
  const submitBtn = document.getElementById('submit-exam');
  
  submitBtn.addEventListener('click', () => {
    let score = 0;
    let totalQuestions = 0;

    parts.forEach(part => {
      // Chỉ chấm các phần Reading (1-5)
      if (part.part_number > 5) return;

      part.questions.forEach(q => {
        if (!q.ID || !q.Answer) return;
        totalQuestions++;

        const id = q.ID;
        const correctAnswer = String(q.Answer).trim().toLowerCase();
        let userValue = '';

        // 1. Kiểm tra Radio (MultipleChoice)
        const radio = document.querySelector(`input[name="${id}"]:checked`);
        if (radio) userValue = radio.value;

        // 2. Kiểm tra Select (Part 4 Dropdown)
        const select = document.querySelector(`select[name="${id}"]`);
        if (select) userValue = select.value;

        // 3. Kiểm tra Text Input (Part 5)
        const textInput = document.querySelector(`input[name="${id}"][type="text"]`);
        if (textInput) userValue = textInput.value;

        const isCorrect = userValue.trim().toLowerCase() === correctAnswer;
        if (isCorrect) score++;

        // HIỆN THỊ KẾT QUẢ TRÊN GIAO DIỆN
        const inputs = document.querySelectorAll(`[name="${id}"]`);
        inputs.forEach(el => {
           const parent = el.closest('.exam-card, .bg-slate-50, div');
           if (isCorrect) {
             el.classList.add('border-emerald-500', 'bg-emerald-50');
           } else {
             el.classList.add('border-red-500', 'bg-red-50');
           }
        });
      });
    });

    // Mở tất cả các hộp giải thích
    document.querySelectorAll('.explanation-box').forEach(box => box.classList.remove('hidden'));
    
    // Cuộn lên đầu và báo điểm
    window.scrollTo({ top: 0, behavior: 'smooth' });
    alert(`🎉 Chúc mừng! Sếp đạt được: ${score}/${totalQuestions} câu đúng.`);
    submitBtn.innerHTML = "Xem lại kết quả";
    submitBtn.classList.replace('bg-emerald-600', 'bg-slate-800');
  });
</script>

<style is:global>
  .reading-content p { text-indent: 0; }
  .reading-content h3 { border-bottom: 4px solid #10b981; display: inline-block; padding-bottom: 4px; }
  .reading-content { line-height: 2.2 !important; }
</style>