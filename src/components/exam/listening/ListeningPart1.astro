---
// src/components/exam/listening/ListeningPart1.astro
const { q } = Astro.props;
const options = ['A', 'B', 'C'];

// BỘ DÒ TÌM ẢNH THÔNG MINH (Bao trọn mọi loại tên cột)
const imgSrc = q.Image || q.Image_Link || q.image || q.Image_URL || q.image_link || q.Image_link;
---

<div class="mcq-container bg-white rounded-2xl p-6 sm:p-8 border border-slate-100 shadow-sm hover:shadow-md transition-shadow duration-300 mb-8" data-qnum={q.Q_Num}>
    
    <div class="flex items-start gap-4 mb-6">
        <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-teal-500 text-white font-black text-lg rounded-xl shadow-md shadow-teal-200/50">
            {q.Q_Num}
        </span>
        <h3 class="text-xl font-bold text-slate-700 pt-1 leading-relaxed">
            {q.Question || q.questionText || "Listen and choose the correct picture."}
        </h3>
    </div>

    <div class="max-w-2xl mx-auto">
        {/* KHUNG HIỂN THỊ ẢNH CÂN ĐỐI */}
        {imgSrc && (
            <div class="mb-6 rounded-xl overflow-hidden border border-slate-100 shadow-sm bg-white p-2">
                <img 
                    src={imgSrc} 
                    alt={`Question ${q.Q_Num} visual options`} 
                    class="w-full h-auto object-contain rounded-lg"
                />
            </div>
        )}

        {/* 3 NÚT A B C XINH XẮN */}
        <div class="grid grid-cols-3 gap-4">
            {options.map((opt) => (
                <label class="relative cursor-pointer group flex justify-center opt-label">
                    <input type="radio" name={`q-${q.Q_Num}`} value={opt} class="peer sr-only" />
                    
                    {/* Nút được làm mỏng lại (border-2), nhỏ gọn (w-11 h-11) */}
                    <div class="w-11 h-11 rounded-full border-2 border-slate-200 bg-white text-slate-400 font-bold text-lg flex items-center justify-center transition-all duration-300 ease-out
                        peer-checked:border-teal-500 peer-checked:bg-teal-500 peer-checked:text-white peer-checked:shadow-[0_0_15px_rgba(20,184,166,0.3)] peer-checked:scale-110
                        group-hover:border-teal-400 group-hover:text-teal-500 group-hover:bg-teal-50">
                        {opt}
                    </div>
                </label>
            ))}
        </div>
    </div>

    {/* HỘP GIẢI THÍCH */}
    <div class="explanation-box hidden mt-8 pt-6 border-t border-dashed border-slate-200 animate-in fade-in slide-in-from-top-4 duration-500">
        <div class="bg-teal-50 rounded-xl p-5 border border-teal-100">
            <h4 class="font-black text-teal-800 text-sm uppercase tracking-widest mb-3 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Transcript & Giải thích
            </h4>
            <div class="text-slate-700 leading-relaxed font-medium whitespace-pre-wrap">
                {q.Explanation || q.Transcript || "Chưa có lời giải chi tiết cho câu hỏi này."}
            </div>
        </div>
    </div>

</div>