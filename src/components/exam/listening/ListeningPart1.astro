---
const { q } = Astro.props;
const options = ['A', 'B', 'C'];
const imgSrc = q.Image || q.Image_Link || q.image || q.Image_URL || q.image_link || q.Image_link;

const highlightTranscript = (fullText, evidence) => {
    if (!evidence || !fullText) return fullText || "";
    try {
        const words = evidence.match(/[\p{L}\p{N}]+/gu);
        if (!words || words.length === 0) return fullText;
        const regexStr = words.join('[\\s\\W]+');
        const regex = new RegExp(`(${regexStr})`, 'gi');
        if (regex.test(fullText)) {
            return fullText.replace(regex, '<mark class="bg-yellow-300 text-black font-black px-2 py-0.5 rounded shadow-sm border-b-2 border-orange-500">$1</mark>');
        }
        let highlightedText = fullText;
        const chunks = [];
        for (let i = 0; i < words.length; i += 5) {
            const chunk = words.slice(i, i + 7);
            if (chunk.length >= 3) chunks.push(chunk);
        }
        chunks.forEach(chunk => {
            const subRegex = new RegExp(`(${chunk.join('[\\s\\W]+')})`, 'gi');
            if (subRegex.test(highlightedText)) {
                highlightedText = highlightedText.replace(subRegex, '<mark class="bg-yellow-300 text-black font-black px-2 py-0.5 rounded shadow-sm border-b-2 border-orange-500">$1</mark>');
            }
        });
        return highlightedText;
    } catch (e) { return fullText; }
};
---

<div class="mcq-container bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm mb-10" data-qnum={q.Q_Num || q.qNum}>
    <div class="flex items-start gap-5 mb-8">
        <span class="flex-shrink-0 w-12 h-12 flex items-center justify-center bg-teal-500 text-white font-black text-xl rounded-2xl shadow-md">
            {q.Q_Num || q.qNum}
        </span>
        <h3 class="text-2xl font-black text-slate-800 pt-1 tracking-tight leading-tight">
            {q.Question || "Choose the correct picture."}
        </h3>
    </div>

    <div class="max-w-2xl mx-auto">
        {imgSrc && (
            <div class="mb-4 rounded-[1.5rem] overflow-hidden border-2 border-slate-100 bg-white w-full flex justify-center">
                <img src={imgSrc} alt="Question Image" class="w-full h-auto object-contain" />
            </div>
        )}
        <div class="grid grid-cols-3 w-full mb-6">
            {options.map((opt) => (
                <label class="relative cursor-pointer group flex flex-col items-center">
                    <input type="radio" name={`q-${q.Q_Num || q.qNum}`} value={opt} class="peer sr-only" />
                    <div class="opt-radio w-12 h-12 sm:w-14 sm:h-14 rounded-full border-[3px] border-slate-200 bg-white transition-all duration-200 group-hover:border-teal-300 peer-checked:border-teal-500 peer-checked:bg-teal-50 flex items-center justify-center shadow-sm">
                        <span class="text-xl font-black text-slate-400 peer-checked:text-teal-600 transition-colors">{opt}</span>
                    </div>
                </label>
            ))}
        </div>
    </div>

    <div class="explanation-box hidden mt-8 pt-8 border-t border-dashed border-slate-200 animate-in fade-in duration-700 w-full">
        <div class="bg-gradient-to-br from-white to-slate-50 rounded-[2rem] p-8 border border-slate-100 shadow-inner">
            <div class="mb-6">
                <h4 class="font-black text-teal-800 text-xs uppercase tracking-[0.2em] mb-3 flex items-center gap-2">
                    <span class="w-2 h-2 bg-teal-400 rounded-full animate-pulse"></span> LOGIC GIẢI THÍCH
                </h4>
                <p class="text-slate-700 font-bold text-lg leading-relaxed">{q.Logic_VN}</p>
            </div>
            {q.Distractor_VN && (
                <div class="mb-6 p-5 bg-rose-50/50 rounded-2xl border border-rose-100 shadow-sm">
                    <h4 class="font-black text-rose-800 text-xs uppercase tracking-[0.2em] mb-2 flex items-center gap-2">⚠️ PHÂN TÍCH BẪY</h4>
                    <p class="text-rose-700 font-semibold text-sm leading-relaxed">{q.Distractor_VN}</p>
                </div>
            )}
            <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
                <h4 class="font-black text-slate-400 text-[10px] uppercase tracking-widest mb-4">Transcript Analysis</h4>
                <div class="text-slate-600 font-medium leading-relaxed italic text-base">
                    <span set:html={highlightTranscript(q.Transcript_EN, q.Evidence_EN)}></span>
                </div>
            </div>
        </div>
    </div>
</div>