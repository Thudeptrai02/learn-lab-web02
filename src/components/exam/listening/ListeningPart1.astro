---
// src/components/exam/listening/ListeningPart1.astro
const { q } = Astro.props;

// Đảm bảo Part 1 luôn có 3 lựa chọn A, B, C
const options = ['A', 'B', 'C'];
---

<div class="mcq-container bg-white rounded-2xl p-6 sm:p-8 border-2 border-slate-100 shadow-sm transition-colors duration-300 mb-8" data-qnum={q.Q_Num}>
    
    {/* DÒNG CÂU HỎI */}
    <div class="flex items-start gap-4 mb-8">
        <span class="flex-shrink-0 w-12 h-12 flex items-center justify-center bg-indigo-600 text-white font-black text-xl rounded-xl shadow-md shadow-indigo-200">
            {q.Q_Num}
        </span>
        <h3 class="text-xl font-bold text-slate-800 pt-2 leading-relaxed">
            {q.Question || q.questionText}
        </h3>
    </div>

    {/* KHUNG ẢNH VÀ NÚT CHỌN (Đã được căn chỉnh tỷ lệ vàng) */}
    <div class="max-w-2xl mx-auto">
        {/* Bức ảnh lớn chứa 3 hình */}
        {q.Image && (
            <div class="mb-6 rounded-xl overflow-hidden border-2 border-slate-100 shadow-sm bg-white p-2">
                <img 
                    src={q.Image} 
                    alt={`Question ${q.Q_Num} visual options`} 
                    class="w-full h-auto object-contain"
                />
            </div>
        )}

        {/* Lưới 3 cột để căn giữa 3 nút A, B, C trúng phóc 3 hình ảnh */}
        <div class="grid grid-cols-3 gap-4">
            {options.map((opt) => (
                <label class="relative cursor-pointer group flex justify-center opt-label">
                    <input type="radio" name={`q-${q.Q_Num}`} value={opt} class="peer sr-only" />
                    
                    {/* Nút Tròn (Viền dày, to bản, hiệu ứng nổi lên khi click) */}
                    <div class="w-14 h-14 rounded-full border-4 border-slate-200 bg-white text-slate-400 font-black text-2xl flex items-center justify-center transition-all duration-300 ease-out
                        peer-checked:border-indigo-600 peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:shadow-[0_0_20px_rgba(79,70,229,0.4)] peer-checked:scale-110
                        group-hover:border-indigo-400 group-hover:text-indigo-500 group-hover:bg-indigo-50">
                        {opt}
                    </div>
                </label>
            ))}
        </div>
    </div>

    {/* HỘP GIẢI THÍCH (Ẩn đi, chỉ hiện khi nộp bài) */}
    <div class="explanation-box hidden mt-8 pt-6 border-t-2 border-dashed border-slate-200 animate-in fade-in slide-in-from-top-4 duration-500">
        <div class="bg-indigo-50 rounded-xl p-5 border border-indigo-100">
            <h4 class="font-black text-indigo-800 text-sm uppercase tracking-widest mb-3 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Transcript & Giải thích
            </h4>
            <div class="text-slate-700 leading-relaxed font-medium whitespace-pre-wrap">
                {q.Explanation || q.Transcript || "Chưa có lời giải chi tiết cho câu hỏi này."}
            </div>
        </div>
    </div>

</div>