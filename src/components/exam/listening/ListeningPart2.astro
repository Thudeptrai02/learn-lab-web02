---
const { questions = [], passage = "", partNum } = Astro.props;

let contextText = "For each question, write the correct answer in the gap. Write ONE word or a number or a date or a time.";
let notepadTitle = "Listening Part " + partNum;
let staticLines: string[] = [];

if (passage) {
    const lines = passage.split(/\[BR\]|\|\||\r\n|\n|<br\s*\/?>/).map((l: string) => l.trim()).filter((l: string) => l);
    if (lines.length > 0) {
        if (lines[0].toLowerCase().match(/hear|listen|write|for each/)) {
            contextText = lines[0];
            if (lines[1]) notepadTitle = lines[1];
            staticLines = lines.slice(2);
        } else {
            notepadTitle = lines[0];
            staticLines = lines.slice(1);
        }
    }
}

staticLines = staticLines.filter(line => !line.match(/\.{3,}|_{3,}/) && !line.match(/\(\d+\)/));

function parseQuestionLine(text: string) {
    if (!text) return { label: "", valueText: "" };
    const colonIdx = text.indexOf(':');
    if (colonIdx !== -1) {
        return {
            label: text.substring(0, colonIdx + 1).trim(),
            valueText: text.substring(colonIdx + 1).trim()
        };
    }
    return { label: text, valueText: "" };
}

function formatValueWithInput(valueText: string, qNum: string|number, qId: string) {
    let cleanText = valueText.replace(new RegExp(`^\\s*\\(?${qNum}\\)?\\.?\\s*`), '').trim();

    // 🌟 TUYỆT CHIÊU FIX LỖI: Tạo tên input dự phòng nếu thiếu ID
    const safeName = qId || `q_${qNum}`;

    const inputHtml = `
        <span class="inline-flex items-center gap-1.5 mx-1.5 align-middle">
            <span class="flex items-center justify-center w-7 h-7 font-black text-sm text-white bg-sky-500 rounded-md shadow-sm shrink-0 leading-none">${qNum}</span>
            <input type="text" name="${safeName}" class="exam-input w-28 md:w-36 h-8 bg-slate-50 border-2 border-slate-300 rounded-lg outline-none px-2 font-bold text-center text-sky-700 focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-100 transition-all shadow-sm" autocomplete="off" />
        </span>
    `;
    
    if (cleanText.match(/[\._]{2,}/)) return cleanText.replace(/[\._]{2,}/g, inputHtml);
    if (cleanText.toLowerCase().startsWith('from ')) return "from " + inputHtml + cleanText.substring(4);
    if (cleanText.toLowerCase().startsWith('in the ')) return "in the " + inputHtml + cleanText.substring(6);
    return cleanText + " " + inputHtml;
}
---

<div class="w-full max-w-4xl mx-auto scroll-mt-24 md:scroll-mt-40" id={`q-${questions[0]?.Q_Num || questions[0]?.ID}`}>
    
    <div class="bg-sky-50/50 border border-sky-100 p-6 md:p-8 rounded-[2rem] mb-8 shadow-sm">
       <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
           <h4 class="text-sky-800 font-black uppercase text-sm tracking-widest flex items-center gap-2">
              <span>📝</span> YÊU CẦU ĐỀ BÀI
           </h4>
           <div class="bg-sky-200/50 text-sky-800 px-3 py-1.5 rounded-lg font-bold text-xs uppercase tracking-wider inline-block w-max">
               Part {partNum} • Questions {questions[0]?.Q_Num} - {questions[questions.length-1]?.Q_Num}
           </div>
       </div>
       <p class="text-sky-900 font-medium text-base md:text-lg leading-relaxed">{contextText}</p>
    </div>

    <div class="bg-white rounded-[2rem] border-2 border-slate-200 shadow-sm w-full p-8 md:p-12 relative overflow-hidden">
        <h4 class="text-2xl md:text-3xl font-black text-slate-900 mb-10 text-center uppercase tracking-wide border-b-2 border-slate-100 pb-6">
            {notepadTitle}
        </h4>

        <div class="grid grid-cols-[140px_1fr] sm:grid-cols-[180px_1fr] md:grid-cols-[220px_1fr] gap-x-4 gap-y-6 md:gap-y-8 max-w-3xl mx-auto text-lg md:text-xl">
            {staticLines.map(line => {
                const { label, valueText } = parseQuestionLine(line);
                return (
                    <div class="contents">
                        <div class="font-bold text-slate-600 flex items-center md:items-center pb-1">{label}</div>
                        <div class="flex items-center text-slate-800 italic font-medium pb-1">{valueText}</div>
                    </div>
                )
            })}
            {questions.map((q: any) => {
                const { label, valueText } = parseQuestionLine(q.Question);
                return (
                    <div class="contents group">
                        <div class="font-bold text-slate-900 flex items-center md:items-center pb-1">{label}</div>
                        <div class="flex items-center flex-wrap text-slate-700 leading-loose">
                            <span set:html={formatValueWithInput(valueText, q.Q_Num, q.ID)}></span>
                        </div>
                    </div>
                );
            })}
        </div>
    </div>
</div>