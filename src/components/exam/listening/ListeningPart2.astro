---
// src/components/exam/listening/ListeningPart2.astro
const { partData } = Astro.props;

const formTitle = partData.passage || partData.Passage || "NOTES / FORM";
---

<div class="bg-white rounded-[2rem] p-6 sm:p-10 border border-teal-100 shadow-sm hover:shadow-md transition-shadow duration-300 mb-8 relative">
    
    <div class="max-w-3xl mx-auto bg-[#fdfbf7] rounded-xl shadow-inner border border-teal-100 relative overflow-hidden">
        <div class="h-3 bg-teal-500 w-full opacity-90"></div>
        
        <div class="p-8 sm:p-12">
            <h3 class="text-xl sm:text-2xl font-black text-center text-teal-900 tracking-widest uppercase mb-10 border-b-2 border-teal-100 pb-5">
                {formTitle.split('<br/>')[0]}
            </h3>

            <div class="space-y-6 text-lg font-medium text-slate-700">
                {partData.questions?.map((q) => {
                    const qNum = q.Q_Num || q.qNum || q.so_cau || q.id;
                    const rawQuestion = String(q.Question || q.cau_hoi || q.text || "Question");
                    const correctAnswer = q.Answer || q.dap_an || "";

                    // 🟢 BỘ LỌC DẤU CHẤM CỰC MẠNH: Quét sạch mọi loại dấu chấm (chấm liền, chấm cách, dấu ba chấm...)
                    const normalizedQ = rawQuestion.replace(/(?:\.[\s]*){3,}|…+/g, '___SPLIT___');
                    const splitText = normalizedQ.split('___SPLIT___');
                    
                    // Lọc bỏ các khoảng trắng dư thừa
                    const beforeText = splitText[0] ? splitText[0].trim() : "";
                    const afterText = splitText[1] ? splitText[1].trim() : "";

                    return (
                        <div class="part2-container" data-qnum={qNum} data-answer={correctAnswer}>
                            
                            {/* 🟢 DÙNG INLINE-BLOCK ĐỂ ÉP CHÚNG NÓ NẰM CÙNG 1 DÒNG */}
                            <div class="leading-[3.5rem] group transition-all">
                                
                                {/* Cục số thứ tự */}
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-teal-500 text-white font-black text-sm shadow-sm mr-3 align-middle">
                                    {qNum}
                                </span>
                                
                                {/* Chữ phía trước */}
                                <span class="font-bold text-teal-900 align-middle">
                                    {beforeText}
                                </span>
                                
                                {/* Ô Nhập Liệu - Căn giữa theo chữ */}
                                <div class="input-wrapper relative inline-block mx-3 align-middle">
                                    <input 
                                        type="text" 
                                        name={`q-${qNum}`} 
                                        class="w-40 sm:w-48 bg-white border-2 border-teal-300 text-teal-900 font-black px-3 py-2 placeholder-teal-200/70 focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-200 rounded-lg shadow-sm transition-all h-11"
                                        placeholder="Enter answer..."
                                        autocomplete="off"
                                    />
                                </div>

                                {/* Chữ phía sau (nếu có) */}
                                {afterText && (
                                    <span class="font-bold text-teal-900 align-middle">
                                        {afterText}
                                    </span>
                                )}
                            </div>
                            
                            {/* Hộp giải thích (Ẩn) */}
                            <div class="explanation-box hidden w-full text-sm mt-2 p-4 bg-emerald-50 border border-emerald-100 rounded-xl text-emerald-800 animate-in fade-in duration-500">
                                <div class="font-black mb-1 flex items-center gap-2">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                                    Correct: {correctAnswer}
                                </div>
                                {q.Transcript && <div class="text-slate-600 italic bg-white/50 p-2 rounded mt-2 text-xs">{q.Transcript}</div>}
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </div>
</div>