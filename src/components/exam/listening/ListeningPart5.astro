---
// src/components/exam/listening/ListeningPart5.astro
const { partData } = Astro.props;

const formTitle = partData.passage || partData.Passage || "Questions 21-25";
const instruction = partData.instruction || partData.Instruction || "For each question, choose the correct answer.";

// 🟢 1. LINH HOẠT TIÊU ĐỀ CỘT TỪ JSON 
// (Mặc định là "Questions" và "Options" nếu file JSON của sếp không khai báo)
const col1Title = partData.col1Header || partData.col1_title || "Questions";
const col2Title = partData.col2Header || partData.col2_title || "Options";

// Tự động lấy danh sách đáp án từ JSON
const firstQ = partData.questions[0] || {};
const rawOptions = firstQ.options || firstQ.choices || ['A. actor', 'B. coach', 'C. dentist', 'D. journalist', 'E. mechanic', 'F. pilot', 'G. receptionist', 'H. tour guide'];

const letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
---

<div class="bg-white rounded-[2rem] p-6 sm:p-10 border border-teal-100 shadow-sm hover:shadow-md transition-shadow duration-300 mb-8">
    
    <div class="mb-8 pb-5 border-b border-slate-200">
        <h3 class="text-xl font-black text-slate-900 tracking-tight mb-2">
            {formTitle.split('<br/>')[0]}
        </h3>
        <p class="text-slate-700 font-medium">{instruction}</p>
    </div>

    {/* LAYOUT 2 CỘT SONG SONG */}
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row gap-12 md:gap-24">
        
        {/* CỘT TRÁI: DANH SÁCH CÂU HỎI */}
        <div class="flex-1">
            <div class="border-b-2 border-slate-800 pb-2 mb-6">
                <h4 class="font-black text-lg text-slate-900 uppercase tracking-wider">{col1Title}</h4>
            </div>
            
            <div class="space-y-6">
                {partData.questions?.map((q) => {
                    const qNum = q.Q_Num || q.qNum || q.so_cau || q.id;
                    let questionLabel = q.Question || q.cau_hoi || q.text || "Name";
                    
                    // 🟢 2. TẨY SẠCH DẤU CHẤM: Biến "Tyler: ......" thành "Tyler:"
                    questionLabel = String(questionLabel).replace(/\.{2,}/g, '').trim();
                    
                    const correctAnswer = q.Answer || q.dap_an || "";

                    return (
                        <div class="part5-container flex flex-col" data-qnum={qNum} data-answer={correctAnswer}>
                            <div class="flex items-center justify-between gap-4">
                                <div class="flex items-center gap-4 flex-1">
                                    <span class="font-black text-slate-900 w-6">{qNum}</span>
                                    <span class="font-bold text-slate-700">{questionLabel}</span>
                                </div>
                                
                                {/* 🟢 3. Ô BOX HÌNH CHỮ NHẬT XỊN XÒ CHUẨN UI */}
                                <div class="input-wrapper relative shrink-0">
                                    <input 
                                        type="text" 
                                        name={`q-${qNum}`} 
                                        maxlength="1"
                                        class="w-14 h-12 border-2 border-slate-300 rounded-lg bg-white text-center font-black text-2xl text-teal-700 uppercase focus:border-teal-500 focus:ring-4 focus:ring-teal-500/20 focus:outline-none transition-all shadow-sm"
                                        autocomplete="off"
                                    />
                                </div>
                            </div>

                            {/* Hộp giải thích khi chấm điểm */}
                            <div class="explanation-box hidden mt-3 p-3 bg-emerald-50 border border-emerald-100 rounded-lg text-sm text-emerald-800 animate-in fade-in">
                                <div class="font-black">Correct: {correctAnswer}</div>
                                {q.Transcript && <div class="text-slate-600 italic mt-1">{q.Transcript}</div>}
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>

        {/* CỘT PHẢI: DANH SÁCH LỰA CHỌN */}
        <div class="flex-1">
            <div class="border-b-2 border-slate-800 pb-2 mb-6">
                <h4 class="font-black text-lg text-slate-900 uppercase tracking-wider">{col2Title}</h4>
            </div>
            
            {/* Tạo nền nhạt cho cột bên phải để phân biệt rõ ràng với cột trái */}
            <div class="space-y-4 bg-slate-50 p-6 sm:p-8 rounded-2xl border border-slate-100 shadow-inner">
                {rawOptions.map((opt, index) => {
                    const fallbackLetter = letters[index] || '?';
                    const match = String(opt).match(/^([A-H])[\.\-\:]?\s*(.*)/i);
                    const letter = match ? match[1].toUpperCase() : fallbackLetter;
                    const text = match ? match[2] : opt;

                    return (
                        <div class="flex items-start gap-4">
                            <span class="font-black text-teal-600 w-6 text-lg">{letter}</span>
                            <span class="font-bold text-slate-700">{text}</span>
                        </div>
                    )
                })}
            </div>
        </div>

    </div>
</div>