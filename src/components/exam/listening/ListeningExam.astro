---
import ListeningMCQ from './ListeningMCQ.astro';
import ListeningPart1 from './ListeningPart1.astro'; 
import ListeningPart2 from './ListeningPart2.astro';
import ListeningPart5 from './ListeningPart5.astro';

const { questions = [], testTitle = "Cambridge A2 KET Listening" } = Astro.props;
const hasData = questions && questions.length > 0;

const parts = [1, 2, 3, 4, 5].map(num => {
  const pQs = questions.filter(q => parseInt(q.Part || q.part) === num);
  if (pQs.length === 0) return null;
  const qNums = pQs.map(q => parseInt(q.Q_Num || q.qNum)).filter(n => !isNaN(n));
  const minQ = qNums.length > 0 ? Math.min(...qNums) : "";
  const maxQ = qNums.length > 0 ? Math.max(...qNums) : "";
  const qRange = minQ && maxQ ? (minQ === maxQ ? `Question ${minQ}` : `Questions ${minQ}-${maxQ}`) : "";
  return { num, questions: pQs, passage: pQs[0].Passage || pQs[0].passage || "", audioLink: pQs[0].Audio_Link || pQs[0].audioLink || "", qRange };
}).filter(p => p !== null);
---

<style is:global>
    .menu-scroll::-webkit-scrollbar { width: 4px; }
    .menu-scroll::-webkit-scrollbar-track { background: transparent; }
    .menu-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    .highlight-target { animation: pulse-ring 1.5s cubic-bezier(0.4, 0, 0.6, 1) forwards; }
    @keyframes pulse-ring {
        0% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.7); }
        70% { box-shadow: 0 0 0 15px rgba(20, 184, 166, 0); }
        100% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0); }
    }
</style>

{!hasData ? (
    <div class="min-h-screen flex items-center justify-center bg-slate-50"><p class="font-black text-rose-500">NO DATA</p></div>
) : (
    <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <div id="exam-data" data-questions={JSON.stringify(questions)} class="hidden"></div>

    <div class="min-h-screen bg-[#f8fafc] text-slate-700 font-sans relative overflow-x-hidden">
        
        <aside id="side-menu" class="fixed top-0 left-0 h-screen w-72 bg-white shadow-[10px_0_30px_rgba(0,0,0,0.08)] z-[900] transform -translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] flex flex-col border-r border-slate-200">
            
            <button id="toggle-menu-btn" class="absolute top-1/2 -translate-y-1/2 -right-10 w-10 h-16 bg-white border-y border-r border-slate-200 rounded-r-xl shadow-[5px_0_10px_rgba(0,0,0,0.05)] flex items-center justify-center text-teal-600 hover:text-teal-500 transition-colors cursor-pointer group">
                <svg id="menu-arrow" class="w-6 h-6 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path></svg>
            </button>

            <div class="p-6 border-b border-slate-100 bg-teal-50/30">
                <h3 class="font-black text-teal-800 tracking-widest uppercase flex items-center gap-2 text-sm">
                    <svg class="w-5 h-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                    Bản đồ câu hỏi
                </h3>
            </div>

            <div class="flex-1 overflow-y-auto p-5 space-y-8 menu-scroll">
                {parts.map(p => (
                    <div>
                        <h4 class="font-bold text-slate-400 mb-3 text-xs uppercase tracking-widest border-b border-slate-100 pb-2">
                            Part {p.num}
                        </h4>
                        <div class="grid grid-cols-5 gap-2">
                            {p.questions.map(q => {
                                const qNum = q.Q_Num || q.qNum;
                                return (
                                    <button data-nav-target={qNum} class="nav-q-btn w-full aspect-square rounded-lg border-2 border-slate-100 bg-slate-50 font-black text-slate-400 hover:border-teal-400 hover:text-teal-500 transition-all flex items-center justify-center text-xs">
                                        {qNum}
                                    </button>
                                )
                            })}
                        </div>
                    </div>
                ))}
            </div>
        </aside>

        <div id="start-overlay" class="fixed inset-0 z-[1000] bg-white/95 backdrop-blur-xl flex items-center justify-center p-6 transition-all duration-700">
            <div class="text-center max-w-lg">
                <div class="w-24 h-24 mx-auto bg-teal-50 rounded-full flex items-center justify-center mb-8 border-4 border-teal-100">
                    <span class="text-5xl">🎧</span>
                </div>
                <h2 class="text-4xl font-black text-slate-900 mb-10 tracking-tighter uppercase">{testTitle}</h2>
                <button id="btn-start-exam" class="px-16 py-6 bg-teal-500 text-white font-black rounded-[2rem] text-xl shadow-xl shadow-teal-200 hover:scale-105 active:scale-95 transition-all">START TEST NOW</button>
            </div>
        </div>

        <main class="max-w-4xl mx-auto px-4 lg:px-8 py-12 transition-all duration-300" id="main-content">
            <header class="mb-16 text-center">
                <h1 class="text-5xl lg:text-6xl font-black text-slate-900 mb-4 tracking-tighter">{testTitle}</h1>
                <div class="h-1 w-20 bg-teal-500 mx-auto rounded-full"></div>
            </header>

            <div class="space-y-32">
                {parts.map(p => (
                    <section id={`section-part-${p.num}`} class="relative pt-6">
                        <div class="sticky top-4 z-40 mb-12">
    <div class="bg-white/90 backdrop-blur-md border border-slate-200 shadow-lg rounded-[2rem] p-3 flex items-center gap-6 max-w-4xl mx-auto">
        <div class="px-5 h-12 rounded-2xl bg-teal-500 text-white flex items-center justify-center font-black text-sm uppercase tracking-[0.2em] shrink-0 shadow-md shadow-teal-100">
            PART {p.num}
        </div>
        <div class="flex-1">
            <audio controls class="w-full part-audio accent-teal-500 h-10" data-part={p.num} src={p.audioLink}></audio>
        </div>
    </div>
</div>

                        {p.num === 1 && p.questions.map(q => <ListeningPart1 q={q} />)}
                        {p.num === 2 && <ListeningPart2 partData={p} />}
                        {(p.num === 3 || p.num === 4) && p.questions.map(q => <ListeningMCQ q={q} />)}
                        {p.num === 5 && <ListeningPart5 partData={p} />}
                    </section>
                ))}
            </div>
        </main>

        <div class="fixed bottom-6 inset-x-0 z-[800] flex justify-center pointer-events-none">
            <div class="bg-white/90 backdrop-blur-lg border border-slate-200 shadow-[0_15px_30px_rgba(0,0,0,0.1)] rounded-[2.5rem] p-2 flex items-center gap-2 pointer-events-auto">
                
                <div class="hidden sm:flex items-center px-5 font-black text-slate-400 text-sm border-r border-slate-200">
                    <span id="answered-count" class="text-teal-500 text-lg mr-1">0</span> / {questions.length}
                </div>

                <div id="timer-display" class="bg-slate-100 text-slate-800 px-6 py-3 rounded-[2rem] font-black text-xl flex items-center gap-3">
                    <span id="timer-dot" class="w-2.5 h-2.5 bg-teal-500 rounded-full animate-pulse"></span>
                    <span id="time-string" class="tabular-nums tracking-tight">30:00</span>
                </div>
                
                <button id="btn-submit-exam-main" class="bg-teal-500 hover:bg-teal-600 text-white font-black py-3 px-8 rounded-[2rem] shadow-md text-sm uppercase tracking-widest transition-all active:scale-95 flex items-center gap-2">
                    Nộp Bài <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </button>
            </div>
        </div>

        <div id="result-modal" class="fixed inset-0 z-[1200] bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-6 opacity-0 transition-all duration-500">
            <div class="bg-white rounded-[4rem] p-16 max-w-xl w-full text-center shadow-2xl border border-white transform scale-90 transition-all duration-500" id="result-modal-content">
                <div class="text-8xl mb-8">✨</div>
                <h2 class="text-4xl font-black text-slate-900 mb-2">Well Done!</h2>
                <div class="text-[8rem] leading-none font-black text-teal-500 my-8 tracking-tighter" id="score-display">0/25</div>
                <button id="btn-review-exam" class="w-full bg-slate-900 text-white font-black py-6 rounded-[2rem] text-lg shadow-2xl hover:bg-teal-600 transition-all uppercase tracking-widest">Xem Đáp Án</button>
            </div>
        </div>
    </div>

    <script is:inline>
        // --- LOGIC GIAO DIỆN MENU (OFF-CANVAS) ---
        const sideMenu = document.getElementById('side-menu');
        const menuBtn = document.getElementById('toggle-menu-btn');
        const menuArrow = document.getElementById('menu-arrow');

        menuBtn.addEventListener('click', () => {
            const isClosed = sideMenu.classList.contains('-translate-x-full');
            if (isClosed) {
                sideMenu.classList.remove('-translate-x-full');
                menuArrow.classList.add('rotate-180'); // Mũi tên quay ngược
            } else {
                sideMenu.classList.add('-translate-x-full');
                menuArrow.classList.remove('rotate-180');
            }
        });

        // Bấm số chuyển trang
        document.querySelectorAll('.nav-q-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const targetNum = e.currentTarget.dataset.navTarget;
                const targetEl = document.querySelector(`[data-qnum="${targetNum}"]`);
                if (targetEl) {
                    sideMenu.classList.add('-translate-x-full'); // Auto đóng menu
                    menuArrow.classList.remove('rotate-180');
                    const y = targetEl.getBoundingClientRect().top + window.scrollY - 100;
                    window.scrollTo({ top: y, behavior: 'smooth' });

                    targetEl.classList.remove('highlight-target');
                    void targetEl.offsetWidth;
                    targetEl.classList.add('highlight-target', 'rounded-3xl');
                    setTimeout(() => targetEl.classList.remove('highlight-target'), 1500);
                }
            });
        });

        // --- LOGIC TRACKING CÂU ĐÃ LÀM (TÔ MÀU NÚT) ---
        let questionsData = [];
        try { questionsData = JSON.parse(document.getElementById('exam-data').dataset.questions); } catch(e) {}
        
        function updateProgress() {
            let answered = 0;
            document.querySelectorAll('.nav-q-btn').forEach(btn => {
                const qNum = btn.dataset.navTarget;
                const container = document.querySelector(`[data-qnum="${qNum}"]`);
                if(!container) return;

                let isAns = false;
                if(container.querySelector('input[type="radio"]:checked')) isAns = true;
                else {
                    const textInput = container.querySelector('input[type="text"]');
                    if(textInput && textInput.value.trim() !== '') isAns = true;
                    const select = container.querySelector('select');
                    if(select && select.value.trim() !== '') isAns = true;
                }

                if(isAns) {
                    btn.classList.add('!bg-teal-500', '!text-white', '!border-teal-500');
                    answered++;
                } else {
                    btn.classList.remove('!bg-teal-500', '!text-white', '!border-teal-500');
                }
            });
            const countEl = document.getElementById('answered-count');
            if(countEl) countEl.innerText = answered;
            return answered;
        }

        // Lắng nghe mọi thay đổi để tô màu menu ngay lập tức
        document.addEventListener('change', updateProgress);
        document.addEventListener('input', updateProgress);


        // --- LOGIC START, AUDIO & NỘP BÀI ---
        const btnStart = document.getElementById('btn-start-exam');
        const overlay = document.getElementById('start-overlay');
        const timerText = document.getElementById('time-string');
        const btnSubmitMain = document.getElementById('btn-submit-exam-main');
        const resultModal = document.getElementById('result-modal');
        const btnReview = document.getElementById('btn-review-exam');

        let duration = 30 * 60;
        let timerInterval;
        let isSubmitted = false;

        function playSequence(pNum) {
            const audio = document.querySelector(`.part-audio[data-part="${pNum}"]`);
            if (!audio) return;
            audio.play();
            audio.onended = () => { if (pNum < 5) playSequence(pNum + 1); };
        }

        btnStart?.addEventListener('click', () => {
            overlay.classList.add('opacity-0', 'pointer-events-none');
            timerInterval = setInterval(() => {
                const m = Math.floor(duration / 60);
                const s = duration % 60;
                if(timerText) timerText.innerText = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                if (--duration < 0) finalSubmit();
            }, 1000);
            playSequence(1);
        });

        // NÂNG CẤP PRO: Cảnh báo quên làm bài
        btnSubmitMain?.addEventListener('click', () => {
            const answered = updateProgress();
            const total = questionsData.length;
            if (answered < total) {
                if(!confirm(`CẢNH BÁO: Bạn vẫn còn ${total - answered} câu chưa làm!\nBạn có chắc chắn muốn nộp bài sớm không?`)) {
                    return; // Hủy nộp bài
                }
            }
            finalSubmit();
        });

        function finalSubmit() {
            if (isSubmitted) return;
            isSubmitted = true;
            clearInterval(timerInterval);
            
            let score = 0;
            questionsData.forEach(q => {
                const qNum = q.Q_Num || q.qNum;
                const correctAns = String(q.Answer || "").trim().toLowerCase();
                const container = document.querySelector(`[data-qnum="${qNum}"]`);
                if(!container) return;

                let userAns = "";
                const partNum = Number(q.Part || q.part);
                if ([1, 3, 4].includes(partNum)) {
                    userAns = container.querySelector('input:checked')?.value?.trim().toLowerCase() || "";
                } else if (partNum === 2) {
                    userAns = container.querySelector('input')?.value?.trim().toLowerCase() || "";
                } else if (partNum === 5) {
                    userAns = container.querySelector('select')?.value?.trim().toLowerCase() || "";
                }

                const isCorrect = partNum === 2 ? correctAns.split('/').map(s => s.trim().toLowerCase()).includes(userAns) : userAns === correctAns;
                if (isCorrect && userAns !== "") score++;

                const explBox = container.querySelector('.explanation-box');
                if(explBox) {
                    explBox.classList.remove('hidden');
                    const badge = isCorrect 
                        ? `<div class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-700 font-black text-xs uppercase px-4 py-2 rounded-xl mb-4 border border-emerald-200">✓ CHÍNH XÁC</div>`
                        : `<div class="inline-flex items-center gap-2 bg-rose-100 text-rose-700 font-black text-xs uppercase px-4 py-2 rounded-xl mb-4 border border-rose-200">✗ SAI - ĐÁP ÁN: ${correctAns.toUpperCase()}</div>`;
                    explBox.insertAdjacentHTML('afterbegin', badge);
                }

                if ([1, 3, 4].includes(partNum)) {
                    container.querySelectorAll('label').forEach(label => {
                        const radio = label.querySelector('input');
                        const element = label.querySelector('.opt-box') || label.querySelector('.opt-radio');
                        radio.disabled = true;
                        if (radio.value.toLowerCase() === correctAns) {
                            element.classList.add('!border-emerald-500', '!bg-emerald-50', '!text-emerald-700');
                        } else if (radio.checked) {
                            element.classList.add('!border-rose-500/50', '!bg-rose-50', '!text-rose-700');
                        }
                    });
                } else if (partNum === 2 || partNum === 5) {
                    const el = container.querySelector('input, select');
                    el.disabled = true;
                    if(isCorrect) el.classList.add('!border-emerald-500', '!bg-emerald-50', '!text-emerald-700');
                    else {
                        el.classList.add('!border-rose-400', '!bg-rose-50', '!text-rose-700', 'line-through');
                        el.insertAdjacentHTML('afterend', `<span class="ml-4 text-emerald-600 font-black bg-emerald-50 px-4 py-2 rounded-xl border border-emerald-200">Ans: ${correctAns.toUpperCase()}</span>`);
                    }
                }
            });

            document.getElementById('score-display').innerText = `${score}/${questionsData.length}`;
            resultModal.classList.remove('hidden');
            resultModal.classList.add('flex');
            setTimeout(() => {
                resultModal.classList.add('opacity-100');
                document.getElementById('result-modal-content').classList.remove('scale-90');
                if (typeof confetti === 'function') confetti({ particleCount: 200, spread: 100, origin: { y: 0.6 } });
            }, 100);
            
            // Ẩn thanh bottom khi đã nộp bài
            document.querySelector('.fixed.bottom-6').classList.add('hidden');
        }

        btnReview?.addEventListener('click', () => {
            resultModal.classList.add('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>
)}