---
// src/components/exam/listening/ListeningMCQ.astro
const { q } = Astro.props;
const options = ['A', 'B', 'C']; 
---

<div class="mcq-container bg-white rounded-2xl p-6 sm:p-8 border border-slate-100 shadow-sm hover:shadow-md transition-shadow duration-300 mb-8" data-qnum={q.Q_Num}>
    
    <div class="flex items-start gap-4 mb-6">
        <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-teal-500 text-white font-black text-lg rounded-xl shadow-md shadow-teal-200/50">
            {q.Q_Num}
        </span>
        <h3 class="text-xl font-bold text-slate-700 pt-1 leading-relaxed">
            {q.Question || q.questionText}
        </h3>
    </div>

    <div class="grid grid-cols-1 gap-3 pl-0 sm:pl-14">
        {options.map((opt) => {
            const optText = q[opt] || q[opt.toLowerCase()];
            if (!optText) return null;
            
            return (
                <label class="relative cursor-pointer group opt-label block">
                    <input type="radio" name={`q-${q.Q_Num}`} value={opt} class="peer sr-only" />
                    
                    <div class="w-full p-4 rounded-xl border-2 border-slate-100 bg-white text-slate-600 font-medium transition-all duration-200 ease-in-out
                        peer-checked:border-teal-500 peer-checked:bg-teal-50/50 peer-checked:text-teal-800 peer-checked:shadow-sm
                        group-hover:border-teal-200">
                        
                        <div class="flex items-center gap-4">
                            <div class="w-6 h-6 flex-shrink-0 rounded-full border-2 border-slate-300 flex items-center justify-center 
                                peer-checked:border-teal-500 peer-checked:bg-teal-500 transition-colors group-hover:border-teal-300">
                                <div class="w-2.5 h-2.5 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                            </div>
                            <span class="text-lg leading-relaxed flex-1"><strong class="mr-2 text-slate-400">{opt}.</strong> {optText}</span>
                        </div>
                    </div>
                </label>
            )
        })}
    </div>

    <div class="explanation-box hidden mt-8 pt-6 border-t border-dashed border-slate-200 animate-in fade-in slide-in-from-top-4 duration-500">
        <div class="bg-teal-50 rounded-xl p-5 border border-teal-100">
            <h4 class="font-black text-teal-800 text-sm uppercase tracking-widest mb-3 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Transcript & Giải thích
            </h4>
            <div class="text-slate-700 leading-relaxed font-medium whitespace-pre-wrap">
                {q.Explanation || q.Transcript || "Chưa có lời giải chi tiết."}
            </div>
        </div>
    </div>
</div>