---
const { q } = Astro.props;
const options = ['A', 'B', 'C'];
let contextText = "";
let mainQuestion = q.Question || q.questionText || "";

const partNum = parseInt(q.Part || q.part);
if (partNum === 4 && q.Passage) {
    const sentences = q.Passage.match(/[^.!?]+[.!?]+/g) || [q.Passage];
    if (sentences.length > 1) {
        mainQuestion = sentences.pop().trim();
        contextText = sentences.join(' ').trim();
    } else { contextText = q.Passage; }
}

const highlightTranscript = (fullText, evidence) => {
    if (!evidence || !fullText) return fullText || "";
    try {
        const words = evidence.match(/[\p{L}\p{N}]+/gu);
        if (!words || words.length === 0) return fullText;
        const regexStr = words.join('[\\s\\W]+');
        const regex = new RegExp(`(${regexStr})`, 'gi');
        if (regex.test(fullText)) {
            return fullText.replace(regex, '<mark class="bg-yellow-300 text-black font-black px-2 py-0.5 rounded shadow-sm border-b-2 border-orange-500">$1</mark>');
        }
        let highlightedText = fullText;
        let isMatched = false;
        const chunks = [];
        for (let i = 0; i < words.length; i += 5) {
            const chunk = words.slice(i, i + 7);
            if (chunk.length >= 3) chunks.push(chunk);
        }
        chunks.forEach(chunk => {
            const subRegex = new RegExp(`(${chunk.join('[\\s\\W]+')})`, 'gi');
            if (subRegex.test(highlightedText)) {
                highlightedText = highlightedText.replace(subRegex, '<mark class="bg-yellow-300 text-black font-black px-2 py-0.5 rounded shadow-sm border-b-2 border-orange-500">$1</mark>');
                isMatched = true;
            }
        });
        return isMatched ? highlightedText : fullText;
    } catch (e) { return fullText; }
};
---

<div class="mcq-container bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-sm mb-10" data-qnum={q.Q_Num || q.qNum}>
    {contextText && (
        <div class="mb-6 bg-teal-50/30 border-l-4 border-teal-500 p-5 rounded-r-2xl">
            <p class="text-slate-600 font-medium italic leading-relaxed">{contextText}</p>
        </div>
    )}

    <div class="flex items-start gap-5 mb-8">
        <span class="flex-shrink-0 w-12 h-12 flex items-center justify-center bg-teal-500 text-white font-black text-xl rounded-2xl shadow-lg shadow-teal-100">{q.Q_Num || q.qNum}</span>
        <h3 class="text-2xl font-black text-slate-800 pt-1 tracking-tight leading-tight">{mainQuestion}</h3>
    </div>

    <div class="grid grid-cols-1 gap-4 pl-0 sm:pl-16">
        {options.map((opt) => {
            const optText = q[opt] || q[opt.toLowerCase()] || q[`Opt_${opt}`];
            if (!optText) return null;
            return (
                <label class="relative cursor-pointer group block">
                    <input type="radio" name={`q-${q.Q_Num || q.qNum}`} value={opt} class="peer sr-only" />
                    <div class="opt-box w-full p-5 rounded-2xl border-2 border-slate-200 bg-white text-slate-700 font-bold transition-all duration-300 peer-checked:border-teal-500 peer-checked:bg-teal-50 peer-checked:text-teal-900 group-hover:border-teal-300 group-hover:bg-teal-50/50 shadow-sm">
                        <div class="flex items-center gap-5">
                            <div class="opt-circle w-8 h-8 flex-shrink-0 rounded-full border-2 border-slate-200 flex items-center justify-center peer-checked:border-teal-500 peer-checked:bg-teal-500 transition-all">
                                <div class="w-2.5 h-2.5 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                            </div>
                            <span class="text-lg"><strong class="mr-2 opacity-50">{opt}.</strong> {optText}</span>
                        </div>
                    </div>
                </label>
            )
        })}
    </div>

    <div class="explanation-box hidden mt-8 pt-8 border-t border-dashed border-slate-200 animate-in fade-in duration-700 w-full">
        <div class="bg-gradient-to-br from-white to-teal-50/30 rounded-[2rem] p-8 border border-teal-100 shadow-inner">
            <div class="mb-6">
                <h4 class="font-black text-teal-800 text-xs uppercase tracking-[0.2em] mb-3 flex items-center gap-2"><span class="w-2 h-2 bg-teal-500 rounded-full animate-pulse"></span> LOGIC GIẢI THÍCH</h4>
                <p class="text-slate-700 font-bold text-lg leading-relaxed">{q.Logic_VN}</p>
            </div>
            
            {q.Distractor_VN && (
                <div class="mb-6 p-5 bg-rose-50/50 rounded-2xl border border-rose-100 shadow-sm">
                    <h4 class="font-black text-rose-800 text-xs uppercase tracking-[0.2em] mb-2 flex items-center gap-2"><span class="text-base">⚠️</span> PHÂN TÍCH BẪY (DISTRACTOR)</h4>
                    <p class="text-rose-700 font-semibold text-sm leading-relaxed">{q.Distractor_VN}</p>
                </div>
            )}

            <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
                <h4 class="font-black text-slate-400 text-[10px] uppercase tracking-widest mb-4">Audio Transcript Analysis</h4>
                <div class="text-slate-600 font-medium leading-relaxed italic text-base">
                    <span set:html={highlightTranscript(q.Transcript_EN, q.Evidence_EN)}></span>
                </div>
                {q.Transcript_VN && <div class="mt-4 pt-4 border-t border-slate-50 text-slate-400 text-sm italic">{q.Transcript_VN}</div>}
            </div>
        </div>
    </div>
</div>