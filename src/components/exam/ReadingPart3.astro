---
// src/components/exam/ReadingPart3.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

function formatPassage(text) {
  if (!text) return "";
  const lines = text.split('\n').filter(l => l.trim() !== "");
  return lines.map((line, index) => {
    // Dòng đầu tiên luôn là tiêu đề in đậm (Bold)
    if (index === 0) return `<h3 class="text-3xl font-black text-slate-900 mb-8 text-center uppercase tracking-tight">${line}</h3>`;
    return `<p class="mb-5 text-slate-700 leading-loose text-lg font-medium text-justify">${line}</p>`;
  }).join("");
}
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
  <div class="lg:col-span-7 bg-white p-10 md:p-14 rounded-[3.5rem] border border-slate-100 shadow-sm lg:sticky lg:top-10 max-h-[85vh] overflow-y-auto custom-scrollbar">
    <div class="prose prose-slate max-w-none" set:html={formatPassage(part.passage)} />
  </div>

  <div class="lg:col-span-5 space-y-6">
    <div class="bg-slate-900 text-white p-8 rounded-[2.5rem] mb-6 shadow-xl shadow-slate-200">
       <h4 class="text-emerald-400 font-black uppercase tracking-widest text-xs mb-2">Part 3</h4>
       <p class="font-bold text-lg leading-relaxed">{part.guideline}</p>
    </div>
    {part.questions.map(q => <MultipleChoice q={q} />)}
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
</style>