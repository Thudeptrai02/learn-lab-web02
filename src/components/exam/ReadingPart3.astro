---
import MultipleChoice from './MultipleChoice.astro';

const { part } = Astro.props;
const pNum = part.part_number;
const questions = part.questions || [];

function formatReadingText(rawText: string) {
  if (!rawText) return "";
  const lines = String(rawText).split(/\[BR\]|\|\||\r\n|\r|\n|\\n|<br\s*\/?>/).map(l => l.trim()).filter(l => l !== "");
  
  return lines.map((line, index) => {
    const cleanLine = line.replace(/[\s\uFEFF\xA0]+$/g, '');
    const isTitle = cleanLine.length < 55 && !/[.?!]$/.test(cleanLine);
    
    if (isTitle) {
      const displayTitle = cleanLine.replace(/\.*$/g, '');
      if (index === 0) return `<h2 class="text-2xl md:text-3xl font-black text-slate-900 mb-6 text-center uppercase tracking-tight leading-tight">${displayTitle}</h2>`;
      return `<h3 class="text-xl font-black text-slate-900 mb-3 mt-8 first:mt-0 tracking-tight leading-snug">${displayTitle}</h3>`;
    }
    return `<p class="mb-5 text-slate-800 leading-relaxed text-lg text-justify font-medium">${line}</p>`;
  }).join("");
}
---

<div class="flex flex-col xl:flex-row gap-6 lg:gap-12 items-start relative">
  <button type="button" class="mobile-passage-trigger xl:hidden w-full bg-emerald-100 hover:bg-emerald-200 text-emerald-800 font-black py-3.5 rounded-2xl flex items-center justify-center gap-2 shadow-sm transition-all sticky top-20 z-30 border-2 border-emerald-300" data-target={`passage-sheet-${pNum}`}>
     <span>📖 Mở bài đọc Part {pNum}</span>
  </button>
  <div id={`passage-sheet-${pNum}`} class="fixed inset-x-0 bottom-0 z-[70] w-full h-[75vh] bg-white shadow-[0_-20px_50px_rgba(0,0,0,0.2)] rounded-t-[2rem] transition-transform duration-500 translate-y-full flex flex-col xl:static xl:translate-y-0 xl:h-auto xl:w-[60%] 2xl:w-[65%] xl:bg-white xl:p-8 xl:md:p-12 xl:rounded-[2rem] xl:border xl:border-slate-200 xl:shadow-md xl:sticky xl:top-28 xl:self-start max-h-[75vh] xl:max-h-[calc(100vh-8rem)]">
     <div class="flex justify-between items-center p-5 border-b border-slate-100 xl:hidden bg-slate-50 rounded-t-[2rem] shrink-0">
        <span class="font-black text-slate-800 text-lg">📖 Bài đọc Part {pNum}</span>
        <button type="button" class="close-passage-btn w-8 h-8 bg-slate-200 rounded-full flex items-center justify-center font-bold text-slate-600 hover:bg-rose-500 hover:text-white transition-colors" data-target={`passage-sheet-${pNum}`}>✕</button>
     </div>
     <div class="p-6 xl:p-0 overflow-y-auto custom-scrollbar flex-1">
        <div class="prose max-w-none text-slate-800" set:html={formatReadingText(part.passage)} />
     </div>
  </div>
  <div class="w-full xl:w-[40%] 2xl:w-[35%] flex flex-col gap-6 transition-all">
     {questions.map((q: any) => <div id={`q-${q.Q_Num}`} class="scroll-mt-24 md:scroll-mt-32"><MultipleChoice q={q} part={pNum} /></div>)}
  </div>
</div>