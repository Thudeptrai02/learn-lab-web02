---
// src/components/exam/ReadingPart1.astro
import MultipleChoice from './MultipleChoice.astro';
const { part, showAnswers = false } = Astro.props;

function formatWithHighlight(text, evidence, show) {
    if (!text) return "";
    if (!show || !evidence) return text.replace(/\n/g, '<br/>');
    
    const regex = new RegExp(`(${evidence.trim()})`, 'gi');
    return text.replace(regex, `<mark class="bg-yellow-300 text-slate-900 px-1 rounded-sm font-black shadow-sm">$1</mark>`)
               .replace(/\n/g, '<br/>');
}

function renderPassage(q, show) {
    const style = q.Style?.toLowerCase();
    const formattedText = formatWithHighlight(q.Passage, q.Evidence, show);
    const lines = q.Passage.split('\n').filter(l => l.trim() !== "");

    if (style === 'notice') {
        return `
            <div class="notice-board bg-slate-900 text-white p-8 rounded-lg shadow-[10px_10px_0px_#e2e8f0] border-4 border-slate-700 text-center relative mb-6">
                <div class="absolute top-2 left-1/2 -translate-x-1/2 flex gap-4"><div class="w-2 h-2 rounded-full bg-slate-700"></div><div class="w-2 h-2 rounded-full bg-slate-700"></div></div>
                <h3 class="text-xl font-black mb-4 border-b border-slate-500 pb-2 uppercase">${lines[0]}</h3>
                <p class="text-lg font-bold leading-tight">${formattedText.replace(lines[0], '')}</p>
            </div>`;
    }

    if (style === 'email') {
        return `
            <div class="email-card bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm mb-6">
                <div class="bg-slate-50 px-6 py-4 border-b border-slate-100 text-xs font-bold text-slate-400">EMAIL MESSAGE</div>
                <div class="p-8 text-slate-700 text-lg leading-relaxed font-medium">${formattedText}</div>
            </div>`;
    }

    return `
        <div class="chat-container mb-6">
            <div class="max-w-[90%] bg-emerald-500 text-white p-6 rounded-[2rem] rounded-bl-none shadow-lg relative ml-2">
                <p class="text-lg font-bold leading-relaxed italic">${formattedText}</p>
            </div>
        </div>`;
}
---

<div class="max-w-5xl mx-auto space-y-24">
    {part.questions.map((q) => (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
            <div class="lg:sticky lg:top-24">
                <div set:html={renderPassage(q, showAnswers)} />
            </div>
            <MultipleChoice q={q} showAnswers={showAnswers} />
        </div>
    ))}
</div>