---
// src/components/exam/ReadingPart1.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

function renderStimulus(q) {
  const lines = q.Passage.split('\n').filter(l => l.trim() !== "");
  const style = q.Style?.toLowerCase();

  if (style === 'notice') {
    return `
      <div class="notice-container p-8 bg-slate-900 text-white rounded-lg shadow-[12px_12px_0px_#e2e8f0] border-4 border-slate-700 text-center relative mb-6 min-h-[160px] flex flex-col justify-center">
        <div class="absolute top-2 left-1/2 -translate-x-1/2 flex gap-3 opacity-20"><div class="w-2 h-2 rounded-full bg-white"></div><div class="w-2 h-2 rounded-full bg-white"></div></div>
        <h3 class="text-xl md:text-2xl font-black mb-4 border-b-2 border-slate-600 pb-2 uppercase tracking-tighter">${lines[0]}</h3>
        <p class="passage-text text-lg md:text-xl font-bold leading-tight" data-evidence="${q.Evidence || ''}">${lines.slice(1).join('<br/>')}</p>
      </div>`;
  }

  if (style === 'email') {
    return `
      <div class="email-container bg-white border border-slate-200 rounded-[2rem] overflow-hidden shadow-sm mb-6">
        <div class="bg-slate-50 px-6 py-4 border-b border-slate-100 font-sans text-[10px] font-black text-slate-400 uppercase tracking-widest">Incoming Message</div>
        <div class="p-8 passage-text text-slate-700 text-lg leading-relaxed font-medium" data-evidence="${q.Evidence || ''}">
          ${q.Passage.replace(/\n/g, '<br/>')}
        </div>
      </div>`;
  }

  return `
    <div class="chat-bubble-container flex flex-col mb-6">
      <div class="max-w-[90%] bg-emerald-500 text-white p-6 rounded-[2.5rem] rounded-bl-none shadow-xl relative ml-2">
         <p class="passage-text text-lg font-bold italic" data-evidence="${q.Evidence || ''}">${q.Passage.replace(/\n/g, '<br/>')}</p>
      </div>
      <span class="text-[10px] font-black text-slate-300 ml-6 mt-2 uppercase tracking-widest">Delivered</span>
    </div>`;
}
---

<div class="space-y-32 py-10">
  {part.questions.map((q) => (
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div class="lg:sticky lg:top-24">
         <div set:html={renderStimulus(q)} />
      </div>
      <MultipleChoice q={q} />
    </div>
  ))}
</div>