---
// src/components/exam/ReadingPart1.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

function getStyleClass(passage) {
  if (passage.includes('To:') || passage.includes('From:')) return 'bg-slate-50 border-slate-200 rounded-2xl p-6 border-l-8 border-l-emerald-500';
  if (passage.includes('NOTICE') || passage.length < 100) return 'bg-yellow-50 border-yellow-200 rounded-none shadow-md p-10 border-4 border-double';
  return 'bg-white border-slate-100 rounded-3xl p-8';
}
---
<div class="max-w-3xl mx-auto space-y-12">
  <div class="mb-10 text-center">
    <h2 class="text-3xl font-black text-slate-900 mb-2 italic">PART 1</h2>
    <p class="text-slate-400 font-bold uppercase tracking-widest text-xs">{part.guideline}</p>
  </div>

  {part.questions.map(q => (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center animate-in fade-in zoom-in duration-700">
      {/* Khung văn bản mô phỏng thực tế */}
      <div class={`${getStyleClass(q.Passage)} shadow-sm relative overflow-hidden group hover:shadow-xl transition-all`}>
         <div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-30 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" /></svg>
         </div>
         <div class="prose prose-slate max-w-none font-bold text-slate-800 leading-relaxed whitespace-pre-line text-lg" set:html={q.Passage} />
      </div>
      {/* Lựa chọn đáp án */}
      <MultipleChoice q={q} part={1} />
    </div>
  ))}
</div>