---
// src/components/exam/ReadingPart1.astro
import MultipleChoice from './MultipleChoice.astro';
const { part } = Astro.props;

function renderPhysicalUI(q) {
  const lines = q.Passage.split('\n').filter(l => l.trim() !== "");
  const style = (q.Style || 'notice').toLowerCase();

  if (style === 'notice') {
    return `<div class="bg-[#1e293b] text-white p-8 rounded-xl shadow-[8px_8px_0px_#94a3b8] w-full max-w-sm mx-auto relative border-4 border-[#334155]"><h3 class="text-2xl font-black uppercase text-center border-b-2 border-slate-600 pb-3 mb-5 mt-2 text-yellow-400 tracking-widest">${lines[0]}</h3><p class="text-center font-bold text-lg leading-snug">${lines.slice(1).join('<br/>')}</p></div>`;
  }
  if (style === 'email') {
    const fromLine = lines.find(l => l.toLowerCase().includes('from:')) || lines[0];
    const contentLines = lines.filter(l => l !== fromLine && !l.toLowerCase().includes('to:'));
    return `<div class="bg-white rounded-xl border border-slate-300 shadow-xl w-full max-w-sm mx-auto overflow-hidden"><div class="bg-slate-200 px-4 py-2 flex items-center gap-2 border-b border-slate-300"><div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div><div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div><div class="w-3 h-3 rounded-full bg-[#27c93f]"></div></div><div class="bg-slate-50 px-5 py-3 border-b border-slate-100"><p class="text-[11px] font-bold text-slate-400 uppercase">${fromLine}</p></div><div class="p-6 text-slate-700 font-medium text-[15px] leading-relaxed">${contentLines.join('<br/>')}</div></div>`;
  }
  return `<div class="bg-slate-50 rounded-[2rem] border-8 border-white shadow-xl w-full max-w-sm mx-auto p-5 flex flex-col h-full"><div class="text-center text-[10px] font-bold text-slate-400 mb-4 mt-2 tracking-widest">Today 09:41</div><div class="bg-[#25D366] text-white px-5 py-3 rounded-2xl rounded-tr-sm shadow-sm max-w-[85%] self-end"><p class="font-medium text-[15px] leading-relaxed">${q.Passage.replace(/\n/g, '<br/>')}</p></div></div>`;
}
---

<div class="space-y-10 py-6">
  {part.questions.map(q => (
    /* THÊM ID ĐỂ ĐỊNH VỊ VỊ TRÍ CÂU HỎI TRONG PART 1 */
    <div id={`q-${q.ID}`} class="flex flex-col lg:flex-row gap-8 bg-white p-6 md:p-10 rounded-[2.5rem] border border-slate-100 shadow-sm items-center">
      <div class="w-full lg:w-5/12 bg-slate-50/50 p-6 md:p-10 rounded-3xl flex items-center justify-center border border-slate-100 border-dashed">
         <div class="w-full" set:html={renderPhysicalUI(q)} />
      </div>
      <div class="w-full lg:w-7/12">
         <MultipleChoice q={q} isPart1={true} />
      </div>
    </div>
  ))}
</div>