---
// src/components/exam/MultipleChoice.astro
const { q, part } = Astro.props;

// 1. GIỮ NGUYÊN LOGIC LISTENING
function parseQuestionText(text: string) {
    if (!text) return { context: '', mainQuestion: '' };
    let cleanText = text.replace(/\[BR\]|\|\||<br\s*\/?>/gi, '\n').trim();

    if (cleanText.includes('\n')) {
        const parts = cleanText.split('\n');
        if (parts[0].toLowerCase().includes('hear')) {
            return { context: parts[0].trim(), mainQuestion: parts.slice(1).join(' ').trim() };
        }
    }
    const match1 = cleanText.match(/^(.*?(?:will hear|hear).*?[\.\:\?])\s*(.*)$/i);
    if (match1) return { context: match1[1].trim(), mainQuestion: match1[2].trim() };

    const match2 = cleanText.match(/^(.*?(?:will hear|hear).*?)\s+(Which|What|Why|Where|Who|How|When|Do|Does|Did|Is|Are)(.*)/i);
    if (match2) {
        return { context: match2[1].trim(), mainQuestion: (match2[2] + match2[3]).trim() };
    }
    return { context: '', mainQuestion: cleanText };
}

// 2. GIỮ NGUYÊN LOGIC RENDER BIỂN BÁO PART 1
function formatPart1Passage(text: string, style: string) {
    if (!text) return "";
    let formatted = text.replace(/\\n/g, '\n'); 
    
    if (style === "email") {
        return formatted
            .replace(/^(Hi|Dear|To:|From:.*?)[\r\n,]/gim, match => `<span class="font-bold text-slate-500 block mb-2">${match}</span>`)
            .replace(/(Cheers,|Best,|Regards,|Thanks,.*?)$/gim, match => `<span class="font-bold text-slate-500 block mt-4">${match}</span>`)
            .replace(/\n/g, '<br/>');
    }
    
    if (style === "notice") {
        formatted = formatted.replace(/^([A-Z\s0-9!?]{5,})(?=\s|$|\n)/, '<span class="block text-2xl font-black mb-3 border-b-4 border-slate-900/10 pb-2 tracking-tight">$1</span>');
        return formatted.replace(/\n/g, '<br/>');
    }

    return formatted.replace(/\n/g, '<br/>');
}

const { context, mainQuestion } = parseQuestionText(q.Question || "");
const formattedPassage = formatPart1Passage(q.Passage || "", q.Style);

const options = [
    { key: 'A', text: q.Opt_A },
    { key: 'B', text: q.Opt_B },
    { key: 'C', text: q.Opt_C },
    { key: 'D', text: q.Opt_D }
].filter(o => o.text);

const inputName = q.ID || `q_${q.Q_Num}`;
const qNumInt = parseInt(q.Q_Num) || 0;

// 3. GIỮ NGUYÊN MẢNG STYLE CỦA SẾP
const noticeStyles = [
    "border-[6px] border-slate-800 bg-[#FFDE59] text-slate-900 shadow-[8px_8px_0px_rgba(0,0,0,0.1)]", // Biển vàng
    "border-l-[12px] border-l-rose-500 border-y-2 border-r-2 border-slate-200 bg-white shadow-sm", // Cảnh báo đỏ
    "border-dashed border-[4px] border-sky-300 bg-sky-50 text-sky-900", // Coupon xanh
    "border-2 border-slate-200 bg-slate-50 text-slate-800 shadow-inner", // Note xám
    "border-t-[12px] border-t-emerald-500 border-x-2 border-b-2 border-slate-200 bg-white shadow-sm" // Thông tin xanh
];

const emailStyles = [
    "border-t-[8px] border-t-sky-500 border border-slate-200 bg-white shadow-sm",
    "border-l-[6px] border-l-indigo-500 bg-indigo-50/50 border border-indigo-100",
    "bg-white border border-slate-200 shadow-md",
    "border-t-[8px] border-t-amber-400 border border-slate-200 bg-white shadow-sm"
];

const currentNoticeStyle = noticeStyles[qNumInt % noticeStyles.length];
const currentEmailStyle = emailStyles[qNumInt % emailStyles.length];
---

<div class="bg-white p-6 md:p-10 rounded-[2.5rem] border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:shadow-[0_8px_30px_rgba(16,185,129,0.06)] transition-all duration-300 relative overflow-hidden group/card">
    <div class="absolute top-0 left-0 w-1.5 h-full bg-slate-100 group-hover/card:bg-emerald-400 transition-colors duration-300"></div>
    
    {/* KHU VỰC HIỂN THỊ PART 1 VÀ BIỂN BÁO (GIỮ LOGIC, NÂNG CẤP UI) */}
    {part === 1 && q.Passage && (
        <div class="mb-10 w-full flex justify-center">
            {q.Style === "notice" ? (
                <div class={`p-8 w-full max-w-[360px] text-center flex flex-col justify-center min-h-[160px] rounded-2xl relative ${currentNoticeStyle}`}>
                    <p class="text-lg md:text-xl font-bold leading-snug tracking-wide uppercase" set:html={formattedPassage}></p>
                </div>
            ) : (
                <div class={`p-8 max-w-lg w-full relative rounded-2xl ${currentEmailStyle}`}>
                    <div class="absolute top-4 right-5 text-slate-200 text-4xl select-none hidden md:block">✉️</div>
                    <p class="text-slate-700 text-lg font-medium leading-relaxed" set:html={formattedPassage}></p>
                </div>
            )}
        </div>
    )}

    {/* KHU VỰC CÂU HỎI (LISTENING & READING) */}
    <div class="flex items-start gap-5 mb-8">
        <span class="bg-slate-900 text-emerald-400 font-black w-12 h-12 flex items-center justify-center rounded-2xl shrink-0 shadow-lg shadow-slate-900/20 text-lg">
            {q.Q_Num}
        </span>
        <div class="w-full pt-1.5">
            {/* Context cho Listening */}
            {context && <div class="text-slate-500 font-bold text-sm uppercase tracking-wider mb-3 bg-slate-50 inline-block px-3 py-1 rounded-lg border border-slate-100">{context}</div>}
            {/* Câu hỏi chính */}
            <div class="text-xl md:text-2xl font-black text-slate-800 leading-snug" set:html={mainQuestion}></div>
        </div>
    </div>

    {/* CÁC ĐÁP ÁN A, B, C (UI HIỆN ĐẠI MỚI) */}
    <div class="space-y-4 ml-0 md:ml-[4.25rem]">
        {options.map((opt) => (
            <label class="flex items-center gap-4 p-4 md:p-5 rounded-2xl border-2 border-slate-100 cursor-pointer hover:border-emerald-300 hover:bg-emerald-50/50 transition-all group/opt relative bg-white overflow-hidden">
                <input type="radio" name={inputName} value={opt.key} class="peer sr-only" />
                
                {/* Nút tròn Custom */}
                <div class="w-8 h-8 rounded-full border-2 border-slate-300 bg-white flex items-center justify-center text-sm font-black text-slate-400 peer-checked:border-emerald-500 peer-checked:bg-emerald-500 peer-checked:text-white group-hover/opt:border-emerald-400 transition-all shrink-0">
                    {opt.key}
                </div>
                
                {/* Text đáp án */}
                <div class="text-lg text-slate-600 font-medium peer-checked:text-emerald-800 peer-checked:font-bold transition-all pt-0.5" set:html={opt.text}></div>
                
                {/* Lớp nền xanh nhạt chạy vào khi chọn */}
                <div class="absolute inset-0 bg-emerald-50 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity -z-10"></div>
            </label>
        ))}
    </div>

    {/* LỜI GIẢI THÍCH (Mặc định ẩn) */}
    {q.Explanation && (
        <div class="explanation-box hidden mt-8 p-6 bg-emerald-50 rounded-2xl border border-emerald-100 ml-0 md:ml-[4.25rem]">
            <div class="flex items-center gap-3 mb-3">
                <span class="w-8 h-8 bg-emerald-200 text-emerald-700 flex items-center justify-center rounded-lg text-sm">💡</span>
                <span class="text-sm font-bold text-emerald-800 uppercase tracking-widest">Correct Answer: {q.Answer}</span>
            </div>
            <p class="text-slate-700 font-medium leading-relaxed" set:html={q.Explanation}></p>
        </div>
    )}
</div>