---
// src/components/exam/MultipleChoice.astro
// BẢN TINH GỌN (CHỈ DÀNH CHO READING/WRITING - TONE MÀU EMERALD)
const { q } = Astro.props;

const options = [
    { key: 'A', text: q.Opt_A },
    { key: 'B', text: q.Opt_B },
    { key: 'C', text: q.Opt_C },
    { key: 'D', text: q.Opt_D }
].filter(o => o.text); // Tự động ẩn đi nếu không có đáp án D

const inputName = q.ID || `q_${q.Q_Num}`;
---

<div class="bg-white p-6 md:p-8 rounded-[2rem] border-2 border-slate-100 shadow-sm relative group hover:border-emerald-200 transition-colors">
    
    {/* SỐ CÂU & CÂU HỎI */}
    <div class="flex items-start gap-4 mb-6 relative z-10">
        <span class="bg-emerald-500 text-white font-black w-10 h-10 flex items-center justify-center rounded-xl shrink-0 shadow-sm mt-1">
            {q.Q_Num}
        </span>
        <div class="w-full pt-1.5">
            <div class="text-lg md:text-xl font-bold text-slate-900 leading-relaxed" set:html={q.Question}></div>
        </div>
    </div>

    {/* CÁC ĐÁP ÁN A, B, C */}
    <div class="space-y-3 ml-0 md:ml-14 relative z-10">
        {options.map((opt) => (
            <label class="flex items-start gap-4 p-4 rounded-2xl border-2 border-slate-100 cursor-pointer hover:border-emerald-400 hover:bg-emerald-50 transition-all bg-white group/opt">
                <input type="radio" name={inputName} value={opt.key} class="peer sr-only" />
                
                <div class="w-8 h-8 rounded-full border-2 border-slate-300 bg-white flex items-center justify-center text-sm font-black text-slate-400 peer-checked:border-emerald-500 peer-checked:bg-emerald-500 peer-checked:text-white transition-all shrink-0 mt-0.5 shadow-sm">
                    {opt.key}
                </div>
                
                <div class="text-lg text-slate-700 font-medium peer-checked:text-emerald-800 peer-checked:font-bold transition-all pt-0.5 leading-relaxed" set:html={opt.text}></div>
            </label>
        ))}
    </div>

    {/* LỜI GIẢI THÍCH (Mặc định ẩn, dùng cho tính năng Show Answers sau này) */}
    {q.Explanation && (
        <div class="explanation-box hidden mt-6 p-5 bg-emerald-50/50 rounded-xl border border-emerald-100 ml-0 md:ml-14 relative z-10">
            <div class="flex items-center gap-2 mb-2">
                <span class="text-sm font-bold text-slate-500 uppercase tracking-wider">Đáp án đúng:</span>
                <span class="bg-emerald-500 text-white font-black px-2 py-0.5 rounded-md text-sm">{q.Answer}</span>
            </div>
            <p class="text-base text-slate-700 font-medium leading-relaxed" set:html={q.Explanation}></p>
        </div>
    )}
</div>