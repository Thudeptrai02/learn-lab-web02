---
const { q } = Astro.props;
---

<div class="bg-white border border-slate-100 rounded-[2.5rem] p-8 md:p-10 shadow-sm">
  <div class="flex items-center gap-4 mb-8">
    <span class="bg-slate-900 text-emerald-400 font-black px-4 py-1.5 rounded-xl text-sm italic">Writing</span>
    <span class="text-slate-400 font-bold text-sm uppercase tracking-widest">Question {q.Q_Num}</span>
  </div>

  {q.Image_URL && (
    <div class="mb-10 rounded-[2rem] overflow-hidden border-4 border-slate-50 shadow-inner bg-slate-50">
       <img src={q.Image_URL} alt="Story Prompt" class="w-full object-cover max-h-[400px]" />
       <div class="p-4 text-center text-xs font-bold text-slate-400 uppercase tracking-tighter bg-white/50">Cambridge Style Pencil Sketch Illustration</div>
    </div>
  )}

  <div class="prose prose-slate max-w-none mb-8">
    <p class="text-slate-700 font-medium text-lg leading-relaxed italic" set:html={q.Passage}></p>
  </div>

  <div class="relative">
    <textarea 
      name={q.ID}
      placeholder="Type your answer here..."
      class="w-full min-h-[200px] p-8 rounded-[2rem] border-2 border-slate-100 bg-slate-50/50 focus:bg-white focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 outline-none transition-all text-slate-700 font-medium text-lg resize-none"
      oninput="this.parentElement.querySelector('.word-count span').innerText = this.value.trim().split(/\s+/).filter(w => w.length > 0).length"
    ></textarea>
    
    <div class="word-count absolute bottom-6 right-8 bg-white px-4 py-1.5 rounded-full border border-slate-200 shadow-sm text-xs font-black text-slate-400 uppercase tracking-widest">
      <span>0</span> words
    </div>
  </div>

  <div class="explanation-box hidden mt-8 p-8 bg-slate-900 rounded-[2rem] text-white">
     <h5 class="text-emerald-400 font-black text-xs uppercase tracking-[0.2em] mb-4">Sample Answer</h5>
     <p class="text-slate-300 leading-relaxed italic">{q.Answer}</p>
     <div class="h-px bg-slate-800 my-6"></div>
     <p class="text-slate-400 text-sm font-medium">{q.Explanation}</p>
  </div>
</div>