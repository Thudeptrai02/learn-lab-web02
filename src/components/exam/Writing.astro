---
const { q } = Astro.props;
---
<div class="mb-10 p-6 bg-white rounded-2xl border border-slate-200 shadow-sm">
  <h3 class="font-bold text-lg text-slate-900 mb-4"><span class="text-emerald-600 mr-2">{q.Q_Num}.</span>{q.Question}</h3>
  
  {q.Image_URL && (
    <div class="mb-6 border-2 border-dashed border-slate-300 rounded-xl p-4 text-center bg-slate-50">
      <img src={q.Image_URL} alt="Writing Prompt" class="mx-auto max-w-full rounded-lg" />
    </div>
  )}

  <textarea 
    rows="8" 
    class="w-full border-2 border-slate-200 rounded-xl p-4 focus:border-emerald-500 outline-none resize-none text-slate-700"
    placeholder="Start writing here..."
  ></textarea>
</div>