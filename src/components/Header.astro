---
// src/components/Header.astro
---
<header class="sticky top-4 z-50 mx-auto w-[92%] max-w-7xl rounded-[20px] border border-white/10 bg-neutral-950/60 backdrop-blur-xl shadow-[0_8px_32px_0_rgba(0,0,0,0.5)] transition-all duration-500">
  <div class="px-6 py-3">
    <div class="flex items-center justify-between">
      
      <!-- LOGO -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-teal-600 shadow-lg shadow-teal-500/20 transition-transform duration-500 group-hover:scale-105 group-hover:-rotate-3">
          <span class="text-xl font-black text-white">L</span>
        </div>
        <span class="text-2xl font-black tracking-tight text-white">
          Learn<span class="text-teal-400">Lab</span>
        </span>
      </a>

      <!-- NAVIGATION CHÍNH -->
      <nav class="hidden md:flex flex-1 items-center justify-center gap-8 text-sm font-bold text-slate-300">
        <a href="/" class="transition-colors duration-300 hover:text-teal-400">Trang chủ</a>
        
        <!-- DROPDOWN ENGLISH LAB -->
        <div class="group relative py-4">
          <button class="flex items-center gap-1.5 transition-colors duration-300 hover:text-teal-400 outline-none cursor-pointer">
            English Lab
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4 transition-transform duration-500 group-hover:-rotate-180"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </button>
          <div class="absolute left-1/2 top-full w-56 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
            <div class="rounded-2xl border border-white/10 bg-neutral-950/90 backdrop-blur-xl p-2 shadow-2xl ring-1 ring-black/5">
              <a href="/english-lab/toeic" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 hover:bg-white/5 hover:text-teal-400 transition-colors font-bold"><span class="truncate">TOEIC Master</span></a>
              <a href="/english-lab/toeic/vocab-context" class="flex items-center gap-3 rounded-xl px-4 py-2 text-slate-400 hover:bg-white/5 hover:text-teal-400 transition-colors text-sm"><span class="truncate pl-4">↳ Học Từ Ngữ Cảnh</span></a>
              <a href="/english-lab/ielts" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 hover:bg-white/5 hover:text-teal-400 transition-colors font-bold"><span class="truncate">IELTS Pro</span></a>
              <a href="/english-lab/cambridge" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 hover:bg-white/5 hover:text-teal-400 transition-colors font-bold"><span class="truncate">Cambridge</span></a>
            </div>
          </div>
        </div>
        
        <a href="/blog" class="transition-colors duration-300 hover:text-teal-400">Blog</a>
        
        <a href="/free-resources" class="transition-colors duration-300 hover:text-teal-400">Tài liệu</a>

        <a href="/data-generator/" class="transition-colors duration-300 hover:text-amber-400 font-bold text-amber-500">⚡ Data Gen</a>

        <!-- NÚT ZEN MODE -->
        <a href="/zen-mode" class="group relative flex items-center gap-2 rounded-full bg-teal-500/10 px-4 py-1.5 text-teal-400 transition-all duration-500 hover:text-white overflow-hidden shadow-sm border border-teal-500/20">
          <span class="relative z-10 uppercase tracking-widest text-[10px] font-black">Zen Mode</span>
          <svg class="relative z-10 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          <div class="absolute inset-0 bg-gradient-to-r from-teal-400 to-teal-600 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out"></div>
        </a>
      </nav>

      <!-- AUTH BUTTONS & AVATAR -->
      <div class="flex items-center gap-3 border-l border-white/10 pl-8">
        <div id="auth-out" class="hidden flex items-center gap-3">
          <a href="/login" class="px-4 py-2 text-sm font-bold text-slate-300 transition-all hover:text-teal-400">Đăng nhập</a>
          <a href="/register" class="rounded-xl bg-teal-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-teal-500/10 transition-all hover:bg-teal-500 hover:-translate-y-0.5 active:scale-95 duration-300">Đăng ký</a>
        </div>

        <div id="auth-in" class="hidden relative">
          <button id="avatar-btn" class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-tr from-teal-400 to-teal-600 font-bold text-white shadow-md ring-2 ring-white/10 transition-transform hover:scale-105 active:scale-95 outline-none cursor-pointer">
            <span id="user-initial">U</span>
          </button>
          
          <!-- Dropdown Menu Tài khoản -->
          <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-64 bg-neutral-950/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/10 py-2 origin-top-right z-50">
            <div class="px-5 py-4 border-b border-white/5 mb-2">
              <p class="text-[11px] font-black text-slate-400 uppercase tracking-wider mb-1">Tài khoản của bạn</p>
              <p id="user-name" class="text-sm font-bold text-slate-200 truncate">Học viên</p>
              <p id="user-email" class="text-xs font-medium text-slate-400 truncate">email@example.com</p>
            </div>
            <a href="/profile" class="flex items-center gap-3 px-5 py-2.5 text-sm text-slate-300 hover:bg-white/5 hover:text-teal-400 font-bold transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              Cài đặt hồ sơ
            </a>
            <hr class="my-2 border-white/5 mx-3">
            <button id="logout-btn" class="w-full flex items-center gap-3 px-5 py-2.5 text-sm text-rose-400 hover:bg-rose-500/10 hover:text-rose-300 font-bold transition-colors outline-none cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
              Đăng xuất
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</header>

<script>
  import { supabase } from '../lib/supabase';
  const els = {
    out: document.getElementById('auth-out'),
    in: document.getElementById('auth-in'),
    name: document.getElementById('user-name'),
    email: document.getElementById('user-email'),
    initial: document.getElementById('user-initial'),
    avatarBtn: document.getElementById('avatar-btn'),
    dropdown: document.getElementById('user-dropdown'),
    logoutBtn: document.getElementById('logout-btn')
  };

  function updateUI(session) {
    if (session) {
      els.out?.classList.add('hidden');
      els.in?.classList.remove('hidden');
      const fullName = session.user.user_metadata?.fullname || session.user.email?.split('@')[0];
      if(els.name) els.name.textContent = fullName;
      if(els.initial) els.initial.textContent = fullName.charAt(0).toUpperCase();
      if(els.email) els.email.textContent = session.user.email;
    } else {
      els.out?.classList.remove('hidden');
      els.in?.classList.add('hidden');
    }
  }

  supabase.auth.getSession().then(({ data: { session } }) => updateUI(session));
  supabase.auth.onAuthStateChange((_event, session) => updateUI(session));

  els.avatarBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    els.dropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => els.dropdown?.classList.add('hidden'));

  els.logoutBtn?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.reload(); 
  });
</script>