---
// Header.astro - Menu sạch sẽ: English Lab -> TOEIC, IELTS, Cambridge
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/95 backdrop-blur-sm shadow-sm">
  <div class="mx-auto max-w-7xl px-6 py-4">
    <div class="flex items-center justify-between">
      
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-teal-600 shadow-md shadow-teal-100 transition-transform group-hover:rotate-6">
          <span class="text-xl font-black text-white">L</span>
        </div>
        <span class="text-2xl font-black tracking-tight text-slate-900">
          Learn<span class="text-teal-600">Lab</span>
        </span>
      </a>

      <nav class="hidden md:flex flex-1 items-center justify-center gap-10 text-sm font-bold text-slate-600">
        <a href="/" class="transition-colors hover:text-teal-700">Trang chủ</a>
        
        <div class="group relative py-2">
          <button class="flex items-center gap-1 transition-colors group-hover:text-teal-700">
            English Lab
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4 transition-transform group-hover:rotate-180">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          
          <div class="absolute left-1/2 top-full w-48 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="rounded-2xl border border-slate-100 bg-white p-2 shadow-2xl">
              <a href="/english-lab/toeic" class="block rounded-xl px-4 py-3 text-slate-700 hover:bg-teal-50 hover:text-teal-700 transition-colors font-bold">🎯 TOEIC</a>
              <a href="/english-lab/ielts" class="block rounded-xl px-4 py-3 text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition-colors font-bold">📘 IELTS</a>
              <a href="/english-lab/cambridge" class="block rounded-xl px-4 py-3 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors font-bold">🎓 Cambridge</a>
            </div>
          </div>
        </div>

        <a href="/blog" class="transition-colors hover:text-teal-700">Blog</a>
        <a href="/free-resources" class="transition-colors hover:text-teal-700">Tài liệu</a>
      </nav>

      <div class="hidden md:flex items-center gap-3 shrink-0">
        
        <div id="nav-logged-out" class="flex items-center gap-3">
          <a href="/login" class="px-4 py-2.5 text-sm font-bold text-slate-700 transition-all hover:text-teal-700">Đăng nhập</a>
          <a href="/register" class="rounded-xl bg-teal-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-teal-100 transition-all hover:bg-teal-700 hover:-translate-y-0.5 active:scale-95">Đăng ký</a>
        </div>

        <div id="nav-logged-in" class="hidden relative">
          <button id="avatar-btn" class="flex items-center gap-2 p-1 pl-3 pr-1.5 rounded-full border border-slate-200 hover:bg-slate-50 transition-all focus:ring-2 focus:ring-teal-100 bg-white">
            <span id="nav-user-name" class="text-sm font-bold text-slate-700 max-w-[120px] truncate">Học viên</span>
            <div id="avatar-initial" class="w-8 h-8 bg-gradient-to-br from-teal-400 to-emerald-500 text-white font-bold rounded-full flex items-center justify-center text-sm shadow-inner">
              U
            </div>
          </button>

          <div id="avatar-dropdown" class="hidden absolute right-0 mt-3 w-60 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 origin-top-right z-50 transition-all">
            <div class="px-4 py-3 bg-slate-50/50 border-b border-slate-100 mb-2">
              <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider mb-0.5">Tài khoản</p>
              <p id="dropdown-email" class="text-sm font-bold text-slate-700 truncate">email@example.com</p>
            </div>
            <a href="/profile" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-teal-50 hover:text-teal-700 font-bold transition-colors">
              <span class="text-lg">👤</span> Hồ sơ & Cài đặt AI
            </a>
            <a href="/lego" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-amber-50 hover:text-amber-700 font-bold transition-colors">
              <span class="text-lg">🧱</span> Lego Grammar
            </a>
            <hr class="my-2 border-slate-100">
            <button id="nav-logout-btn" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-rose-600 hover:bg-rose-50 font-bold transition-colors">
              <span class="text-lg">🚪</span> Đăng xuất
            </button>
          </div>
        </div>

      </div>

      <button id="menu-toggle" class="rounded-xl border border-slate-200 p-2 md:hidden hover:bg-slate-50">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden border-t border-slate-100 mt-4 pt-4 md:hidden text-sm font-bold">
      <a href="/" class="block px-4 py-2 hover:bg-slate-50 rounded-lg">Trang chủ</a>
      <p class="px-4 pt-4 text-[10px] uppercase text-slate-400">Chứng chỉ</p>
      <a href="/english-lab/toeic" class="block px-4 py-3 pl-8 text-teal-700 hover:bg-teal-50 rounded-lg">TOEIC</a>
      <a href="/english-lab/ielts" class="block px-4 py-3 pl-8 text-sky-700 hover:bg-sky-50 rounded-lg">IELTS</a>
      <a href="/english-lab/cambridge" class="block px-4 py-3 pl-8 text-emerald-700 hover:bg-emerald-50 rounded-lg">Cambridge</a>
      
      <div id="mobile-logged-out" class="mt-4 border-t border-slate-100 pt-4 flex flex-col gap-2 px-4">
        <a href="/login" class="block w-full text-center rounded-xl px-4 py-3 bg-slate-100 text-slate-700 hover:bg-slate-200">Đăng nhập</a>
        <a href="/register" class="block w-full text-center rounded-xl px-4 py-3 bg-teal-600 text-white hover:bg-teal-700 shadow-md">Đăng ký</a>
      </div>
      
      <div id="mobile-logged-in" class="hidden mt-4 border-t border-slate-100 pt-4 flex flex-col gap-2 px-4">
        <a href="/profile" class="block w-full rounded-xl px-4 py-3 text-slate-700 bg-slate-50 hover:bg-slate-100">👤 Hồ sơ & Cài đặt AI</a>
        <button id="mobile-logout-btn" class="block w-full text-left rounded-xl px-4 py-3 text-rose-600 bg-rose-50 hover:bg-rose-100">🚪 Đăng xuất</button>
      </div>
    </div>
  </div>
</header>

<script>
  // Chú ý: Đường dẫn import Supabase này có thể cần chỉnh lại tùy vào vị trí file Header.astro của sếp
  // Thường là: '../lib/supabase.js' hoặc '../../lib/supabase.js'
  import { supabase } from '../lib/supabase.js';

  // --- 1. XỬ LÝ MENU ĐIỆN THOẠI ---
  const toggleButton = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggleButton && mobileMenu) {
    toggleButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // --- 2. XỬ LÝ AUTHENTICATION (ĐĂNG NHẬP / AVATAR) ---
  const navLoggedOut = document.getElementById('nav-logged-out');
  const navLoggedIn = document.getElementById('nav-logged-in');
  const avatarBtn = document.getElementById('avatar-btn');
  const avatarDropdown = document.getElementById('avatar-dropdown');
  const navUserName = document.getElementById('nav-user-name');
  const avatarInitial = document.getElementById('avatar-initial');
  const dropdownEmail = document.getElementById('dropdown-email');
  const navLogoutBtn = document.getElementById('nav-logout-btn');

  // Cho Mobile
  const mobileLoggedOut = document.getElementById('mobile-logged-out');
  const mobileLoggedIn = document.getElementById('mobile-logged-in');
  const mobileLogoutBtn = document.getElementById('mobile-logout-btn');

  async function checkNavbarAuth() {
    const { data: { session } } = await supabase.auth.getSession();
    
    if (session) {
      // NẾU ĐÃ ĐĂNG NHẬP
      if(navLoggedOut) navLoggedOut.classList.add('hidden');
      if(navLoggedIn) navLoggedIn.classList.remove('hidden');
      if(mobileLoggedOut) mobileLoggedOut.classList.add('hidden');
      if(mobileLoggedIn) mobileLoggedIn.classList.remove('hidden');
      
      const meta = session.user.user_metadata;
      const email = session.user.email;
      const fullName = meta.full_name || email.split('@')[0];
      
      if(navUserName) navUserName.textContent = fullName;
      if(avatarInitial) avatarInitial.textContent = fullName.charAt(0).toUpperCase();
      if(dropdownEmail) dropdownEmail.textContent = email;
    } else {
      // NẾU CHƯA ĐĂNG NHẬP
      if(navLoggedOut) navLoggedOut.classList.remove('hidden');
      if(navLoggedIn) navLoggedIn.classList.add('hidden');
      if(mobileLoggedOut) mobileLoggedOut.classList.remove('hidden');
      if(mobileLoggedIn) mobileLoggedIn.classList.add('hidden');
    }
  }

  // Chạy ngay khi load component
  checkNavbarAuth();

  // Bật/tắt menu xổ xuống khi bấm vào Avatar
  avatarBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    avatarDropdown?.classList.toggle('hidden');
  });

  // Tự động đóng menu Avatar khi click ra ngoài
  document.addEventListener('click', (e) => {
    if (navLoggedIn && !navLoggedIn.contains(e.target)) {
      avatarDropdown?.classList.add('hidden');
    }
  });

  // Chức năng Đăng xuất
  const handleLogout = async () => {
    await supabase.auth.signOut();
    window.location.href = "/login";
  };

  navLogoutBtn?.addEventListener('click', handleLogout);
  mobileLogoutBtn?.addEventListener('click', handleLogout);
</script>